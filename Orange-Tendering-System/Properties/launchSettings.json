      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "TeamDev__Database": "OrangeTenderingTeamDev"
      }
    },
    "https (Orange Radar demo database)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7182;http://localhost:5254",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "TeamDev__Database": "OrangeTenderingTeamDev_RadarDemo",
        "OrangeRadar__DemoDataset__Enabled": "true"
      }
