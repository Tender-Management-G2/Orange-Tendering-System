{
  "ConnectionStrings": {
    "Default Connection": "Server=localhost;Database=OrangeTenderingTeamDev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AccountLinks": {
    "PublicBaseUrl": null
  },
  "TenderApprovalPolicy": {
    "Version": "ORANGE-2026-11",
    "WeightApproverUserIds": [],
    "WeightApproverRoles": [
      "Sourcing Manager"
    ],
    "TopCommitteeRequirement": "All",
    "HighValueThreshold": null,
    "ThresholdCurrency": null,
    "TopQuorum": 4,
    "TopApprovalsRequired": 4,
    "RejectVoteBlocksAward": true,
    "TopTieOutcome": "Block",
    "PreTenderApprovalsRequired": 4
  },
  "ReportSigning": {
    "RequireCertificateBacked": false,
    "StoreLocation": "CurrentUser",
    "UserCertificateThumbprints": {}
  },
  "ReportRevisionPolicy": {
    "Version": null,
    "Routes": []
  },
  "ReportPdf": {
    "FontDirectory": null
  },
  "Meetings": {
    "Provider": "Jitsi"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "gemma3:4b",
    "TimeoutSeconds": 120,
    "NumGpu": 99,
    "ContextLength": 4096
  },
  "OrangeRadar": {
    "Models": {
      "BaseUrl": "http://127.0.0.1:11434",
      "ChatModel": "qwen3.5:4b",
      "DeepModel": null,
      "EmbeddingModel": "qwen3-embedding:0.6b",
      "ContextLength": 8192,
      "MaxAnswerTokens": 420,
      "KeepAlive": "15m",
      "TimeoutSeconds": 90,
      "MaxToolRounds": 4
    },
    "Whisper": {
      "ModelPath": "%USERPROFILE%\\AI-Models\\Whisper\\ggml-small.bin",
      "Threads": 6,
      "MaxSeconds": 30,
      "Runtime": "auto",
      "AdaptiveAudioContext": true
    },
    "Piper": {
      "PythonExecutable": "%LOCALAPPDATA%\\Programs\\Python\\Python312\\python.exe",
      "VoicesDirectory": "%USERPROFILE%\\AI-Models\\Piper",
      "ArabicVoice": "ar_JO-kareem-medium.onnx",
      "EnglishVoice": "en_US-lessac-medium.onnx",
      "WorkerScript": "Tools/OrangeRadar/radar_piper_worker.py"
    },
    "DemoDataset": {
      "Enabled": false
    },
    "CacheSeconds": 60
  },
  "Zoom": {
    "AccountId": null,
    "ClientId": null,
    "ClientSecret": null,
    "HostUserId": null,
    "TimeoutSeconds": 30
  },
  "ExternalInvitations": {
    "Enabled": false,
    "PublicBaseUrl": null,
    "MaxAttempts": 3
  }
}
