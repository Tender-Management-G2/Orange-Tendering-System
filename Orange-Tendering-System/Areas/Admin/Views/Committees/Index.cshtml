@{
    ViewData["Title"] = "Committees";
    ViewData["WorkspaceSection"] = "Committees";
    ViewData["Description"] = "Choose a committee to create and organize its member accounts.";
}
<partial name="_PageHeader" />
<section class="admin-committee-grid" aria-label="Choose a committee">
    <article class="admin-committee-seat admin-committee-choice">
        <span class="pg-status">Evaluation Committee</span>
        <h2>Evaluation Committee</h2>
        <p>Four member categories</p>
        <ul><li>Sourcing Manager</li><li>Technical</li><li>Finance</li><li>Department Representative</li></ul>
        <a class="pg-btn pg-btn-primary" asp-area="Admin" asp-controller="Committees" asp-action="Members" asp-route-committee="Evaluation">Open Evaluation Committee →</a>
    </article>
    <article class="admin-committee-seat admin-committee-choice">
        <span class="pg-status">Top Committee</span>
        <h2>Top Committee</h2>
        <p>Four member categories</p>
        <ul><li>Chief Executive Officer</li><li>Chief Financial Officer</li><li>Chief Technology Officer</li><li>Chief Operations Officer</li></ul>
        <a class="pg-btn pg-btn-primary" asp-area="Admin" asp-controller="Committees" asp-action="Members" asp-route-committee="Top">Open Top Committee →</a>
    </article>
</section>
