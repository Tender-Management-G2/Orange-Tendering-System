@{
    ViewData["Title"] = "Committees";
    ViewData["BodyClass"] = "admin-committees-home";
    ViewData["WorkspaceSection"] = "Committees";
    ViewData["Description"] = "Choose a committee to create and organize its member accounts.";
}
<partial name="_PageHeader" />
<section class="admin-committee-grid" aria-label="Choose a committee">
    <article class="admin-committee-seat admin-committee-choice admin-committee-choice--evaluation">
        <div class="admin-committee-choice-heading">
            <span class="admin-committee-choice-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("scale"))</svg></span>
            <div>
                <h2>Evaluation Committee</h2>
                <p>Four member categories</p>
            </div>
        </div>
        <ul><li>Sourcing Manager</li><li>Technical</li><li>Finance</li><li>Department Representative</li></ul>
        <a class="pg-btn pg-btn-primary" asp-area="Admin" asp-controller="Committees" asp-action="Members" asp-route-committee="Evaluation">Open Evaluation Committee <span class="admin-committee-choice-arrow" aria-hidden="true">→</span></a>
    </article>
    <article class="admin-committee-seat admin-committee-choice admin-committee-choice--top">
        <div class="admin-committee-choice-heading">
            <span class="admin-committee-choice-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("users"))</svg></span>
            <div>
                <h2>Top Committee</h2>
                <p>Four member categories</p>
            </div>
        </div>
        <ul><li>Chief Executive Officer</li><li>Chief Financial Officer</li><li>Chief Technology Officer</li><li>Chief Operations Officer</li></ul>
        <a class="pg-btn pg-btn-primary" asp-area="Admin" asp-controller="Committees" asp-action="Members" asp-route-committee="Top">Open Top Committee <span class="admin-committee-choice-arrow" aria-hidden="true">→</span></a>
    </article>
</section>
