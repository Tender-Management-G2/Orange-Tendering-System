
@*
ORANGE TENDER MANAGEMENT SYSTEM
OWNER: Rjoub
PAGE: Create Department
*@

@model CreateDepartmentViewModel

@{
    ViewData["Title"] = "Create Department";
    ViewData["WorkspaceSection"] = "Departments";
    ViewData["Description"] =
        "Add a department.";
}

<partial name="_PageHeader" />

<section class="ws-panel pg-panel">

    <h2>Create Department</h2>

    <form asp-area="Admin"
          asp-controller="Departments"
          asp-action="Create"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="pg-form-grid">

            <!-- Department Name -->
            <div class="pg-field">
                <label asp-for="Name"></label>

                <input asp-for="Name"
                       class="form-control"
                       maxlength="100"
                       placeholder="Enter department name" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>

                <small class="pg-hint">
                    Department name must be unique.
                </small>
            </div>

            <!-- Description -->
            <div class="pg-field pg-field-wide">
                <label asp-for="Description"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="2"
                          maxlength="160"
                          placeholder="Brief description (up to 160 characters)"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <!-- Department Status -->
            <div class="pg-field pg-field-wide">
                <label class="pg-check">
                    <input asp-for="IsActive" />
                    Active Department
                </label>
            </div>

        </div>

        <!-- ACTIONS -->
        <div class="pg-actions">

            <button type="submit"
                    class="pg-btn pg-btn-primary">
                Create Department
            </button>

            <a asp-area="Admin"
               asp-controller="Departments"
               asp-action="Index"
               class="pg-btn">
                Cancel
            </a>

        </div>

    </form>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
