@model List<DepartmentListViewModel>

@{
    ViewData["Title"] = "Department Management";
    ViewData["WorkspaceSection"] = "Departments";
    ViewData["Description"] = "Manage organization departments and their activity.";
}

<partial name="_PageHeader" />

<section class="ws-panel pg-panel">

    <div class="pg-panel-head">
        <h2>Departments</h2>

        <a class="pg-btn pg-btn-primary"
           asp-area="Admin"
           asp-controller="Departments"
           asp-action="Create">
            Add Department
        </a>
    </div>

    <div class="pg-table-wrap">

        <table class="pg-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Employees</th>
                    <th>Purchase Requests</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            No departments found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var department in Model)
                    {
                        <tr>
                            <td>@department.Name</td>

                            <td>@department.Description</td>

                            <td>@department.EmployeeCount</td>

                            <td>@department.PurchaseRequestCount</td>

                            <td>
                                @if (department.IsActive)
                                {
                                    <span class="pg-status">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="pg-status">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <a class="pg-btn"
                                   asp-area="Admin"
                                   asp-controller="Departments"
                                   asp-action="Edit"
                                   asp-route-id="@department.Id">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>

</section>
