
@*
ORANGE TENDER MANAGEMENT SYSTEM
OWNER: Rjoub
PAGE: Edit Department
*@

@model EditDepartmentViewModel

@{
    ViewData["Title"] = "Edit Department";
    ViewData["WorkspaceSection"] = "Departments";
    ViewData["Description"] =
        "Update department information and employee assignments.";
}

<partial name="_PageHeader" />

<section class="ws-panel pg-panel">

    <h2>Edit Department</h2>

    <form asp-area="Admin"
          asp-controller="Departments"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="pg-form-grid">

            <!-- Department Name -->
            <div class="pg-field">
                <label asp-for="Name"></label>

                <input asp-for="Name"
                       class="form-control"
                       maxlength="100"
                       placeholder="Enter department name" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>

                <small class="pg-hint">
                    Department name must be unique.
                </small>
            </div>

            <!-- Description -->
            <div class="pg-field pg-field-wide">

                <label asp-for="Description"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          maxlength="500"
                          placeholder="Enter department description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <!-- Status -->
            <div class="pg-field pg-field-wide">
                <label class="pg-check">
                    <input asp-for="IsActive" />
                    Active Department
                </label>
            </div>

        </div>

        <!-- ==================================
             EMPLOYEE MANAGEMENT
        =================================== -->

        <div class="pg-field pg-field-wide">

            <h3>Department Employees</h3>

            <p class="pg-hint">
                Selected employees belong to this department.
                Add available employees or deselect existing
                employees to remove their department assignment.
            </p>

            @if (Model.AvailableEmployees.Any())
            {
                <select asp-for="SelectedEmployeeIds"
                        asp-items="Model.AvailableEmployees"
                        multiple
                        size="8"
                        class="form-control"
                        aria-label="Manage department employees">
                </select>

                <small class="pg-hint">
                    Hold Ctrl to select multiple employees.
                    Deselecting an employee will not delete
                    their account.
                </small>
            }
            else
            {
                <p class="pg-hint">
                    No employees are currently available.
                </p>
            }

            <span asp-validation-for="SelectedEmployeeIds"
                  class="text-danger"></span>

        </div>

        <!-- ACTIONS -->
        <div class="pg-actions">

            <button type="submit"
                    class="pg-btn pg-btn-primary">
                Save Changes
            </button>

            <a asp-area="Admin"
               asp-controller="Departments"
               asp-action="Index"
               class="pg-btn">
                Cancel
            </a>

        </div>

    </form>

</section>

<aside class="pg-note">
    <strong>Keep History</strong>

    <p>
        Departments with purchase requests should not
        be deleted. Deactivate them instead to preserve
        historical records.

        Removing an employee from a department does not
        delete their user account.
    </p>
</aside>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
