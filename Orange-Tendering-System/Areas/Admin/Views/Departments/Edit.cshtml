STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@

@model EditDepartmentViewModel

@{
    ViewData["Title"] = "Edit Department";
    ViewData["WorkspaceSection"] = "Departments";
    ViewData["Description"] = "Update department information and status.";
}

<partial name="_PageHeader" />

<section class="ws-panel pg-panel">

    <h2>Edit Department</h2>

    <form asp-area="Admin"
          asp-controller="Departments"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="pg-form-grid">

            <!-- Department Name -->
            <div class="pg-field">
                <label asp-for="Name"></label>

                <input asp-for="Name"
                       class="form-control"
                       maxlength="100"
                       placeholder="Enter department name" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>

                <small class="pg-hint">
                    Department name must be unique.
                </small>
            </div>

            <!-- Department Description -->
            <div class="pg-field pg-field-wide">
                <label asp-for="Description"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          maxlength="500"
                          placeholder="Enter department description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <!-- Department Status -->
            <label class="pg-check">
                <input asp-for="IsActive" />
                Active
            </label>

        </div>

        <div class="pg-actions">

            <button type="submit"
                    class="pg-btn pg-btn-primary">
                Save Changes
            </button>

            <a asp-area="Admin"
               asp-controller="Departments"
               asp-action="Index"
               class="pg-btn">
                Cancel
            </a>

        </div>

    </form>

</section>

<aside class="pg-note">
    <strong>Keep History</strong>
    <p>
        Departments with purchase requests should not
        be deleted. Deactivate them instead to preserve
        historical records.
    </p>
</aside>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li>
            <a asp-area="Admin"
               asp-controller="Departments"
               asp-action="Index">
                Back to Departments
            </a>
        </li>
    </ul>
</nav>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
