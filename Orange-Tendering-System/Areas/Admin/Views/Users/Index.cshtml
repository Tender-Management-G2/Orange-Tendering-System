
@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: User Management
DEVELOPER OWNER: Rjoub
MODULE: Administration

FEATURES:
- Real database KPI cards
- Manual Search
- Voice Search
- Role Filter
- Department Filter
- Status Filter
- Server-side Pagination
- Create / Details / Edit User
===========================================================
*@

@using Orange_Tendering_System.Models
@model UserIndexViewModel

@{
    ViewData["Title"] = "User Management";
    ViewData["WorkspaceSection"] = "Users";
    ViewData["Description"] =
        "Manage employee and supplier accounts.";
}

<partial name="_PageHeader" />

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<section class="dash-metrics admin-management-stats" aria-label="Users statistics">
    <article class="dash-metric dash-orange">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("users"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.TotalUsers</strong>
            <span>Total Users</span>
        </div>
    </article>
    <article class="dash-metric dash-blue">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("check"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.ActiveUsers</strong>
            <span>Active Users</span>
        </div>
    </article>
    <article class="dash-metric dash-purple">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("shield"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.InactiveUsers</strong>
            <span>Inactive Users</span>
        </div>
    </article>
    <article class="dash-metric dash-green">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("building"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.DepartmentUsers</strong>
            <span>Department Users</span>
        </div>
    </article>
</section>

<form asp-area="Admin" asp-controller="Users" asp-action="Index" method="get" class="admin-list-filters" data-admin-list-filters>
<div class="admin-filter-field admin-filter-search">
    <label for="admin-list-search">Search</label>
    <input id="admin-list-search" type="text" name="search" value="@Model.Search" placeholder="Name or email" aria-label="Search Users" maxlength="100" /></div>
<div class="admin-filter-field">
    <label for="roleFilter">Role</label>
    <select id="roleFilter" name="roleFilter"
            aria-label="Filter by role">

        <option value="All"
                selected="@(string.IsNullOrEmpty(Model.RoleFilter)
                    || Model.RoleFilter == "All")">
            All Roles
        </option>

        @foreach (var role in SystemRoles.PublicRoles)
        {
            <option value="@role"
                    selected="@(Model.RoleFilter == role)">
                @role
            </option>
        }

    </select></div>
<div class="admin-filter-field">
    <label for="departmentFilter">Department</label>
    <select id="departmentFilter" name="departmentFilter"
            aria-label="Filter by department">

        <option value="All"
                selected="@(string.IsNullOrEmpty(Model.DepartmentFilter)
                    || Model.DepartmentFilter == "All")">
            All Departments
        </option>

        @foreach (var department in Model.Departments)
        {
            <option value="@department.Value"
                    selected="@(Model.DepartmentFilter == department.Value)">
                @department.Text
            </option>
        }

    </select></div>
<div class="admin-filter-field">
    <label for="statusFilter">Status</label>
    <select id="statusFilter" name="statusFilter"
            aria-label="Filter by status">

        <option value="All"
                selected="@(string.IsNullOrEmpty(Model.StatusFilter)
                    || Model.StatusFilter == "All")">
            All Statuses
        </option>

        <option value="Active"
                selected="@(Model.StatusFilter == "Active")">
            Active
        </option>

        <option value="Inactive"
                selected="@(Model.StatusFilter == "Inactive")">
            Inactive
        </option>

    </select></div>
<a asp-area="Admin" asp-controller="Users" asp-action="Index" class="pg-btn pg-btn-primary admin-clear">Clear</a>
</form>
<p class="pg-hint admin-list-status" data-admin-list-status role="status" aria-live="polite"></p>





<!-- =====================================
     USERS TABLE
===================================== -->

<div data-admin-list-results>
<section class="ws-panel pg-panel admin-list-records">

    <div class="pg-panel-head">

        <div>
            <h2>User Accounts</h2>

            <p>
                Matching Users: @Model.TotalRecords
            </p>
        </div>

        <a class="pg-btn pg-btn-primary"
           asp-area="Admin"
           asp-controller="Users"
           asp-action="Create"
           data-no-modal>
            Create User
        </a>

    </div>

    <div class="pg-table-wrap">

        <table class="pg-table">

            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Department / Company</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="6">
                            No matching users found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>

                            <td>
                                @user.FullName
                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>
                                @user.Roles
                            </td>

                            <td>
                                @user.DepartmentOrCompany
                            </td>

                            <td>
                                <span class="pg-status">
                                    @user.StatusLabel
                                </span>
                            </td>

                            <td><div class="admin-row-actions">
                                <a class="pg-btn"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Details" data-modal="center"
                                   asp-route-id="@user.Id">
                                    Details
                                </a>

                                <a class="pg-btn pg-btn-primary"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Edit"
                                   asp-route-id="@user.Id">
                                    Edit
                                </a>
                            </div></td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>


    <!-- =====================================
         PAGINATION
    ===================================== -->

    @if (Model.TotalPages > 1)
    {
        <nav class="pg-actions"
             aria-label="User pages">

            @if (Model.CurrentPage > 1)
            {
                <a class="pg-btn"
                   asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-roleFilter="@Model.RoleFilter"
                   asp-route-departmentFilter="@Model.DepartmentFilter"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    Previous
                </a>
            }

            <span>
                Page @Model.CurrentPage of @Model.TotalPages
            </span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="pg-btn pg-btn-primary"
                   asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-roleFilter="@Model.RoleFilter"
                   asp-route-departmentFilter="@Model.DepartmentFilter"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    Next
                </a>
            }

        </nav>
    }

</section>
</div>


<!-- =====================================
     EXISTING VOICE SEARCH SCRIPT
===================================== -->


@section Scripts {
    <script src="~/js/admin-list-live.js" asp-append-version="true"></script>
}
