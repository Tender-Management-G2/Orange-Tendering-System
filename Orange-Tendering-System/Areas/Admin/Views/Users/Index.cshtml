@{
    ViewData["Title"] = "User Management";
    ViewData["WorkspaceSection"] = "Users";
    ViewData["Description"] = "Internal employee accounts and supplier login accounts, with roles, department or company, and status.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search by name or email" aria-label="Search by name or email" />
    <select aria-label="Role"><option>Role: All</option><option>Role: Admin</option><option>Role: Requesting Department</option><option>Role: Sourcing Officer</option><option>Role: Supplier</option><option>Role: Evaluation Committee</option><option>Role: Sourcing Manager</option><option>Role: Top Committee</option></select>
    <select aria-label="Status"><option>Status: All</option><option>Status: Active</option><option>Status: Inactive</option></select>
    <span class="pg-hint">Search and filters update the records shown on this page.</span>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-accounts">
    <div class="pg-panel-head"><h2 id="tbl-accounts">Accounts</h2><a class="pg-btn pg-btn-primary" asp-area="Admin" asp-controller="Users" asp-action="Create">Create user</a></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Full name</th><th scope="col">Email</th><th scope="col">Role(s)</th><th scope="col">Department / Company</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody><tr><td colspan="6"><partial name="_EmptyState" model='"No user accounts are loaded yet."' /></td></tr></tbody>
        </table>
    </div>
</section>
