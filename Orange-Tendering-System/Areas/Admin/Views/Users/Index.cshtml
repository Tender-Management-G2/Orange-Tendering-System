@model List<UserListViewModel>

@{
    ViewData["Title"] = "User Management";
    ViewData["WorkspaceSection"] = "Users";
    ViewData["Description"] =
        "Manage employee and supplier accounts.";
}

<partial name="_PageHeader" />

<section class="ws-panel pg-panel">

    <div class="pg-panel-head">
        <div>
            <h2>User Accounts</h2>
            <p>
                Total Users: @(Model?.Count ?? 0)
            </p>
        </div>

        <a class="pg-btn pg-btn-primary"
           asp-area="Admin"
           asp-controller="Users"
           asp-action="Create">
            Create User
        </a>
    </div>

    <div class="pg-table-wrap">

        <table class="pg-table">

            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role(s)</th>
                    <th>Department / Company</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            No user accounts found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FullName</td>

                            <td>@user.Email</td>

                            <td>@user.Roles</td>

                            <td>@user.DepartmentOrCompany</td>

                            <td>
                                <span class="pg-status">@user.StatusLabel</span>
                            </td>

                            <td>
                                <a class="pg-btn"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Details"
                                   asp-route-id="@user.Id">
                                    Details
                                </a>

                                <a class="pg-btn"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Edit"
                                   asp-route-id="@user.Id">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>

</section>
