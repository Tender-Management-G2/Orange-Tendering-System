@model List<Orange_Tendering_System.Models.Entities.ApplicationUser>
<h1>User management</h1><a asp-action="Create">Create employee account</a><table><tr><th>Name</th><th>Email</th><th>Active</th><th>Confirmed</th></tr>@foreach(var u in Model){<tr><td><a asp-action="Details" asp-route-id="@u.Id">@u.FullName</a></td><td>@u.Email</td><td>@u.IsActive</td><td>@u.EmailConfirmed</td></tr>}</table>
