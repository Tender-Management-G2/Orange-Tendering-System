@using Orange_Tendering_System.Models
@using Orange_Tendering_System.Models.Entities
<h1>Create employee account</h1><p>The employee sets their private password through a secure activation email.</p><div asp-validation-summary="All"></div><form method="post" asp-action="Create"><label>Full name<input name="fullName" required /></label><label>Email<input name="email" type="email" required /></label><label>Department<select name="departmentId">@foreach(Department d in ViewBag.Departments){<option value="@d.Id">@d.Name</option>}</select></label><label>Role<select name="role">@foreach(var role in SystemRoles.All.Where(r=>r!=SystemRoles.Supplier)){<option>@role</option>}</select></label><button>Create employee and send activation</button></form>
