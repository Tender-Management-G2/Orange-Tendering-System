@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Create User

DEVELOPER OWNER: Rjoub
MODULE: Administration
TRELLO TASK: User Management
TRELLO URL: https://trello.com/c/UYxdWeUv

PURPOSE:
Form to create an internal employee account with department
and role(s).

BUSINESS ACCESS:
Admin

ROUTE: /Admin/Users/Create

FUTURE IMPLEMENTATION:
- Add [HttpPost, ValidateAntiForgeryToken] Create with
  server-side validation.
- Create the user with UserManager and set FullName,
  DepartmentId and IsActive.
- Assign roles with UserManager.AddToRoleAsync using the
  SystemRoles names.
- Write an AuditLog entry without the password.

DEPENDENCIES:
AspNetUsers, AspNetRoles, Departments, AuditLogs.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
No hardcoded passwords or demo accounts.
===========================================================
*@

@model CreateUserViewModel

@{
    var committeeSeat = CommitteeAccountSeats.Find(Model.CommitteeSeat);
    ViewData["Title"] = committeeSeat == null ? "Create User" : $"Create {committeeSeat.Title}";
    ViewData["WorkspaceSection"] = "Users";
    ViewData["Description"] =
        committeeSeat == null ? "Create an internal employee account." : $"{(committeeSeat.Committee == "Top" ? "Top Committee" : "Evaluation Committee")} · {committeeSeat.Title}";
}

<partial name="_PageHeader" />

<section class="ws-panel pg-panel">

    <h2>@(committeeSeat == null ? "Create Employee Account" : $"Create {committeeSeat.Title} Account")</h2>

    <form asp-area="Admin"
          asp-controller="Users"
          asp-action="Create"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CommitteeSeat" />
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="pg-form-grid">

            <div class="pg-field">
                <label asp-for="FullName">Full Name</label>

                <input asp-for="FullName"
                       class="form-control"
                       maxlength="150" />

                <span asp-validation-for="FullName"
                      class="text-danger"></span>
            </div>

            <div class="pg-field">
                <label asp-for="Email">Email</label>

                <input asp-for="Email"
                       class="form-control"
                       type="email" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="pg-field">
                <label asp-for="DepartmentId">Department</label>

                <select asp-for="DepartmentId"
                        asp-items="Model.Departments"
                        class="form-control">
                    <option value="">Select Department</option>
                </select>

                <span asp-validation-for="DepartmentId"
                      class="text-danger"></span>
            </div>

            <div class="pg-field">
                <label asp-for="Role">Role</label>

                @if (committeeSeat != null)
                {
                    <input type="hidden" asp-for="Role" />
                    <input value="@committeeSeat.Role" class="form-control" readonly aria-label="Assigned committee role" />
                    <small class="pg-hint">Committee and category: @(committeeSeat.Committee == "Top" ? "Top Committee" : "Evaluation Committee") · @committeeSeat.Title</small>
                }
                else
                {
                <select asp-for="Role"
                        asp-items="Model.Roles"
                        class="form-control">
                    <option value="">Select Role</option>
                </select>
                }

                <span asp-validation-for="Role"
                      class="text-danger"></span>
            </div>

            <div class="pg-field pg-field-wide">
                <p class="pg-hint">The user will receive a welcome email with a secure link to set their password and a link to sign in. The password link expires in one hour.</p>
            </div>

            <div class="pg-field">
                <label class="pg-check">
                    <input asp-for="IsActive" />
                    Active Account
                </label>
            </div>

        </div>

        <div class="pg-actions">

            <button type="submit"
                    class="pg-btn pg-btn-primary">
                Create Account
            </button>

            <a asp-area="Admin"
               asp-controller="Users"
               asp-action="Index"
               class="pg-btn">
                Cancel
            </a>

        </div>

    </form>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li>
            <a asp-area="Admin"
               asp-controller="Users"
               asp-action="Index">
                Back to Users
            </a>
        </li>
    </ul>
</nav>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
