@using Orange_Tendering_System.Models
@using Orange_Tendering_System.Models.Entities
@{ ViewData["Title"] = "Create employee account"; ViewData["WorkspaceSection"] = "Users"; ViewData["Description"] = "The employee sets their private password through a secure activation email."; }
<partial name="_PageHeader" />
<section class="ws-panel pg-panel">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <form method="post" asp-action="Create" class="pg-form">
        <div class="pg-form-grid">
            <div class="pg-field"><label for="fullName">Full name</label><input id="fullName" name="fullName" required /></div>
            <div class="pg-field"><label for="email">Email</label><input id="email" name="email" type="email" required /></div>
            <div class="pg-field"><label for="departmentId">Department</label><select id="departmentId" name="departmentId">@foreach (Department d in ViewBag.Departments) { <option value="@d.Id">@d.Name</option> }</select></div>
            <div class="pg-field"><label for="role">Role</label><select id="role" name="role">@foreach (var role in SystemRoles.All.Where(r => r != SystemRoles.Supplier)) { <option>@role</option> }</select></div>
        </div>
        <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Create employee and send activation</button><a class="pg-btn" asp-action="Index">Cancel</a></div>
    </form>
</section>
