@{
    ViewData["Title"] = "Create User";
    ViewData["WorkspaceSection"] = "Users";
    ViewData["Description"] = "Provision an internal employee account and assign its department and role(s).";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Account details</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field"><label for="f-full-name-1">Full name</label><input id="f-full-name-1" type="text" /></div>
                <div class="pg-field"><label for="f-email-2">Email</label><input id="f-email-2" type="email" /></div>
                <div class="pg-field"><label for="f-department-3">Department</label><select id="f-department-3"><option>Select a department</option></select></div>
                <div class="pg-field"><label for="f-role-s-4">Role(s)</label><select id="f-role-s-4"><option>Requesting Department</option><option>Sourcing Officer</option><option>Evaluation Committee</option><option>Sourcing Manager</option><option>Top Committee</option><option>Admin</option></select></div>
                <div class="pg-field"><label for="f-temporary-password-5">Temporary password</label><input id="f-temporary-password-5" type="password" /><small class="pg-hint">The user changes it after the first sign-in.</small></div>
                <label class="pg-check"><input type="checkbox" id="f-active-account-6" /> Active account</label>
            </div>
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Create account</button><span class="pg-hint">Not implemented yet — nothing is saved.</span></div>
        </fieldset>
    </form>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Admin" asp-controller="Users" asp-action="Index">Back to users</a></li>
    </ul>
