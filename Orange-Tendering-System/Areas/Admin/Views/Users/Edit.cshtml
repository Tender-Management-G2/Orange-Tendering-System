@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Edit User

DEVELOPER OWNER: Rjoub
MODULE: Administration
TRELLO TASK: User Management
TRELLO URL: https://trello.com/c/UYxdWeUv

PURPOSE:
Edit an existing account’s name, department, roles and
active status.

BUSINESS ACCESS:
Admin

ROUTE: /Admin/Users/Edit/{id?}

FUTURE IMPLEMENTATION:
- Load the user by id; return NotFound when missing.
- POST Edit: update fields, add/remove roles, keep at least
  one active Admin.
- Audit role and status changes.

DEPENDENCIES:
AspNetUsers, AspNetUserRoles, Departments, AuditLogs.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@
@{
    ViewData["Title"] = "Edit User";
    ViewData["WorkspaceSection"] = "Users";
    ViewData["Description"] = "Change an employee account’s name, department, roles and active status.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Account details</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field"><label for="f-full-name-1">Full name</label><input id="f-full-name-1" type="text" /></div>
                <div class="pg-field"><label for="f-email-2">Email</label><input id="f-email-2" type="email" /><small class="pg-hint">Changing the email also changes the sign-in name.</small></div>
                <div class="pg-field"><label for="f-department-3">Department</label><select id="f-department-3"><option>Select a department</option></select></div>
                <div class="pg-field"><label for="f-role-s-4">Role(s)</label><select id="f-role-s-4"><option>Requesting Department</option><option>Sourcing Officer</option><option>Evaluation Committee</option><option>Sourcing Manager</option><option>Top Committee</option><option>Admin</option></select></div>
                <label class="pg-check"><input type="checkbox" id="f-active-account-5" /> Active account</label>
            </div>
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Save changes</button><span class="pg-hint">Not implemented yet — nothing is saved.</span></div>
        </fieldset>
    </form>
</section>

<aside class="pg-note"><strong>Deactivate, do not delete</strong><p>Users who created requests, bids, scores or votes must stay in the database. Clear "Active account" to block sign-in.</p></aside>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Admin" asp-controller="Users" asp-action="Details">User details</a></li>
        <li><a asp-area="Admin" asp-controller="Users" asp-action="Index">Back to users</a></li>
    </ul>
</nav>
