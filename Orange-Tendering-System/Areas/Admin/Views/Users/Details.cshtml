@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: User Details

DEVELOPER OWNER: Rjoub
MODULE: Administration
TRELLO TASK: User Management
TRELLO URL: Not provided — add from the Trello board

PURPOSE:
Read-only view of one account and its recent audited
changes.

BUSINESS ACCESS:
Admin

ROUTE: /Admin/Users/Details/{id?}

FUTURE IMPLEMENTATION:
- Load the user, roles, department and supplier.
- Show AuditLogs where EntityName = AspNetUsers and EntityId
  = user id.

DEPENDENCIES:
AspNetUsers, AspNetUserRoles, Departments, Suppliers,
AuditLogs.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@
@{
    ViewData["Title"] = "User Details";
    ViewData["WorkspaceSection"] = "Users";
    ViewData["Description"] = "Account information, roles and recent audited changes for one user.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Account</h2>
    <dl class="pg-dl">
        <div><dt>Full name</dt><dd>—</dd></div>
        <div><dt>Email</dt><dd>—</dd></div>
        <div><dt>Role(s)</dt><dd>—</dd></div>
        <div><dt>Department</dt><dd>—</dd></div>
        <div><dt>Supplier company</dt><dd>—</dd></div>
        <div><dt>Status</dt><dd>—</dd></div>
        <div><dt>Email confirmed</dt><dd>—</dd></div>
        <div><dt>Locked out until</dt><dd>—</dd></div>
    </dl>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-recent-audit-entries">
    <div class="pg-panel-head"><h2 id="tbl-recent-audit-entries">Recent audit entries</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Date (UTC)</th><th scope="col">Action</th><th scope="col">Entity</th><th scope="col">Changed by</th></tr></thead>
            <tbody><tr><td colspan="4"><partial name="_EmptyState" model='"No audit entries are loaded yet."' /></td></tr></tbody>
        </table>
    </div>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Admin" asp-controller="Users" asp-action="Edit">Edit user</a></li>
        <li><a asp-area="Admin" asp-controller="Users" asp-action="Index">Back to users</a></li>
    </ul>
</nav>
