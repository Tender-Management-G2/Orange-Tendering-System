@model Orange_Tendering_System.Models.Entities.ApplicationUser
<h1>@Model.FullName</h1><p>@Model.Email · Active: @Model.IsActive · Email confirmed: @Model.EmailConfirmed</p><form asp-action="SetActive" method="post"><input name="id" value="@Model.Id" type="hidden"/><button name="active" value="@((!Model.IsActive).ToString().ToLowerInvariant())">@(Model.IsActive?"Deactivate account":"Activate account")</button></form>
