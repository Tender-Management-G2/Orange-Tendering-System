@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Audit Logs
DEVELOPER OWNER: Rjoub
MODULE: Administration

PURPOSE:
Search, filter and read the AuditLogs table.

BUSINESS ACCESS: Admin
ROUTE: /Admin/AuditLogs

IMPORTANT:
Audit records must never contain passwords,
tokens or biometric data.
===========================================================
*@

@model AuditLogPageViewModel

@{
    ViewData["Title"] = "Audit Logs";
    ViewData["WorkspaceSection"] = "AuditLogs";
    ViewData["Description"] = "Search and review recorded system activities.";
}

<partial name="_PageHeader" />

<form asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" method="get" class="admin-list-filters admin-audit-filters" data-admin-list-filters>
<div class="admin-filter-field admin-filter-search">
    <label for="audit-log-search">Search</label>
    <input id="audit-log-search" type="text" name="search" value="@Model.Search" placeholder="User, action or entity" aria-label="Search AuditLogs" maxlength="100" /></div>
<div class="admin-filter-field">
    <label for="fromDate">From Date</label>
    <input id="fromDate" type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" aria-label="From Date" /></div>
<div class="admin-filter-field">
    <label for="toDate">To Date</label>
    <input id="toDate" type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" aria-label="To Date" /></div>
<a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="pg-btn pg-btn-primary admin-clear">Clear</a>
</form>
<p class="pg-hint admin-list-status" data-admin-list-status role="status" aria-live="polite"></p>
<div data-admin-list-results>
<section class="ws-panel pg-panel admin-list-records">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <!-- Results -->
    <div class="pg-panel-head">
        <div>
            <h2>Recorded Activities</h2>

            <p>
                Total matching records: @Model.TotalRecords
            </p>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="pg-table-wrap">

        <table class="pg-table" data-no-enhance>

            <thead>
                <tr>
                    <th>Date &amp; Time (Jordan time)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Changes</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Logs.Any())
                {
                    <tr>
                        <td colspan="6">
                            No matching audit logs found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model.Logs)
                    {
                        <tr>

                            <!-- Date -->
                            <td>
                                @log.CreatedAt.ToJordan("yyyy-MM-dd HH:mm")
                            </td>

                            <!-- User -->
                            <td>
                                @log.UserName
                            </td>

                            <!-- Action -->
                            <td>
                                <span class="pg-status">
                                    @log.Action
                                </span>
                            </td>

                            <!-- Entity -->
                            <td>
                                @log.EntityName
                            </td>

                            <!-- Record ID -->
                            <td>
                                @log.EntityId
                            </td>

                            <!-- Changes -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(log.OldValues) ||
                                     !string.IsNullOrWhiteSpace(log.NewValues))
                                {
                                    <details>
                                        <summary>View Changes</summary>

                                        @if (!string.IsNullOrWhiteSpace(log.OldValues))
                                        {
                                            <p>
                                                <strong>Before:</strong>
                                            </p>

                                            <pre style="white-space:pre-wrap;overflow-wrap:anywhere;">@log.OldValues</pre>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(log.NewValues))
                                        {
                                            <p>
                                                <strong>After:</strong>
                                            </p>

                                            <pre style="white-space:pre-wrap;overflow-wrap:anywhere;">@log.NewValues</pre>
                                        }
                                    </details>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="pg-actions" aria-label="Audit log pages">

            <!-- Previous Page -->
            @if (Model.CurrentPage > 1)
            {
                <a class="pg-btn"
                   asp-area="Admin"
                   asp-controller="AuditLogs"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                   asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    Previous
                </a>
            }

            <!-- Current Page -->
            <span>
                Page @Model.CurrentPage of @Model.TotalPages
            </span>

            <!-- Next Page -->
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="pg-btn pg-btn-primary"
                   asp-area="Admin"
                   asp-controller="AuditLogs"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                   asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    Next
                </a>
            }

        </nav>
    }


</section>
</div>
@section Scripts {
    <script src="~/js/admin-list-live.js" asp-append-version="true"></script>
}
