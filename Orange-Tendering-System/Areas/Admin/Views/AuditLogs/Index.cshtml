@{
    ViewData["Title"] = "Audit Logs";
    ViewData["WorkspaceSection"] = "Audit Logs";
    ViewData["Description"] = "Who changed what, and when, across the system.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search entity name or record ID" aria-label="Search entity name or record ID" />
    <select aria-label="Action"><option>Action: All</option><option>Action: Create</option><option>Action: Update</option><option>Action: Delete</option><option>Action: Submit</option><option>Action: Approve</option><option>Action: Reject</option><option>Action: Vote</option></select>
    <select aria-label="Entity"><option>Entity: All</option><option>Entity: PurchaseRequests</option><option>Entity: Tenders</option><option>Entity: TenderRounds</option><option>Entity: Bids</option><option>Entity: TenderReports</option><option>Entity: CommitteeVotes</option><option>Entity: Suppliers</option></select>
    <span class="pg-hint">Search and filters update the records shown on this page.</span>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-audit-entries">
    <div class="pg-panel-head"><h2 id="tbl-audit-entries">Audit entries</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Date (UTC)</th><th scope="col">User</th><th scope="col">Action</th><th scope="col">Entity</th><th scope="col">Record ID</th><th scope="col">Old / new values</th></tr></thead>
            <tbody><tr><td colspan="6"><partial name="_EmptyState" model='"No audit entries are loaded yet."' /></td></tr></tbody>
        </table>
    </div>
</section>
