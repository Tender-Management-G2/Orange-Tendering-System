@using Orange_Tendering_System.Models.Entities
@model SupplierDetailsViewModel

@{
    ViewData["Title"] = "Supplier Registration Review";
    ViewData["WorkspaceSection"] = "Suppliers";
    ViewData["Description"] =
        "Verify legal documents and manage supplier approval.";
}

<div class="supplier-review">
<partial name="_PageHeader" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Company Information -->
<section class="ws-panel pg-panel supplier-review-company" aria-labelledby="supplier-review-company-title">
    <div class="pg-panel-head">
        <div>
            <span class="supplier-review-eyebrow">Registration profile</span>
            <h2 id="supplier-review-company-title">@Model.CompanyName</h2>
            <p>Check the company details against the submitted documents.</p>
        </div>

        <span class="supplier-review-status supplier-review-status--@Model.Status.ToLowerInvariant()">@Model.Status</span>
    </div>

    <dl class="pg-dl">
        <div>
            <dt>Company Name</dt>
            <dd>@Model.CompanyName</dd>
        </div>

        <div>
            <dt>Registration Number</dt>
            <dd>@Model.RegistrationNumber</dd>
        </div>

        <div>
            <dt>Tax Number</dt>
            <dd>@(Model.TaxNumber ?? "—")</dd>
        </div>

        <div>
            <dt>Email</dt>
            <dd>@Model.Email</dd>
        </div>

        <div>
            <dt>Phone</dt>
            <dd>@(Model.Phone ?? "—")</dd>
        </div>

        <div>
            <dt>Address</dt>
            <dd>@(Model.Address ?? "—")</dd>
        </div>

        <div>
            <dt>Registered At (UTC)</dt>
            <dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </div>

        <div>
            <dt>Reviewed By</dt>
            <dd>@(Model.ReviewedBy ?? "—")</dd>
        </div>

        <div>
            <dt>Review Notes</dt>
            <dd>@(Model.ReviewNotes ?? "—")</dd>
        </div>
    </dl>
</section>

<!-- Legal Documents -->
<section class="ws-panel pg-panel supplier-review-documents" aria-labelledby="supplier-review-documents-title">
    <div class="pg-panel-head">
        <div>
            <span class="supplier-review-eyebrow">Step 01 · Evidence</span>
            <h2 id="supplier-review-documents-title">Legal documents</h2>
            <p>Open each file, compare it with the company profile, then record your findings.</p>
        </div>
        <span class="supplier-review-count">@Model.Documents.Count @(Model.Documents.Count == 1 ? "document" : "documents")</span>
    </div>

    @if (!Model.Documents.Any())
    {
        <div class="supplier-review-empty">No legal documents have been uploaded for this supplier.</div>
    }
    else
    {
        <div class="supplier-review-document-list">
            @foreach (var document in Model.Documents)
            {
                var documentLabel = document.DocumentType switch
                {
                    "CommercialRegistration" => "Commercial registration",
                    "TaxCertificate" => "Tax certificate",
                    "BusinessLicense" => "Business license",
                    _ => document.DocumentType ?? "Legal document"
                };
                var documentUrl = Url.Action("Document", "Suppliers", new { area = "Admin", id = document.Id });
                <article class="supplier-review-document" aria-labelledby="supplier-document-@document.Id">
                    <div class="supplier-review-document-main">
                        <div class="supplier-review-file-icon" aria-hidden="true">@(System.IO.Path.GetExtension(document.FileName).TrimStart('.').ToUpperInvariant())</div>
                        <div class="supplier-review-file-info">
                            <span class="supplier-review-type">@documentLabel</span>
                            <h3 id="supplier-document-@document.Id">@document.FileName</h3>
                            <p>Uploaded @document.UploadedAt.ToString("dd MMM yyyy") · @((document.SizeBytes / 1024.0).ToString("0.#")) KB · Expires @(document.ExpiresAt?.ToString("dd MMM yyyy") ?? "not specified")</p>
                        </div>
                        <span class="supplier-review-status supplier-review-status--@document.VerificationStatus.ToLowerInvariant().Replace(" ", "-")">@document.VerificationStatus</span>
                    </div>
                    <div class="supplier-review-document-actions">
                        <button type="button" class="pg-btn supplier-review-view" data-document-preview="@documentUrl" data-document-name="@document.FileName">View document <span aria-hidden="true">↗</span></button>
                        <a class="pg-btn supplier-review-download" data-no-modal asp-area="Admin" asp-controller="Suppliers" asp-action="Document" asp-route-id="@document.Id" asp-route-download="true">Download</a>
                    </div>
                    @if (Model.Status != "Approved")
                    {
                        <form asp-area="Admin" asp-controller="Suppliers" asp-action="VerifyDocument" method="post" class="pg-form supplier-review-verify">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SupplierId" value="@Model.Id" />
                            <input type="hidden" name="DocumentId" value="@document.Id" />
                            <div class="pg-field">
                                <label for="document-status-@document.Id">Verification status</label>
                                <select id="document-status-@document.Id" name="Status" required>
                                    <option value="Pending" selected="@(document.VerificationStatus == "Pending")">Pending review</option>
                                    <option value="Verified" selected="@(document.VerificationStatus == "Verified")">Verified</option>
                                    <option value="Rejected" selected="@(document.VerificationStatus == "Rejected")">Rejected</option>
                                </select>
                            </div>
                            <div class="pg-field supplier-review-notes">
                                <label for="document-notes-@document.Id">Review notes</label>
                                <textarea id="document-notes-@document.Id" name="Notes" data-fv-required-when="Status=Rejected" data-fv-label="Verification notes" data-fv-msg="Please give the reason for rejecting this document." data-fv-msg-ar="يرجى ذكر سبب رفض هذا المستند." maxlength="1000" rows="2" placeholder="Record what you checked">@document.VerificationNotes</textarea>
                            </div>
                            <button type="submit" class="pg-btn pg-btn-primary">Save review</button>
                        </form>
                    }
                    else
                    {
                        <p class="supplier-review-locked">Document review is locked while this supplier is approved.</p>
                    }
                </article>
            }
        </div>
    }
</section>

<dialog class="supplier-review-preview" id="supplier-document-preview" aria-labelledby="supplier-document-preview-title">
    <div class="supplier-review-preview-head">
        <div><span class="supplier-review-eyebrow">Document preview</span><h2 id="supplier-document-preview-title"></h2></div>
        <button type="button" class="supplier-review-preview-close" data-document-close aria-label="Close document preview">×</button>
    </div>
    <iframe title="Supplier document preview"></iframe>
    <div class="supplier-review-preview-actions">
        <a class="pg-btn" data-no-modal target="_blank" rel="noopener noreferrer" data-document-open>Open in new tab ↗</a>
        <button type="button" class="pg-btn pg-btn-primary" data-document-close>Close preview</button>
    </div>
</dialog>

<!-- Supplier Decision -->
<section class="ws-panel pg-panel supplier-review-decision">
    <div class="pg-panel-head">
        <div><span class="supplier-review-eyebrow">Step 02 · Outcome</span><h2>Supplier decision</h2>
            <p>Review the documents before deciding. Approval also verifies pending, unexpired documents and records the outcome in the audit history.</p></div>
    </div>

    <form asp-area="Admin"
          asp-controller="Suppliers"
          asp-action="SubmitReview"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="SupplierId"
               value="@Model.Id" />

        <div class="pg-form-grid">

            <div class="pg-field">
                <label for="decision">Decision</label>

                <select id="decision"
                        name="Decision"
                        class="form-control"
                        required>

                    @if (Model.Status == "Pending")
                    {
                        <option value="Approved">Approve</option>
                        <option value="Rejected">Reject</option>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <option value="Suspended">Suspend</option>
                    }
                    else if (Model.Status == "Suspended")
                    {
                        <option value="Approved">
                            Restore Approval
                        </option>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <option value="Approved">Approve</option>
                    }
                    else
                    {
                        <option value="">
                            No available decision
                        </option>
                    }
                </select>
            </div>

            <div class="pg-field pg-field-wide">
                <label for="reviewNotes">Decision notes</label>

                <textarea id="reviewNotes"
                          name="ReviewNotes" data-fv-required-when="Decision=Rejected|Suspended" data-fv-msg="Please give the reason for this rejection or suspension." data-fv-msg-ar="يرجى ذكر سبب الرفض أو الإيقاف."
                          class="form-control"
                          rows="4"
                          maxlength="1000"
                          placeholder="Record the findings and reason for this decision"></textarea>

                <small class="pg-hint">
                    A reason is required for rejection
                    and suspension.
                </small>
            </div>
        </div>

        @if (Model.Status == "Pending" ||
             Model.Status == "Approved" ||
             Model.Status == "Suspended" ||
             Model.Status == "Rejected")
        {
            <div class="pg-actions">
                <button type="submit"
                        class="pg-btn pg-btn-primary">
                    Save decision
                </button>
            </div>
        }
    </form>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li>
            <a asp-area="Admin"
               asp-controller="Suppliers"
               asp-action="Details"
               asp-route-id="@Model.Id">
                Supplier Details
            </a>
        </li>
        <li>
            <a asp-area="Admin"
               asp-controller="Suppliers"
               asp-action="Index">
                Back to Suppliers
            </a>
        </li>
    </ul>
</nav>
</div>

@section Scripts {
    <script src="~/js/admin-supplier-review.js" asp-append-version="true"></script>
}
