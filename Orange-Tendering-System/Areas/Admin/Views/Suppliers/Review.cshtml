@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Supplier Registration Review

DEVELOPER OWNER: Rjoub
MODULE: Administration
TRELLO TASK: Supplier Administration
TRELLO URL: https://trello.com/c/zvMwn4LD

PURPOSE:
Review a pending supplier registration and its legal
documents, then approve, reject or suspend it.

BUSINESS ACCESS:
Admin

ROUTE: /Admin/Suppliers/Review/{id?}

FUTURE IMPLEMENTATION:
- Load the supplier with its Documents (SupplierId).
- POST Approve / Reject / Suspend: set Status, ReviewNotes,
  ReviewedByUserId, ReviewedAt (UTC).
- Verify documents: Documents.VerificationStatus,
  VerifiedByUserId, VerifiedAt.
- Notify the supplier account(s) and write AuditLogs.

DEPENDENCIES:
Suppliers, Documents, AspNetUsers (SupplierId),
Notifications, AuditLogs.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Only Approved, active suppliers may be invited or submit
offers.
===========================================================
*@

@model SupplierDetailsViewModel

@{
    ViewData["Title"] = "Supplier Registration Review";
    ViewData["WorkspaceSection"] = "Suppliers";
    ViewData["Description"] =
        "Verify legal documents and manage supplier approval.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/supplier-document-review.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/supplier-document-review.js" asp-append-version="true"></script>
}

<partial name="_PageHeader" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Company Information -->
<section class="ws-panel pg-panel">
    <div class="pg-panel-head">
        <h2>Supplier Registration</h2>

        <span class="pg-status">@Model.Status</span>
    </div>

    <dl class="pg-dl">
        <div>
            <dt>Company Name</dt>
            <dd>@Model.CompanyName</dd>
        </div>

        <div>
            <dt>Registration Number</dt>
            <dd>@Model.RegistrationNumber</dd>
        </div>

        <div>
            <dt>Tax Number</dt>
            <dd>@(Model.TaxNumber ?? "—")</dd>
        </div>

        <div>
            <dt>Email</dt>
            <dd>@Model.Email</dd>
        </div>

        <div>
            <dt>Phone</dt>
            <dd>@(Model.Phone ?? "—")</dd>
        </div>

        <div>
            <dt>Address</dt>
            <dd>@(Model.Address ?? "—")</dd>
        </div>

        <div>
            <dt>Registered At (Jordan time)</dt>
            <dd>@Model.CreatedAt.ToJordan("yyyy-MM-dd HH:mm")</dd>
        </div>

        <div>
            <dt>Reviewed By</dt>
            <dd>@(Model.ReviewedBy ?? "—")</dd>
        </div>

        <div>
            <dt>Review Notes</dt>
            <dd>@(Model.ReviewNotes ?? "—")</dd>
        </div>
    </dl>
</section>

<!-- Legal Documents -->
<section class="ws-panel pg-panel supplier-document-review" aria-labelledby="legal-documents-heading">
    <div class="pg-panel-head">
        <h2 id="legal-documents-heading">Legal Document Verification</h2>
        <p>Review company registration and legal documents.</p>
    </div>

    <div class="pg-table-wrap">
        <table class="pg-table document-review-table" role="table" aria-labelledby="legal-documents-heading">
            <thead role="rowgroup">
                <tr role="row">
                    <th role="columnheader" scope="col">Document</th>
                    <th role="columnheader" scope="col">Type</th>
                    <th role="columnheader" scope="col">Uploaded / Expiry</th>
                    <th role="columnheader" scope="col">Current Status</th>
                    <th role="columnheader" scope="col">Verification Review</th>
                </tr>
            </thead>

            <tbody role="rowgroup">
                @if (!Model.Documents.Any())
                {
                    <tr role="row">
                        <td role="cell" colspan="5" class="document-review-empty">
                            No documents uploaded.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var document in Model.Documents)
                    {
                        var extension = System.IO.Path.GetExtension(document.FileName);
                        var fileType = extension.TrimStart('.').ToUpperInvariant();
                        var fileStyle = fileType switch
                        {
                            "PDF" => "pdf",
                            "PNG" or "JPG" or "JPEG" => "image",
                            _ => "other"
                        };
                        var documentType = document.DocumentType is { Length: > 0 } type
                            ? System.Text.RegularExpressions.Regex.Replace(type, "(?<=[a-z])(?=[A-Z])", " ")
                            : "—";
                        var status = document.VerificationStatus is "Rejected" or "Verified"
                            ? document.VerificationStatus
                            : "Pending";
                        var isRejected = status == "Rejected";
                        var statusId = $"document-status-{document.Id}";
                        var notesId = $"document-notes-{document.Id}";

                        <tr role="row" data-document-row>
                            <td role="cell" class="document-review-file-cell">
                                <a asp-area="Admin"
                                   asp-controller="Suppliers"
                                   asp-action="Document"
                                   asp-route-id="@document.Id"
                                   class="document-review-file"
                                   title="@document.FileName"
                                   aria-label="Download @document.FileName"
                                   data-no-modal
                                   download="@document.FileName">
                                    <span class="document-review-file-type" data-file-style="@fileStyle" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                                            <path d="M6 3h8l5 5v13H6zM14 3v6h5" />
                                            @if (fileStyle == "image")
                                            {
                                                <path d="m8.5 17 3-3 2.5 2 1.5-1.5 1 1" />
                                                <circle cx="10" cy="11" r=".7" />
                                            }
                                            else
                                            {
                                                <path d="M9 13h7m-7 4h5" />
                                            }
                                        </svg>
                                        <span>@(fileType.Length is > 0 and <= 6 ? fileType : "FILE")</span>
                                    </span>
                                    <span class="document-review-filename" dir="auto">
                                        <span class="document-review-stem">@System.IO.Path.GetFileNameWithoutExtension(document.FileName)</span>
                                        @if (extension.Length <= 7)
                                        {
                                            <span>@extension</span>
                                        }
                                    </span>
                                    <span class="document-review-download" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                                            <path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4" />
                                        </svg>
                                    </span>
                                </a>
                            </td>

                            <td role="cell">
                                <span class="document-review-mobile-label" aria-hidden="true">Type</span>
                                @documentType
                            </td>

                            <td role="cell" class="document-review-dates">
                                <div><span>Uploaded</span> @document.UploadedAt.ToJordan("dd MMM yyyy")</div>
                                <div><span>Expiry</span> @(document.ExpiresAt?.ToString("dd MMM yyyy") ?? "—")</div>
                            </td>

                            <td role="cell">
                                <span class="document-review-mobile-label" aria-hidden="true">Current Status</span>
                                <span class="ui-pill document-review-status" data-status="@status">@status</span>
                            </td>

                            <td role="cell" class="document-review-controls">
                                @if (Model.Status != "Approved")
                                {
                                    <form asp-area="Admin"
                                          asp-controller="Suppliers"
                                          asp-action="VerifyDocument"
                                          method="post"
                                          class="pg-form document-review-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="SupplierId"
                                               value="@Model.Id" />

                                        <input type="hidden"
                                               name="DocumentId"
                                               value="@document.Id" />

                                        <div class="pg-field">
                                            <label for="@statusId">Verification Status</label>
                                            <select id="@statusId" name="Status"
                                                    class="form-control"
                                                    required>
                                                <option value="Pending" selected="@(status == "Pending")">Pending</option>
                                                <option value="Verified" selected="@(status == "Verified")">Verified</option>
                                                <option value="Rejected" selected="@isRejected">Rejected</option>
                                            </select>
                                        </div>

                                        <div class="pg-field document-review-notes" hidden="@(!isRejected)">
                                            <label for="@notesId">Review Notes</label>
                                            <textarea id="@notesId" name="Notes"
                                                      required="@isRejected"
                                                      disabled="@(!isRejected)"
                                                      data-fv-required-when="Status=Rejected"
                                                      data-fv-msg="Please give the reason for rejecting this document."
                                                      data-fv-msg-ar="يرجى ذكر سبب رفض هذا المستند."
                                                      class="form-control"
                                                      maxlength="1000"
                                                      rows="2"
                                                      placeholder="Explain why this document was rejected">@document.VerificationNotes</textarea>
                                        </div>

                                        <button type="submit"
                                                class="pg-btn pg-btn-primary">
                                            Save Review
                                        </button>
                                        <div class="document-review-result" role="status" aria-atomic="true"></div>
                                    </form>
                                }
                                else
                                {
                                    <span class="document-review-locked">
                                        Verification locked while approved.
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Supplier Decision -->
<section class="ws-panel pg-panel">
    <div class="pg-panel-head">
        <h2>Supplier Decision</h2>
        <p>
            Open the documents before making a decision. Approving also verifies
            pending, unexpired documents and records the decision in the audit history.
        </p>
    </div>

    <form asp-area="Admin"
          asp-controller="Suppliers"
          asp-action="SubmitReview"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="SupplierId"
               value="@Model.Id" />

        <div class="pg-form-grid">

            <div class="pg-field">
                <label for="decision">Decision</label>

                <select id="decision"
                        name="Decision"
                        class="form-control"
                        required>

                    @if (Model.Status == "Pending")
                    {
                        <option value="Approved">Approve</option>
                        <option value="Rejected">Reject</option>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <option value="Suspended">Suspend</option>
                    }
                    else if (Model.Status == "Suspended")
                    {
                        <option value="Approved">
                            Restore Approval
                        </option>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <option value="Approved">Approve</option>
                    }
                    else
                    {
                        <option value="">
                            No available decision
                        </option>
                    }
                </select>
            </div>

            <div class="pg-field pg-field-wide">
                <label for="reviewNotes">
                    Review Notes / Reason
                </label>

                <textarea id="reviewNotes"
                          name="ReviewNotes"
                          data-fv-required-when="Decision=Rejected|Suspended"
                          data-fv-msg="Please give the reason for this rejection or suspension."
                          data-fv-msg-ar="يرجى ذكر سبب الرفض أو الإيقاف."
                          class="form-control"
                          rows="4"
                          maxlength="1000"
                          placeholder="Record the reason or justification"></textarea>

                <small class="pg-hint">
                    A reason is required for rejection
                    and suspension.
                </small>
            </div>
        </div>

        @if (Model.Status == "Pending" ||
             Model.Status == "Approved" ||
             Model.Status == "Suspended" ||
             Model.Status == "Rejected")
        {
            <div class="pg-actions">
                <button type="submit"
                        class="pg-btn pg-btn-primary">
                    Submit Decision
                </button>
            </div>
        }
    </form>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li>
            <a asp-area="Admin"
               asp-controller="Suppliers"
               asp-action="Details"
               asp-route-id="@Model.Id">
                Supplier Details
            </a>
        </li>
        <li>
            <a asp-area="Admin"
               asp-controller="Suppliers"
               asp-action="Index">
                Back to Suppliers
            </a>
        </li>
    </ul>
</nav>
