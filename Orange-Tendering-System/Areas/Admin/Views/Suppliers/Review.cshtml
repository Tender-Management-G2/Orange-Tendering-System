@model Orange_Tendering_System.Models.Entities.Supplier
@using Orange_Tendering_System.Models.Entities
@{ ViewData["Title"]="Supplier registration review"; }
<h1>@Model.CompanyName</h1><p>@Model.Status | @Model.Email | Registration @Model.RegistrationNumber</p>
<div asp-validation-summary="All" role="alert"></div>
<ul>@foreach(var doc in Model.Documents) { <li><a asp-area="Admin" asp-controller="Suppliers" asp-action="Document" asp-route-id="@doc.Id">@doc.FileName</a> | @doc.VerificationStatus</li> }</ul>
@if(Model.Status==SupplierStatus.Pending) { <form asp-area="Admin" asp-controller="Suppliers" asp-action="Review" asp-route-id="@Model.Id" method="post"><label>Document verification findings and reason<textarea name="notes" maxlength="1000" required></textarea></label><p>Review the stored legal document before deciding. Approval alone does not confirm the account's email.</p><button name="approve" value="true">Approve supplier registration</button> <button name="approve" value="false">Reject registration</button></form> }
<p>@Model.ReviewNotes | @Model.ReviewedByUserId | @Model.ReviewedAt?.ToString("u")</p>
