@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Supplier Administration

DEVELOPER OWNER: Rjoub
MODULE: Administration
TRELLO TASK: Supplier Administration
TRELLO URL: Not provided — add from the Trello board

PURPOSE:
List supplier companies by status so Admin can review
registrations and suspend suppliers.

BUSINESS ACCESS:
Admin

ROUTE: /Admin/Suppliers

FUTURE IMPLEMENTATION:
- Query Suppliers with ReviewedByUser.
- Row actions: Review (Pending) and Details.
- Counts per SupplierStatus for the summary cards.

DEPENDENCIES:
Suppliers, AspNetUsers, Documents.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@
@{
    ViewData["Title"] = "Supplier Administration";
    ViewData["WorkspaceSection"] = "Suppliers";
    ViewData["Description"] = "Registered supplier companies and their approval status.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-cards" aria-label="Summary">
    <article class="pg-card"><span>Pending registrations</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Approved suppliers</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Rejected</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Suspended</span><strong>—</strong><small>Not connected</small></article>
</section>

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search company or registration number" aria-label="Search company or registration number" disabled />
    <select aria-label="Status" disabled><option>Status: All</option><option>Status: Pending</option><option>Status: Approved</option><option>Status: Rejected</option><option>Status: Suspended</option></select>
    <span class="pg-hint">Search and filters are not implemented yet.</span>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-suppliers">
    <div class="pg-panel-head"><h2 id="tbl-suppliers">Suppliers</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Company</th><th scope="col">Registration no.</th><th scope="col">Email</th><th scope="col">Status</th><th scope="col">Registered</th><th scope="col">Reviewed by</th><th scope="col">Actions</th></tr></thead>
            <tbody><tr><td colspan="7"><partial name="_EmptyState" model='"No supplier companies are loaded yet."' /></td></tr></tbody>
        </table>
    </div>
</section>
