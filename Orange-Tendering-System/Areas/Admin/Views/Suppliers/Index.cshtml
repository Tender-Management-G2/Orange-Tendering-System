@model SupplierIndexViewModel

@{
    ViewData["Title"] = "Supplier Administration";
    ViewData["WorkspaceSection"] = "Suppliers";
    ViewData["Description"] =
        "Registered supplier companies and their approval status.";
}

<partial name="_PageHeader" />

<!-- Supplier Status Summary -->
<section class="dash-metrics admin-management-stats" aria-label="Supplier summary">
    <article class="dash-metric dash-orange">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("list"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.PendingCount</strong>
            <span>Pending Registrations</span>
        </div>
    </article>
    <article class="dash-metric dash-blue">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("check"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.ApprovedCount</strong>
            <span>Approved Suppliers</span>
        </div>
    </article>
    <article class="dash-metric dash-purple">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("shield"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.RejectedCount</strong>
            <span>Rejected</span>
        </div>
    </article>
    <article class="dash-metric dash-green">
        <span class="dash-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24">@Html.Raw(WorkspaceNavigation.Icon("layers"))</svg></span>
        <div class="dash-metric-copy">
            <strong>@Model.SuspendedCount</strong>
            <span>Suspended</span>
        </div>
    </article>
</section>

<!-- Search and Filters -->
<form asp-area="Admin"
      asp-controller="Suppliers"
      asp-action="Index"
      method="get"
      class="admin-list-filters"
      data-admin-voice-filter
      role="search"
      aria-label="Search and filters">

    <div class="admin-filter-field admin-filter-search">
        <label for="supplier-search">Search</label>
        <div class="admin-supplier-search-input">
            <input id="supplier-search" type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Search company or registration number"
                   aria-label="Search suppliers"
                   maxlength="200" />
            <button type="submit" class="pg-btn" aria-label="Apply supplier filters" title="Apply supplier filters">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg>
            </button>
        </div>
    </div>

    <div class="admin-filter-field">
        <label for="supplier-status-filter">Status</label>
        <select id="supplier-status-filter" name="statusFilter"
                aria-label="Supplier status">

            <option value="All"
                    selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All")">
                All statuses
            </option>

            <option value="Pending"
                    selected="@(Model.StatusFilter == "Pending")">
                Pending
            </option>

            <option value="Approved"
                    selected="@(Model.StatusFilter == "Approved")">
                Approved
            </option>

            <option value="Rejected"
                    selected="@(Model.StatusFilter == "Rejected")">
                Rejected
            </option>

            <option value="Suspended"
                    selected="@(Model.StatusFilter == "Suspended")">
                Suspended
            </option>
        </select>
    </div>
    <a asp-area="Admin"
       asp-controller="Suppliers"
       asp-action="Index"
       class="pg-btn pg-btn-primary admin-clear">
        Clear
    </a>

</form>

<!-- Suppliers Table -->
<section class="ws-panel pg-panel admin-list-records"
         aria-labelledby="tbl-suppliers">

    <div class="pg-panel-head">
        <div>
            <h2 id="tbl-suppliers">Suppliers</h2>
            <p>Total matching suppliers: @Model.TotalRecords</p>
        </div>
    </div>

    <div class="pg-table-wrap">

        <table class="pg-table admin-suppliers-table">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Registration No.</th>
                    <th>Email</th>
                    <th>Documents</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th>Reviewed By</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Suppliers.Any())
                {
                    <tr>
                        <td colspan="8">
                            No matching suppliers found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <td>
                                <strong>@supplier.CompanyName</strong>
                            </td>

                            <td>@supplier.RegistrationNumber</td>

                            <td>@supplier.Email</td>

                            <td>@supplier.DocumentCount</td>

                            <td>
                                <span class="pg-status">
                                    @supplier.Status
                                </span>
                            </td>

                            <td>
                                @supplier.CreatedAt.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(supplier.ReviewedBy)
                                    ? "—"
                                    : supplier.ReviewedBy)
                            </td>

                            <td>
                                <div class="admin-row-actions">
                                    <a class="pg-btn"
                                       asp-area="Admin"
                                       asp-controller="Suppliers"
                                       asp-action="Details"
                                       data-modal="center"
                                       asp-route-id="@supplier.Id">
                                        Details
                                    </a>

                                    <a class="pg-btn pg-btn-primary"
                                       asp-area="Admin"
                                       asp-controller="Suppliers"
                                       asp-action="Review"
                                       data-no-modal
                                       asp-route-id="@supplier.Id">
                                        @(supplier.Status == "Pending"
                                            ? "Review"
                                            : "Manage")
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="pg-actions" aria-label="Supplier pages">

            @if (Model.CurrentPage > 1)
            {
                <a class="pg-btn"
                   asp-area="Admin"
                   asp-controller="Suppliers"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    Previous
                </a>
            }

            <span>
                Page @Model.CurrentPage of @Model.TotalPages
            </span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="pg-btn pg-btn-primary"
                   asp-area="Admin"
                   asp-controller="Suppliers"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    Next
                </a>
            }

        </nav>
    }

</section>
