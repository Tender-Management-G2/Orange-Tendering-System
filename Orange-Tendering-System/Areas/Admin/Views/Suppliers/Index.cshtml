@model List<Orange_Tendering_System.Models.Entities.Supplier>
@{ ViewData["Title"]="Supplier registration reviews"; }
<h1>Supplier registration reviews</h1>
@foreach(var company in Model) { <section class="ws-panel pg-panel"><a asp-area="Admin" asp-controller="Suppliers" asp-action="Review" asp-route-id="@company.Id">@company.CompanyName</a><p>@company.Status | @company.Email</p></section> }
