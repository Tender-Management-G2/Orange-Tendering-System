@model SupplierIndexViewModel

@{
    ViewData["Title"] = "Supplier Administration";
    ViewData["WorkspaceSection"] = "Suppliers";
    ViewData["Description"] =
        "Registered supplier companies and their approval status.";
}

<partial name="_PageHeader" />

<!-- Supplier Status Summary -->
<section class="pg-cards" aria-label="Supplier summary">

    <article class="pg-card">
        <span>Pending Registrations</span>
        <strong>@Model.PendingCount</strong>
        <small>Awaiting Admin review</small>
    </article>

    <article class="pg-card">
        <span>Approved Suppliers</span>
        <strong>@Model.ApprovedCount</strong>
        <small>Approved companies</small>
    </article>

    <article class="pg-card">
        <span>Rejected</span>
        <strong>@Model.RejectedCount</strong>
        <small>Rejected registrations</small>
    </article>

    <article class="pg-card">
        <span>Suspended</span>
        <strong>@Model.SuspendedCount</strong>
        <small>Suspended companies</small>
    </article>

</section>

<!-- Search and Filters -->
<form asp-area="Admin"
      asp-controller="Suppliers"
      asp-action="Index"
      method="get"
      class="pg-toolbar"
      aria-label="Search and filters">

    <input type="search"
           name="search"
           value="@Model.Search"
           placeholder="Search company or registration number"
           aria-label="Search suppliers"
           maxlength="200" />

    <select name="statusFilter"
            aria-label="Supplier status">

        <option value="All"
                selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All")">
            Status: All
        </option>

        <option value="Pending"
                selected="@(Model.StatusFilter == "Pending")">
            Pending
        </option>

        <option value="Approved"
                selected="@(Model.StatusFilter == "Approved")">
            Approved
        </option>

        <option value="Rejected"
                selected="@(Model.StatusFilter == "Rejected")">
            Rejected
        </option>

        <option value="Suspended"
                selected="@(Model.StatusFilter == "Suspended")">
            Suspended
        </option>
    </select>

   

    <a asp-area="Admin"
       asp-controller="Suppliers"
       asp-action="Index"
       class="pg-btn">
        Clear
    </a>

</form>

<!-- Suppliers Table -->
<section class="ws-panel pg-panel"
         aria-labelledby="tbl-suppliers">

    <div class="pg-panel-head">
        <div>
            <h2 id="tbl-suppliers">Suppliers</h2>
            <p>Total matching suppliers: @Model.TotalRecords</p>
        </div>
    </div>

    <div class="pg-table-wrap">

        <table class="pg-table">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Registration No.</th>
                    <th>Email</th>
                    <th>Documents</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th>Reviewed By</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Suppliers.Any())
                {
                    <tr>
                        <td colspan="8">
                            No matching suppliers found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <td>
                                <strong>@supplier.CompanyName</strong>
                            </td>

                            <td>@supplier.RegistrationNumber</td>

                            <td>@supplier.Email</td>

                            <td>@supplier.DocumentCount</td>

                            <td>
                                <span class="pg-status">
                                    @supplier.Status
                                </span>
                            </td>

                            <td>
                                @supplier.CreatedAt.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(supplier.ReviewedBy)
                                    ? "—"
                                    : supplier.ReviewedBy)
                            </td>

                            <td>
                                <a class="pg-btn"
                                   asp-area="Admin"
                                   asp-controller="Suppliers"
                                   asp-action="Details"
                                   asp-route-id="@supplier.Id">
                                    Details
                                </a>

                                <a class="pg-btn pg-btn-primary"
                                   asp-area="Admin"
                                   asp-controller="Suppliers"
                                   asp-action="Review"
                                   asp-route-id="@supplier.Id">
                                    @(supplier.Status == "Pending"
                                        ? "Review"
                                        : "Manage")
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="pg-actions" aria-label="Supplier pages">

            @if (Model.CurrentPage > 1)
            {
                <a class="pg-btn"
                   asp-area="Admin"
                   asp-controller="Suppliers"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    Previous
                </a>
            }

            <span>
                Page @Model.CurrentPage of @Model.TotalPages
            </span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="pg-btn pg-btn-primary"
                   asp-area="Admin"
                   asp-controller="Suppliers"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    Next
                </a>
            }

        </nav>
    }

</section>
