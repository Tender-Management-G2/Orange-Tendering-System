@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: System Settings
MODULE: Administration

PURPOSE:
Read-only system configuration overview.

IMPORTANT:
Do not display passwords, API keys,
connection string secrets or authentication tokens.
===========================================================
*@

@model SettingsViewModel

@{
    ViewData["Title"] = "System Settings";
    ViewData["WorkspaceSection"] = "Settings";
    ViewData["Description"] =
        "Read-only overview of application configuration.";
}

<partial name="_PageHeader" />

<!-- Information Notice -->
<aside class="pg-note">
    <strong>System Configuration</strong>

    <p>
        This page displays available application settings.
        Configuration changes are managed by the development
        team through the application configuration system.
    </p>
</aside>

<!-- Environment Settings -->
<section class="ws-panel pg-panel">

    <div class="pg-panel-head">
        <h2>Application Environment</h2>
    </div>

    <dl class="pg-dl">

        <div>
            <dt>Current Environment</dt>
            <dd>
                <span class="pg-status">
                    @Model.EnvironmentName
                </span>
            </dd>
        </div>

        <div>
            <dt>Database Server</dt>
            <dd>@Model.DatabaseServer</dd>
        </div>

        <div>
            <dt>Database Name</dt>
            <dd>@Model.DatabaseName</dd>
        </div>

    </dl>

</section>

<!-- Email Settings -->
<section class="ws-panel pg-panel">

    <div class="pg-panel-head">
        <h2>Email Configuration</h2>
    </div>

    <dl class="pg-dl">

        <div>
            <dt>Email Settings</dt>
            <dd>
                <span class="pg-status">
                    @Model.EmailConfiguration
                </span>
            </dd>
        </div>

    </dl>

    <p class="pg-hint">
        Configuration presence does not confirm that
        email delivery is working.
    </p>

</section>

<!-- Document Storage Settings -->
<section class="ws-panel pg-panel">

    <div class="pg-panel-head">
        <h2>Document Storage</h2>
    </div>

    <dl class="pg-dl">

        <div>
            <dt>Storage Configuration</dt>
            <dd>
                <span class="pg-status">
                    @Model.DocumentStorage
                </span>
            </dd>
        </div>

        <div>
            <dt>Maximum Upload Size</dt>
            <dd>@Model.MaximumUploadSize</dd>
        </div>

        <div>
            <dt>Allowed File Types</dt>
            <dd>@Model.AllowedFileTypes</dd>
        </div>

    </dl>

    <p class="pg-hint">
        Upload restrictions must also be enforced
        by the document storage service.
    </p>

</section>

<!-- Security Notice -->
<aside class="pg-note">

    <strong>Security &amp; Access</strong>

    <p>
        This page is available only to authorized administrators.
        Sensitive connection credentials, passwords, API keys
        and authentication tokens are never displayed.
    </p>

</aside>
