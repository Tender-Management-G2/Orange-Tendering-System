@model Orange_Tendering_System.ViewModels.SourcingOfficerDashboardViewModel
@{ ViewData["Title"] = "Sourcing Officer Home"; ViewData["WorkspaceSection"] = "Dashboard"; ViewData["Description"] = "Your work, in order. Start with a request or use the ready-made demo tender to try the full officer flow."; }
<div class="so-page"><partial name="_PageHeader" />
<section class="so-welcome ws-panel" aria-labelledby="so-welcome-title">
    <div><span class="so-eyebrow">WELCOME TO YOUR WORKSPACE</span><h2 id="so-welcome-title">What would you like to do?</h2><p>Follow the numbered steps below. The demo data is already in the database, so you can try each screen right away.</p></div>
    <a class="pg-btn pg-btn-primary" asp-controller="PurchaseRequests" asp-action="Index">Start with requests <span aria-hidden="true">→</span></a>
</section>
<section class="pg-cards so-metrics" aria-label="Current work counts">
    <a class="pg-card" asp-controller="PurchaseRequests" asp-action="Index"><span>Requests waiting for review</span><strong>@Model.SubmittedRequests</strong><small>Open the request inbox</small></a>
    <a class="pg-card" asp-controller="PurchaseRequests" asp-action="Index"><span>Accepted, ready for a tender</span><strong>@Model.AcceptedRequestsWithoutTender</strong><small>Create a tender from a request</small></a>
    <a class="pg-card" asp-controller="Tenders" asp-action="Index"><span>Open tenders</span><strong>@Model.ActiveTenders</strong><small>View tenders and offers</small></a>
    <a class="pg-card" asp-controller="Reports" asp-action="Index"><span>Committee reports to forward</span><strong>@Model.ReportsToForward</strong><small>Read and send reports to the manager</small></a>
</section>
<section class="ws-panel pg-panel so-guide" aria-labelledby="so-guide-title">
    <div class="pg-panel-head"><div><span class="so-eyebrow">A SIMPLE WALKTHROUGH</span><h2 id="so-guide-title">Try the demo in four steps</h2></div><span class="pg-badge is-ok">Demo data loaded</span></div>
    <ol class="so-steps">
        <li><span class="so-step-number">1</span><div><h3>Review a department request</h3><p>Open the request inbox. Choose <strong>DEMO - Monitors awaiting review</strong> and mark it accepted, returned, or rejected.</p></div><a class="pg-btn" asp-controller="PurchaseRequests" asp-action="Index">Open requests</a></li>
        <li><span class="so-step-number">2</span><div><h3>Create a tender</h3><p>Use <strong>DEMO - Laptops ready for tender</strong>, or the request you just accepted. Its item is copied into the new tender automatically.</p></div><a class="pg-btn" asp-controller="PurchaseRequests" asp-action="Index">Choose an accepted request</a></li>
        <li><span class="so-step-number">3</span><div><h3>Send offers to the evaluation committee</h3><p>For the quickest test, open <strong>DEMO Tender - Laptops ready for committee</strong>. It has four submitted offers: three compliant and one non-compliant. Select the three compliant offers and send them.</p>@if(Model.TenderReadyForCommittee != null){<a class="so-inline-link" asp-controller="Tenders" asp-action="Details" asp-route-id="@Model.TenderReadyForCommittee.Id">Open the demo tender →</a>}</div><a class="pg-btn" asp-controller="Tenders" asp-action="Index">Open tenders</a></li>
        <li><span class="so-step-number">4</span><div><h3>Read committee reports and answer a supplier</h3><p>Reports contains submitted, accepted, returned, and rejected examples. Clarifications contains one open supplier question you can answer.</p></div><div class="so-step-actions"><a class="pg-btn" asp-controller="Reports" asp-action="Index">Open reports</a><a class="pg-btn" asp-controller="Clarifications" asp-action="Index">Open messages</a></div></li>
    </ol>
</section>
<aside class="so-help"><strong>Want to see it as a supplier?</strong><span>Sign out and log in as <code>supplier1@orange-demo.local</code>. Password for every demo account: <code>OrangeDemo2026!</code>. The supplier account can see its own invitation and offer only.</span><a class="so-inline-link" asp-area="" asp-controller="Home" asp-action="HowItWorks">Read how the workflow works →</a></aside>
</div>
