@model Orange_Tendering_System.Models.Entities.PurchaseRequest
@{ ViewData["Title"] = Model.Title; ViewData["WorkspaceSection"] = "Requests"; ViewData["Description"] = "Review the request, then accept, return or reject it."; }
<partial name="_PageHeader" />
<section class="ws-panel pg-panel">
    <dl class="ui-facts">
        <div><dt>Request</dt><dd>PR-@Model.Id.ToString("0000")</dd></div>
        <div><dt>Status</dt><dd>@Model.Status</dd></div>
    </dl>
    <p>@Model.Justification</p>
    <div class="pg-table-wrap"><table class="pg-table" data-no-enhance><thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Specifications</th></tr></thead><tbody>
    @foreach (var i in Model.Items) { <tr><td>@i.Name</td><td>@i.Quantity @i.Unit</td><td>@i.Specifications</td></tr> }
    </tbody></table></div>
    <h3>Submission history</h3>
    @if (!Model.Reviews.Any()) { <p class="pg-hint">No review decisions yet.</p> }
    <ul class="ui-timeline">@foreach (var h in Model.Reviews) { <li><strong>Submission @h.SubmissionNumber · @h.Decision</strong><span>@h.Comment</span></li> }</ul>
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    @if (Model.Status == Orange_Tendering_System.Models.Entities.PurchaseRequestStatus.Submitted)
    {
        <form method="post" asp-action="Review" asp-route-id="@Model.Id" class="pg-form">
            <div class="pg-field pg-field-wide"><label for="comment">Review feedback</label><textarea id="comment" name="comment" required></textarea></div>
            <div class="pg-actions">
                <button type="submit" class="pg-btn pg-btn-primary" name="decision" value="Accepted">Accept purchase request</button>
                <button type="submit" class="pg-btn" name="decision" value="Returned">Return for changes</button>
                <button type="submit" class="pg-btn pg-btn-danger" name="decision" value="Rejected">Reject</button>
            </div>
        </form>
    }
    @if (Model.Status == Orange_Tendering_System.Models.Entities.PurchaseRequestStatus.Accepted)
    {
        <div class="pg-actions"><a class="pg-btn pg-btn-primary" data-no-modal asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Create" asp-route-id="@Model.Id">Prepare tender</a></div>
    }
</section>
