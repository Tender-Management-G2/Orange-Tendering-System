@model Orange_Tendering_System.Models.Entities.PurchaseRequest
@{ ViewData["Title"] = "Request details"; ViewData["WorkspaceSection"] = "Request"; ViewData["Description"] = "Read what the department needs, then choose the next step."; }
<div class="so-page"><partial name="_PageHeader" /><section class="ws-panel pg-panel"><div class="pg-panel-head"><div><span class="pg-badge">Request #@Model.Id</span> <span class="pg-badge">@Model.Status</span></div><a class="pg-btn" asp-action="Index">← All requests</a></div><h2>@Model.Title</h2><dl class="pg-dl"><div><dt>Department</dt><dd>@Model.Department.Name</dd></div><div><dt>Priority</dt><dd>@Model.Priority</dd></div><div><dt>Needed by</dt><dd>@(Model.NeededBy?.ToLocalTime().ToString("d MMM yyyy")??"Not specified")</dd></div><div><dt>Submitted</dt><dd>@(Model.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy")??"—")</dd></div></dl><h3 class="so-subheading">Why this is needed</h3><p>@Model.Justification</p><h3 class="so-subheading">Requested items</h3><div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Item</th><th>Specifications</th><th>Quantity</th><th>Unit</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.Name</strong></td><td>@item.Specifications</td><td>@item.Quantity</td><td>@item.Unit</td></tr>}</tbody></table></div></section>
@if (Model.Status == Orange_Tendering_System.Models.Entities.PurchaseRequestStatus.Submitted) {<section class="ws-panel pg-panel"><h2>Choose an outcome</h2><p class="pg-hint">Accept it, then go to the Tender page. Return it if the department must add information. Reject it to close the request.</p><form asp-action="Review" method="post" class="pg-form"><input type="hidden" name="id" value="@Model.Id"/><div class="pg-field"><label for="comment">Comment for the department</label><textarea id="comment" name="comment" rows="3" placeholder="Explain what needs to change, if anything"></textarea></div><div class="pg-actions"><button class="pg-btn pg-btn-primary" name="decision" value="Accepted">Accept request</button><button class="pg-btn" name="decision" value="Returned">Request additional documents / changes</button><button class="pg-btn pg-btn-danger" name="decision" value="Rejected">Reject request</button></div></form></section>} else {<section class="ws-panel pg-panel"><p>This request has already been reviewed. Its current status is @Model.Status.</p></section>} @if (Model.Status == Orange_Tendering_System.Models.Entities.PurchaseRequestStatus.Accepted) {<a class="pg-btn pg-btn-primary" asp-controller="Workflow" asp-action="Index">Go to Tender</a>}</div>
