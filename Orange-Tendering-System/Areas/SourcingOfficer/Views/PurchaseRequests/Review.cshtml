@model Orange_Tendering_System.Models.Entities.PurchaseRequest
<h1>@Model.Title</h1><p>Request #@Model.Id · <strong>@Model.Status</strong></p><p>@Model.Justification</p><table>@foreach(var i in Model.Items){<tr><td>@i.Name</td><td>@i.Quantity @i.Unit</td><td>@i.Specifications</td></tr>}</table><h2>Submission history</h2>@foreach(var h in Model.Reviews){<p>Submission @h.SubmissionNumber · @h.Decision · @h.Comment</p>}
<div asp-validation-summary="All"></div>@if(Model.Status==Orange_Tendering_System.Models.Entities.PurchaseRequestStatus.Submitted){<form method="post" asp-action="Review" asp-route-id="@Model.Id"><label>Review feedback<textarea name="comment" required></textarea></label><button name="decision" value="Accepted">Accept purchase request</button><button name="decision" value="Rejected">Reject</button><button name="decision" value="Returned">Return</button></form>}@if(Model.Status==Orange_Tendering_System.Models.Entities.PurchaseRequestStatus.Accepted){<a asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Create" asp-route-id="@Model.Id">Prepare tender</a>}
