@model IEnumerable<Orange_Tendering_System.Models.Entities.PurchaseRequest>
@using Orange_Tendering_System.Models.Entities
@{
    ViewData["Title"] = "Request";
    ViewData["WorkspaceSection"] = "Request";
    ViewData["Description"] = "Review department requests here. Create and manage tenders from the Tender page.";
    var rows = Model.ToList();
}
<div class="so-page">
    <partial name="_PageHeader" />
    <div class="pg-cards">
        <article class="pg-card"><span>Waiting for review</span><strong>@rows.Count(r => r.Status == PurchaseRequestStatus.Submitted)</strong></article>
        <article class="pg-card"><span>Accepted, without a tender</span><strong>@rows.Count(r => r.Status == PurchaseRequestStatus.Accepted && !r.Tenders.Any())</strong></article>
        <article class="pg-card"><span>Returned or rejected</span><strong>@rows.Count(r => r.Status is PurchaseRequestStatus.Returned or PurchaseRequestStatus.Rejected)</strong></article>
    </div>
    <section class="ws-panel pg-panel">
        <div class="pg-panel-head"><h2>All requests</h2><span class="pg-hint">Open Details to review a request and record your decision.</span></div>
        <div class="pg-table-wrap"><table class="pg-table">
            <thead><tr><th>Request</th><th>Department</th><th>Priority</th><th>Needed by</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
            @if (rows.Count == 0) { <tr><td colspan="6">No department requests yet.</td></tr> }
            @foreach (var request in rows)
            {
                <tr>
                    <td><strong>@request.Title</strong><br /><small>Request #@request.Id</small></td>
                    <td>@request.Department.Name</td><td>@request.Priority</td>
                    <td>@(request.NeededBy?.ToLocalTime().ToString("d MMM yyyy") ?? "—")</td>
                    <td>@request.Status</td>
                    <td><a class="pg-btn" asp-action="Review" asp-route-id="@request.Id">Details</a></td>
                </tr>
            }
            </tbody>
        </table></div>
    </section>
</div>
