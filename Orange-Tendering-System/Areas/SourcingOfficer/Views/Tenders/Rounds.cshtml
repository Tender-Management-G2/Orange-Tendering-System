@model Orange_Tendering_System.ViewModels.TenderRoundsViewModel
@{
    ViewData["Title"] = "Tender rounds";
    ViewData["WorkspaceSection"] = "Tenders";
    ViewData["Description"] = Model.TenderTitle;
}
<div class="so-page"><partial name="_PageHeader" />
@if (TempData["RoundError"] is string error) { <p class="pg-note" role="alert">@error</p> }
@if (TempData["RoundStarted"] is string message) { <p class="pg-note" role="status">@message</p> }
<section class="ws-panel pg-panel"><h2>Offer rule</h2><p>Normally, send at least <strong>3 compliant offers from 3 suppliers</strong> to the Evaluation Committee. Starting with the third attempt—after <strong>2 previous failed attempts</strong>—you can proceed with <strong>2 compliant suppliers</strong>. Offers must come from the current round only.</p></section>
<section class="ws-panel pg-panel"><div class="pg-panel-head"><div><h2>Attempts for this tender</h2><span class="pg-hint">A failed attempt is recorded when you start a new round after an expired round with fewer than 3 submitted offers.</span></div><a class="pg-btn" asp-action="Details" asp-route-id="@Model.TenderId">Back to tender</a></div>
<div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Round</th><th>Status</th><th>Invited</th><th>Submitted offers</th><th>Distinct suppliers</th><th>Deadline</th></tr></thead><tbody>
@foreach (var round in Model.Rounds)
{
    <tr><td>Round @round.RoundNumber</td><td>@round.Status</td><td>@round.Invitations</td><td>@round.SubmittedOffers</td><td>@round.DistinctSuppliers</td><td>@(round.Deadline?.ToLocalTime().ToString("d MMM yyyy h:mm tt") ?? "—")</td></tr>
}
@if (Model.Rounds.Count == 0) { <tr><td colspan="6">No tendering attempts are available.</td></tr> }
</tbody></table></div></section>
<section class="ws-panel pg-panel"><h2>Start another supplier attempt</h2>
@if (Model.CanStartNextRound)
{
    <p>The previous round received fewer than 3 submitted offers and has expired. Starting a new round keeps the old invitations and offers in the history.</p>
    <form asp-action="StartNextRound" method="post"><input type="hidden" name="tenderId" value="@Model.TenderId" /><button class="pg-btn pg-btn-primary" type="submit">Start next round</button></form>
}
else { <p>@Model.NextRoundMessage</p> }
</section></div>
