@model Orange_Tendering_System.ViewModels.CreateOfficerTenderModel
@{ ViewData["Title"] = "Create tender"; ViewData["WorkspaceSection"] = "Tenders"; ViewData["Description"] = "Enter the supplier-facing details and dates. The requested items are copied from the department request."; }
<div class="so-page"><partial name="_PageHeader" /><form asp-action="Create" method="post" class="pg-form"><input asp-for="PurchaseRequestId" type="hidden"/><div asp-validation-summary="ModelOnly" class="pg-validation"></div>
<section class="ws-panel pg-panel"><div class="pg-panel-head"><div><span class="so-eyebrow">BASED ON REQUEST</span><h2>@Model.RequestTitle</h2></div><a class="pg-btn" asp-controller="PurchaseRequests" asp-action="Index">← Requests</a></div><div class="pg-form-grid"><div class="pg-field pg-field-wide"><label asp-for="Title">Tender title</label><input asp-for="Title"/><span asp-validation-for="Title" class="pg-validation"></span></div><div class="pg-field pg-field-wide"><label asp-for="Description">Description for suppliers</label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description" class="pg-validation"></span></div><div class="pg-field pg-field-wide"><label asp-for="Requirements">Mandatory documents or conditions</label><textarea asp-for="Requirements" rows="3" placeholder="For example: commercial registration; tax certificate; warranty terms"></textarea><small class="pg-hint">These requirements will help you review offer compliance later.</small></div></div></section>
<section class="ws-panel pg-panel"><h2>Items copied from the request</h2><div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Item</th><th>Specifications</th><th>Quantity</th><th>Unit</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.Name</strong></td><td>@item.Specifications</td><td>@item.Quantity</td><td>@item.Unit</td></tr>}</tbody></table></div></section>
<section class="ws-panel pg-panel"><h2>First bidding round</h2><p class="pg-hint">Suppliers can respond between the opening time and deadline.</p><div class="pg-form-grid"><div class="pg-field"><label asp-for="OpensAt">Opens at</label><input asp-for="OpensAt" type="datetime-local"/><span asp-validation-for="OpensAt" class="pg-validation"></span></div><div class="pg-field"><label asp-for="Deadline">Submission deadline</label><input asp-for="Deadline" type="datetime-local"/><span asp-validation-for="Deadline" class="pg-validation"></span></div></div><div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Create tender</button><span class="pg-hint">Next: choose approved suppliers to invite.</span></div></section></form></div>
