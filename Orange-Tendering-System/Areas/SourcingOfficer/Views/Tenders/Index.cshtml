@model IEnumerable<Orange_Tendering_System.Models.Entities.Tender>
@{ ViewData["Title"] = "Tenders"; ViewData["WorkspaceSection"] = "Tenders"; ViewData["Description"] = "Each tender is based on a department request. Open a tender to invite suppliers or review its offers."; var rows=Model.ToList(); }
<div class="so-page"><partial name="_PageHeader" />
<section class="pg-cards"><article class="pg-card"><span>Total tenders</span><strong>@rows.Count</strong></article><article class="pg-card"><span>Taking offers</span><strong>@rows.Count(t=>t.Status==Orange_Tendering_System.Models.Entities.TenderStatus.Bidding)</strong></article><article class="pg-card"><span>Under evaluation or review</span><strong>@rows.Count(t=>t.Status is Orange_Tendering_System.Models.Entities.TenderStatus.Evaluation or Orange_Tendering_System.Models.Entities.TenderStatus.ManagerReview or Orange_Tendering_System.Models.Entities.TenderStatus.OfficerReview)</strong></article></section>
<section class="ws-panel pg-panel"><div class="pg-panel-head"><div><h2>Your tenders</h2><span class="pg-hint">Use Details to see the next available action for each tender.</span></div><a class="pg-btn" asp-controller="PurchaseRequests" asp-action="Index">← Requests</a></div><div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Tender</th><th>From request</th><th>Round</th><th>Status</th><th></th></tr></thead><tbody>
@if(rows.Count==0){<tr><td colspan="5" class="so-empty">No tenders yet. Accept a request, then use Create tender from the request list.</td></tr>}
@foreach(var t in rows){var round=t.Rounds.OrderByDescending(r=>r.RoundNumber).FirstOrDefault();<tr><td><strong>@t.Title</strong><br/><small class="pg-hint">Tender #@t.Id</small></td><td>@t.PurchaseRequest.Title</td><td>@(round==null?"—":$"Round {round.RoundNumber} · {round.Status}")</td><td><span class="pg-badge @(t.Status==Orange_Tendering_System.Models.Entities.TenderStatus.Bidding?"is-ok":"")">@t.Status</span></td><td><a class="pg-btn pg-btn-primary" asp-action="Details" asp-route-id="@t.Id">Open tender</a></td></tr>}
</tbody></table></div></section></div>
