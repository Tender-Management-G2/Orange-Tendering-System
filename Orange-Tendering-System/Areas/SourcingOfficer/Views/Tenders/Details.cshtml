@model Orange_Tendering_System.Models.Entities.Tender
@{ ViewData["Title"] = "Tender details"; ViewData["WorkspaceSection"] = "Tenders"; ViewData["Description"] = "Check the tender requirements, supplier responses, and available next step."; }
<div class="so-page"><partial name="_PageHeader" />
<section class="ws-panel pg-panel"><div class="pg-panel-head"><div><span class="pg-badge">Tender #@Model.Id</span> <span class="pg-badge">@Model.Status</span></div><a class="pg-btn" asp-action="Index">← All tenders</a></div><h2>@Model.Title</h2><p>@Model.Description</p><dl class="pg-dl"><div><dt>Purchase request</dt><dd>@Model.PurchaseRequest.Title</dd></div><div><dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd></div></dl></section>
<div class="so-form-layout"><section class="ws-panel pg-panel"><h2>What suppliers must meet</h2><p>@(string.IsNullOrWhiteSpace(Model.Requirements)?"No mandatory requirements were entered.":Model.Requirements)</p><h2>Requested items</h2><div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Item</th><th>Specifications</th><th>Quantity</th><th>Unit</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td><strong>@i.Name</strong></td><td>@i.Specifications</td><td>@i.Quantity</td><td>@i.Unit</td></tr>}</tbody></table></div></section>
<section class="ws-panel pg-panel"><h2>Rounds and next steps</h2>@foreach(var r in Model.Rounds.OrderByDescending(r=>r.RoundNumber)){var invitationCount=r.Invitations.Count;var bidCount=r.Invitations.SelectMany(i=>i.Bids).Count(b=>b.Status==Orange_Tendering_System.Models.Entities.BidStatus.Submitted);<article class="so-round"><div class="so-round-title"><strong>Round @r.RoundNumber</strong><span class="pg-badge">@r.Status</span></div><p class="pg-hint">@invitationCount invitations · @bidCount submitted offers<br/>Deadline: @(r.Deadline?.ToLocalTime().ToString("d MMM yyyy h:mm tt")??"Not set")</p><div class="so-actions"><a class="pg-btn" asp-controller="Tenders" asp-action="SelectSuppliers" asp-route-id="@r.Id">Choose suppliers</a><a class="pg-btn" asp-controller="Bids" asp-action="Index" asp-route-id="@Model.Id">Review offers</a>@if(r.Status==Orange_Tendering_System.Models.Entities.TenderRoundStatus.Open && bidCount>0){<a class="pg-btn pg-btn-primary" asp-controller="Bids" asp-action="ForwardToCommittee" asp-route-id="@r.Id">Select offers for committee</a>}</div></article>}</section></div></div>
