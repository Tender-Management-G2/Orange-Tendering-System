@model Orange_Tendering_System.Models.Entities.Bid
@{ ViewData["Title"] = "Offer details"; ViewData["WorkspaceSection"] = "Received Bids"; ViewData["Description"] = "Read the price, technical response, and attachments submitted by this supplier."; }
<div class="so-page"><partial name="_PageHeader" /><section class="ws-panel pg-panel"><div class="pg-panel-head"><div><span class="pg-badge">Offer #@Model.Id</span> <span class="pg-badge">@Model.ComplianceStatus</span></div><div class="so-actions"><a class="pg-btn" asp-action="Index" asp-route-id="@Model.TenderInvitation.TenderRound.TenderId">← Offers</a><a class="pg-btn pg-btn-primary" asp-action="Compliance" asp-route-id="@Model.Id">Check requirements</a></div></div><h2>@Model.TenderInvitation.Supplier.CompanyName</h2><p>@Model.TenderInvitation.TenderRound.Tender.Title · Submitted @(Model.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy")??"—")</p><dl class="pg-dl"><div><dt>Delivery</dt><dd>@(Model.DeliveryDays?.ToString()+" days"??"Not specified")</dd></div><div><dt>Payment terms</dt><dd>@(Model.PaymentTerms??"Not specified")</dd></div><div><dt>Currency</dt><dd>@Model.CurrencyCode</dd></div><div><dt>Offer total</dt><dd>@Model.Items.Sum(i=>i.Quantity*i.UnitPrice).ToString("N2") @Model.CurrencyCode</dd></div></dl></section>
<section class="ws-panel pg-panel"><h2>Technical proposal</h2><p>@(Model.TechnicalProposal??"No technical proposal was provided.")</p><h2 class="so-subheading">Price lines</h2><div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Item</th><th>Quantity</th><th>Unit price</th><th>Line total</th><th>Supplier's specifications</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.TenderItem.Name</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("N2") @Model.CurrencyCode</td><td>@((item.Quantity*item.UnitPrice).ToString("N2")) @Model.CurrencyCode</td><td>@item.OfferedSpecifications</td></tr>}</tbody></table></div><h2 class="so-subheading">Attachments</h2>@if(Model.Documents.Count==0){<p class="pg-hint">No files attached.</p>}else{<ul>@foreach(var d in Model.Documents){<li>@d.FileName · @d.DocumentType</li>}</ul>}</section></div>
