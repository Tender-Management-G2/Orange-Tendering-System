@model Orange_Tendering_System.ViewModels.OfficerReportActionModel
@{ ViewData["Title"] = "Choose offers for evaluation"; ViewData["WorkspaceSection"] = "Received Bids"; ViewData["Description"] = "Select the compliant supplier offers the Technical & Financial Evaluation Committee should review."; }
<div class="so-page"><partial name="_PageHeader" /><section class="ws-panel pg-panel"><span class="so-eyebrow">BEFORE YOU SEND</span><h2>Check the offers, then select the eligible ones</h2><p>Only offers marked <strong>Compliant</strong> are listed here. The round needs at least three submitted offers from different suppliers, and four evaluation committee members must be assigned.</p></section>
<section class="ws-panel pg-panel"><form asp-action="ForwardToCommittee" method="post" class="pg-form"><input asp-for="RoundId" type="hidden"/><div asp-validation-summary="All" class="pg-validation"></div><div class="pg-panel-head"><div><h2>Compliant offers (@Model.Bids.Count)</h2><span class="pg-hint">Tick the offers to include. Each row belongs to a different supplier.</span></div></div>
@if(Model.Bids.Count==0){<div class="so-empty">No compliant offers are ready. Go back to Offers and record a compliance decision first.</div>}else{<div class="so-offer-picks">@foreach(var b in Model.Bids){<label class="so-offer-pick"><input type="checkbox" name="BidIds" value="@b.Id"/><span><strong>@b.TenderInvitation.Supplier.CompanyName</strong><small>Offer #@b.Id · @b.CurrencyCode · delivery @(b.DeliveryDays?.ToString()+" days"??"not specified")</small></span><span class="so-offer-total">@b.Items.Sum(i=>i.Quantity*i.UnitPrice).ToString("N2") @b.CurrencyCode</span></label>}</div>}
<div class="pg-field so-note-field"><label asp-for="Comment">Note for the evaluation committee <span class="pg-hint">(optional)</span></label><textarea asp-for="Comment" rows="3" placeholder="Mention anything the committee should know"></textarea></div><div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary" disabled="@(Model.Bids.Count==0)">Send selected offers to committee</button><a class="pg-btn" asp-controller="Tenders" asp-action="Index">Cancel</a></div></form></section></div>
