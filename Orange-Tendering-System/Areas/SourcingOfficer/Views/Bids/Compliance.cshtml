@model Orange_Tendering_System.Models.Entities.Bid
@{ ViewData["Title"] = "Check offer requirements"; ViewData["WorkspaceSection"] = "Received Bids"; ViewData["Description"] = "Compare the offer with the tender's required documents and conditions."; }
<div class="so-page">
    <partial name="_PageHeader" />
    @if (TempData["ComplianceSaved"] is string saved) { <div class="so-alert" role="status">@saved</div> }
    <section class="ws-panel pg-panel">
        <div class="pg-panel-head">
            <div><span class="pg-badge">Offer #@Model.Id</span> <span class="pg-badge">@Model.TenderInvitation.Supplier.CompanyName</span></div>
            <a class="pg-btn" asp-action="Details" asp-route-id="@Model.Id">Read full offer</a>
        </div>
        <h2>@Model.TenderInvitation.TenderRound.Tender.Title</h2>
        <div class="so-requirements"><strong>Requirements set for suppliers</strong><p>@(string.IsNullOrWhiteSpace(Model.TenderInvitation.TenderRound.Tender.Requirements) ? "No mandatory requirements were entered for this tender." : Model.TenderInvitation.TenderRound.Tender.Requirements)</p></div>
        <h3 class="so-subheading">Documents submitted with this offer</h3>
        @if (Model.Documents.Count == 0) { <p class="pg-hint">The supplier did not attach documents to this offer.</p> }
        else { <div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Document</th><th>Type</th><th>Uploaded</th></tr></thead><tbody>@foreach (var document in Model.Documents) { <tr><td>@document.FileName</td><td>@(document.DocumentType ?? "—")</td><td>@document.UploadedAt.ToLocalTime().ToString("d MMM yyyy")</td></tr> }</tbody></table></div> }
        <p class="pg-hint">Choose a result below. The form will show only the information needed for that result.</p>
    </section>

    <section class="ws-panel pg-panel">
        <h2>Your compliance decision</h2>
        <form asp-action="Compliance" method="post" class="pg-form" id="compliance-form" data-offer-compliance>
            <input type="hidden" name="id" value="@Model.Id" />
            <div asp-validation-summary="ModelOnly" class="pg-validation" role="alert"></div>
            <div class="pg-field pg-field-wide">
                <label for="status">Does this offer meet the requirements?</label>
                <select id="status" name="status" aria-controls="noncompliant-box clarification-box">
                    <option value="Compliant" selected="@(Model.ComplianceStatus == Orange_Tendering_System.Models.Entities.ComplianceStatus.Compliant)">Compliant — meets requirements</option>
                    <option value="NonCompliant" selected="@(Model.ComplianceStatus == Orange_Tendering_System.Models.Entities.ComplianceStatus.NonCompliant)">Non-compliant — a requirement is missing</option>
                    <option value="PendingClarification" selected="@(Model.ComplianceStatus == Orange_Tendering_System.Models.Entities.ComplianceStatus.PendingClarification)">Needs clarification — waiting for supplier</option>
                </select>
            </div>
            <p class="pg-hint" data-compliance-confirmation hidden>Choosing Compliant confirms that you reviewed the attached documents and resolved the previous missing requirements.</p>
            <div class="pg-field so-conditional-box" id="noncompliant-box" hidden>
                <label for="notes">Why does this offer not meet the requirements?</label>
                <textarea name="notes" id="notes" rows="3" maxlength="2000" placeholder="Explain the unmet requirement or failed check">@Model.ComplianceNotes</textarea>
                <small class="pg-hint">A reason is required so the decision is clear.</small>
                <span class="pg-validation" data-error-for="notes">@Html.ValidationMessage("notes")</span>
            </div>
            <div class="pg-field so-conditional-box" id="clarification-box" hidden>
                <label for="missingRequirements">What information or documents are needed from the supplier?</label>
                <textarea name="missingRequirements" id="missingRequirements" rows="3" maxlength="2000" placeholder="List each missing document or detail">@Model.MissingRequirements</textarea>
                <small class="pg-hint">List what the supplier needs to provide before you can complete the check.</small>
                <span class="pg-validation" data-error-for="missingRequirements">@Html.ValidationMessage("missingRequirements")</span>
            </div>
            <div class="pg-actions">
                <button type="submit" class="pg-btn pg-btn-primary">Save compliance decision</button>
                <a class="pg-btn" asp-action="Index" asp-route-id="@Model.TenderInvitation.TenderRound.TenderId">Cancel</a>
            </div>
        </form>
    </section>
</div>
