@model IEnumerable<Orange_Tendering_System.Models.Entities.Clarification>
@{ ViewData["Title"] = "Supplier messages"; ViewData["WorkspaceSection"] = "Clarifications"; ViewData["Description"] = "A simple inbox for supplier questions about offers. Open a message to reply."; var rows=Model.OrderByDescending(c=>c.CreatedAt).ToList(); }
<div class="so-page"><partial name="_PageHeader" /><section class="pg-cards"><article class="pg-card"><span>Open conversations</span><strong>@rows.Count(c=>c.Status==Orange_Tendering_System.Models.Entities.ClarificationStatus.Open)</strong></article><article class="pg-card"><span>Answered</span><strong>@rows.Count(c=>c.Status==Orange_Tendering_System.Models.Entities.ClarificationStatus.Answered)</strong></article><article class="pg-card"><span>Resolved</span><strong>@rows.Count(c=>c.Status==Orange_Tendering_System.Models.Entities.ClarificationStatus.Closed)</strong></article></section>
<section class="ws-panel pg-panel"><div class="pg-panel-head"><div><h2>Conversations</h2><span class="pg-hint">Only conversations about offers invited by you appear here.</span></div></div><div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Subject</th><th>Supplier</th><th>Related offer</th><th>Status</th><th>Last update</th><th></th></tr></thead><tbody>@if(rows.Count==0){<tr><td colspan="6" class="so-empty">No supplier questions yet. If a supplier asks about an offer, the conversation will appear here.</td></tr>}@foreach(var c in rows){<tr><td><strong>@c.Subject</strong></td><td>@c.Bid!.TenderInvitation.Supplier.CompanyName</td><td>@c.Bid.TenderInvitation.TenderRound.Tender.Title</td><td><span class="pg-badge @(c.Status==Orange_Tendering_System.Models.Entities.ClarificationStatus.Open?"is-warn":c.Status==Orange_Tendering_System.Models.Entities.ClarificationStatus.Answered?"is-ok":"")">@c.Status</span></td><td>@c.CreatedAt.ToLocalTime().ToString("d MMM yyyy h:mm tt")</td><td><a class="pg-btn @(c.Status==Orange_Tendering_System.Models.Entities.ClarificationStatus.Open?"pg-btn-primary":"")" asp-action="Details" asp-route-id="@c.Id">@(c.Status==Orange_Tendering_System.Models.Entities.ClarificationStatus.Open?"Reply":"Open chat")</a></td></tr>}</tbody></table></div></section></div>
