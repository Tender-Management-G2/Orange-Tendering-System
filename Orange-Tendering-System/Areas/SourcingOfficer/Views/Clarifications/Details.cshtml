@model Orange_Tendering_System.Models.Entities.Clarification
@{ ViewData["Title"] = "Supplier conversation"; ViewData["WorkspaceSection"] = "Clarifications"; ViewData["Description"] = "Read the supplier's question and send a short reply."; }
<div class="so-page"><partial name="_PageHeader" /><section class="ws-panel pg-panel"><div class="pg-panel-head"><div><span class="pg-badge">@Model.Bid!.TenderInvitation.Supplier.CompanyName</span><span class="pg-badge">@Model.Status</span></div><a class="pg-btn" asp-action="Index">← Inbox</a></div><h2>@Model.Subject</h2><p class="pg-hint">About offer #@Model.BidId · @Model.Bid.TenderInvitation.TenderRound.Tender.Title</p><div class="so-chat">@foreach(var m in Model.Messages.OrderBy(m=>m.SentAt)){var own=m.SenderUserId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;<article class="so-message @(own?"is-own":"")"><small><strong>@(own?"You":Model.Bid.TenderInvitation.Supplier.CompanyName)</strong> · @m.SentAt.ToLocalTime().ToString("d MMM yyyy h:mm tt")</small><p>@m.Message</p></article>}</div></section>
@if(Model.Status!=Orange_Tendering_System.Models.Entities.ClarificationStatus.Closed){<section class="ws-panel pg-panel"><h2>Reply to supplier</h2><form asp-action="Reply" method="post" class="pg-form"><input type="hidden" name="id" value="@Model.Id"/><div class="pg-field"><label for="message">Your reply</label><textarea name="message" id="message" required maxlength="10000" rows="3" placeholder="Write a clear answer or ask for one more detail"></textarea></div><div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Send reply</button><span class="pg-hint">The supplier will see your reply in the same conversation.</span></div></form></section>}</div>
