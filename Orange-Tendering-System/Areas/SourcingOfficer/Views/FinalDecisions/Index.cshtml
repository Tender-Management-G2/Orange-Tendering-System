@model List<Orange_Tendering_System.Models.Entities.FinalDecisionNotice>
@using Orange_Tendering_System.Models.Entities
@{
    ViewData["Title"] = "Final decisions"; ViewData["WorkspaceSection"] = "Final Decisions";
    ViewData["Description"] = "Top Committee, then Sourcing Manager, then you. Only you can announce results to suppliers.";
    var suppliers = (Dictionary<int, string>)ViewBag.Suppliers; var emails = (Dictionary<string, string?>)ViewBag.Emails;
}
<partial name="_PageHeader" />
<partial name="_Flash" />
@foreach (var n in Model)
{
    <section class="ws-panel pg-panel" aria-labelledby="fd-@n.Id">
        <div class="pg-panel-head"><h2 id="fd-@n.Id">@n.Tender.Title</h2>
            <span class="ui-pill ui-pill--@(n.Status == FinalDecisionStatus.SuppliersNotified ? "good" : n.Status == FinalDecisionStatus.ForwardedToOfficer ? "info" : "warn")">@(n.Status switch { FinalDecisionStatus.AwaitingManager => "Waiting for Manager", FinalDecisionStatus.ForwardedToOfficer => "Ready to notify suppliers", _ => "Suppliers notified" })</span></div>
        <ol class="ui-timeline">
            <li><strong>Top Committee</strong><span>@(n.TopVotes == 0 ? "Not required: Manager approval is the final decision" : $"{n.TopApprovals} of {n.TopVotes} approved") · @n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></li>
            <li><strong>Sourcing Manager</strong><span>@(n.ManagerAcknowledgedAt is { } t ? "Acknowledged and forwarded " + t.ToString("yyyy-MM-dd HH:mm") + (string.IsNullOrWhiteSpace(n.ManagerComment) ? "" : " · " + n.ManagerComment) : "Waiting for acknowledgement")</span></li>
            <li><strong>Sourcing Officer</strong><span>@(n.SuppliersNotifiedAt is { } s ? "Suppliers notified " + s.ToString("yyyy-MM-dd HH:mm") : "Suppliers have not been notified")</span></li>
        </ol>
        @if (n.Status == FinalDecisionStatus.ForwardedToOfficer)
        {
            <form method="post" asp-action="Notify" asp-route-id="@n.TenderId" class="pg-form"><div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary" data-confirm="Announce the winning and unsuccessful results to suppliers now?">Notify Suppliers</button><span class="pg-hint">The tender must be awarded first. This can only be done once.</span></div></form>
        }
        @if (n.Deliveries.Any())
        {
            <div class="pg-table-wrap"><table class="pg-table">
                <thead><tr><th scope="col">Supplier</th><th scope="col">Recipient</th><th scope="col">Result</th><th scope="col">In-app</th><th scope="col">E-mail</th><th scope="col">Attempts</th></tr></thead>
                <tbody>@foreach (var d in n.Deliveries.OrderBy(x => x.SupplierId))
                {
                    <tr><td>@(suppliers.GetValueOrDefault(d.SupplierId) ?? "—")</td><td>@(emails.GetValueOrDefault(d.RecipientUserId) ?? "—")</td><td>@d.Outcome</td><td>@d.InAppStatus</td><td>@d.EmailStatus</td><td>@d.EmailAttempts</td></tr>
                }</tbody></table></div>
            @if (n.Deliveries.Any(d => d.EmailStatus == "Failed" && d.EmailAttempts < Orange_Tendering_System.Services.TenderWorkflowService.MaxEmailAttempts))
            {
                <form method="post" asp-action="Retry" asp-route-id="@n.TenderId" class="pg-form"><div class="pg-actions"><button type="submit" class="pg-btn">Retry failed e-mails</button></div></form>
            }
        }
    </section>
}
@if (Model.Count == 0) { <section class="ws-panel pg-panel"><partial name="_EmptyState" model='"No final decision has been recorded yet."' /></section> }
