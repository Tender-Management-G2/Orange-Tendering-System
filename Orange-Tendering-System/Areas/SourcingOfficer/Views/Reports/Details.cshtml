@model Orange_Tendering_System.Models.Entities.TenderReport
@{ ViewData["Title"] = "Report details"; ViewData["WorkspaceSection"] = "Reports"; ViewData["Description"] = "Read the committee's report and any manager response."; }
<div class="so-page"><partial name="_PageHeader" /><section class="ws-panel pg-panel"><div class="pg-panel-head"><div><span class="pg-badge">@Model.ReportType · Version @Model.VersionNumber</span><span class="pg-badge @(Model.Status==Orange_Tendering_System.Models.Entities.ReportStatus.Accepted?"is-ok":Model.Status==Orange_Tendering_System.Models.Entities.ReportStatus.Returned?"is-warn":Model.Status==Orange_Tendering_System.Models.Entities.ReportStatus.Rejected?"is-bad":"")">@Model.Status</span></div><a class="pg-btn" asp-action="Index">← All reports</a></div><h2>@Model.TenderRound.Tender.Title</h2><dl class="pg-dl"><div><dt>Submitted</dt><dd>@(Model.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy h:mm tt")??"Not submitted")</dd></div><div><dt>Recommended offer</dt><dd>@(Model.RecommendedBidId?.ToString()??"Not specified")</dd></div><div><dt>Manager's response date</dt><dd>@(Model.ReviewedAt?.ToLocalTime().ToString("d MMM yyyy")??"—")</dd></div></dl></section>
<section class="ws-panel pg-panel"><h2>Committee report</h2><div class="so-report-content">@Model.Content</div>@if(!string.IsNullOrWhiteSpace(Model.RankingSnapshotJson)){<h3 class="so-subheading">Evaluation snapshot</h3><pre class="so-json">@Model.RankingSnapshotJson</pre>}</section>
@if(!string.IsNullOrWhiteSpace(Model.ReviewComment)){<section class="ws-panel pg-panel so-manager-note"><h2>Manager's note</h2><p>@Model.ReviewComment</p></section>}@if(Model.PreviousReportId.HasValue){<p class="pg-hint">This is a revised report following version @Model.PreviousReportId.</p>}</div>
