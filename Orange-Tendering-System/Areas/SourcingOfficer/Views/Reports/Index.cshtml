@model Orange_Tendering_System.ViewModels.OfficerReportsViewModel
@{ ViewData["Title"] = "Committee reports"; ViewData["WorkspaceSection"] = "Reports"; ViewData["Description"] = "Read the evaluation committee's report. Forward submitted reports to the Sourcing Manager, and check returned or decided reports here."; var rows=Model.Reports.OrderByDescending(r=>r.CreatedAt).ToList(); }
<div class="so-page"><partial name="_PageHeader" />@if(TempData["ManagerForwarded"] is string forwarded){<div class="so-alert" role="status">@forwarded</div>}@if(TempData["ManagerForwardError"] is string forwardError){<div class="so-alert so-alert-error" role="alert">@forwardError</div>}@if(TempData["CommitteeForwarded"] is string committeeForwarded){<div class="so-alert" role="status">@committeeForwarded</div>}<div class="pg-cards"><article class="pg-card"><span>New committee reports</span><strong>@rows.Count(r=>r.ReportType==Orange_Tendering_System.Models.Entities.ReportType.FullEvaluation && r.Status==Orange_Tendering_System.Models.Entities.ReportStatus.Submitted && !Model.ForwardedReportIds.Contains(r.Id))</strong></article><article class="pg-card"><span>Returned for clarification</span><strong>@rows.Count(r=>r.Status==Orange_Tendering_System.Models.Entities.ReportStatus.Returned)</strong></article><article class="pg-card"><span>Accepted or rejected</span><strong>@rows.Count(r=>r.Status is Orange_Tendering_System.Models.Entities.ReportStatus.Accepted or Orange_Tendering_System.Models.Entities.ReportStatus.Rejected)</strong></article></div>
<section class="ws-panel pg-panel"><div class="pg-panel-head"><div><h2>Reports and decisions</h2><span class="pg-hint">The status tells you what happened. Open a report to read the committee's notes.</span></div></div><div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Tender</th><th>Report</th><th>Version</th><th>Status</th><th>Manager's note</th><th>Next step</th></tr></thead><tbody>@if(rows.Count==0){<tr><td colspan="6" class="so-empty">No committee reports yet. Reports will appear here after evaluation is complete.</td></tr>}@foreach(var r in rows){var cls=r.Status switch{Orange_Tendering_System.Models.Entities.ReportStatus.Accepted=>"is-ok",Orange_Tendering_System.Models.Entities.ReportStatus.Returned=>"is-warn",Orange_Tendering_System.Models.Entities.ReportStatus.Rejected=>"is-bad",_=>""};<tr><td><strong>@r.TenderRound.Tender.Title</strong></td><td>@r.ReportType</td><td>v@r.VersionNumber</td><td><span class="pg-badge @cls">@r.Status</span></td><td>@(string.IsNullOrWhiteSpace(r.ReviewComment)?"—":r.ReviewComment)</td><td><div class="so-actions"><a class="pg-btn" asp-action="Details" asp-route-id="@r.Id">Read report</a>@if(r.ReportType==Orange_Tendering_System.Models.Entities.ReportType.FullEvaluation && r.Status==Orange_Tendering_System.Models.Entities.ReportStatus.Submitted && !Model.ForwardedReportIds.Contains(r.Id)){<form asp-action="SubmitToManager" method="post"><input type="hidden" name="id" value="@r.Id"/><button class="pg-btn pg-btn-primary" type="submit">Forward to manager</button></form>}else if(Model.ForwardedReportIds.Contains(r.Id)){<span class="pg-badge is-ok">Sent to manager</span>}</div></td></tr>}</tbody></table></div></section><aside class="so-help"><strong>What do statuses mean?</strong><span><b>Submitted</b> waiting for forwarding or review · <b>Returned</b> manager needs clarification · <b>Accepted</b> approved · <b>Rejected</b> closed.</span></aside></div>
