<h1>Create purchase request</h1><div asp-validation-summary="All"></div><form method="post" asp-action="Create">
<label>Title<input name="title" required maxlength="200" /></label><label>Justification<textarea name="justification" required></textarea></label>
<label>Item name<input name="itemName" required /></label><label>Quantity<input name="quantity" type="number" min="0.001" step="0.001" required /></label><label>Unit<input name="unit" required maxlength="30" /></label><label>Specifications<textarea name="specifications"></textarea></label><button>Submit purchase request</button></form>
