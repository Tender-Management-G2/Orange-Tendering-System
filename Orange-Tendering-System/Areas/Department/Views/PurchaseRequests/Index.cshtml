@model RequestList
@{
    ViewData["Title"] = "My Purchase Requests";
    ViewData["WorkspaceSection"] = "My Requests";
    ViewData["Description"] = "Requests belonging to your department. Only the creator can edit a Draft or Returned request.";
}
<partial name="_PageHeader" />
<form method="get" asp-action="Index" class="pg-toolbar" aria-label="Search and filters">
    <input type="search" name="search" value="@Model.Search" placeholder="Title or PR reference" aria-label="Title or PR reference" maxlength="200" />
    <select name="status" aria-label="Status"><option value="">All statuses</option>
    @foreach (var status in RequestDisplay.Statuses) { <option value="@status" selected="@(Model.Status == status)">@status</option> }
    </select>
    <select name="priority" aria-label="Priority"><option value="">All priorities</option>
    @foreach (var priority in Enum.GetValues<RequestPriority>()) { <option value="@priority" selected="@(Model.Priority == priority)">@priority</option> }
    </select>
    <button type="submit" class="pg-btn pg-btn-primary">Search</button><a asp-action="Index" class="pg-btn">Clear</a>
</form>
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><h2>Purchase requests (@Model.Total)</h2><a class="pg-btn pg-btn-primary" asp-action="Create">New request</a></div>
    <partial name="_RequestTable" model='new RequestTable(Model.Requests, Model.UserId)' />
    <nav class="pg-actions" aria-label="Request pages">
    @if (Model.Page > 1) { <a class="pg-btn" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">Previous</a> }
    <span>Page @Model.Page of @Model.Pages</span>
    @if (Model.Page < Model.Pages) { <a class="pg-btn" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">Next</a> }
    </nav>
</section>
