@model List<Orange_Tendering_System.Models.Entities.PurchaseRequest>
<h1>Purchase requests</h1><a asp-action="Create">Create purchase request</a><table><tr><th>ID</th><th>Title</th><th>Status</th></tr>@foreach(var p in Model){<tr><td>@p.Id</td><td><a asp-action="Details" asp-route-id="@p.Id">@p.Title</a></td><td>@p.Status</td></tr>}</table>
