@model RequestForm
<input asp-for="Id" type="hidden" />
<input asp-for="Version" type="hidden" />
<div asp-validation-summary="All" role="alert"></div>
@if (!string.IsNullOrWhiteSpace(Model.ReturnComment))
{
    <aside class="pg-note"><strong>Sourcing Officer's return comments</strong><p>@Model.ReturnComment</p></aside>
}
<section class="ws-panel pg-panel">
    <h2>Request information</h2>
    <div class="pg-form-grid">
        <div class="pg-field"><label asp-for="Title"></label><input asp-for="Title" maxlength="200" required /><span asp-validation-for="Title"></span></div>
        <div class="pg-field"><label asp-for="Priority"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<RequestPriority>()"></select></div>
        <div class="pg-field"><label asp-for="NeededBy">Needed by</label><input asp-for="NeededBy" type="date" required /><span asp-validation-for="NeededBy"></span></div>
        <div class="pg-field pg-field-wide"><label asp-for="Justification">Justification / reason</label><textarea asp-for="Justification" rows="4" maxlength="10000" required></textarea><span asp-validation-for="Justification"></span></div>
    </div>
</section>
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><h2>Requested items</h2><button type="button" class="pg-btn" id="department-add-item">Add item</button></div>
    <p class="pg-hint">At least one item. Quantities must be positive, with up to three decimal places.</p>
    <div class="pg-table-wrap"><table class="pg-table">
        <thead><tr><th scope="col">Item / service</th><th scope="col">Specifications</th><th scope="col">Quantity</th><th scope="col">Unit</th><th scope="col">Action</th></tr></thead>
        <tbody id="department-items">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            <tr>
                <td><input asp-for="Items[i].Name" aria-label="Item name" maxlength="200" required /></td>
                <td><textarea asp-for="Items[i].Specifications" aria-label="Item specifications" maxlength="10000" rows="2"></textarea></td>
                <td><input asp-for="Items[i].Quantity" aria-label="Quantity" type="number" min="0.001" max="999999999999999.999" step="0.001" required /></td>
                <td><input asp-for="Items[i].Unit" aria-label="Unit" maxlength="30" required /></td>
                <td><button type="button" class="pg-btn" data-remove-item>Remove</button></td>
            </tr>
        }
        </tbody>
    </table></div>
    <p id="department-item-message" class="pg-hint" role="status" aria-live="polite"></p>
</section>
<section class="ws-panel pg-panel">
    <h2>Supporting attachments</h2>
    @if (Model.ExistingDocuments.Count > 0)
    {
        <ul>@foreach (var document in Model.ExistingDocuments) { <li>@document.FileName</li> }</ul>
        <p class="pg-hint">Existing attachments are preserved.</p>
    }
    <div class="pg-field"><label asp-for="Attachments">Add files</label><input asp-for="Attachments" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.docx,.xlsx" /><span asp-validation-for="Attachments"></span>
    <small class="pg-hint">PDF, PNG, JPEG, DOCX or XLSX. Up to five files per save, 5 MB each and 10 MB combined. Reselect new files if validation fails.</small></div>
    <div class="pg-actions">
        <button type="submit" name="intent" value="save" class="pg-btn">@(Model.Id == 0 ? "Save draft" : "Save changes")</button>
        <button type="submit" name="intent" value="submit" class="pg-btn pg-btn-primary">@(Model.Id == 0 ? "Submit to Sourcing Officer" : "Submit / resubmit to Sourcing Officer")</button>
        <a class="pg-btn" asp-action="Index">Cancel</a>
    </div>
    <p class="pg-hint">Submission goes directly to the Sourcing Officer. Submitted requests are read-only until returned for corrections.</p>
</section>
