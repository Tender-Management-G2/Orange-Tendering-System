@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Purchase Request Details & History

DEVELOPER OWNER: Doulat
MODULE: Department / Purchase Requests
TRELLO TASK: Purchase Request Details & History
TRELLO URL: https://trello.com/c/IR3EpX2r

PURPOSE:
Show one request, its items and attachments, and the full
submission/decision history.

BUSINESS ACCESS:
Requesting Department (own department only)

ROUTE: /Department/PurchaseRequests/Details/{id?}

FUTURE IMPLEMENTATION:
- Load the request with Items, Reviews and Documents; deny
  other departments.
- Render each PurchaseRequestReview.SubmittedSnapshotJson as
  a read-only version.
- For Returned requests: show the Officer’s comment and an
  Edit & resubmit action.
- Link clarification threads where
  Clarification.PurchaseRequestId = this request.

DEPENDENCIES:
PurchaseRequests, PurchaseRequestItems,
PurchaseRequestReviews, Documents, Clarifications.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@
@{
    ViewData["Title"] = "Purchase Request Details & History";
    ViewData["WorkspaceSection"] = "My Requests";
    ViewData["Description"] = "The current request, its items, and every earlier submission with the Officer’s decisions.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Request</h2>
    <dl class="pg-dl">
        <div><dt>Reference</dt><dd>—</dd></div>
        <div><dt>Title</dt><dd>—</dd></div>
        <div><dt>Department</dt><dd>—</dd></div>
        <div><dt>Priority</dt><dd>—</dd></div>
        <div><dt>Needed by</dt><dd>—</dd></div>
        <div><dt>Status</dt><dd>—</dd></div>
        <div><dt>Created</dt><dd>—</dd></div>
        <div><dt>Last submitted</dt><dd>—</dd></div>
    </dl>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-items">
    <div class="pg-panel-head"><h2 id="tbl-items">Items</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Item / service</th><th scope="col">Specifications</th><th scope="col">Quantity</th><th scope="col">Unit</th></tr></thead>
            <tbody><tr><td colspan="4"><partial name="_EmptyState" model='"No items loaded."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-submission-history">
    <div class="pg-panel-head"><h2 id="tbl-submission-history">Submission history</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Submission #</th><th scope="col">Submitted</th><th scope="col">Officer decision</th><th scope="col">Comment</th><th scope="col">Reviewed</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"This request has not been submitted yet."' /></td></tr></tbody>
        </table>
    </div>
</section>

<aside class="pg-note"><strong>Earlier versions stay visible</strong><p>Each submission keeps a snapshot (SubmittedSnapshotJson). If the request is returned and changed from 10 to 15 computers, the original 10-computer submission is still shown here.</p></aside>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Department" asp-controller="PurchaseRequests" asp-action="Edit">Edit &amp; resubmit (returned requests)</a></li>
        <li><a asp-area="Department" asp-controller="PurchaseRequests" asp-action="Index">Back to my requests</a></li>
        <li><a asp-area="" asp-controller="Clarifications" asp-action="Index">Clarifications</a></li>
    </ul>
</nav>
