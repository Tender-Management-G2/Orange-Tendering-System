@model RequestForm
@{
    ViewData["Title"] = "Edit & Resubmit Purchase Request";
    ViewData["WorkspaceSection"] = "My Requests";
    ViewData["Description"] = "Save corrections or resubmit directly to the Sourcing Officer. Previous submissions stay unchanged.";
}
<partial name="_PageHeader" />
<nav class="pg-links"><ul><li><a asp-action="Details" asp-route-id="@Model.Id">View earlier submissions & Officer review history</a></li></ul></nav>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="pg-form department-form" data-om="popup">
    <partial name="_RequestForm" model="Model" />
</form>
@section Styles { <link rel="stylesheet" href="~/css/procurement-forms.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/department-request-create.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/department-request-redesign.css" asp-append-version="true" /> }
@section Scripts { @if (Model.Items.Count > 1) { <partial name="_FormScripts" /> } else { <script src="~/js/department-request-form.js" asp-append-version="true"></script> } }
