@model DecisionHistory
@{
    ViewData["Title"] = "Committee Voting & Decision History";
    ViewData["WorkspaceSection"] = "Decision History";
    ViewData["Description"] = "Recorded rounds and votes for tenders assigned to you. Earlier decisions remain preserved.";
}
<div class="tc-history tc-live" data-live-root>
<partial name="_PageHeader" /><partial name="_Messages" />
@{ ViewData["KpiAction"] = "History"; }
<partial name="_RoundKpis" model="Model" />
<form method="get" asp-action="History" asp-route-id="" class="pg-toolbar" data-live-form aria-label="Search committee rounds">
<input id="tc-live-search" type="search" name="search" maxlength="200" value="@Model.Search" placeholder="Tender title or reference (e.g. T-4)" aria-label="Tender search" aria-controls="tc-live-results" autocomplete="off" />
<select id="tc-live-status" name="status" aria-label="Round status" aria-controls="tc-live-results"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<CommitteeRoundStatus>()) { <option value="@status" selected="@(Model.Status == status)">@CommitteeDisplay.Status(status)</option> }</select>
<button type="submit" class="pg-btn pg-btn-primary">Search</button>
<a class="pg-btn" asp-action="History" asp-route-id="">Reset</a>
</form>
<p class="tc-live-status" role="status" aria-live="polite" aria-atomic="true" data-live-status></p>
<div id="tc-live-results" data-live-results><partial name="_HistoryResults" model="Model" /></div>
</div>
@section Styles { <partial name="_TopStyles" /><partial name="_HistoryStyles" /><partial name="_LiveFiltersStyles" /> }

@section Scripts { <partial name="_LiveFiltersScripts" /> }
