@model List<Orange_Tendering_System.Areas.TopCommittee.Services.TopCase>
@{
    ViewData["Title"] = "Decision History"; ViewData["WorkspaceSection"] = "Decision History";
    ViewData["Description"] = "Past tenders you decided on, with the final outcome.";
}
<partial name="_PageHeader" />
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><h2>Bid history</h2></div>
    <div class="pg-table-wrap"><table class="pg-table">
        <thead><tr><th scope="col">Tender</th><th scope="col">Department</th><th scope="col">Outcome</th><th scope="col">Supplier</th><th scope="col">Decisions (approve / total)</th><th scope="col">My decision</th><th scope="col">Closed</th><th scope="col" data-nosort>Actions</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr><td><strong>@c.Title</strong></td><td>@c.Department</td><td>@(c.Outcome ?? c.Status)</td><td>@(c.Winner ?? "—")</td><td>@c.Approvals / @c.Votes</td><td>@(c.MyVote ?? "—")</td><td>@(c.AwardedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                <td><a class="pg-btn" data-no-modal asp-action="ReviewEvaluation" asp-route-id="@c.TenderId">Details</a></td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="8"><partial name="_EmptyState" model='"No decided tenders yet."' /></td></tr> }
        </tbody>
    </table></div>
</section>
