@model RoundSelection
@{ var listing = Model.Listing; var voting = Model.TargetAction == "Decision"; }
<section class="ws-panel pg-panel" data-result-count="@listing.Total" data-result-page="@listing.Page">
    <div class="pg-panel-head"><h2>Your Assigned Committee Rounds (@listing.Total)</h2></div>
    @if (listing.Total == 0)
    {
        @if (!string.IsNullOrWhiteSpace(listing.Search) || listing.Status.HasValue)
        { <p>No matching results found.</p> }
        else
        { <p>No matching results found. No committee rounds have been assigned to your account yet.</p><p class="pg-hint">The responsible team member must assign you to a tender's Top Committee and create its committee round before it appears here.</p> }
    }
    else
    {
        <div class="pg-table-wrap"><table class="pg-table">
            <thead><tr><th>Tender</th><th>Committee Round</th><th>Recommended Supplier</th><th>Status</th><th>Voting Progress</th><th>My Vote</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var round in listing.Rounds)
            {
                var myVote = round.Votes.SingleOrDefault(v => v.CommitteeMember.UserId == Model.UserId);
                var statusClass = round.Status switch { CommitteeRoundStatus.Approved => "is-ok", CommitteeRoundStatus.Rejected => "is-bad", _ => "is-warn" };
                <tr>
                    <td>T-@round.TenderRound.TenderId<br />@round.TenderRound.Tender.Title</td>
                    <td>@round.RoundNumber</td>
                    <td>@(round.TenderReport?.RecommendedBid?.TenderInvitation.Supplier.CompanyName ?? "No recommendation recorded")</td>
                    <td><span class="pg-badge @statusClass">@CommitteeDisplay.Status(round.Status)</span></td>
                    <td>@round.Votes.Select(v => v.CommitteeMemberId).Distinct().Count() / 4 Voted</td>
                    <td>@(myVote?.Decision.ToString() ?? "Pending")</td>
                    <td><a class="pg-btn pg-btn-primary" asp-action="@Model.TargetAction" asp-route-id="@round.Id">@(voting ? "View voting & eligibility" : "Review evaluation")</a></td>
                </tr>
            }
            </tbody>
        </table></div>
        <nav class="pg-actions" aria-label="Assigned round pages" data-live-pagination>
        @if (listing.Page > 1)
        { <a class="pg-btn" asp-action="@Model.TargetAction" asp-route-id="" asp-route-page="@(listing.Page - 1)" asp-route-search="@listing.Search" asp-route-status="@listing.Status">Previous</a> }
        <span>Page @listing.Page of @listing.Pages</span>
        @if (listing.Page < listing.Pages)
        { <a class="pg-btn" asp-action="@Model.TargetAction" asp-route-id="" asp-route-page="@(listing.Page + 1)" asp-route-search="@listing.Search" asp-route-status="@listing.Status">Next</a> }
        </nav>
    }
</section>
