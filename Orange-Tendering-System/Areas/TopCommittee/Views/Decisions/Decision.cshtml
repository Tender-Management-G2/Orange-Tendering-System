@model Orange_Tendering_System.Areas.TopCommittee.Services.TopCaseDetails
@{
    ViewData["Title"] = "Decision: " + Model.Case.Title; ViewData["WorkspaceSection"] = "Voting";
    ViewData["Description"] = "Your final decision is cast and signed on the report page. It needs the committee and Manager signatures and records one vote per member.";
}
<partial name="_PageHeader" />
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><h2>@Model.Case.Title</h2><span class="ui-pill ui-pill--@(Model.Case.MyVote != null ? "good" : Model.Case.AwaitingMyVote ? "warn" : "info")">@(Model.Case.MyVote != null ? "You voted: " + Model.Case.MyVote : Model.Case.AwaitingMyVote ? "Waiting for your decision" : Model.Case.Status)</span></div>
    <dl class="ui-facts">
        <div><dt>Recommended supplier</dt><dd>@(Model.Case.Winner ?? "—")</dd></div>
        <div><dt>Unified report</dt><dd>v@(Model.ReportVersion) · @Model.ReportStatus</dd></div>
        <div><dt>Tender status</dt><dd>@Model.Case.Status</dd></div>
        <div><dt>Recorded decisions</dt><dd>@(Model.CanSeeCounts ? $"{Model.Case.Approvals} approve of {Model.Case.Votes}" : "Hidden until you vote")</dd></div>
    </dl>
    <ol class="ui-timeline">
        <li><strong>1. Review the results</strong><span><a data-no-modal asp-action="ReviewEvaluation" asp-route-id="@Model.Case.TenderId">Open the evaluation summary</a></span></li>
        <li><strong>2. Read the signed report</strong><span>The PDF, the evaluation committee signatures and the Sourcing Manager's signature are shown on the report page.</span></li>
        <li><strong>3. Vote and sign</strong><span>Approve or reject with a written justification. Three of four approvals are required; the Manager then forwards the decision to the Sourcing Officer.</span></li>
    </ol>
    <div class="pg-actions">
        @if (Model.Case.ReportId != 0) { <a class="pg-btn pg-btn-primary" data-no-modal asp-area="TopCommittee" asp-controller="Reports" asp-action="Review" asp-route-id="@Model.Case.ReportId">@(Model.Case.AwaitingMyVote ? "Open the report to vote and sign" : "Open the signed report")</a> }
        <a class="pg-btn" asp-action="Decision" asp-route-id="">Back</a>
    </div>
</section>
