@model RoundSelection
@{
    var voting = Model.TargetAction == "Decision";
    var listing = Model.Listing;
    ViewData["Title"] = voting ? "Voting" : "Evaluation Summary";
    ViewData["WorkspaceSection"] = voting ? "Voting" : "Evaluation Summary";
    ViewData["Description"] = voting
        ? "Choose an assigned round to view the members' votes. Voting is available only when the round is eligible and you have not already voted."
        : "Choose an assigned round to review its evaluation, recommendation and supporting documents.";
}
<div class="tc-live" data-live-root>
<partial name="_PageHeader" />
<partial name="_Messages" />
<form asp-action="@Model.TargetAction" asp-route-id="" method="get" class="pg-toolbar tc-live-toolbar" data-live-form>
<div class="tc-live-field"><label for="tc-live-search">Tender Search</label><input id="tc-live-search" name="search" type="search" maxlength="200" value="@listing.Search" placeholder="Tender title or reference (e.g. T-4)" aria-controls="tc-live-results" autocomplete="off" /></div>
<div class="tc-live-field"><label for="tc-live-status">Round Status</label><select id="tc-live-status" name="status" aria-controls="tc-live-results"><option value="">All statuses</option>
@foreach (var status in Enum.GetValues<CommitteeRoundStatus>()) { <option value="@status" selected="@(listing.Status == status)">@CommitteeDisplay.Status(status)</option> }
</select></div>
</form>
<p class="tc-live-status" role="status" aria-live="polite" aria-atomic="true" data-live-status></p>
<div id="tc-live-results" data-live-results><partial name="_RoundResults" model="Model" /></div>
</div>
@section Styles { <partial name="_TopStyles" /><partial name="_LiveFiltersStyles" /> }
@section Scripts { <partial name="_LiveFiltersScripts" /> }
