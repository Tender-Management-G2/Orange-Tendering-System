<style>
.tc-live{display:flex;flex-direction:column;gap:18px;min-width:0}.tc-live>*{min-width:0}.tc-live .pg-table td:last-child{white-space:nowrap}.tc-live .pg-table td:last-child .pg-btn{white-space:nowrap;flex-shrink:0;padding-inline:12px}.tc-live .tc-live-toolbar{display:grid;grid-template-columns:minmax(220px,2fr) minmax(170px,1fr);gap:16px;align-items:end;max-width:780px}.tc-live .tc-live-field{display:grid;gap:7px;min-width:0}.tc-live .tc-live-field label{font-size:12px;font-weight:600;color:var(--ws-muted,#596071)}.tc-live .tc-live-toolbar input,.tc-live .tc-live-toolbar select{width:100%;max-width:none;min-width:0;height:42px;background:var(--ws-surface,#fff);color:var(--ws-ink,#17212e);border:1px solid var(--ws-rule,#cbd1dc);border-radius:10px;padding:9px 12px;font:inherit;font-size:13px}.tc-live .tc-live-toolbar input:focus-visible,.tc-live .tc-live-toolbar select:focus-visible{outline:2px solid #ff7900;outline-offset:2px}.tc-live .tc-live-status{margin:0;font-size:12px;line-height:1.5;color:var(--ws-muted,#596071);min-height:18px}.tc-live .tc-live-status[data-error]{color:var(--ws-accent,#ad4900)}.tc-live [data-live-results]{min-width:0}.tc-live [data-live-results][aria-busy=true]{opacity:.65}.tc-live [data-live-results]>.pg-panel{margin:0}
