@page
@model PendingApprovalModel
@{
    var faceDone = Model.FaceTemplateCount > 0;
    var passkeyDone = Model.PasskeyCount > 0;
    // Onboarding needs one enrolled identity method: a face or a device passkey. Either one completes it.
    var done = faceDone || passkeyDone;
    ViewData["Title"] = done ? (Model.CompanyApproved ? "Supplier identity — Sign in" : "Pending administrator approval") : "Identity enrollment";
}
<section class="as-shell" id="authStudio" data-chapter="identity" data-face-done="@(faceDone ? "true" : "false")" data-passkey-done="@(passkeyDone ? "true" : "false")" data-approved="@(Model.CompanyApproved ? "true" : "false")">
    @* LEFT: the Identity Station. Decorative: every real status is repeated as text in the form. *@
    <div class="as-stage" id="asStage" data-shot="wide" data-caption="1">
        <div class="as-stage-ui" aria-hidden="true">
            <p class="as-chapter"><span class="as-sq"></span>Supplier Genesis</p>
            <p class="as-tagline">Every great partnership begins with a small idea.</p>
        </div>
        @* The live camera, seen through the Paper Iris. It opens only after Start face enrollment. *@
        <div class="as-camera bio-hidden" id="facePanel">
            <video id="faceVideo" playsinline muted autoplay aria-label="Live camera preview"></video>
        </div>
        <p class="sr-only" data-scene-status></p>
    </div>

    @* RIGHT: a normal form. *@
    <div class="as-panel">
        <div class="as-panel-inner" id="bio-root" data-return-url="" data-face-complete="@(faceDone ? "true" : "false")" data-enrolled-url="/Identity/Account/PendingApproval?faceRegistered=true">
            @Html.AntiForgeryToken()
            <p class="as-brand"><span class="as-brand-mark" aria-hidden="true"></span><span class="as-brand-name">Sourcing &amp; Tender Management</span></p>
            <p class="as-kicker">Supplier registration · Identity</p>
            <h1 class="as-title">@(done ? (Model.CompanyApproved ? "Your identity is ready." : "Pending Administrator Approval") : "Enroll your identity")</h1>
            <p class="as-lede">@(done
                ? (Model.CompanyApproved
                    ? "Your identity has a place. Sign in with your email and password, then confirm with your face or passkey."
                    : "Your identity has a place. " + (faceDone ? "Your face samples are linked to your account. " : "Your device passkey is linked to your account. ") + "Your company is still awaiting administrator review.")
                : "Let's bring your identity to life. Choose one method: Face Recognition with your camera, or Fingerprint / Device Passkey with this device or your phone. One is enough.")</p>

            <ol class="as-steps" aria-label="Registration progress">
                <li class="is-done"><span class="as-n">1</span><span class="as-t">Application</span></li>
                <li class="is-done"><span class="as-n">2</span><span class="as-t">Email</span></li>
                <li class="@(done ? "is-done" : "is-current")" aria-current="@(done ? null : "step")"><span class="as-n">3</span><span class="as-t">Identity</span></li>
                <li class="@(done ? "is-current" : "")" aria-current="@(done ? "step" : null)"><span class="as-n">4</span><span class="as-t">@(Model.CompanyApproved ? "Sign in" : "Approval")</span></li>
            </ol>

            @if (faceDone)
            {
                <p class="as-status is-success" role="status">Face samples registered for this account.</p>
            }
            @if (passkeyDone)
            {
                <p class="as-status is-success" role="status">Device passkey registered for this account (@Model.PasskeyCount passkey(s) registered.)</p>
            }
            <div id="bio-status" class="as-status bio-status" role="status" aria-live="polite"></div>

            <div class="as-field">
                <label for="bioPassword">Current password</label>
                <input id="bioPassword" type="password" autocomplete="current-password" />
                <p class="as-fine">Your password is checked before the camera or the device prompt opens.</p>
            </div>

            <div class="as-cards" role="group" aria-label="Identity methods">
                <section class="as-card" aria-labelledby="faceCardTitle">
                    <h2 class="as-card-title" id="faceCardTitle">Face Recognition</h2>
                    <p class="as-fine">The Paper Iris opens on your live camera. Hold still for 7 seconds in good light.</p>
                    <div class="as-actions">
                        @if (faceDone && Model.CompanyApproved)
                        {
                            <button id="btnFaceSetupLogin" type="button" class="as-primary">Verify face and enter workspace</button>
                        }
                        <button id="btnFaceEnroll" type="button" class="@(faceDone ? "as-secondary" : "as-primary")">@(faceDone ? "Replace face samples" : "Start face enrollment")</button>
                    </div>
                    <div class="as-actions" id="faceActions" hidden>
                        <button type="button" id="btnFaceCancel" class="as-secondary" data-bio-keep>Cancel and close the camera</button>
                    </div>
                    <p id="faceHint" class="as-hint" role="status" aria-live="polite">Use a well-lit place and keep only one person in view.</p>
                </section>
                <section class="as-card" aria-labelledby="passkeyCardTitle">
                    <h2 class="as-card-title" id="passkeyCardTitle">Fingerprint / Device Passkey</h2>
                    <p class="as-fine">Device passkey: your device asks for its fingerprint (or its face or PIN). To use your phone, choose "Use a phone or tablet" in the browser prompt and scan the QR code the browser shows. The application never receives your fingerprint and cannot see which method your device used.</p>
                    <div class="as-field">
                        <label for="passkeyLabel">Device name</label>
                        <input id="passkeyLabel" type="text" maxlength="60" placeholder="My phone" />
                    </div>
                    <div class="as-actions">
                        <button id="btnPasskeyRegister" type="button" class="@(done ? "as-secondary" : "as-primary")">@(passkeyDone ? "Add another device passkey" : "Register a device passkey")</button>
                    </div>
                    <p class="as-fine">@(passkeyDone ? Model.PasskeyCount + " passkey(s) registered." : "No device passkey registered.") This uses the password above.</p>
                </section>
            </div>

            <p class="as-fine">Your camera image stays on this device. Face measurements are sent to this application and stored encrypted. This academic face check has no liveness or spoof protection, so it is not production-grade biometric proof.</p>

            <p class="as-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Return to homepage</a>
                <a asp-page="./Login">Go to sign in</a>
            </p>
            <form asp-page="./Logout" method="post"><button type="submit" class="as-quiet">Sign out</button></form>
        </div>
    </div>
</section>
@section Styles {
    <partial name="_AuthStudioHead" />
}
@section Scripts {
    <script src="~/js/biometric.js" asp-append-version="true"></script>
    <script type="module" src="~/js/auth-studio/station-page.js" asp-append-version="true"></script>
}
