@page
@model PendingApprovalModel
@{
    var faceDone = Model.FaceTemplateCount > 0;
    var passkeyDone = Model.PasskeyCount > 0;
    ViewData["Title"] = faceDone ? (Model.CompanyApproved ? "Supplier dossier — Sign in with biometrics" : "Supplier dossier — Pending approval") : "Face enrollment — The Living Dossier";
}
<section class="ld-shell ld-shell--face">
    <div class="ld-interface" id="bio-root" data-return-url="" data-cinematic-face="true" data-face-complete="@(faceDone ? "true" : "false")" data-enrolled-url="/Identity/Account/PendingApproval?faceRegistered=true">
        @Html.AntiForgeryToken()
        <div class="ld-brand"><span class="ld-brand-symbol">◈</span><div><strong>Supplier registration</strong><small>THE LIVING DOSSIER</small></div></div>
        <div class="ld-intro">
            <span class="ld-kicker">Identity · final setup</span>
            <h1>@(faceDone ? "Your identity has a place." : "Let's bring your identity to life.")</h1>
            <p>@(faceDone ? (Model.CompanyApproved ? "Your face samples are linked to your account. Sign out, then use face recognition or a device passkey to enter your supplier workspace." : "Your face samples are linked to your account. Your company is still awaiting administrator review.") : "Use your camera to add your face to your company dossier.")</p>
        </div>
        <ol class="ld-progress" aria-label="Registration progress">
            <li class="is-done"><span>01</span> Company dossier</li>
            <li class="is-done"><span>02</span> Verify email</li>
            <li class="@(faceDone ? "is-done" : "is-current")"><span>03</span> Face enrollment</li>
            <li class="@(faceDone ? "is-current" : "")"><span>04</span> @(Model.CompanyApproved ? "Biometric sign-in" : "Pending approval")</li>
        </ol>
        @if (faceDone)
        {
            <div class="ld-face-success" role="status">✓ Face samples registered for this account.</div>
        }
        <div id="bio-status" class="bio-status" role="status" aria-live="polite"></div>
        <div class="ld-face-controls">
            <label for="bioPassword">Current password</label>
            <input id="bioPassword" type="password" autocomplete="current-password" />
            <small>Your password is checked before the camera opens.</small>
            <button id="btnFaceEnroll" type="button" class="primary">@(faceDone ? "Replace face samples" : "Start face enrollment")</button>
            <div id="faceHint" class="ld-face-hint" role="status" aria-live="polite">Position your face inside the frame. Use a well-lit environment and keep one person in view.</div>
        </div>
        <p class="ld-privacy">Your camera image stays on this device. Face measurements are sent to this application and stored encrypted. This academic implementation does not have spoof or liveness protection, so it should not be treated as production-grade biometric proof.</p>
        @if (faceDone)
        {
            <div class="ld-face-passkey">
                <h2>Device passkey <small>Optional setup</small></h2>
                <p>Use your device's available authenticator for another sign-in method. A fingerprint is offered only if your device supports it.</p>
                <label for="passkeyLabel">Device name</label>
                <input id="passkeyLabel" type="text" maxlength="60" placeholder="My device" />
                <button id="btnPasskeyRegister" type="button">@(passkeyDone ? "Add another device passkey" : "Register a device passkey")</button>
                <small>@(passkeyDone ? Model.PasskeyCount + " passkey(s) registered." : "No device passkey registered.") This uses the password above.</small>
                <small>Fingerprint-specific enrollment — Coming Soon. A device passkey may use a fingerprint when your authenticator offers it.</small>
            </div>
        }
        <div class="ld-footer-links"><a asp-area="" asp-controller="Home" asp-action="Index">Return to homepage</a><a asp-page="./Login">Go to sign in</a></div>
        <form asp-page="./Logout" method="post"><button type="submit" class="ld-secondary">Sign out</button></form>
    </div>
    <aside class="ld-visual" aria-label="Paper portrait and company dossier">
        <partial name="_LivingDossier" model='"face"' />
    </aside>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/biometric.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/living-dossier.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script>
    <script src="~/js/living-dossier-motion.js" asp-append-version="true"></script>
    <script src="~/js/biometric.js" asp-append-version="true"></script>
}
