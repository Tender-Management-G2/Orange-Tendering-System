@page
@model ForgotPasswordModel
@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Forgot Password (ASP.NET Core Identity)

DEVELOPER OWNER: Ahmad
MODULE: Authentication
TRELLO TASK: Forgot / Reset Password
TRELLO URL: https://trello.com/c/uLN8NsSX

PURPOSE:
Request a password-reset link by email.

BUSINESS ACCESS:
Anonymous visitors with an existing account.

DEPENDENCIES:
AspNetUsers, UserManager, IEmailSender, ResetPassword page.

STATUS:
SMTP sender is implemented; each deployment must configure runtime credentials.
===========================================================
*@
@{
    ViewData["Title"] = "Forgot your password?";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">ACCOUNT RECOVERY</span>
        <h1>Forgot your password?</h1>
        <p>Enter your account email to request a time-limited reset link.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
            <button type="submit" class="primary">Send Reset Link →</button>
        </form>
        <a class="auth-link" asp-page="./Login">Back to sign in ↗</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
