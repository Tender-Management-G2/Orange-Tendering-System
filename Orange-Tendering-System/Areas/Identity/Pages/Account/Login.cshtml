@page
@model LoginModel
@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Sign In (ASP.NET Core Identity login)

DEVELOPER OWNER: Ahmad
MODULE: Authentication & Biometrics
TRELLO TASK: User Login & Role Redirect
  (also hosts the entry points for "Fingerprint Registration &
  Login" and "Face Registration & Recognition Login")
TRELLO URL: Not provided — add from the Trello board

PURPOSE:
Email/password sign-in for every user (employees and approved
suppliers), using the existing Identity LoginModel unchanged.

BUSINESS ACCESS:
Anonymous visitors.

FUTURE IMPLEMENTATION:
- After sign-in, redirect to the user's workspace by role
  (see WorkspaceController / Workspace/Index) instead of "/".
- Block suppliers whose Supplier.Status is not Approved, and
  users with ApplicationUser.IsActive = false.
- Fingerprint and face sign-in: replace the disabled buttons
  below with a real, demonstrable verification flow. Never
  accept a static photo as live face verification.
- Audit failed and successful sign-ins (without secrets).

DEPENDENCIES:
AspNetUsers, ApplicationUser, Supplier, SignInManager,
Biometrics pages, AuditLogs.

STATUS:
PASSWORD SIGN-IN WORKS (existing Identity). Role redirect and
biometric sign-in are NOT IMPLEMENTED.

IMPORTANT:
Do not add a second authentication system next to Identity.
===========================================================
*@
@{
    ViewData["Title"] = "Sign In";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">YOUR PROCUREMENT WORKSPACE</span>
        <h1>Sign In</h1>
        <p>Use an account provisioned for this system. Supplier accounts require Admin approval.</p>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
            <label class="auth-check"><input asp-for="Input.RememberMe" /> @Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            <button id="login-submit" type="submit" class="primary">Sign In →</button>
        </form>

        @* Biometric entry points — Ahmad. Disabled until a real verification flow exists. *@
        <div class="auth-biometric" aria-label="Biometric sign-in">
            <small>Biometric sign-in (not implemented yet)</small>
            <button type="button" class="overview" disabled title="Fingerprint sign-in is not implemented yet">Sign in with fingerprint</button>
            <button type="button" class="overview" disabled title="Face recognition sign-in is not implemented yet">Sign in with face recognition</button>
        </div>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="overview" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                }
            </form>
        }

        <a class="auth-link" id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
        <a class="auth-link" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a supplier ↗</a>
        <a class="auth-link" id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
