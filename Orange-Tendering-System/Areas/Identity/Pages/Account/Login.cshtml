@page
@model LoginModel
@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Sign In (ASP.NET Core Identity login)

DEVELOPER OWNER: Ahmad
MODULE: Authentication & Biometrics
TRELLO TASK: User Login & Role Redirect
  (also hosts the entry points for "Fingerprint Registration &
  Login" and "Face Registration & Recognition Login")
TRELLO URL: https://trello.com/c/WoTewqHd

PURPOSE:
One Identity email/password sign-in for employees and approved suppliers.

BUSINESS ACCESS:
Anonymous visitors.

BIOMETRIC SIGN-IN:
- Fingerprint (WebAuthn passkey) and face recognition (live camera
  challenge, password required) are wired to BiometricsController and
  wwwroot/js/biometric.js. They issue the same Identity cookie.

DEPENDENCIES:
AspNetUsers, ApplicationUser, Supplier, SignInManager,
Biometrics pages, AuditLogs.

STATUS:
Identity sign-in, role redirect, account-state checks, and lockout are implemented.
Biometric sign-in is implemented (see Controllers/BiometricsController.cs).

IMPORTANT:
Do not add a second authentication system next to Identity.
===========================================================
*@
@{
    ViewData["Title"] = "Sign In";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">YOUR PROCUREMENT WORKSPACE</span>
        <h1>Sign In</h1>
        <p>Use an account provisioned for this system. Supplier accounts require Admin approval.</p>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
            <label class="auth-check"><input asp-for="Input.RememberMe" /> @Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            <button id="login-submit" type="submit" class="primary">Sign In →</button>
        </form>

        @* Biometric sign-in (Ahmad): Identity cookie issued by BiometricsController after a verified fingerprint passkey
           (WebAuthn) only. Camera face recognition is not an authentication factor. *@
        <div class="auth-biometric" id="bio-root" data-return-url="@Model.ReturnUrl" aria-label="Biometric sign-in">
            <div id="bio-status" class="bio-status" role="status" aria-live="polite"></div>
            <button type="button" id="btnPasskeyLogin" class="overview">Sign in with fingerprint</button>
            <button type="button" id="btnFaceLogin" data-bio-disabled="true" class="overview" disabled title="Face Login is disabled pending secure server-verifiable identity proof">Sign in with face recognition</button>
            <small>Passkeys use your device's authenticator (fingerprint, PIN or device face unlock). This application does not receive physical fingerprint data. Camera-based Face Login is disabled until secure server-verifiable proof is implemented and verified.</small>
            <div id="facePanel" class="bio-face-panel bio-hidden">
                <video id="faceVideo" playsinline muted autoplay></video>
                <div id="faceHint" class="bio-face-hint"></div>
            </div>
        </div>

        <a class="auth-link" id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
        <a class="auth-link" asp-page="./Register">Register as a supplier ↗</a>
        <a class="auth-link" id="resend-confirmation" asp-page="./VerifyEmail">Verify supplier email</a>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/biometric.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/biometric.js" asp-append-version="true"></script>
}
