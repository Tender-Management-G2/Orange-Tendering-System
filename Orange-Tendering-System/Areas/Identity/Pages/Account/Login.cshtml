@page
@model LoginModel
@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Sign In (ASP.NET Core Identity login)

DEVELOPER OWNER: Ahmad
MODULE: Authentication & Biometrics
TRELLO TASK: User Login & Role Redirect
  (also hosts the entry points for "Fingerprint Registration &
  Login" and "Face Registration & Recognition Login")
TRELLO URL: https://trello.com/c/WoTewqHd

PURPOSE:
One Identity email/password sign-in for employees and approved suppliers.

BUSINESS ACCESS:
Anonymous visitors.

BIOMETRIC SIGN-IN:
- Face recognition (email + live camera challenge) and fingerprint
  (WebAuthn passkey, demo) are wired to BiometricsController and
  wwwroot/js/biometric.js. They issue the same Identity cookie.
- An Approved supplier who has enrolled face/passkey cannot use the
  password form (Login.cshtml.cs); pending suppliers can, to reach
  Pending Approval and finish face setup.

DEPENDENCIES:
AspNetUsers, ApplicationUser, Supplier, SignInManager,
Biometrics pages, AuditLogs.

STATUS:
Identity sign-in, role redirect, account-state checks, and lockout are implemented.
Biometric sign-in is implemented (see Controllers/BiometricsController.cs).

IMPORTANT:
Do not add a second authentication system next to Identity.
===========================================================
*@
@{
    ViewData["Title"] = "Sign In";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">YOUR PROCUREMENT WORKSPACE</span>
        <h1>Sign In</h1>
        <p>Employees sign in with their email and password. Approved suppliers sign in with face recognition.</p>

        @* Supplier biometric sign-in (Ahmad): BiometricsController verifies the live face (or the WebAuthn passkey)
           and issues the same Identity cookie. Only Approved supplier companies can sign in this way. *@
        <fieldset class="auth-fieldset auth-biometric" id="bio-root" data-return-url="@Model.ReturnUrl" aria-label="Supplier sign-in">
            <legend>Suppliers</legend>
            <label for="faceEmail">Supplier email</label>
            <input id="faceEmail" type="email" autocomplete="username" />
            <div id="bio-status" class="bio-status" role="status" aria-live="polite"></div>
            <button type="button" id="btnFaceLogin" class="primary">Sign in with face recognition</button>
            <div id="facePanel" class="bio-face-panel bio-hidden">
                <video id="faceVideo" playsinline muted autoplay></video>
                <div id="faceHint" class="bio-face-hint"></div>
            </div>
            <button type="button" id="btnPasskeyLogin" class="overview">Fingerprint / passkey (demo)</button>
            <small>The camera picture stays on this device; only face measurements are checked. The passkey option uses your device's own fingerprint, face unlock or PIN, or a phone via QR code; this site cannot tell which one was used.</small>
            <small>Company still awaiting approval? Sign in below with your password to see your application.</small>
        </fieldset>

        <form id="account" method="post">
            <fieldset class="auth-fieldset">
                <legend>Employees (and pending suppliers)</legend>
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
                <label class="auth-check"><input asp-for="Input.RememberMe" /> @Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                <button id="login-submit" type="submit" class="primary">Sign In →</button>
            </fieldset>
        </form>

        <a class="auth-link" id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
        <a class="auth-link" asp-page="./Register">Register as a supplier ↗</a>
        <a class="auth-link" id="resend-confirmation" asp-page="./VerifyEmail">Verify supplier email</a>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/biometric.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/biometric.js" asp-append-version="true"></script>
}
