@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="as-shell" id="authStudio" data-chapter="login" data-step="credentials">
    @* LEFT: the animated world. Decorative: every real status is repeated as text in the form. *@
    <div class="as-stage" id="asStage" data-shot="wide" data-caption="1">
        <div class="as-stage-ui" aria-hidden="true">
            <p class="as-chapter"><span class="as-sq"></span>Orange Signal</p>
            <p class="as-tagline">Every connection begins with a signal.</p>
        </div>
        <div class="as-stage-fallback" data-stage-fallback hidden></div>
        @* The live camera of Face ID. It opens only after the supplier chooses Face ID and continues. *@
        <div class="as-camera bio-hidden" id="facePanel">
            <video id="faceVideo" playsinline muted autoplay aria-label="Live camera preview"></video>
        </div>
        <p class="sr-only" data-scene-status></p>
    </div>

    @* RIGHT: a normal form. It never waits for the illustration. *@
    <div class="as-panel">
        <div class="as-panel-inner" id="bio-root" data-return-url="@Model.ReturnUrl" data-expires-in="@Model.BiometricStepSeconds">
            <p class="as-brand"><span class="as-brand-mark" aria-hidden="true"></span><span class="as-brand-name">Sourcing &amp; Tender Management</span></p>

            <div id="signInCredentials">
                <p class="as-kicker">Welcome back</p>
                <h1 class="as-title">Sign in to your workspace</h1>
                <p class="as-lede" id="signInLede"><span class="as-lede-tagline">Every connection begins with a signal. </span><span id="signInLedeText">Choose how you want to sign in.</span></p>

                <form id="account" method="post" novalidate data-fv-skip>
                    <div id="signInMessage" class="as-summary" role="alert"></div>
                    <div asp-validation-summary="ModelOnly" class="as-summary" role="alert"></div>
                    @* A preference only: the server checks it against the account's real role. *@
                    <fieldset class="as-account" id="accountType">
                        <legend class="as-account-legend">I am signing in as</legend>
                        <label class="as-seg"><input type="radio" name="Input.AccountType" value="supplier" checked="@(Model.Input.AccountType != "other")" /><span>Supplier</span></label>
                        <label class="as-seg"><input type="radio" name="Input.AccountType" value="other" checked="@(Model.Input.AccountType == "other")" /><span>Other User</span></label>
                    </fieldset>

                    @* Every account chooses one method first (owner decision 2026-11-16; Other User too since 2026-11-17). *@
                    <fieldset class="as-account as-account--three" id="signInMethods">
                        <legend class="as-account-legend">Sign in with</legend>
                        <label class="as-seg"><input type="radio" name="method" value="password" checked /><span><svg class="as-seg-icon" viewBox="0 0 48 48" aria-hidden="true"><rect x="9" y="21" width="30" height="20" rx="4" /><path d="M16 21v-6a8 8 0 0 1 16 0v6M24 29v5" /></svg>Email &amp; Password</span></label>
                        <label class="as-seg"><input type="radio" name="method" value="face" /><span><svg class="as-seg-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 16V11a3 3 0 0 1 3-3h5M32 8h5a3 3 0 0 1 3 3v5M40 32v5a3 3 0 0 1-3 3h-5M16 40h-5a3 3 0 0 1-3-3v-5" /><path d="M18 19v3M30 19v3M24 20v8h-2M18.5 32c3.200 2.600 7.800 2.600 11 0" /></svg>Face ID</span></label>
                        <label class="as-seg"><input type="radio" name="method" value="fingerprint" /><span><svg class="as-seg-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M14 40c2.6-5 3.6-10.4 3.6-16a6.4 6.4 0 0 1 12.8 0c0 6.8-1.2 12.8-3.8 18M24 24c0 6.4-1.2 12-4 17M11 33c1.2-3 1.6-5.8 1.6-9a11.4 11.4 0 0 1 22.8 0c0 4.6-.5 8.8-1.6 12.8M9.5 19.5A15.5 15.5 0 0 1 24 8.5c4 0 7.7 1.5 10.5 4M38.5 18c.6 1.9 1 3.9 1 6" /></svg>Fingerprint</span></label>
                    </fieldset>

                    <div class="as-field">
                        <label asp-for="Input.Email">Email address</label>
                        <input asp-for="Input.Email" autocomplete="username" inputmode="email" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="as-field-error"></span>
                    </div>
                    <div id="passwordFields">
                        <div class="as-field">
                            <label asp-for="Input.Password">Password</label>
                            <div class="as-with-toggle">
                                <input asp-for="Input.Password"  aria-required="true" />
                                <button type="button" class="as-reveal" data-reveal="Input_Password" aria-pressed="false" data-bio-keep>Show</button>
                            </div>
                            <span asp-validation-for="Input.Password" class="as-field-error"></span>
                        </div>
                        <label class="as-check"><input asp-for="Input.RememberMe" /> <span>Remember me on this device</span></label>
                    </div>
                    <div class="as-actions">
                        <button id="login-submit" type="submit" class="as-primary">Sign in <span aria-hidden="true">→</span></button>
                    </div>
                </form>

                <div id="bio-status" class="as-status bio-status" role="status" aria-live="polite"></div>
                <p id="faceHint" class="as-hint" role="status" aria-live="polite"></p>
                <div class="as-actions" id="faceActions" hidden>
                    <button type="button" id="btnFaceCancel" class="as-secondary" data-bio-keep>Cancel and close the camera</button>
                </div>

                @* Fingerprint with a phone: a QR code from this site. The phone approves only after the number below and its
                   own fingerprint check; this browser then receives the session (Controllers/PhonePasskeyController.cs). *@
                <div class="pp pp-panel" id="phoneSignIn" hidden>
                    <div data-pp-view="loading" class="pp-wait"><span class="pp-spinner" aria-hidden="true"></span><span>Creating a QR code…</span></div>
                    <div data-pp-view="qr" hidden>
                        <div class="pp-qr">
                            <img id="ppLoginQr" class="pp-qr-img" alt="QR code that opens the sign-in approval on your phone" width="196" height="196" />
                            <div>
                                <ol class="pp-steps">
                                    <li>Scan the code with your phone's camera and tap the link.</li>
                                    <li>Type this number on your phone:</li>
                                </ol>
                                <p class="pp-code" aria-live="polite">Number <strong id="ppLoginCode">--</strong></p>
                                <p class="pp-fine">Then confirm with your fingerprint.</p>
                            </div>
                        </div>
                        <p class="pp-wait" role="status" aria-live="polite">
                            <span class="pp-spinner" aria-hidden="true"></span>
                            <span class="pp-wait-text" id="ppLoginWait">Waiting for your phone…</span>
                            <span class="pp-timer" aria-label="Time left"><span id="ppLoginTimer"></span></span>
                        </p>
                        <div class="pp-row"><button type="button" id="btnPhoneLoginCancel" class="pp-link" data-bio-keep>Cancel</button></div>
                    </div>
                    <div data-pp-view="ended" hidden>
                        <p class="pp-result pp-result--warn" id="ppLoginEnded" role="status"></p>
                        <div class="pp-row"><button type="button" id="btnPhoneLoginRetry" class="pp-btn pp-btn--secondary" data-bio-keep>Create a new QR code</button></div>
                    </div>
                </div>
                <p class="as-fine pp" id="phoneQrOffer" hidden>Fingerprint is on your phone? <button type="button" id="btnPhoneQrLogin" class="pp-link" data-bio-keep>Show a QR code for my phone</button></p>

                @* Started by wwwroot/js/supplier-login.js once the server opened the identity step for the typed email;
                   biometric.js (face) and phone-passkey.js (fingerprint) do the actual check. *@
                <button type="button" id="btnFaceLogin" hidden tabindex="-1" aria-hidden="true">Face ID</button>
                <button type="button" id="btnPasskeyStep" hidden tabindex="-1" aria-hidden="true">Fingerprint</button>

                <p class="as-fine" id="methodFine" hidden></p>
                <noscript><p class="as-note">Face ID and Fingerprint need JavaScript. Enable it, or sign in with Email &amp; Password.</p></noscript>

                <p class="as-links">
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                    <a asp-page="./Register">Register as a supplier</a>
                    <a id="resend-confirmation" asp-page="./VerifyEmail">Verify supplier email</a>
                </p>
            </div>
        </div>
    </div>
</section>
@section Styles {
    <partial name="_AuthStudioHead" />
    <link rel="stylesheet" href="~/css/phone-passkey.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/biometric.js" asp-append-version="true"></script>
    <script src="~/js/phone-passkey.js" asp-append-version="true"></script>
    <script src="~/js/supplier-login.js" asp-append-version="true"></script>
    <script type="module" src="~/js/auth-studio/login-page.js" asp-append-version="true"></script>
}
