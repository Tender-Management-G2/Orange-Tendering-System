@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in — The Living Dossier";
}
<section class="ld-shell ld-shell--login">
    <div class="ld-interface">
        <div class="ld-brand"><span class="ld-brand-symbol">◈</span><div><strong>Sourcing &amp; Tender Management</strong><small>THE LIVING DOSSIER</small></div></div>
        <div class="ld-intro">
            <span class="ld-kicker">Welcome back</span>
            <h1>Open your dossier.</h1>
            <p>Choose the sign-in method for your account.</p>
        </div>
        <div class="ld-login-option" id="bio-root" data-return-url="@Model.ReturnUrl">
            @Html.AntiForgeryToken()
            <span class="ld-option-number">01 / SUPPLIER</span>
            <h2>Recognize your identity</h2>
            <p>Approved suppliers can sign in with their enrolled face or a registered device passkey.</p>
            <div class="ld-fields"><div class="ld-wide"><label for="faceEmail">Supplier email</label><input id="faceEmail" type="email" autocomplete="username" /></div></div>
            <div id="bio-status" class="bio-status" role="status" aria-live="polite"></div>
            <div class="ld-login-actions">
                <button type="button" id="btnFaceLogin" class="primary">Open with face recognition →</button>
                <button type="button" id="btnPasskeyLogin" class="ld-secondary">Use a device passkey</button>
            </div>
            <div id="faceHint" class="ld-face-hint" role="status" aria-live="polite">Your camera opens only after you choose face recognition.</div>
            <small class="ld-login-note">The camera image remains on your device. This academic face matching system has no spoof or liveness protection.</small>
        </div>
        <form id="account" method="post" class="ld-login-option">
            <span class="ld-option-number">02 / EMPLOYEE &amp; SUPPLIER SETUP</span>
            <h2>Continue with a password</h2>
            <p>Employees use their password. Suppliers awaiting setup or approval can return to their application here.</p>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="ld-fields">
                <div class="ld-wide"><label asp-for="Input.Email">Email</label><input asp-for="Input.Email" autocomplete="username" aria-required="true" /><span asp-validation-for="Input.Email" class="field-error"></span></div>
                <div class="ld-wide"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" autocomplete="current-password" aria-required="true" /><span asp-validation-for="Input.Password" class="field-error"></span></div>
            </div>
            <label class="ld-remember"><input asp-for="Input.RememberMe" /> @Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            <div class="ld-actions"><button id="login-submit" type="submit" class="primary">Sign in →</button></div>
        </form>
        <div class="ld-footer-links">
            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
            <a asp-page="./Register">Register as a supplier</a>
            <a id="resend-confirmation" asp-page="./VerifyEmail">Verify supplier email</a>
        </div>
    </div>
    <aside class="ld-visual" aria-label="An origami identity above an open company dossier"><partial name="_LivingDossier" model='"login"' /></aside>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/biometric.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/living-dossier.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script>
    <script src="~/js/living-dossier-motion.js" asp-append-version="true"></script>
    <script src="~/js/biometric.js" asp-append-version="true"></script>
}
