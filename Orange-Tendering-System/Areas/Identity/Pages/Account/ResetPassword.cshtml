@page
@model ResetPasswordModel
@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Reset Password (ASP.NET Core Identity)

DEVELOPER OWNER: Ahmad
MODULE: Authentication
TRELLO TASK: Forgot / Reset Password
TRELLO URL: https://trello.com/c/uLN8NsSX

PURPOSE:
Set a new password using the code from the reset email.

BUSINESS ACCESS:
Anonymous visitors holding a valid reset code.

DEPENDENCIES:
AspNetUsers, UserManager, ForgotPassword page, AuditLogs.

STATUS:
Identity reset token validation and password-change audit are implemented.
===========================================================
*@
@{
    ViewData["Title"] = "Reset password";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">ACCOUNT RECOVERY</span>
        <h1>Reset your password</h1>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            <button type="submit" class="primary">Reset Password →</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
