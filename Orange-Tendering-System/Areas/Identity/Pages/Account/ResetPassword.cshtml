@page
@model ResetPasswordModel
@{ ViewData["Title"] = "Reset password — The Living Dossier"; }
<section class="ld-shell ld-shell--verify">
    <div class="ld-interface">
        <div class="ld-brand"><span class="ld-brand-symbol">◈</span><div><strong>Sourcing &amp; Tender Management</strong><small>THE LIVING DOSSIER</small></div></div>
        <div class="ld-intro"><span class="ld-kicker">Account recovery</span><h1>A fresh beginning.</h1><p>Choose a new password for your account.</p></div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="ld-fields">
                <div class="ld-wide"><label asp-for="Input.Email"></label><input asp-for="Input.Email" autocomplete="username" aria-required="true" /><span asp-validation-for="Input.Email" class="field-error"></span></div>
                <div class="ld-wide"><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="new-password" aria-required="true" /><span asp-validation-for="Input.Password" class="field-error"></span></div>
                <div class="ld-wide"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" /><span asp-validation-for="Input.ConfirmPassword" class="field-error"></span></div>
            </div>
            <div class="ld-actions"><button type="submit" class="primary">Reset password →</button></div>
        </form>
        <div class="ld-footer-links"><a asp-page="./Login">Back to sign in</a></div>
    </div>
    <aside class="ld-visual" aria-label="A private letter beside the dossier"><partial name="_LivingDossier" model='"reset"' /></aside>
</section>
@section Styles { <link rel="stylesheet" href="~/css/living-dossier.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script><script src="~/js/living-dossier-motion.js" asp-append-version="true"></script> }
