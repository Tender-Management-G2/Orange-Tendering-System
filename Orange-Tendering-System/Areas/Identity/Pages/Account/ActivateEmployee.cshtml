@page
@model ActivateEmployeeModel
@{
    ViewData["Title"] = "Activate employee account";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">EMPLOYEE ACCESS</span>
        <h1>Activate your account</h1>
        @if (Model.Activated)
        {
            <p role="status">Your password is set. You can now sign in.</p>
            <a class="auth-link" asp-page="./Login">Sign in</a>
        }
        else
        {
            <p>Choose a private password to activate your employee account.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <input asp-for="Input.Email" type="hidden" />
                <input asp-for="Input.Code" type="hidden" />
                <label asp-for="Input.Password">New password</label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                <button type="submit" class="primary">Activate account →</button>
            </form>
        }
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
