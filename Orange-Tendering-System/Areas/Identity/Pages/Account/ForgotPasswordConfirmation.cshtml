@page
@{ ViewData["Title"] = "Check your email — The Living Dossier"; }
<section class="ld-shell ld-shell--verify">
    <div class="ld-interface">
        <div class="ld-brand"><span class="ld-brand-symbol">◈</span><div><strong>Sourcing &amp; Tender Management</strong><small>THE LIVING DOSSIER</small></div></div>
        <div class="ld-intro"><span class="ld-kicker">Account recovery</span><h1>Check your email.</h1><p>If the account is eligible, password reset instructions have been sent.</p></div>
        <div class="ld-footer-links"><a asp-page="./Login">Back to sign in</a></div>
    </div>
    <aside class="ld-visual" aria-label="A private letter beside the dossier"><partial name="_LivingDossier" model='"confirm"' /></aside>
</section>
@section Styles { <link rel="stylesheet" href="~/css/living-dossier.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script><script src="~/js/living-dossier-motion.js" asp-append-version="true"></script> }
