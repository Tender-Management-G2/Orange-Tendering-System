@page
@model VerifyEmailModel
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
@using Orange_Tendering_System.Services
@{
    ViewData["Title"] = "Verify your email";
    // What the server decided on the last post, for the illustration only (never the code itself).
    var result = !ViewData.ModelState.IsValid ? "failed" : TempData.Peek("Notice") is string ? "resent" : "waiting";
}
<section class="as-shell" id="authStudio" data-chapter="verify" data-result="@result">
    @* LEFT: the animated world. Decorative: every real status is repeated as text in the form. *@
    <div class="as-stage" id="asStage" data-shot="wide" data-caption="1">
        <div class="as-stage-ui" aria-hidden="true">
            <p class="as-chapter"><span class="as-sq"></span>Supplier Genesis</p>
            <p class="as-tagline">Every great partnership begins with a small idea.</p>
        </div>
        <p class="sr-only" data-scene-status></p>
    </div>

    @* RIGHT: a normal form. *@
    <div class="as-panel">
        <div class="as-panel-inner">
            <p class="as-brand"><span class="as-brand-mark" aria-hidden="true"></span><span class="as-brand-name">Sourcing &amp; Tender Management</span></p>
            <p class="as-kicker">Supplier registration</p>
            <h1 class="as-title">Verify your email</h1>
            <p class="as-lede">Enter the six-digit code sent to your contact email. The code expires in 10 minutes.</p>

            <ol class="as-steps" aria-label="Registration progress">
                <li class="is-done"><span class="as-n">1</span><span class="as-t">Application</span></li>
                <li class="is-current" aria-current="step"><span class="as-n">2</span><span class="as-t">Email</span></li>
                <li><span class="as-n">3</span><span class="as-t">Face</span></li>
                <li><span class="as-n">4</span><span class="as-t">Approval</span></li>
            </ol>

            @if (TempData["Notice"] is string notice) { <p class="as-status" role="status">@notice</p> }
            <form method="post" asp-page="./VerifyEmail">
                <div asp-validation-summary="ModelOnly" class="as-summary" role="alert"></div>
                <div class="as-field">
                    <label asp-for="Input.Email">Contact email</label>
                    <input asp-for="Input.Email" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="Input.Email" class="as-field-error"></span>
                </div>
                <div class="as-field as-code">
                    <label asp-for="Input.Code">Verification code</label>
                    <input asp-for="Input.Code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" />
                    <span asp-validation-for="Input.Code" class="as-field-error"></span>
                </div>
                <div class="as-actions"><button type="submit" class="as-primary">Verify email <span aria-hidden="true">→</span></button></div>
            </form>
            <form method="post" asp-page-handler="Resend">
                <input type="hidden" name="email" value="@Model.Input.Email" />
                <p class="as-links"><button type="submit" class="as-quiet">Send a new code</button></p>
            </form>
            <p class="as-fine">Your application enters administrator review after your email is verified. Your uploaded documents are kept if you need a new code.</p>
            <p class="as-links">
                <a asp-page="./Register">Return to registration</a>
                <a asp-page="./Login">Sign in</a>
            </p>
            @if (HostEnvironment.IsDevelopment() && SmtpEmailSender.IsLocalInbox(Configuration))
            {
                <p class="as-dev-note">Development mode sends codes to the <a href="http://127.0.0.1:8025/" target="_blank" rel="noopener noreferrer">local mail inbox</a>.</p>
            }
        </div>
    </div>
</section>
@section Styles {
    <partial name="_AuthStudioHead" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/auth-studio/station-page.js" asp-append-version="true"></script>
}
