@page
@model VerifyEmailModel
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
@using Orange_Tendering_System.Services
@{
    ViewData["Title"] = "Verify your email — The Living Dossier";
}
<section class="ld-shell ld-shell--verify">
    <div class="ld-interface">
        <div class="ld-brand"><span class="ld-brand-symbol">◈</span><div><strong>Supplier registration</strong><small>THE LIVING DOSSIER</small></div></div>
        <div class="ld-intro">
            <span class="ld-kicker">Chapter two · correspondence</span>
            <h1>A letter for your dossier.</h1>
            <p>Enter the six-digit code sent to your contact email. The code expires in 10 minutes.</p>
        </div>
        <ol class="ld-progress" aria-label="Registration progress">
            <li class="is-done"><span>01</span> Company dossier</li>
            <li class="is-current" aria-current="step"><span>02</span> Verify email</li>
            <li><span>03</span> Face enrollment</li>
            <li><span>04</span> Pending approval</li>
        </ol>
        <p class="ld-process-note">Your application enters administrator review after your email is verified. Your uploaded documents are saved if you need a new code.</p>
        @if (HostEnvironment.IsDevelopment() && SmtpEmailSender.IsLocalInbox(Configuration))
        {
            <p class="ld-dev-note">Development mode sends codes to the <a href="http://127.0.0.1:8025/" target="_blank" rel="noopener noreferrer">local mail inbox</a>.</p>
        }
        @if (TempData["Notice"] is string notice) { <p class="ld-notice" role="status">@notice</p> }
        <form method="post" asp-page="./VerifyEmail">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="ld-fields ld-verify-fields">
                <div class="ld-wide"><label asp-for="Input.Email">Contact email</label><input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email" class="field-error"></span></div>
                <div class="ld-wide"><label asp-for="Input.Code">Verification code</label><input asp-for="Input.Code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" /><span asp-validation-for="Input.Code" class="field-error"></span></div>
            </div>
            <div class="ld-actions"><button type="submit" class="primary">Verify email →</button></div>
        </form>
        <form method="post" asp-page-handler="Resend">
            <input type="hidden" name="email" value="@Model.Input.Email" />
            <button type="submit" class="ld-secondary">Send a new code</button>
        </form>
        <div class="ld-footer-links"><a asp-page="./Register">Return to registration</a><a asp-page="./Login">Sign in</a></div>
    </div>
    <aside class="ld-visual" aria-label="A private letter beside the company dossier"><partial name="_LivingDossier" model='"verify"' /></aside>
</section>
@section Styles { <link rel="stylesheet" href="~/css/living-dossier.css" asp-append-version="true" /> }
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script>
    <script src="~/js/living-dossier-motion.js" asp-append-version="true"></script>
}
