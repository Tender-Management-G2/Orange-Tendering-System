@{
    ViewData["Title"] = "Access denied";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">ACCESS DENIED</span>
        <h1>You do not have access to this page.</h1>
        <p>Your account does not have the role required for this workspace. If you believe this is wrong, contact the system administrator.</p>
        <a class="primary" asp-area="" asp-controller="Workspace" asp-action="Index">Go to my workspace →</a>
        <a class="auth-link" asp-area="" asp-controller="Home" asp-action="Index">Back to homepage ↗</a>
    </div>
</section>
