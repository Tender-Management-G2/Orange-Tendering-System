@page
@model RegisterModel
@{
    ViewData["Title"] = "Supplier Registration";
}
<section class="section auth-section">
    <div class="glass auth-card auth-card-wide">
        <span class="eyebrow">SUPPLIER ONBOARDING</span>
        <h1>Register your company</h1>
        <p>Registration is for supplier companies. Your company can participate only after administrator approval.</p>
        <form id="registerForm" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <fieldset class="auth-fieldset">
                <legend>Contact account</legend>
                <label asp-for="Input.FullName">Contact person's full name</label>
                <input asp-for="Input.FullName" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="field-error"></span>
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </fieldset>
            <fieldset class="auth-fieldset">
                <legend>Company details</legend>
                <label asp-for="Input.CompanyName">Legal company name</label>
                <input asp-for="Input.CompanyName" />
                <span asp-validation-for="Input.CompanyName" class="field-error"></span>
                <label asp-for="Input.RegistrationNumber">Commercial registration number</label>
                <input asp-for="Input.RegistrationNumber" />
                <span asp-validation-for="Input.RegistrationNumber" class="field-error"></span>
                <label asp-for="Input.TaxNumber">Tax number (where applicable)</label>
                <input asp-for="Input.TaxNumber" />
                <span asp-validation-for="Input.TaxNumber" class="field-error"></span>
                <label asp-for="Input.CompanyEmail">Company email</label>
                <input asp-for="Input.CompanyEmail" autocomplete="email" />
                <span asp-validation-for="Input.CompanyEmail" class="field-error"></span>
                <label asp-for="Input.CompanyPhone">Company telephone number</label>
                <input asp-for="Input.CompanyPhone" type="tel" />
                <span asp-validation-for="Input.CompanyPhone" class="field-error"></span>
                <label asp-for="Input.CompanyAddress">Company address</label>
                <input asp-for="Input.CompanyAddress" />
                <span asp-validation-for="Input.CompanyAddress" class="field-error"></span>
            </fieldset>
            <fieldset class="auth-fieldset">
                <legend>Official documents</legend>
                <p>PDF, PNG, or JPEG. Maximum 10 MB per file.</p>
                <label asp-for="CommercialRegistrationCertificate">Commercial registration certificate</label>
                <input asp-for="CommercialRegistrationCertificate" type="file" accept=".pdf,.png,.jpg,.jpeg" />
                <span asp-validation-for="CommercialRegistrationCertificate" class="field-error"></span>
                <label asp-for="TaxCertificate">Tax certificate (required if you entered a tax number)</label>
                <input asp-for="TaxCertificate" type="file" accept=".pdf,.png,.jpg,.jpeg" />
                <span asp-validation-for="TaxCertificate" class="field-error"></span>
                <label asp-for="LegalDocuments">Business licenses or other required legal documents</label>
                <input asp-for="LegalDocuments" type="file" multiple accept=".pdf,.png,.jpg,.jpeg" />
                <span asp-validation-for="LegalDocuments" class="field-error"></span>
            </fieldset>
            <p class="auth-note">After email verification, your company remains Pending until an administrator reviews its details and documents.</p>
            <button id="registerSubmit" type="submit" class="primary">Submit registration →</button>
        </form>
        <a class="auth-link" asp-page="./Login">Already registered? Sign in</a>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
