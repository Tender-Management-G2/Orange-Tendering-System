@model List<SupplierDocumentViewModel>
@{ ViewData["Title"] = "Company Documents"; ViewData["WorkspaceSection"] = "Documents"; }
<partial name="_PageHeader" />
@if (TempData["DocumentMessage"] is string message) { <p class="pg-note" role="status">@message</p> }
<section class="ws-panel pg-panel"><h2>Official company documents</h2>
<ul>@foreach (var doc in Model) { <li><a asp-action="Download" asp-route-id="@doc.Id">@doc.FileName</a> — @doc.UploadedAt.ToString("yyyy-MM-dd")</li> }</ul>
@if (Model.Count == 0) { <p>No company documents uploaded.</p> }
<form asp-action="UploadCompany" method="post" enctype="multipart/form-data" class="pg-form">
<label for="company-file">PDF, PNG or JPEG (maximum 10 MB)</label><input id="company-file" name="file" type="file" accept=".pdf,.png,.jpg,.jpeg" required />
<button type="submit" class="pg-btn pg-btn-primary">Upload for review</button></form></section>
