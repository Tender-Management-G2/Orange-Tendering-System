@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Invitation Details

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Supplier Portal
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
Show one invitation: tender description, items to price,
requirements and deadline.

BUSINESS ACCESS:
Supplier (own company only, Admin-approved)

ROUTE: /Supplier/Invitations/Details/{id?}

FUTURE IMPLEMENTATION:
- Load the invitation only if it belongs to the user’s
  company; otherwise NotFound.

DEPENDENCIES:
TenderInvitations, Tenders, TenderItems, Documents.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Every query must be filtered by the signed-in user’s
SupplierId. Never show other suppliers’ invitations, offers,
prices or evaluations.
===========================================================
*@
@{
    ViewData["Title"] = "Invitation Details";
    ViewData["WorkspaceSection"] = "Invitations";
    ViewData["Description"] = "What the tender asks for and its deadline.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Tender</h2>
    <dl class="pg-dl">
        <div><dt>Tender</dt><dd>—</dd></div>
        <div><dt>Round</dt><dd>—</dd></div>
        <div><dt>Opens</dt><dd>—</dd></div>
        <div><dt>Deadline</dt><dd>—</dd></div>
        <div><dt>Invitation status</dt><dd>—</dd></div>
    </dl>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-items-to-price">
    <div class="pg-panel-head"><h2 id="tbl-items-to-price">Items to price</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Item</th><th scope="col">Specifications</th><th scope="col">Quantity</th><th scope="col">Unit</th></tr></thead>
            <tbody><tr><td colspan="4"><partial name="_EmptyState" model='"Items not loaded."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel">
    <h2>Requirements</h2>
    <dl class="pg-dl">
        <div><dt>Mandatory documents and conditions</dt><dd>—</dd></div>
    </dl>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Supplier" asp-controller="Invitations" asp-action="Respond">Accept or decline</a></li>
        <li><a asp-area="Supplier" asp-controller="Offers" asp-action="Create">Create offer</a></li>
        <li><a asp-area="Supplier" asp-controller="Clarifications" asp-action="Index">Ask a question</a></li>
    </ul>
</nav>
