@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: My Invitations

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Supplier Portal
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
List the supplier’s own invitations by status.

BUSINESS ACCESS:
Supplier (own company only, Admin-approved)

ROUTE: /Supplier/Invitations

FUTURE IMPLEMENTATION:
- Query TenderInvitations where SupplierId = the user’s
  SupplierId.

DEPENDENCIES:
TenderInvitations, TenderRounds, Tenders.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Every query must be filtered by the signed-in user’s
SupplierId. Never show other suppliers’ invitations, offers,
prices or evaluations.
===========================================================
*@
@{
    ViewData["Title"] = "My Invitations";
    ViewData["WorkspaceSection"] = "Invitations";
    ViewData["Description"] = "Tenders your company has been invited to.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search tender" aria-label="Search tender" disabled />
    <select aria-label="Status" disabled><option>Status: All</option><option>Status: Pending</option><option>Status: Accepted</option><option>Status: Declined</option></select>
    <span class="pg-hint">Search and filters are not implemented yet.</span>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-invitations">
    <div class="pg-panel-head"><h2 id="tbl-invitations">Invitations</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender</th><th scope="col">Round</th><th scope="col">Invited</th><th scope="col">Deadline</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody><tr><td colspan="6"><partial name="_EmptyState" model='"Your company has no invitations."' /></td></tr></tbody>
        </table>
    </div>
</section>
