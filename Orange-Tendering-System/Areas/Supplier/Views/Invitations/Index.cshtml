@model SupplierInvitationsViewModel
@* Owner: Saja. Own invitations, search, status filters and details. *@
@{
    ViewData["Title"] = "My Invitations";
    ViewData["WorkspaceSection"] = "Invitations";
    ViewData["Description"] = "Tenders your company has been invited to.";
}
<partial name="_PageHeader" />

@if (Model.AccessMessage != null)
{
    <section class="ws-panel pg-panel" role="alert">
        <h2>Invitations unavailable</h2>
        <p>@Model.AccessMessage</p>
    </section>
}
else
{
    <form asp-action="Index" method="get" class="pg-toolbar" aria-label="Search and filters">
        <input type="search" name="search" value="@Model.Search" maxlength="200" placeholder="Search tender" aria-label="Search tender" />
        <select name="status" aria-label="Status">
            <option value="">Status: All</option>
            <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
            <option value="Accepted" selected="@(Model.StatusFilter == "Accepted")">Accepted</option>
            <option value="Declined" selected="@(Model.StatusFilter == "Declined")">Declined</option>
            <option value="Expired" selected="@(Model.StatusFilter == "Expired")">Expired</option>
        </select>
        <button type="submit" class="pg-btn">Search</button>
        <a asp-action="Index" class="pg-btn">Reset</a>
    </form>

    <section class="ws-panel pg-panel" aria-labelledby="tbl-invitations">
        <div class="pg-panel-head"><h2 id="tbl-invitations">Invitations</h2></div>
        <div class="pg-table-wrap">
            <table class="pg-table">
                <thead>
                    <tr><th scope="col">Tender</th><th scope="col">Round</th><th scope="col">Invited</th><th scope="col">Deadline</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
                </thead>
                <tbody>
                    @if (Model.Invitations.Count == 0)
                    {
                        <tr><td colspan="6"><partial name="_EmptyState" model='"Your company has no invitations."' /></td></tr>
                    }
                    else
                    {
                        @foreach (var invitation in Model.Invitations)
                        {
                            <tr>
                                <td>@invitation.TenderTitle</td>
                                <td>@invitation.RoundNumber</td>
                                <td>@invitation.InvitedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(invitation.Deadline?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@invitation.DisplayStatus</td>
                                <td>
                                    <a asp-area="Supplier" asp-controller="Invitations" asp-action="Details"
                                       asp-route-id="@invitation.Id" class="pg-btn">Details</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}
