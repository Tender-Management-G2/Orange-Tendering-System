@model SupplierInvitationDetailsViewModel
@* Owner: Saja. Accepting an invitation does not create or submit a bid. *@
@{
    ViewData["Title"] = "Accept / Decline Invitation";
    ViewData["WorkspaceSection"] = "Invitations";
    ViewData["Description"] = "Respond to your company's invitation.";
}
<partial name="_PageHeader" />

<section class="ws-panel pg-panel">
    <h2>@Model.TenderTitle</h2>
    <dl class="pg-dl">
        <div><dt>Round</dt><dd>@Model.RoundNumber</dd></div>
        <div><dt>Deadline</dt><dd>@(Model.Deadline?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
        <div><dt>Status</dt><dd>@Model.DisplayStatus</dd></div>
    </dl>

    @if (Model.CanRespond)
    {
        <p>Accept if your company intends to participate. Acceptance does not create or submit an offer.</p>
        <p>Declining means your company will not participate in this round. Your response cannot be changed here.</p>
        <form asp-area="Supplier" asp-controller="Invitations" asp-action="Respond"
              asp-route-id="@Model.Id" method="post" class="pg-form">
            <div class="pg-actions">
                <button type="submit" name="decision" value="Accepted" class="pg-btn pg-btn-primary">Accept invitation</button>
                <button type="submit" name="decision" value="Declined" class="pg-btn">Decline invitation</button>
            </div>
        </form>
    }
    else
    {
        <p role="status">This invitation was already answered or the bidding period is not open. No response can be saved.</p>
    }
</section>
<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Supplier" asp-controller="Invitations" asp-action="Details" asp-route-id="@Model.Id">Back to details</a></li>
        <li><a asp-area="Supplier" asp-controller="Invitations" asp-action="Index">Back to invitations</a></li>
    </ul>
</nav>
