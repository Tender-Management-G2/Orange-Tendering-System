@model List<SupplierNotificationViewModel>
@{ ViewData["Title"] = "Notifications"; ViewData["WorkspaceSection"] = "Notifications"; }
<partial name="_PageHeader" />
@if (TempData["NotificationMessage"] is string notice) { <p class="pg-note" role="status">@notice</p> }
<section class="ws-panel pg-panel"><div class="pg-panel-head"><div><h2>Your updates</h2><span class="pg-hint">Private updates for your supplier account, including invitations, offer status and clarification replies.</span></div>
@if (Model.Any(n => !n.IsRead)) { <form asp-action="MarkAllRead" method="post"><button type="submit" class="pg-btn">Mark all as read</button></form> }
</div>
<form asp-action="Index" method="get" class="pg-toolbar" aria-label="Search notifications">
    <input type="search" name="search" value="@ViewData["Search"]" maxlength="200" placeholder="Search notifications" aria-label="Search notifications" />
    <select name="status" aria-label="Filter notifications">
        <option value="">All updates</option>
        <option value="Unread" selected="@(string.Equals(ViewData["Status"]?.ToString(), "Unread", StringComparison.OrdinalIgnoreCase))">Unread</option>
        <option value="Read" selected="@(string.Equals(ViewData["Status"]?.ToString(), "Read", StringComparison.OrdinalIgnoreCase))">Read</option>
    </select>
    <button type="submit" class="pg-btn pg-btn-primary">Search</button>
    <a asp-action="Index" class="pg-btn">Reset</a>
</form>
@foreach (var notification in Model)
{
    <article class="ws-panel pg-panel @(notification.IsRead ? "" : "supplier-notification-unread")">
        <div class="pg-panel-head"><div><h3>@notification.Title</h3><span class="pg-badge @(notification.IsRead ? "" : "is-warn")">@(notification.IsRead ? "Read" : "Unread")</span></div><time>@notification.At.ToLocalTime().ToString("d MMM yyyy h:mm tt")</time></div>
        <p style="white-space:pre-wrap">@notification.Message</p>
        <div class="pg-actions">
            @if (Url.IsLocalUrl(notification.Link) && notification.Link!.StartsWith("/Supplier/", StringComparison.OrdinalIgnoreCase)) { <a href="@notification.Link" class="pg-btn pg-btn-primary">Open related page</a> }
            @if (!notification.IsRead) { <form asp-action="MarkRead" asp-route-id="@notification.Id" method="post"><button type="submit" class="pg-btn">Mark as read</button></form> }
        </div>
    </article>
}
@if (Model.Count == 0) { <p class="pg-empty">No notifications match this search.</p> }
</section>
