@model List<SupplierNotificationViewModel>
@{ ViewData["Title"] = "Notifications and Results"; ViewData["WorkspaceSection"] = "Notifications"; }
<partial name="_PageHeader" />
<p class="pg-note">Approved tender results and next steps appear here when the Sourcing Officer sends your notification. Other suppliers' offers are private.</p>
@foreach (var notification in Model) {
<section class="ws-panel pg-panel"><h2>@notification.Title</h2><p style="white-space:pre-wrap">@notification.Message</p><p>@notification.At.ToString("yyyy-MM-dd HH:mm") UTC — @(notification.IsRead ? "Read" : "Unread")</p>
@if (Url.IsLocalUrl(notification.Link) && notification.Link!.StartsWith("/Supplier/", StringComparison.OrdinalIgnoreCase)) {
<p><a href="@notification.Link" class="pg-btn">Open related record</a></p>
}
@if (!notification.IsRead) { <form asp-action="MarkRead" asp-route-id="@notification.Id" method="post"><button type="submit" class="pg-btn">Mark as read</button></form> }
</section>
}
@if (Model.Count == 0) { <section class="ws-panel pg-panel"><p>No notifications yet.</p></section> }
