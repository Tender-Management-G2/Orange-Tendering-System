@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Company Profile

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Supplier Portal
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
Show the supplier company profile and let the supplier
update contact details.

BUSINESS ACCESS:
Supplier (own company only, Admin-approved)

ROUTE: /Supplier/Profile

FUTURE IMPLEMENTATION:
- Load the Supplier of the signed-in user.
- POST: update only contact fields; registration number and
  status are Admin-controlled.

DEPENDENCIES:
Suppliers, AspNetUsers.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Every query must be filtered by the signed-in user’s
SupplierId. Never show other suppliers’ invitations, offers,
prices or evaluations.
===========================================================
*@
@{
    ViewData["Title"] = "Company Profile";
    ViewData["WorkspaceSection"] = "Profile";
    ViewData["Description"] = "Your company registration details and approval status.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Company</h2>
    <dl class="pg-dl">
        <div><dt>Company name</dt><dd>—</dd></div>
        <div><dt>Registration number</dt><dd>—</dd></div>
        <div><dt>Tax number</dt><dd>—</dd></div>
        <div><dt>Email</dt><dd>—</dd></div>
        <div><dt>Phone</dt><dd>—</dd></div>
        <div><dt>Address</dt><dd>—</dd></div>
        <div><dt>Approval status</dt><dd>—</dd></div>
        <div><dt>Reviewed at</dt><dd>—</dd></div>
    </dl>
</section>

<section class="ws-panel pg-panel">
    <h2>Update contact details</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field"><label for="f-phone-1">Phone</label><input id="f-phone-1" type="tel" /></div>
                <div class="pg-field pg-field-wide"><label for="f-address-2">Address</label><textarea id="f-address-2" rows="4"></textarea></div>
            </div>
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Save changes</button><span class="pg-hint">Not implemented yet — nothing is saved.</span></div>
        </fieldset>
    </form>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Supplier" asp-controller="Documents" asp-action="Index">My documents</a></li>
    </ul>
</nav>
