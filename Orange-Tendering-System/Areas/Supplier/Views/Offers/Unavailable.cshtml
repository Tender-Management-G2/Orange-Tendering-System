@model string
@{
    ViewData["Title"] = "Offer not available";
    ViewData["WorkspaceSection"] = "My Offers";
    ViewData["Description"] = "This offer cannot be created right now.";
}
<partial name="_PageHeader" />
<section class="section">
    <div class="glass" style="max-width:640px;padding:28px;display:grid;gap:14px">
        <span class="eyebrow">OFFER NOT AVAILABLE</span>
        <p role="status">@Model</p>
        <p>
            <a class="primary" asp-area="Supplier" asp-controller="Workflow" asp-action="Index">Back to my invitations</a>
            <a asp-area="Supplier" asp-controller="Offers" asp-action="Index">My offers</a>
        </p>
    </div>
</section>
