@model SupplierDraftOfferViewModel
<form asp-area="Supplier" asp-controller="Offers" asp-action="@(Model.BidId.HasValue ? "Edit" : "Create")" asp-route-id="@(Model.BidId ?? Model.InvitationId)" method="post" class="pg-form">
    <div asp-validation-summary="All" role="alert"></div>
    <section class="ws-panel pg-panel">
        <h2>@Model.TenderTitle</h2>
        <p>This saves a draft only. Your offer is not submitted to the Sourcing Officer.</p>
        <div class="pg-form-grid">
            <div class="pg-field">
                <label asp-for="Input.CurrencyCode">Currency</label>
                <select asp-for="Input.CurrencyCode"><option>JOD</option><option>USD</option><option>EUR</option></select>
                <span asp-validation-for="Input.CurrencyCode"></span>
            </div>
            <div class="pg-field">
                <label asp-for="Input.DeliveryDays">Delivery (days)</label>
                <input asp-for="Input.DeliveryDays" type="number" min="1" max="3650" />
                <span asp-validation-for="Input.DeliveryDays"></span>
            </div>
            <div class="pg-field pg-field-wide">
                <label asp-for="Input.PaymentTerms">Payment terms</label>
                <textarea asp-for="Input.PaymentTerms" rows="3" maxlength="1000"></textarea>
                <span asp-validation-for="Input.PaymentTerms"></span>
            </div>
            <div class="pg-field pg-field-wide">
                <label asp-for="Input.TechnicalProposal">Technical proposal</label>
                <textarea asp-for="Input.TechnicalProposal" rows="4" maxlength="10000"></textarea>
                <span asp-validation-for="Input.TechnicalProposal"></span>
            </div>
        </div>
        <div class="pg-form-grid">
            <div class="pg-field"><label asp-for="Input.ValidUntil">Valid until</label><input asp-for="Input.ValidUntil" type="date" /></div>
            <div class="pg-field"><label asp-for="Input.ShippingCost">Shipping</label><input asp-for="Input.ShippingCost" type="number" min="0" step="0.01" /></div>
            <div class="pg-field"><label asp-for="Input.InstallationCost">Installation</label><input asp-for="Input.InstallationCost" type="number" min="0" step="0.01" /></div>
            <div class="pg-field"><label asp-for="Input.MaintenanceCost">Maintenance</label><input asp-for="Input.MaintenanceCost" type="number" min="0" step="0.01" /></div>
            <div class="pg-field"><label asp-for="Input.TaxAmount">Tax</label><input asp-for="Input.TaxAmount" type="number" min="0" step="0.01" /></div>
            <div class="pg-field"><label asp-for="Input.OtherCost">Other costs</label><input asp-for="Input.OtherCost" type="number" min="0" step="0.01" /></div>
        </div>
    </section>
    <section class="ws-panel pg-panel">
        <h2>Item prices</h2>
        <div class="pg-table-wrap">
            <table class="pg-table">
                <thead><tr><th>Item</th><th>Required quantity</th><th>Offered quantity</th><th>Unit price</th><th>Offered specifications</th></tr></thead>
                <tbody>
                    @for (int i = 0; i < Model.Input.Items.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Input.Items[i].Name
                                <input asp-for="Input.Items[i].TenderItemId" type="hidden" />
                            </td>
                            <td>@Model.Input.Items[i].RequiredQuantity.ToString("0.###")</td>
                            <td><input asp-for="Input.Items[i].Quantity" aria-label="Offered quantity" type="number" min="0.001" max="999999999" step="0.001" /><span asp-validation-for="Input.Items[i].Quantity"></span></td>
                            <td><input asp-for="Input.Items[i].UnitPrice" aria-label="Unit price" type="number" min="0" max="999999999" step="0.01" /><span asp-validation-for="Input.Items[i].UnitPrice"></span></td>
                            <td><textarea asp-for="Input.Items[i].OfferedSpecifications" aria-label="Offered specifications" rows="2" maxlength="4000"></textarea></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Input.Items.Count > 0)
        {
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Save draft</button></div>
        }
        else
        {
            <p>No tender items are available. Please contact the Sourcing Officer.</p>
        }
    </section>
</form>
<nav class="pg-links" aria-label="Related pages">
    <ul><li><a asp-area="Supplier" asp-controller="Invitations" asp-action="Details" asp-route-id="@Model.InvitationId">Back to invitation</a></li></ul>
</nav>
