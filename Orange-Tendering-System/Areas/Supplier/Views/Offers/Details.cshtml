@model SupplierOfferDetailsViewModel
@{ ViewData["Title"] = "Offer Details"; ViewData["WorkspaceSection"] = "My Offers"; }
<partial name="_PageHeader" />
@if (TempData["OfferSuccess"] is string success) { <p class="pg-note" role="status">@success</p> }
@if (TempData["OfferError"] is string error) { <p class="pg-note" role="alert">@error</p> }
@{ var t = Model.Terms; var totals = OfferTotals.Of(t.Items.Sum(x => x.Quantity * x.UnitPrice), t.ShippingCost + t.InstallationCost + t.MaintenanceCost + t.OtherCost, t.TaxAmount); string M(decimal v) => CurrencyRules.Format(v, t.CurrencyCode); }
<section class="ws-panel pg-panel">
<h2>@Model.TenderTitle — Offer #@Model.Id</h2>
<dl class="pg-dl">
<div><dt>Status</dt><dd>@(Model.Status == Orange_Tendering_System.Models.Entities.BidStatus.Draft ? "Not submitted yet" : Model.Status.ToString()) (revision @Model.Revision)</dd></div>
<div><dt>Submitted (Jordan time)</dt><dd>@(Model.SubmittedAt?.ToJordan("yyyy-MM-dd HH:mm") ?? "Not submitted")</dd></div>
<div><dt>Deadline (Jordan time)</dt><dd>@Model.Deadline?.ToJordan("yyyy-MM-dd HH:mm")</dd></div>
<div><dt>Delivery lead time</dt><dd>@t.DeliveryDays calendar days after order confirmation</dd></div>
<div><dt>Offer valid until</dt><dd>@t.ValidUntil?.ToString("yyyy-MM-dd")</dd></div>
<div><dt>Payment terms</dt><dd>@t.PaymentTerms</dd></div>
<div><dt>Warranty</dt><dd>@(t.WarrantyMonths is int wm ? wm + " months" : "Not applicable") @t.WarrantyType</dd></div>
<div><dt>Technical proposal</dt><dd style="white-space:pre-wrap">@t.TechnicalProposal</dd></div>
@if (!string.IsNullOrWhiteSpace(t.WarrantyTerms)) { <div><dt>Warranty conditions</dt><dd style="white-space:pre-wrap">@t.WarrantyTerms</dd></div> }
@if (!string.IsNullOrWhiteSpace(t.Deviations)) { <div><dt>Deviations</dt><dd style="white-space:pre-wrap">@t.Deviations</dd></div> }
@if (!string.IsNullOrWhiteSpace(t.AfterSalesSupport)) { <div><dt>After-sales support</dt><dd style="white-space:pre-wrap">@t.AfterSalesSupport</dd></div> }
</dl>
<div class="pg-table-wrap"><table class="pg-table"><thead><tr><th>Item</th><th>Offered product / specifications</th><th>Quantity</th><th>Unit price (excl. tax)</th><th>Line total</th></tr></thead><tbody>
@foreach (var item in t.Items) { <tr><td>@item.Name</td><td><b>@item.OfferedProduct</b><br /><span style="white-space:pre-wrap">@item.OfferedSpecifications</span>@if (!string.IsNullOrWhiteSpace(item.Notes)) { <br /><small>@item.Notes</small> }</td><td>@item.Quantity.ToString("0.###")</td><td>@M(item.UnitPrice)</td><td>@M(item.Quantity * item.UnitPrice)</td></tr> }
</tbody></table></div>
<dl class="pg-dl">
<div><dt>Items subtotal</dt><dd>@M(totals.ItemsSubtotal)</dd></div>
<div><dt>Additional costs</dt><dd>@M(totals.AdditionalCharges)@if (totals.AdditionalCharges > 0) { <small> (shipping @t.ShippingCost.ToString("0.###"), installation @t.InstallationCost.ToString("0.###"), maintenance @t.MaintenanceCost.ToString("0.###")@(t.MaintenanceDescription != null ? " — " + t.MaintenanceDescription : ""), other @t.OtherCost.ToString("0.###")@(t.OtherCostDescription != null ? " — " + t.OtherCostDescription : ""))</small> }</dd></div>
<div><dt>Total before tax</dt><dd>@M(totals.TotalBeforeTax)</dd></div>
<div><dt>Tax</dt><dd>@M(totals.Tax) @(t.TaxRate is decimal rate ? $"({rate:0.##}% on {(t.TaxIncludesCharges ? "items and additional costs" : "items")})" : "(stated amount)")</dd></div>
<div><dt><strong>Grand total (incl. tax)</strong></dt><dd><strong>@M(totals.GrandTotal)</strong></dd></div>
</dl>
</section>
<section class="ws-panel pg-panel"><h2>Attachments</h2>
<ul>@foreach (var doc in Model.Documents) { <li>@OfferDocumentTypes.Label(doc.DocumentType): <a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.Id">@doc.FileName</a> <small>(@((doc.SizeBytes / 1024.0).ToString("0")) KB)</small></li> }</ul>
@if (Model.Documents.Count == 0) { <p>No attachments uploaded.</p> }
</section>
@if (Model.CanEdit) {
<section class="ws-panel pg-panel"><h2>This offer has not been submitted</h2>
<p>Complete it in the offer form, attach the required documents and submit it before the deadline.</p>
<a asp-action="Create" asp-route-id="@Model.InvitationId" class="pg-btn pg-btn-primary">Complete and submit the offer</a>
</section>
}
@if (Model.Outcome != null) {
<section class="ws-panel pg-panel"><h2>Approved result: @Model.Outcome</h2><p style="white-space:pre-wrap">@Model.ResultMessage</p><p>Notified: @Model.NotifiedAt?.ToJordan("yyyy-MM-dd HH:mm") (Jordan time)</p></section>
} else {
<p class="pg-note">Awaiting the approved result notification from the Sourcing Officer.</p>
}
<nav class="pg-links"><a asp-action="Index">My offers</a> | <a asp-action="History" asp-route-id="@Model.Id">History</a> |
@if (Model.CanContactOfficer) {
<a asp-controller="Clarifications" asp-action="Create" asp-route-bidId="@Model.Id">Contact Sourcing Officer</a><span> | </span>
}
<a asp-controller="Notifications" asp-action="Index">Notifications and results</a></nav>
