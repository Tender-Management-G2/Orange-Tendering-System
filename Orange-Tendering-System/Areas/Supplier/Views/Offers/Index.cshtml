@model List<SupplierOfferDetailsViewModel>
@{ ViewData["Title"] = "My Offers"; ViewData["WorkspaceSection"] = "My Offers"; }
<partial name="_PageHeader" />
@if (TempData["OfferSuccess"] is string success) { <p class="pg-note" role="status">@success</p> }
<p><a asp-action="DownloadSummary" class="pg-btn">Download my summary</a></p>
<section class="ws-panel pg-panel"><div class="pg-table-wrap"><table class="pg-table">
<thead><tr><th>Offer</th><th>Tender</th><th>Revision</th><th>Status</th><th>Total</th><th>Actions</th></tr></thead><tbody>
@foreach (var offer in Model) {
<tr><td>#@offer.Id</td><td>@offer.TenderTitle</td><td>@offer.Revision</td><td>@offer.Status</td><td>@offer.Total.ToString("N2") @offer.Terms.CurrencyCode</td><td>
<a asp-action="Details" asp-route-id="@offer.Id" class="pg-btn">Details</a>
@if (offer.CanEdit) { <a asp-action="Edit" asp-route-id="@offer.Id" class="pg-btn">Edit draft</a> }
</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="6">No offers yet. Accept an invitation to create your first draft.</td></tr> }
</tbody></table></div></section>
