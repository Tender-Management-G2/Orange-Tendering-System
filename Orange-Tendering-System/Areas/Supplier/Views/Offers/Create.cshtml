@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Create Supplier Offer

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Supplier Portal
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
Create a draft offer: terms, item prices, extra costs and
documents.

BUSINESS ACCESS:
Supplier (own company only, Admin-approved)

ROUTE: /Supplier/Offers/Create/{id?}

FUTURE IMPLEMENTATION:
- Only for an own, Accepted invitation in an Open round
  before the deadline.
- POST: Bid (RevisionNumber 1, Draft) + BidItems (unique Bid
  + TenderItem) + Documents (BidId).
- Submit: Status = Submitted, SubmittedAt; notify the
  Officer; audit.

DEPENDENCIES:
Bids, BidItems, TenderItems, Documents, TenderInvitations.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Every query must be filtered by the signed-in user’s
SupplierId. Never show other suppliers’ invitations, offers,
prices or evaluations.
===========================================================
*@
@{
    ViewData["Title"] = "Create Supplier Offer";
    ViewData["WorkspaceSection"] = "My Offers";
    ViewData["Description"] = "Prepare your offer for an accepted invitation.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Offer terms</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field"><label for="f-currency-1">Currency</label><select id="f-currency-1"><option>JOD</option><option>USD</option><option>EUR</option></select></div>
                <div class="pg-field"><label for="f-delivery-days-2">Delivery (days)</label><input id="f-delivery-days-2" type="number" /></div>
                <div class="pg-field"><label for="f-valid-until-3">Valid until</label><input id="f-valid-until-3" type="date" /></div>
                <div class="pg-field pg-field-wide"><label for="f-payment-terms-4">Payment terms</label><textarea id="f-payment-terms-4" rows="4"></textarea></div>
                <div class="pg-field pg-field-wide"><label for="f-technical-proposal-5">Technical proposal</label><textarea id="f-technical-proposal-5" rows="4"></textarea></div>
            </div>
        </fieldset>
    </form>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-item-prices">
    <div class="pg-panel-head"><h2 id="tbl-item-prices">Item prices</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender item</th><th scope="col">Required quantity</th><th scope="col">Offered quantity</th><th scope="col">Unit price</th><th scope="col">Offered specifications</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"Items of the tender are not loaded."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel">
    <h2>Extra costs</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field"><label for="f-shipping-cost-6">Shipping cost</label><input id="f-shipping-cost-6" type="number" /></div>
                <div class="pg-field"><label for="f-installation-cost-7">Installation cost</label><input id="f-installation-cost-7" type="number" /></div>
                <div class="pg-field"><label for="f-maintenance-cost-8">Maintenance cost</label><input id="f-maintenance-cost-8" type="number" /></div>
                <div class="pg-field"><label for="f-tax-amount-9">Tax amount</label><input id="f-tax-amount-9" type="number" /></div>
                <div class="pg-field"><label for="f-other-cost-10">Other cost</label><input id="f-other-cost-10" type="number" /></div>
            </div>
        </fieldset>
    </form>
</section>

<section class="ws-panel pg-panel">
    <h2>Documents</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field"><label for="f-offer-documents-11">Offer documents</label><input id="f-offer-documents-11" type="file" /></div>
            </div>
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Submit offer</button><button type="button" class="pg-btn">Save draft</button><span class="pg-hint">Not implemented yet — nothing is saved.</span></div>
        </fieldset>
    </form>
</section>
