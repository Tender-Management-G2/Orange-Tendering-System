@model List<SupplierClarificationViewModel>
@{ ViewData["Title"] = "Clarifications"; ViewData["WorkspaceSection"] = "Clarifications"; }
<partial name="_PageHeader" />
@if (TempData["ClarificationMessage"] is string message) { <p class="pg-note" role="status">@message</p> }
<section class="ws-panel pg-panel"><p>Messages with the Sourcing Officer only. To start a conversation, open an invited tender during bidding or one of your submitted offers.</p>
<table class="pg-table"><thead><tr><th>Subject</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var thread in Model) { <tr><td>@thread.Subject</td><td>@thread.Status</td><td><a asp-action="Details" asp-route-id="@thread.Id" class="pg-btn">Open</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="3">No clarifications yet.</td></tr> }
</tbody></table></section>
