@model Orange_Tendering_System.Services.TenderWorkflowService.ExecutiveSummaryPage
@using Orange_Tendering_System.Models.Entities
@{
    var f = Model.Facts; var r = Model.Review; var tenderId = r.Tender.Id;
    var ar = Orange_Tendering_System.ViewModels.UiLanguage.IsArabic(Context);
    string L(string en, string arabic) => ar ? arabic : en;
    ViewData["Title"] = L("Review & Forward to Top Committee", "مراجعة وإرسال إلى اللجنة العليا"); ViewData["WorkspaceSection"] = "Tender";
    ViewData["Description"] = $"{f.Reference} · {f.Title}";
    var submitted = Model.Submitted != null;
    var evalSigned = r.Signatures.Count(x => x.Stage == ReportSigningStage.Evaluation && x.InvalidatedAt == null);
    var best = f.Ranking.FirstOrDefault(x => x.Rank == 1);
    // The executive assessment is a required field of the summary: pre-fill a neutral sentence so the Manager only has to review, sign and send.
    if (Model.CanEdit && !submitted && (Model.Input.ManagerAssessment ?? "").Trim().Length < 20)
        Model.Input.ManagerAssessment = "The Sourcing Manager reviewed the signed evaluation report and forwards it to the Top Committee for a decision.";
    var pdfUrl = Url.Action("Pdf", "Reports", new { area = "SourcingManager", id = r.Report.Id });
    var downloadUrl = Url.Action("Pdf", "Reports", new { area = "SourcingManager", id = r.Report.Id, download = true });
}
@section Styles {
    <link rel="stylesheet" href="~/css/procurement-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-scores.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manager-forward.css" asp-append-version="true" />
}
@section Scripts { <script src="~/js/manager-forward.js" asp-append-version="true"></script> }
<partial name="_PageHeader" />
<div class="mf-page" dir="@(ar ? "rtl" : "ltr")">
    @if (ViewData["SummaryError"] is string error) { <p class="pf-note pf-warn" role="alert">@error</p> }

    @if (submitted)
    {
        <section class="mf-card mf-done" aria-live="polite">
            <span class="mf-done-icon" aria-hidden="true">&#10003;</span>
            <h2>@L("Sent to Top Committee", "تم الإرسال إلى اللجنة العليا")</h2>
            <p>@L("The tender has been signed and forwarded to the Top Committee for review and decision.", "تم توقيع المناقصة وإرسالها إلى اللجنة العليا للمراجعة واتخاذ القرار.")</p>
        </section>
        <section class="mf-card">
            <h3 class="mf-card-title">@L("Tender Information", "معلومات المناقصة")</h3>
            <dl class="mf-facts">
                <div><dt>@L("Tender No.", "رقم المناقصة")</dt><dd>@f.Reference</dd></div>
                <div><dt>@L("Title", "العنوان")</dt><dd>@f.Title</dd></div>
                <div><dt>@L("Recommended Supplier", "المورد الموصى به")</dt><dd class="mf-accent">@(f.Recommended ?? "—")</dd></div>
                <div><dt>@L("Status", "الحالة")</dt><dd><span class="mf-pill">@L("Awaiting Top Committee Decision", "بانتظار قرار اللجنة العليا")</span></dd></div>
            </dl>
            <p class="mf-muted">@L("Submitted on", "تم الإرسال في") @Model.Submitted!.SubmittedAt?.ToJordan("d MMM yyyy HH:mm")</p>
            <div class="mf-actions mf-center"><a class="mf-btn" asp-action="Index" asp-route-open="@tenderId">@L("View Details", "عرض التفاصيل")</a></div>
        </section>
    }
    else if (!Model.CanEdit)
    {
        <section class="mf-card"><p class="pf-note">@L("This report is not awaiting your review.", "هذا التقرير لا ينتظر مراجعتك.")</p>
            <div class="mf-actions"><a class="mf-btn" asp-action="Index" asp-route-open="@tenderId">@L("Back", "رجوع")</a></div></section>
    }
    else
    {
        <form method="post" asp-action="ExecutiveSummary" asp-route-id="@tenderId" class="mf-form" data-mf-form>
            <input type="hidden" name="documentHash" value="@r.Report.PdfSha256" />

            <section class="mf-card">
                <h3 class="mf-card-title">@L("Tender Information", "معلومات المناقصة")</h3>
                <dl class="mf-facts">
                    <div><dt>@L("Tender No.", "رقم المناقصة")</dt><dd>@f.Reference</dd></div>
                    <div><dt>@L("Title", "العنوان")</dt><dd>@f.Title</dd></div>
                    <div><dt>@L("Recommended Supplier", "المورد الموصى به")</dt><dd class="mf-accent">@(f.Recommended ?? L("No single offer (tie)", "لا يوجد عرض منفرد (تعادل)"))</dd></div>
                    <div><dt>@L("Total Score", "الدرجة الإجمالية")</dt><dd>@(best.Supplier != null ? best.Score.ToString("0.0") : "—")</dd></div>
                    <div><dt>@L("Total Cost", "إجمالي التكلفة")</dt><dd>@(f.RecommendedTotal is decimal total ? CurrencyRules.Format(total, f.Currency) : "—")</dd></div>
                    <div><dt>@L("Committee signatures", "تواقيع اللجنة")</dt><dd>@evalSigned / 4</dd></div>
                </dl>
            </section>

            <section class="mf-card">
                <h3 class="mf-card-title">@L("Officer Report", "تقرير المسؤول")</h3>
                <div class="mf-file">
                    <span class="mf-file-icon" aria-hidden="true">PDF</span>
                    <span class="mf-file-name">Evaluation_Report_v@(f.ReportVersion).pdf</span>
                    <button type="button" class="mf-ghost" data-mf-preview="@pdfUrl">@L("View", "عرض")</button>
                    <a class="mf-icon-btn" href="@downloadUrl" download title="@L("Download the report (PDF)", "تنزيل التقرير (PDF)")" aria-label="@L("Download the report (PDF)", "تنزيل التقرير (PDF)")">&#11015;</a>
                </div>
                <div class="mf-preview" data-mf-preview-box hidden></div>
                <p class="mf-muted">@L("Opening the report is recorded; signing requires that you opened this exact version.", "فتح التقرير يُسجَّل؛ والتوقيع يتطلب أنك فتحت هذه النسخة بالذات.") SHA-256 @r.Report.PdfSha256?[..12]…</p>
            </section>

            <details class="mf-card mf-summary">
                <summary>@L("Executive summary for the Top Committee (pre-filled, editable)", "الملخص التنفيذي للجنة العليا (معبّأ مسبقاً وقابل للتعديل)")</summary>
                <div class="mf-fields">
                    <div class="pg-field"><label asp-for="Input.BusinessNeed">@L("Business need", "حاجة العمل")</label><textarea asp-for="Input.BusinessNeed" rows="3" maxlength="4000"></textarea></div>
                    <div class="pg-field"><label asp-for="Input.KeyFindings">@L("Key financial and technical findings", "النتائج المالية والفنية الرئيسية")</label><textarea asp-for="Input.KeyFindings" rows="3" maxlength="4000"></textarea></div>
                    <div class="pg-field"><label asp-for="Input.RecommendationReasons">@L("Reasons for the recommendation", "أسباب التوصية")</label><textarea asp-for="Input.RecommendationReasons" rows="3" maxlength="4000"></textarea></div>
                    <div class="pg-field"><label asp-for="Input.Risks">@L("Risks and observations", "المخاطر والملاحظات")</label><textarea asp-for="Input.Risks" rows="2" maxlength="4000"></textarea></div>
                    <div class="pg-field"><label asp-for="Input.ManagerAssessment">@L("Executive assessment", "التقييم التنفيذي")</label><textarea asp-for="Input.ManagerAssessment" rows="3" maxlength="4000"></textarea></div>
                    <button type="submit" name="intent" value="save" class="mf-ghost" formnovalidate>@L("Save draft", "حفظ المسودة")</button>
                </div>
            </details>

            <section class="mf-card">
                <h3 class="mf-card-title">@L("Manager Remarks", "ملاحظات المدير") <small>(@L("Optional", "اختياري"))</small></h3>
                <textarea name="remarks" rows="3" maxlength="1500" placeholder="@L("Add remarks...", "أضف ملاحظاتك...")"></textarea>
            </section>

            <div class="mf-actions">
                <a class="mf-btn" asp-action="Index" asp-route-open="@tenderId">&larr; @L("Back", "رجوع")</a>
                <button type="button" class="mf-primary" data-mf-open>@L("Sign & Send to Top Committee", "توقيع وإرسال إلى اللجنة العليا") <span aria-hidden="true">&rarr;</span></button>
            </div>
            <p class="mf-muted">@L("To send the report back for a correction, or to reject it, use the tender page (both require a written reason).", "لإعادة التقرير للتصحيح أو رفضه استخدم صفحة المناقصة (كلاهما يتطلب سبباً مكتوباً).")</p>

            <dialog class="mf-modal" data-mf-dialog aria-labelledby="mf-sign-title">
                <div class="mf-modal-head"><h2 id="mf-sign-title">&#9998; @L("Manager Signature", "توقيع المدير")</h2><button type="button" class="mf-x" data-mf-cancel aria-label="@L("Cancel", "إلغاء")">&times;</button></div>
                <p>@L("Please sign to confirm and send the tender to the Top Committee.", "يرجى التوقيع للتأكيد وإرسال المناقصة إلى اللجنة العليا.")</p>
                <partial name="_ReportSignaturePad" />
                <label class="mf-check"><input type="checkbox" name="confirmed" value="true" required /> @L("I reviewed the signed evaluation report.", "راجعت تقرير التقييم الموقّع.")</label>
                <div class="mf-modal-actions">
                    <button type="button" class="mf-btn" data-mf-cancel>@L("Cancel", "إلغاء")</button>
                    <button type="submit" name="intent" value="submit" class="mf-primary" data-mf-send>@L("Sign & Send", "توقيع وإرسال") <span aria-hidden="true">&#10148;</span></button>
                </div>
            </dialog>
        </form>
    }
</div>
