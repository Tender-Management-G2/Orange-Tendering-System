@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Sourcing Manager Dashboard

DEVELOPER OWNER: Haya
MODULE: Sourcing Manager Review
TRELLO TASK: Sourcing Manager Dashboard
TRELLO URL: https://trello.com/c/ZkMN8s14

PURPOSE:
Landing page for the Sourcing Manager: detailed reports
waiting for managerial review and recent decisions.

BUSINESS ACCESS:
Sourcing Manager

ROUTE: /SourcingManager

IMPLEMENTATION:
- Count FullEvaluation reports by review status.
- Display pending managerial review tasks.
- Display recent decisions made by the current manager.
- Display evaluation report status distribution.

DEPENDENCIES:
TenderReports, Tenders.

STATUS:
Dashboard report data connected through WorkspaceDashboardViewModel.

IMPORTANT:
The Manager is also one of the four Evaluation Committee
members, but this managerial review is a separate stage.
===========================================================
*@

@model WorkspaceDashboardViewModel

@{
    ViewData["Title"] = "Sourcing Manager Dashboard";
    ViewData["WorkspaceSection"] = "Dashboard";

    var data = Model ?? new WorkspaceDashboardViewModel();
    var displayName = data.DisplayName ?? "Sourcing Manager";

    var total = data.Statuses.Sum(status =>
        (long)Math.Max(0, status.Count));

    var palette = new[]
    {
        "#ff8a00",
        "#00bf81",
        "#ef4444",
        "#098fff"
    };

    var segments = new List<string>();
    decimal angle = 0;

    for (var i = 0; i < data.Statuses.Count && total > 0; i++)
    {
        var end = angle +
            Math.Max(0, data.Statuses[i].Count) * 360m / total;

        segments.Add(
            $"{palette[i % palette.Length]} " +
            $"{angle.ToString(System.Globalization.CultureInfo.InvariantCulture)}deg " +
            $"{end.ToString(System.Globalization.CultureInfo.InvariantCulture)}deg"
        );

        angle = end;
    }

    var distribution = total > 0
        ? $"conic-gradient({string.Join(",", segments)})"
        : "conic-gradient(var(--dash-empty-ring) 0deg 360deg)";
}

<div class="dash-board dash-internal"
     data-dashboard-body="true"
     data-dashboard-role="Sourcing Manager">

    <!-- Welcome -->
    <section class="dash-welcome" aria-labelledby="dashboard-title">

        <div class="dash-welcome-photo" aria-hidden="true"></div>
        <div class="dash-welcome-waves" aria-hidden="true"></div>

        <div class="dash-welcome-copy">
            <h1 id="dashboard-title">
                Welcome back,
                <strong>@displayName</strong>
            </h1>

            <p>
                Review evaluation outcomes and coordinate
                management approvals.
            </p>
        </div>

    </section>

    <!-- Dashboard Metrics -->
    <section class="dash-metrics" aria-label="Dashboard statistics">

        <!-- Pending Reviews -->
        <article class="dash-metric dash-orange">

            <div class="dash-metric-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="5" y="5" width="14" height="17" rx="2" />
                    <path d="M9 3h6v5H9zM9 13h6M9 17h6" />
                </svg>
            </div>

            <div class="dash-metric-copy">
                <strong>@data.Number("pending-reviews")</strong>
                <span>Pending Reviews</span>
            </div>

            <div class="dash-metric-wave" aria-hidden="true"></div>

            @if (data.Trends.TryGetValue("pending-reviews", out var trendPending))
            {
                <span class="dash-trend @(trendPending >= 0 ? "is-positive" : "is-negative")">
                    @(trendPending >= 0 ? "↑" : "↓")
                    @trendPending.ToString("+0.##;-0.##;0")%
                </span>
            }
            else
            {
                <span class="dash-metric-source">
                    @(data.DataConnected ? "Verified data" : "Not connected")
                </span>
            }

        </article>

        <!-- Approved Reports -->
        <article class="dash-metric dash-blue">

            <div class="dash-metric-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m2 7 10-5 10 5-10 5zM2 12l10 5 10-5M2 17l10 5-10 5" />
                </svg>
            </div>

            <div class="dash-metric-copy">
                <strong>@data.Number("approved-reports")</strong>
                <span>Approved Reports</span>
            </div>

            <div class="dash-metric-wave" aria-hidden="true"></div>

            @if (data.Trends.TryGetValue("approved-reports", out var trendApproved))
            {
                <span class="dash-trend @(trendApproved >= 0 ? "is-positive" : "is-negative")">
                    @(trendApproved >= 0 ? "↑" : "↓")
                    @trendApproved.ToString("+0.##;-0.##;0")%
                </span>
            }
            else
            {
                <span class="dash-metric-source">
                    @(data.DataConnected ? "Verified data" : "Not connected")
                </span>
            }

        </article>

        <!-- Rejected Reports -->
        <article class="dash-metric dash-green">

            <div class="dash-metric-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="9" cy="7" r="4" />
                    <path d="M2 21v-3c0-7 14-7 14 0v3M17 4c5 0 5 7 0 7M18 14c4 0 4 4 4 7" />
                </svg>
            </div>

            <div class="dash-metric-copy">
                <strong>@data.Number("rejected-reports")</strong>
                <span>Rejected Reports</span>
            </div>

            <div class="dash-metric-wave" aria-hidden="true"></div>

            @if (data.Trends.TryGetValue("rejected-reports", out var trendRejected))
            {
                <span class="dash-trend @(trendRejected >= 0 ? "is-positive" : "is-negative")">
                    @(trendRejected >= 0 ? "↑" : "↓")
                    @trendRejected.ToString("+0.##;-0.##;0")%
                </span>
            }
            else
            {
                <span class="dash-metric-source">
                    @(data.DataConnected ? "Verified data" : "Not connected")
                </span>
            }

        </article>

        <!-- Returned Reports -->
        <article class="dash-metric dash-purple">

            <div class="dash-metric-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="5" y="5" width="14" height="17" rx="2" />
                    <path d="M9 3h6v5H9zM8 14l3 3 5-6" />
                </svg>
            </div>

            <div class="dash-metric-copy">
                <strong>@data.Number("returned-reports")</strong>
                <span>Returned Reports</span>
            </div>

            <div class="dash-metric-wave" aria-hidden="true"></div>

            @if (data.Trends.TryGetValue("returned-reports", out var trendReturned))
            {
                <span class="dash-trend @(trendReturned >= 0 ? "is-positive" : "is-negative")">
                    @(trendReturned >= 0 ? "↑" : "↓")
                    @trendReturned.ToString("+0.##;-0.##;0")%
                </span>
            }
            else
            {
                <span class="dash-metric-source">
                    @(data.DataConnected ? "Verified data" : "Not connected")
                </span>
            }

        </article>

    </section>

    <!-- Middle Row -->
    <section class="dash-middle-row">

        <!-- Sourcing Workflow -->
        <article class="dash-panel dash-workflow">

            <div class="dash-panel-heading">
                <h2>Sourcing Workflow</h2>

                <button type="button"
                        class="dash-text-action"
                        disabled
                        title="This module is not available yet">
                    View Process <span aria-hidden="true">→</span>
                </button>
            </div>

            <ol class="dash-workflow-stages">

                <li class="@(data.CurrentWorkflowStage == 0 ? "is-current" : data.CurrentWorkflowStage > 0 ? "is-complete" : "")">
                    <span class="dash-workflow-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="5" y="5" width="14" height="17" rx="2" />
                            <path d="M9 3h6v5H9zM8 14l3 3 5-6" />
                        </svg>
                    </span>
                    <span>Purchase<br />Request</span>
                </li>

                <li class="@(data.CurrentWorkflowStage == 1 ? "is-current" : data.CurrentWorkflowStage > 1 ? "is-complete" : "")">
                    <span class="dash-workflow-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="5" y="5" width="14" height="17" rx="2" />
                            <path d="M9 3h6v5H9zM9 13h6M9 17h6" />
                        </svg>
                    </span>
                    <span>Tender<br />Creation</span>
                </li>

                <li class="@(data.CurrentWorkflowStage == 2 ? "is-current" : data.CurrentWorkflowStage > 2 ? "is-complete" : "")">
                    <span class="dash-workflow-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m2 7 10-5 10 5-10 5zM2 12l10 5 10-5M2 17l10 5-10 5" />
                        </svg>
                    </span>
                    <span>Bidding<br /><small>(by Suppliers)</small></span>
                </li>

                <li class="@(data.CurrentWorkflowStage == 3 ? "is-current" : data.CurrentWorkflowStage > 3 ? "is-complete" : "")">
                    <span class="dash-workflow-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2v19M7 22h10M3 6h18M5 6l-4 9h8zM19 6l-4 9h8z" />
                        </svg>
                    </span>
                    <span>Evaluation<br /><small>(Technical &amp; Financial)</small></span>
                </li>

                <li class="@(data.CurrentWorkflowStage == 4 ? "is-current" : data.CurrentWorkflowStage > 4 ? "is-complete" : "")">
                    <span class="dash-workflow-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="5" y="5" width="14" height="17" rx="2" />
                            <path d="M9 3h6v5H9zM8 14l3 3 5-6" />
                        </svg>
                    </span>
                    <span>Manager<br />Review</span>
                </li>

                <li class="@(data.CurrentWorkflowStage == 5 ? "is-current" : data.CurrentWorkflowStage > 5 ? "is-complete" : "")">
                    <span class="dash-workflow-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="9" cy="7" r="4" />
                            <path d="M2 21v-3c0-7 14-7 14 0v3M17 4c5 0 5 7 0 7M18 14c4 0 4 4 4 7" />
                        </svg>
                    </span>
                    <span>Top<br />Committee</span>
                </li>

                <li class="@(data.CurrentWorkflowStage == 6 ? "is-current" : data.CurrentWorkflowStage > 6 ? "is-complete" : "")">
                    <span class="dash-workflow-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3h10v7a5 5 0 0 1-10 0zM7 5H3v4c0 4 4 4 4 4M17 5h4v4c0 4-4 4-4 4M12 15v6M7 22h10" />
                        </svg>
                    </span>
                    <span>Award<br />&amp; Closure</span>
                </li>

            </ol>

            <span class="dash-data-caption">
                @(data.CurrentWorkflowStage.HasValue
                    ? "Verified workflow position"
                    : "Process overview · no tender selected")
            </span>

        </article>

        <!-- Ongoing Tender -->
        <article class="dash-panel dash-ongoing">

            <div class="dash-panel-heading">
                <h2>Ongoing Tender</h2>
            </div>

            <svg class="dash-tower" viewBox="0 0 160 190" aria-hidden="true">
                <path d="m80 45-40 140h80L80 45M80 45v140M65 95l40 30-55 35 70 25M95 95l-40 30 55 35-70 25M65 52c-22-17-22-45 0-62M95 52c22-17 22-45 0-62M55 65c-35-24-35-61 0-85M105 65c35-24 35-61 0-85" />
                <circle cx="80" cy="20" r="7" />
            </svg>

            <div class="dash-ongoing-copy">

                @if (data.OngoingTender is { } tender)
                {
                    <strong>@tender.Reference</strong>
                    <p>@tender.Title</p>

                    <div class="dash-tender-progress">
                        <i style="width:@(Math.Clamp(tender.Progress ?? 0, 0, 100))%"></i>
                    </div>

                    <div class="dash-progress-caption">
                        <span>@tender.Status</span>
                        <b>
                            @(tender.Progress.HasValue
                                ? $"{Math.Clamp(tender.Progress.Value, 0, 100)}%"
                                : "—")
                        </b>
                    </div>
                }
                else
                {
                    <strong>—</strong>
                    <p>No verified tender selected</p>

                    <div class="dash-tender-progress"></div>

                    <div class="dash-progress-caption">
                        <span>Waiting for tender data</span>
                        <b>—</b>
                    </div>
                }

            </div>

        </article>

    </section>

    <!-- Bottom Row -->
    <section class="dash-bottom-row">

        <!-- Evaluation Reports Distribution -->
        <article class="dash-panel dash-distribution">

            <div class="dash-panel-heading">
                <h2>Evaluation Reports by Status</h2>
            </div>

            <div class="dash-distribution-body">

                <div class="dash-donut @(data.Statuses.Count > 0 ? "has-data" : "")"
                     style="--dash-distribution:@distribution">

                    <span>
                        <strong>@data.Number("reports-total")</strong>
                        <small>Reports</small>
                    </span>

                </div>

                <div class="dash-legend">

                    @if (data.Statuses.Count > 0)
                    {
                        for (var i = 0; i < data.Statuses.Count; i++)
                        {
                            var status = data.Statuses[i];

                            <div>
                                <i style="background-color:@palette[i % palette.Length]"></i>
                                <span>@status.Label</span>
                                <b>@status.Count</b>
                            </div>
                        }
                    }
                    else
                    {
                        <div><i></i><span>Pending Review</span><b>—</b></div>
                        <div><i></i><span>Approved</span><b>—</b></div>
                        <div><i></i><span>Rejected</span><b>—</b></div>
                        <div><i></i><span>Returned</span><b>—</b></div>
                    }

                </div>

            </div>

            <span class="dash-data-caption">
                @(data.DataConnected
                    ? "Verified system data"
                    : "Waiting for verified data")
            </span>

        </article>

        <!-- Recent Activities -->
        <article class="dash-panel dash-activity">

            <div class="dash-panel-heading">
                <h2>Recent Activities</h2>

                <a asp-area="SourcingManager"
                   asp-controller="Reports"
                   asp-action="History"
                   class="dash-text-action">
                    View All <span aria-hidden="true">→</span>
                </a>
            </div>

            <div class="dash-activity-list">

                @if (data.Activities.Count > 0)
                {
                    foreach (var activity in data.Activities)
                    {
                        <div class="dash-activity-item">

                            <i aria-hidden="true"></i>

                            <div>
                                <strong>@activity.Title</strong>
                                <span>@activity.Context</span>
                            </div>

                            <time>@activity.Time</time>

                        </div>
                    }
                }
                else
                {
                    <div class="dash-empty-timeline" aria-hidden="true">
                        <i></i>
                        <i></i>
                        <i></i>
                    </div>

                    <div class="dash-empty-state">
                        <span>
                            @(data.DataConnected
                                ? "No recent decisions."
                                : "Activity history is not connected.")
                        </span>
                    </div>
                }

            </div>

        </article>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/workspace-dashboard.css"
          asp-append-version="true" />
}
