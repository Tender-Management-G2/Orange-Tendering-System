@model List<Orange_Tendering_System.Models.Entities.FinalDecisionNotice>
@using Orange_Tendering_System.Models.Entities
@{ ViewData["Title"] = "Final decisions"; ViewData["WorkspaceSection"] = "Final Decisions"; ViewData["Description"] = "Acknowledge the Top Committee decision and forward it to the Sourcing Officer. Suppliers are never notified from here."; }
<partial name="_PageHeader" />
<partial name="_Flash" />
<section class="ws-panel pg-panel" aria-labelledby="fd-title">
    <div class="pg-panel-head"><h2 id="fd-title">Decisions assigned to you</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender</th><th scope="col">Top Committee</th><th scope="col">Status</th><th scope="col">Recorded</th><th scope="col" data-nosort>Actions</th></tr></thead>
            <tbody>
            @foreach (var n in Model)
            {
                <tr><td><strong>@n.Tender.Title</strong></td><td>@(n.TopVotes == 0 ? "Manager decision" : $"{n.TopApprovals} of {n.TopVotes} approved")</td>
                    <td>@(n.Status switch { FinalDecisionStatus.AwaitingManager => "Awaiting your acknowledgement", FinalDecisionStatus.ForwardedToOfficer => "Forwarded to Officer", _ => "Suppliers notified" })</td>
                    <td>@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@if (n.Status == FinalDecisionStatus.AwaitingManager) { <a class="pg-btn pg-btn-primary" asp-action="Acknowledge" asp-route-id="@n.TenderId">Acknowledge &amp; forward</a> }</td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5"><partial name="_EmptyState" model='"No final decisions are waiting for you."' /></td></tr> }
            </tbody>
        </table>
    </div>
</section>
