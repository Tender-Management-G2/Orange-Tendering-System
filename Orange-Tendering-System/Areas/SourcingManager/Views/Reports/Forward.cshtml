@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Forward to Top Committee

DEVELOPER OWNER: Haya
MODULE: Sourcing Manager Review
TRELLO TASK: Forward to Top Committee
TRELLO URL: https://trello.com/c/953NoZV0

PURPOSE:
Prepare the short executive summary and forward it to the
Top Committee.

BUSINESS ACCESS:
Sourcing Manager

ROUTE: /SourcingManager/Reports/Forward/{id?}

FUTURE IMPLEMENTATION:
- Create TenderReport (ReportType = ExecutiveSummary) linked
  to the accepted FullEvaluation version.
- Create the Top CommitteeRound (TenderReportId = the
  summary); notify the 4 Top Committee members.
- A materially revised summary requires a new round and four
  new approvals.

DEPENDENCIES:
TenderReports, CommitteeRounds, CommitteeMembers,
Notifications, AuditLogs.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@
@{
    ViewData["Title"] = "Forward to Top Committee";
    ViewData["WorkspaceSection"] = "Forwarding";
    ViewData["Description"] = "Write the short executive summary and forward it to the four-member Top Committee.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Based on</h2>
    <dl class="pg-dl">
        <div><dt>Detailed report version</dt><dd>—</dd></div>
        <div><dt>Recommended offer</dt><dd>—</dd></div>
        <div><dt>Evaluation round approved on</dt><dd>—</dd></div>
    </dl>
</section>

<section class="ws-panel pg-panel">
    <h2>Executive summary for the Top Committee</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field pg-field-wide"><label for="f-summary-1">Summary</label><textarea id="f-summary-1" rows="4"></textarea><small class="pg-hint">Short: the Top Committee sees this, not the full report.</small></div>
                <div class="pg-field pg-field-wide"><label for="f-key-comparison-points-2">Key comparison points</label><textarea id="f-key-comparison-points-2" rows="4"></textarea></div>
            </div>
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Save summary draft</button><span class="pg-hint">Not implemented yet — nothing is saved.</span></div>
        </fieldset>
    </form>
</section>

<section class="ws-panel pg-panel">
    <h2>Executive summary preview</h2>
    <partial name="_EmptyState" model='"The preview of your draft summary, exactly as the Top Committee will see it, appears here."' />
</section>

<partial name="_ConfirmAction" model='new ConfirmActionModel("Forward to Top Committee", "Send the executive summary to the Top Committee.", "Creates an ExecutiveSummary report version and a Top CommitteeRound that needs 4/4 approval.", false, false)' />
