@model Orange_Tendering_System.Models.Entities.TenderReport

@{
    ViewData["Title"] = "Forward to Top Committee";
    ViewData["WorkspaceSection"] = "Forwarding";
    ViewData["Description"] = "Write the short executive summary and forward it to the four-member Top Committee.";
}

<partial name="_PageHeader" />


<section class="ws-panel pg-panel">
    <h2>Tender Information</h2>

    <dl class="pg-dl">
        <div>
            <dt>Tender</dt>
            <dd>@Model.TenderRound.Tender.Title</dd>
        </div>

        <div>
            <dt>Deadline</dt>
            <dd>
                @(Model.TenderRound.Deadline?.ToString("yyyy-MM-dd")
                    ?? "Not available")
            </dd>
        </div>

        <div>
            <dt>Recommended Supplier</dt>
            <dd>
                @(Model.RecommendedBid?.TenderInvitation?
                    .Supplier?.CompanyName ?? "Not available")
            </dd>
        </div>

        <div>
            <dt>Recommended Offer Total Cost</dt>
            <dd>
                @if (ViewBag.TotalCost != null)
                {
                    <span>
                        @(((decimal)ViewBag.TotalCost).ToString("N2"))
                        @Model.RecommendedBid?.CurrencyCode
                    </span>
                }
                else
                {
                    <span>Not available</span>
                }
            </dd>
        </div>

        <div>
            <dt>Report Version</dt>
            <dd>Version @Model.VersionNumber</dd>
        </div>
    </dl>

    <h3>Products and Quantities</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.TenderRound.Tender.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.Unit</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Evaluation Result</h3>

    <p style="white-space: pre-wrap;">@Model.Content</p>
</section>


<section class="ws-panel pg-panel">
    <h2>Executive summary for the Top Committee</h2>

    <form asp-area="SourcingManager"
          asp-controller="Reports"
          asp-action="SaveSummaryDraft"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="pg-form-grid">
            <div class="pg-field pg-field-wide">
                <label for="summary">Summary</label>

                <textarea id="summary"
                          name="summary"
                          rows="4"
                          required>@ViewBag.Summary</textarea>

                <small class="pg-hint">
                    Short: the Top Committee sees this, not the full report.
                </small>
            </div>

            <div class="pg-field pg-field-wide">
                <label for="keyComparisonPoints">
                    Key comparison points
                </label>

                <textarea id="keyComparisonPoints"
                          name="keyComparisonPoints"
                          rows="4"
                          required>@ViewBag.KeyComparisonPoints</textarea>

            </div>
        </div>

        <div class="pg-actions">
            <button type="submit" class="pg-btn pg-btn-primary">
                Forward to Top Committee
            </button>
        </div>
    </form>
</section>


<section class="ws-panel pg-panel">
    <h2>Executive summary preview</h2>

    @if (!string.IsNullOrWhiteSpace((string)ViewBag.Summary))
    {
        <div class="pg-field">
            <h3>Summary</h3>
            <p style="white-space: pre-wrap;">@ViewBag.Summary</p>
        </div>

        <div class="pg-field">
            <h3>Key comparison points</h3>
            <p style="white-space: pre-wrap;">
                @ViewBag.KeyComparisonPoints
            </p>
        </div>
    }
    else
    {
        <partial name="_EmptyState"
                 model='"No executive summary draft saved yet."' />
    }
</section>


<section class="ws-panel pg-panel">
    <h2>Forward to Top Committee</h2>

    <p>
        Review the forwarding requirements before sending
        the saved executive summary to the Top Committee.
    </p>

    @{
        bool hasSavedDraft =
            !string.IsNullOrWhiteSpace(
                ViewBag.Summary as string) &&
            !string.IsNullOrWhiteSpace(
                ViewBag.KeyComparisonPoints as string);
    }

    @if (!hasSavedDraft)
    {
        <p class="pg-hint">
            Please save your executive summary draft first.
        </p>
    }

    <form asp-area="SourcingManager"
          asp-controller="Reports"
          asp-action="SubmitToTopCommittee"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="pg-field pg-field-wide">
            <h3>Forwarding Review Checklist</h3>

            <label>
                <input type="checkbox"
                       name="costAndItemsReviewed"
                       value="true"
                       required />
                I have reviewed the total cost, deadline,
                product type, and quantity.
            </label>
        </div>

        <div class="pg-field pg-field-wide">
            <label>
                <input type="checkbox"
                       name="supplierReviewed"
                       value="true"
                       required />
                I have reviewed the recommended supplier
                and evaluation results.
            </label>
        </div>

        <div class="pg-field pg-field-wide">
            <label>
                <input type="checkbox"
                       name="readyForCommittee"
                       value="true"
                       required />
                I confirm this tender is ready
                for Top Committee review.
            </label>
        </div>

        <div class="pg-actions">
            <button type="submit"
                    class="pg-btn pg-btn-primary"
                    disabled="@(!hasSavedDraft)">
                Forward to Top Committee
            </button>
        </div>
    </form>
</section>
