@model List<Orange_Tendering_System.Models.Entities.TenderReport>

@{
    ViewData["Title"] = "Sourcing Manager Decision History";
    ViewData["WorkspaceSection"] = "Decision History";
    ViewData["Description"] = "Every decision you made on report versions.";
}

<partial name="_PageHeader" />

<section class="ws-panel pg-panel" aria-labelledby="tbl-decisions">
    <div class="pg-panel-head">
        <h2 id="tbl-decisions">Decisions</h2>
    </div>

    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead>
                <tr>
                    <th scope="col">Tender</th>
                    <th scope="col">Report version</th>
                    <th scope="col">Decision</th>
                    <th scope="col">Comment</th>
                    <th scope="col">Decided at</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <partial name="_EmptyState"
                                     model='"No decisions recorded yet."' />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td>@report.TenderRound?.Tender?.Title</td>

                            <td>Version @report.VersionNumber</td>

                            <td>@report.Status</td>

                            <td>@(report.ReviewComment ?? "-")</td>

                            <td>
                                @report.ReviewedAt?.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>
                                <a asp-area="SourcingManager"
                                   asp-controller="Reports"
                                   asp-action="Review"
                                   asp-route-id="@report.Id"
                                   class="pg-btn">
                                    View Report
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
