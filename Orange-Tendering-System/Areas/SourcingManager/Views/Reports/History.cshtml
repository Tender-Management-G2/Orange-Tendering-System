@model List<Orange_Tendering_System.ViewModels.WorkflowListRow>
@{
    ViewData["Title"] = "Decision History"; ViewData["WorkspaceSection"] = "Decision History";
    ViewData["Description"] = "Tenders whose report has already been decided.";
}
<partial name="_PageHeader" />
<section class="ws-panel pg-panel" aria-labelledby="mr-title">
    <div class="pg-panel-head"><h2 id="mr-title">Decision History</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender</th><th scope="col">Title</th><th scope="col">Status</th><th scope="col" data-nosort>Actions</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr><td>T-@row.TenderId.ToString("0000")</td><td><strong>@row.Title</strong></td><td>@row.Status</td><td><a class="pg-btn" data-no-modal asp-area="SourcingManager" asp-controller="Workflow" asp-action="Details" asp-route-id="@row.TenderId">Open</a></td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4"><partial name="_EmptyState" model='"No decided reports yet."' /></td></tr> }
            </tbody>
        </table>
    </div>
</section>
