@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Sourcing Manager Decision History

DEVELOPER OWNER: Haya
MODULE: Sourcing Manager Review
TRELLO TASK: Sourcing Manager Decision History
TRELLO URL: https://trello.com/c/CSb7lOgK

PURPOSE:
History of manager decisions, each attached to the report
version it applied to.

BUSINESS ACCESS:
Sourcing Manager

ROUTE: /SourcingManager/Reports/History

FUTURE IMPLEMENTATION:
- Query TenderReports where ReviewedByUserId = current user,
  newest first.

DEPENDENCIES:
TenderReports.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@
@{
    ViewData["Title"] = "Sourcing Manager Decision History";
    ViewData["WorkspaceSection"] = "Decision History";
    ViewData["Description"] = "Every decision you made on report versions.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel" aria-labelledby="tbl-decisions">
    <div class="pg-panel-head"><h2 id="tbl-decisions">Decisions</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender</th><th scope="col">Report version</th><th scope="col">Decision</th><th scope="col">Comment</th><th scope="col">Decided at</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"No decisions recorded yet."' /></td></tr></tbody>
        </table>
    </div>
</section>
