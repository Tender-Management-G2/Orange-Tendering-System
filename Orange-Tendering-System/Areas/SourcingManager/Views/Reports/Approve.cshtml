        <div><dt>Submitted</dt><dd>—</dd></div>
        <div><dt>Recommended offer</dt><dd>—</dd></div>
    </dl>
</section>

<partial name="_ConfirmAction" model='new ConfirmActionModel("Approve Evaluation Report", "Approve the detailed evaluation report.", "Sets the report version to Accepted with your decision. You can then forward the executive summary to the Top Committee.", false, false)' />

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="SourcingManager" asp-controller="Reports" asp-action="Review">Back to review</a></li>
