@model Orange_Tendering_System.Models.Entities.TenderReport

@{
    ViewData["Title"] = "Return Report for Review";
    ViewData["WorkspaceSection"] = "Report Review";
    ViewData["Description"] = "Return the report to the Sourcing Officer for correction.";
}

<partial name="_PageHeader" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<section class="ws-panel pg-panel">
    <h2>Report</h2>

    <dl class="pg-dl">
        <div>
            <dt>Tender</dt>
            <dd>@Model.TenderRound.Tender.Title</dd>
        </div>

        <div>
            <dt>Version</dt>
            <dd>v@Model.VersionNumber</dd>
        </div>

        <div>
            <dt>Submitted by</dt>
            <dd>
                @(Model.CreatedByUser?.UserName
                    ?? Model.CreatedByUserId)
            </dd>
        </div>

        <div>
            <dt>Submitted</dt>
            <dd>
                @(Model.SubmittedAt?.ToString("yyyy-MM-dd HH:mm")
                    ?? "Not submitted")
            </dd>
        </div>

        <div>
            <dt>Recommended offer</dt>
            <dd>
                @(Model.RecommendedBidId?.ToString()
                    ?? "No recommendation")
            </dd>
        </div>

        <div>
            <dt>Status</dt>
            <dd>@Model.Status</dd>
        </div>
    </dl>
</section>

<section class="ws-panel pg-panel pg-confirm"
         aria-labelledby="confirm-title">

    <h2 id="confirm-title">Return Report for Review</h2>

    <p>
        Return the evaluation report to the Sourcing Officer
        for correction.
    </p>

    <p class="pg-consequence">
        <strong>What this will do:</strong>
        Sets this report version to Returned.
        The Officer must submit a new version.
        The current version will be preserved.
    </p>

    <form asp-area="SourcingManager"
          asp-controller="ManagerReports"
          asp-action="Return"
          method="post"
          class="pg-form">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.Id" />

        <div class="pg-field">
            <label for="comment">
                Return reason (required)
            </label>

            <textarea id="comment"
                      name="comment"
                      rows="4"
                      maxlength="2000"
                      required
                      placeholder="Explain what needs to be corrected..."></textarea>
        </div>

        <div class="pg-actions">
            <button type="submit"
                    class="pg-btn pg-btn-primary">
                Confirm Return
            </button>

            <a asp-area="SourcingManager"
               asp-controller="ManagerReports"
               asp-action="Review"
               asp-route-id="@Model.Id">
                Cancel
            </a>
        </div>
    </form>
</section>
