@model Orange_Tendering_System.ViewModels.ReportReviewModel
@using Orange_Tendering_System.Models.Entities
@{ ViewData["Title"]=$"Evaluation report v{Model.Report.VersionNumber}"; var area=ViewContext.RouteData.Values["area"]?.ToString(); var id=Model.Report.Id; }
<style>.rl-panel{padding:1.2rem;border:1px solid #8885;border-radius:10px;margin:1rem 0}.rl-panel label{display:block;margin:.7rem 0}.rl-panel textarea,.rl-panel select{display:block;max-width:48rem;width:100%;padding:.6rem;background:transparent;color:inherit;border:1px solid #888;border-radius:4px}.rl-panel button,.rl-button{padding:.6rem 1rem;border:0;border-radius:4px;background:#ff7900;color:#111;font-weight:700}.rl-table{width:100%;border-collapse:collapse}.rl-table td,.rl-table th{text-align:left;padding:.6rem;border-bottom:1px solid #8885}.rl-scroll{overflow:auto}.rl-hash{overflow-wrap:anywhere}.rl-block{border-left:5px solid #ff7900;padding:1rem}.rl-pdf{width:100%;height:75vh;min-height:450px;border:1px solid #8885}</style>
<p><a asp-area="@area" asp-controller="Workflow" asp-action="Details" asp-route-id="@Model.Tender.Id">Return to tender</a></p>
<h1>@Model.Tender.Title - Evaluation report v@(Model.Report.VersionNumber)</h1>
<p>Report #@id | @Model.Report.Status | @(Model.IsCurrent ? "Current version" : "Historical / superseded version")</p>
@if(TempData["ReportMessage"] is string message) { <p role="status">@message</p> }
@if(!Model.IsCurrent) { <p class="rl-block">This version is retained for audit. Its endorsements cannot approve a newer version.</p> }
<section class="rl-panel"><h2>Review the automatically generated report</h2><p>The report layout and calculations are generated automatically. Each viewing or downloaded copy identifies its accessing user and UTC access time.</p>
<p><a class="rl-button" asp-area="@area" asp-controller="Reports" asp-action="Pdf" asp-route-id="@id" asp-route-download="true">Download your watermarked PDF</a> <a asp-area="@area" asp-controller="Reports" asp-action="Verify" asp-route-id="@id" target="_blank" rel="noopener">Verify document and signature receipts</a></p>
<p class="rl-hash">Canonical document SHA-256: <code>@Model.Report.PdfSha256</code></p>
<iframe class="rl-pdf" title="Personalized watermarked tender evaluation PDF" src="@Url.Action("Pdf","Reports",new { area, id })"></iframe>
</section>
<section class="rl-panel"><h2>Signing and approvals</h2><p>Review the PDF before signing your assigned section. Signing binds your authenticated identity, assigned role, report version, UTC time and canonical document hash.</p>
<p>Electronic acknowledgments are recorded separately from certificate-backed signing. Trusted personal certificates, when explicitly configured and verified, produce detached CMS signatures over the report-hash manifest. Viewing copies are watermarked derivatives; they are not presented as embedded certificate-signed PDFs.</p>
@if(Model.RequireCertificate) { <p class="rl-block">This deployment requires a trusted personal signing certificate. An unavailable or untrusted credential blocks signing.</p> }
@if(Model.CanSignCommittee && !Model.Signatures.Any(x=>x.Stage==ReportSigningStage.Evaluation && x.UserId==Model.UserId)) {
<form asp-area="EvaluationCommittee" asp-controller="Reports" asp-action="Sign" asp-route-id="@id" method="post"><input type="hidden" name="documentHash" value="@Model.Report.PdfSha256" /><label>Review observations<textarea name="comment" maxlength="2000"></textarea></label><partial name="_ReportSignaturePad" /><label><input type="checkbox" name="confirmed" value="true" required /> I have opened and reviewed this report version and explicitly sign my assigned Evaluation Committee section.</label><button>Sign and endorse this report version</button></form>
}
@if(Model.CanReviewManager) {
<form asp-area="SourcingManager" asp-controller="Reports" asp-action="Decision" asp-route-id="@id" method="post"><input type="hidden" name="documentHash" value="@Model.Report.PdfSha256" /><label>Manager decision<select name="decision"><option>Approve</option><option>Reject</option></select></label><label>Comments (required for rejection)<textarea name="comment" maxlength="2000"></textarea></label><partial name="_ReportSignaturePad" /><label><input type="checkbox" name="confirmed" value="true" required /> I have reviewed the current PDF. Approval explicitly signs my Manager section.</label><button>Record Manager decision</button></form>
}
@if(Model.CanVoteTop && !Model.Signatures.Any(x=>x.Stage==ReportSigningStage.Top && x.UserId==Model.UserId)) {
<form asp-area="TopCommittee" asp-controller="Reports" asp-action="Vote" asp-route-id="@id" method="post"><input type="hidden" name="documentHash" value="@Model.Report.PdfSha256" /><label>Official final decision<select name="decision"><option>Approve</option><option>Reject</option></select></label><label>Decision justification<textarea name="comment" maxlength="2000" required></textarea></label><partial name="_ReportSignaturePad" /><label><input type="checkbox" name="confirmed" value="true" required /> I have reviewed the report and explicitly sign my assigned Top Committee decision section.</label><button>Sign and record Top Committee decision</button></form>
}
@if(Model.CanForward) { <form asp-area="SourcingOfficer" asp-controller="Reports" asp-action="Forward" asp-route-id="@id" method="post"><p>All four current-version committee signatures are verified before forwarding.</p><button>Forward signed report to Sourcing Manager</button></form> }
<div class="rl-scroll"><table class="rl-table"><thead><tr><th>Assigned section</th><th>Signer / role</th><th>Decision and method</th><th>UTC</th><th>Applicability / receipt</th></tr></thead><tbody>
@foreach(var signature in Model.Signatures) { <tr><td>@signature.Stage / @signature.Slot</td><td>@signature.SignerName<br />@signature.UserId<br />@signature.Role</td><td>@signature.Decision<br />@signature.Method</td><td>@signature.SignedAt.ToString("u")</td><td>@(signature.InvalidatedAt==null && Model.IsCurrent ? "Current endorsement" : "Historical - not valid for a new version")<br /><a asp-area="@area" asp-controller="Reports" asp-action="Receipt" asp-route-id="@signature.Id">Download signature receipt</a> · <a asp-area="@area" asp-controller="Reports" asp-action="Receipt" asp-route-id="@signature.Id" asp-route-manifest="true">Download exact signed manifest</a><br />@signature.InvalidationReason</td></tr> }
</tbody></table></div></section>
@if(Model.CanReturn) {
<section class="rl-panel"><h2>Return for Revision</h2><p>Provide feedback and the required correction. Only an approved narrative route may proceed. A request to change locked weights, submitted bids or finalized scores enters a blocked policy state.</p>
<form asp-area="@area" asp-controller="Reports" asp-action="Return" asp-route-id="@id" method="post"><input name="RequestId" type="hidden" value="@Guid.NewGuid()" /><input name="DocumentHash" type="hidden" value="@Model.Report.PdfSha256" /><label>Target responsible party<select name="Target"><option value="SourcingOfficer">Assigned Sourcing Officer</option><option value="ReportAuthor">Original report author</option></select></label><label>Required correction category<select name="Correction"><option value="NarrativeOnly">Narrative clarification only</option><option value="Weights">Approved evaluation weights - policy blocked</option><option value="SupplierBid">Deadline-locked supplier bid - policy blocked</option><option value="FinalScores">Finalized committee scores - policy blocked</option></select></label><label>Mandatory feedback<textarea name="Feedback" maxlength="4000" required></textarea></label><label>Required corrective action<textarea name="RequiredAction" maxlength="4000" required></textarea></label><button>Record Return for Revision</button></form>
</section>
}
<section class="rl-panel"><h2>Feedback, correction assignments and resubmission history</h2>
@foreach(var revision in Model.Revisions) {
<article class="rl-panel"><h3>Revision request #@revision.Id - @revision.Status</h3><p>Report #@revision.TenderReportId | @revision.SourceStage → @revision.TargetStage | @revision.Correction</p><p>Returning user: @revision.ReturningUserId | Responsible user: @revision.ResponsibleUserId | @revision.RequestedAt.ToString("u")</p><p><strong>Feedback:</strong> @revision.Feedback</p><p><strong>Required action:</strong> @revision.RequiredAction</p>
@if(revision.Status==RevisionStatus.PolicyBlocked) { <p class="rl-block">@revision.Blocker</p>
@if(revision.ReturningUserId==Model.UserId) { <form asp-area="@area" asp-controller="Reports" asp-action="ActivateRevision" asp-route-id="@id" method="post"><input name="revisionId" type="hidden" value="@revision.Id" /><p>Activation succeeds only after an explicit policy authorizes this exact route and returning identity. Locked source changes remain blocked.</p><button>Check approved revision policy</button></form> }
}
@if(revision.Status==RevisionStatus.AwaitingCorrection && revision.ResponsibleUserId==Model.UserId) {
<form asp-area="@area" asp-controller="Reports" asp-action="Resubmit" asp-route-id="@revision.TenderReportId" method="post"><input name="revisionId" type="hidden" value="@revision.Id" /><label>Permitted narrative correction<textarea name="correction" maxlength="10000" required></textarea></label><p>The system recalculates from preserved source records, generates a new PDF version, supersedes old endorsements and requires fresh committee signing. You cannot edit report layout, weights, bids or finalized scores here.</p><button>Resubmit as a new generated report version</button></form>
}
@if(revision.ResubmittedReportId!=null) { <p>Resubmitted @revision.ResubmittedAt?.ToString("u") | <a asp-area="@area" asp-controller="Reports" asp-action="Review" asp-route-id="@revision.ResubmittedReportId">Open resubmitted report #@revision.ResubmittedReportId</a></p><p>@revision.CorrectionSummary</p> }
</article>
}
</section>
<section class="rl-panel"><h2>Document version history</h2><ul>@foreach(var version in Model.Versions) { <li><a asp-area="@area" asp-controller="Reports" asp-action="Review" asp-route-id="@version.Id">Version @version.VersionNumber - @version.Status</a> | @version.CreatedAt.ToString("u") @(version.SupersededAt==null ? "" : "| Superseded")</li> }</ul></section>


