@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Technical Evaluation

DEVELOPER OWNER: Tariq
MODULE: Technical & Financial Evaluation Committee
TRELLO TASK: Technical Evaluation
TRELLO URL: Not provided — add from the Trello board

PURPOSE:
A committee member enters technical scores and remarks for
each eligible offer.

BUSINESS ACCESS:
Evaluation Committee member (assigned to the tender)

ROUTE: /EvaluationCommittee/Evaluations/Technical/{id?}

FUTURE IMPLEMENTATION:
- List eligible (Compliant) offers of the round.
- POST: one EvaluationScore per (Bid, Criterion,
  CommitteeMember) — unique index prevents duplicates.
- Validate 0 ≤ score ≤ MaxScore once the scale is decided.
- Block edits after the round is approved or rejected.

DEPENDENCIES:
EvaluationCriteria (Type = Technical), EvaluationScores,
CommitteeMembers, Bids.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.
===========================================================
*@
@{
    ViewData["Title"] = "Technical Evaluation";
    ViewData["WorkspaceSection"] = "Technical Evaluation";
    ViewData["Description"] = "Score each eligible offer against the technical criteria of this round.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="ws-panel pg-panel">
    <h2>Context</h2>
    <dl class="pg-dl">
        <div><dt>Tender</dt><dd>—</dd></div>
        <div><dt>Committee round</dt><dd>—</dd></div>
        <div><dt>Offer being scored</dt><dd>—</dd></div>
        <div><dt>Officer report version</dt><dd>—</dd></div>
    </dl>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-technical-scoring">
    <div class="pg-panel-head"><h2 id="tbl-technical-scoring">Technical scoring</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Criterion</th><th scope="col">Weight</th><th scope="col">Max score</th><th scope="col">My score</th><th scope="col">Remarks</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"Technical criteria for this round are not loaded."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel">
    <h2>Observations</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field pg-field-wide"><label for="f-technical-observations-1">Technical observations</label><textarea id="f-technical-observations-1" rows="4"></textarea></div>
            </div>
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Save technical scores</button><span class="pg-hint">Not implemented yet — nothing is saved.</span></div>
        </fieldset>
    </form>
</section>
