@model List<Orange_Tendering_System.ViewModels.WorkflowListRow>
@{
    Layout = User.IsInRole(Orange_Tendering_System.Models.SystemRoles.SourcingManager) ? "_SourcingManagerLayout" : "_EvaluationCommitteeLayout";
    ViewData["Title"] = "Weighted Tender Evaluation"; ViewData["WorkspaceSection"] = "Weighted Evaluation"; var area=ViewContext.RouteData.Values["area"]?.ToString(); var controller=ViewContext.RouteData.Values["controller"]?.ToString(); }
<h1>Weighted Tender Evaluation</h1>
<p>Requirements → four proposals → formal weight approval → bidding → compliance → evaluation → recommendation → final approval and award.</p>
@if(area=="SourcingOfficer") { <p><a asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Create">Prepare tender from an accepted Purchase Request</a></p> }
@if(Model.Count==0) { <p>No authorized tenders are assigned to this account.</p> }
@foreach(var row in Model) { <section class="ws-panel pg-panel"><h2><a asp-area="@area" asp-controller="@controller" asp-action="Details" asp-route-id="@row.TenderId">@row.Title</a></h2><p>#@row.TenderId · @row.Status</p></section> }
