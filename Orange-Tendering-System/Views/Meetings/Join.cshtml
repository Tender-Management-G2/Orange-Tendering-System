@model Orange_Tendering_System.Controllers.MeetingsController.MeetingInfo
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Evaluation meeting"; ViewData["WorkspaceSection"] = "Weighted Evaluation";
    ViewData["Description"] = "Video meeting of the evaluation committee: " + Model.Title;
}
<partial name="_PageHeader" />
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><div><h2>@Model.Title</h2><span class="pg-hint">Scheduled <time data-local="@DateTime.SpecifyKind(Model.StartsAt, DateTimeKind.Utc).ToString("O")">@Model.StartsAt.ToString("u")</time> – <time data-local="@DateTime.SpecifyKind(Model.EndsAt, DateTimeKind.Utc).ToString("O")">@Model.EndsAt.ToString("u")</time></span></div>
        <div class="pg-actions"><a class="pg-btn" data-no-modal target="_blank" rel="noopener noreferrer" href="@Model.Url">Open in a new tab</a>
            <a class="pg-btn" data-no-modal asp-area="" asp-controller="Workflow" asp-action="Details" asp-route-id="@Model.TenderId">Back to the tender</a></div></div>
    <div id="meet" data-room="@Model.Room" data-name="@Model.DisplayName" style="width:100%;height:640px;border-radius:14px;overflow:hidden;background:#000"></div>
    <p class="pg-hint">Allow camera and microphone when your browser asks. This meeting room is private to the Sourcing Officer and the four committee members.</p>
</section>
@section Scripts {
    <script src="https://meet.jit.si/external_api.js"></script>
    <script>
        window.addEventListener('load', function () {
            var holder = document.getElementById('meet');
            if (!window.JitsiMeetExternalAPI) { holder.innerHTML = '<p style="color:#fff;padding:24px">The video service could not be loaded. Use "Open in a new tab".</p>'; return; }
            new JitsiMeetExternalAPI('meet.jit.si', { roomName: holder.dataset.room, parentNode: holder, width: '100%', height: 640, userInfo: { displayName: holder.dataset.name } });
        });
    </script>
}
