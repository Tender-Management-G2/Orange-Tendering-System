@*
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Orange Intelligence - the Sourcing Officer intelligence workspace.
Four exclusive tabs (Overview, Suppliers, Tenders, AI Studio): a tab replaces the main content, it never stacks below
another. All numbers come from the server (Services/Radar), already limited to the user's authorized scope; the scripts only
draw them. The AI Studio tab (Gemini) has three features: supplier summary, text chat and a live voice call
(intelligence-ai.js, intelligence-audio.js, Services/Radar/IntelligenceAiService.cs).
*@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "_SourcingOfficerLayout";
    var arabic = UiLanguage.IsArabic(Context);
    string L(string en, string ar) => arabic ? ar : en;
    string U(string action) => Url.Action(action, "Intelligence", new { area = "" })!;
}
@section Styles {
    <link rel="stylesheet" href="~/css/orange-radar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orange-intelligence.css" asp-append-version="true" />
}

<div class="radar oi" id="radar" data-radar data-tab="suppliers"
     data-csrf="@Antiforgery.GetAndStoreTokens(Context).RequestToken"
     data-ui-language="@(arabic ? "ar" : "en")"
     data-url-workspace="@U("Workspace")" data-url-simulate="@U("Simulate")"
     data-url-offer-comparison="@U("OfferComparison")"
     data-url-offer-record="@Url.Action("Details", "Bids", new { area = "SourcingOfficer" })"
     data-url-export="@U("Export")" data-three="@Url.Content("~/lib/three/three.module.min.js")">

    <!-- ===== Shared shell: brand, four exclusive tabs, global scope ===== -->
    <header class="oi-bar">
        <div class="oi-brand">
            <span class="oi-mark" aria-hidden="true"><svg viewBox="0 0 40 40"><circle cx="18" cy="22" r="12.5" /><circle cx="18" cy="22" r="5.2" /><path d="M27 13l7-7M29 6h5v5" /></svg></span>
            <div><h1>Orange <em>Intelligence</em></h1><p>@L("Procurement intelligence & analytics", "ذكاء المشتريات والتحليلات")</p></div>
        </div>
        <nav class="oi-tabs" role="tablist" aria-label="@L("Orange Intelligence workspaces", "مساحات أورنج للذكاء")" data-tabs>
            <button type="button" role="tab" id="oi-tab-overview" aria-controls="oi-overview" aria-selected="false" tabindex="-1" data-tab-link="overview"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2" /><rect x="13.5" y="3" width="7.5" height="7.5" rx="2" /><rect x="3" y="13.5" width="7.5" height="7.5" rx="2" /><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2" /></svg><span>@L("Overview", "نظرة عامة")</span></button>
            <button type="button" role="tab" id="oi-tab-suppliers" aria-controls="oi-suppliers" aria-selected="true" data-tab-link="suppliers"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-4 3.2-6 6.5-6s5.9 2 6.5 6M16 4.8a3.3 3.3 0 0 1 0 6.4M18.5 14.4c1.8.8 2.8 2.7 3 5.6" /></svg><span>@L("Suppliers", "الموردون")</span></button>
            <button type="button" role="tab" id="oi-tab-tenders" aria-controls="oi-tenders" aria-selected="false" tabindex="-1" data-tab-link="tenders"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5" /></svg><span>@L("Tenders", "العطاءات")</span></button>
            <button type="button" role="tab" id="oi-tab-studio" aria-controls="oi-studio" aria-selected="false" tabindex="-1" data-tab-link="studio"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM18.5 15l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9zM5.5 15.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z" /></svg><span>@L("AI Studio", "استوديو الذكاء")</span></button>
        </nav>
    </header>

    <div class="oi-context" role="group" aria-label="@L("Analysis scope", "نطاق التحليل")">
        <span class="oi-scope" data-scope title="@L("Your data permissions decide what is analysed.", "صلاحياتك تحدد البيانات المحللة.")"><i aria-hidden="true"></i><span data-scope-label>@L("Authorized scope", "النطاق المصرح")</span></span>
        <div class="oi-period">
            <label><span>@L("From", "من")</span><input type="date" id="rd-from" /></label>
            <label><span>@L("To", "إلى")</span><input type="date" id="rd-to" /></label>
            <button type="button" class="rd-icon-btn" data-action="run" aria-label="@L("Refresh analysis", "تحديث التحليل")" title="@L("Refresh analysis", "تحديث التحليل")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.4-5.7M20 4v5h-5" /></svg></button>
        </div>
        <div class="oi-chips" data-filter-chips aria-live="polite"></div>
        <b class="rd-demo" data-demo-marker hidden>@L("Demo dataset", "بيانات تجريبية")</b>
        <div class="rd-status" role="status" aria-live="polite" data-status></div>
        <div class="oi-context-find">
            <label class="oi-find">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg>
                <input type="search" list="oi-find-list" data-global-find placeholder="@L("Find a supplier or tender", "ابحث عن مورد أو عطاء")" aria-label="@L("Find an authorized supplier or tender", "ابحث عن مورد أو عطاء مصرح به")" autocomplete="off" />
                <datalist id="oi-find-list" data-global-find-list></datalist>
            </label>
        </div>
        </div>

    <!-- ===== 1. Overview ===== -->
    <section class="oi-panel" id="oi-overview" role="tabpanel" aria-labelledby="oi-tab-overview" data-tab-panel="overview" hidden>
        <header class="oi-head">
            <div><p class="oi-kicker">@L("Overview", "نظرة عامة")</p><h2>@L("Your procurement intelligence at a glance", "ذكاء مشترياتك في لمحة")</h2>
                <p class="oi-lead" data-ov-lead></p></div>
        </header>
        <div class="oi-kpis" data-ov-kpis></div>
        <div class="oi-ov-grid">
            <article class="rd-card oi-lifecycle-card">
                <header><div><h3>@L("Tender Lifecycle", "دورة حياة العطاء")</h3><p data-ov-life-note></p></div><button type="button" class="rd-link" data-tab-jump="tenders">@L("Open Tenders", "فتح العطاءات")</button></header>
                <ol class="oi-funnel" data-ov-funnel></ol>
            </article>
            <article class="rd-card oi-attention">
                <header><div><h3>@L("Worth your attention", "يستحق انتباهك")</h3><p>@L("From the records in your scope · each item links to its evidence", "من السجلات في نطاقك · كل بند مرتبط بدليله")</p></div></header>
                <ul class="oi-attention-list" data-ov-attention></ul>
            </article>
        </div>
        <nav class="oi-shortcuts" aria-label="@L("Workspaces", "مساحات العمل")" data-ov-shortcuts></nav>
    </section>

    <!-- ===== 2. Suppliers (signature view) ===== -->
    <section class="oi-panel oi-suppliers" id="oi-suppliers" role="tabpanel" aria-labelledby="oi-tab-suppliers" data-tab-panel="suppliers">
        <header class="oi-head">
            <div class="oi-head-title"><span class="oi-head-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-4 3.2-6 6.5-6s5.9 2 6.5 6M16 4.8a3.3 3.3 0 0 1 0 6.4M18.5 14.4c1.8.8 2.8 2.7 3 5.6" /></svg></span>
                <div><h2>@L("Supplier Intelligence", "ذكاء الموردين")</h2><p class="oi-lead">@L("Explore your supplier ecosystem, participation and relationships.", "استكشف منظومة مورديك ومشاركتهم وعلاقاتهم.")</p></div></div>
            <div class="oi-filters" role="group" aria-label="@L("Supplier filters", "مرشحات الموردين")">
                <label class="oi-select"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12l9-8 9 8M5 10v10h14V10" /></svg><select data-sup-filter="department" aria-label="@L("Department", "الجهة")"></select></label>
                <label class="oi-select"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4zM3 12l9 4 9-4M3 17l9 4 9-4" /></svg><select data-sup-filter="category" aria-label="@L("Category", "الفئة")"></select></label>
                <label class="oi-select"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg><select data-sup-filter="activity" aria-label="@L("Activity", "النشاط")">
                    <option value="all">@L("All suppliers", "جميع الموردين")</option><option value="active">@L("Submitted offers", "قدّموا عروضاً")</option><option value="silent">@L("No offer yet", "دون عروض")</option><option value="approved">@L("Approved only", "المعتمدون فقط")</option></select></label>
            </div>
        </header>

        <div class="oi-kpis oi-kpis-sup" data-sup-kpis></div>

        <article class="oi-snapshot" aria-label="@L("Market snapshot", "لمحة السوق")">
            <div class="oi-snap-title"><h3>@L("Market snapshot", "لمحة السوق")</h3><p>@L("Category mix and participation over time", "مزيج الفئات والمشاركة عبر الزمن")</p></div>
            <div class="oi-snap-donut" data-chart="snapCats" role="img" aria-label="@L("Suppliers by category", "الموردون حسب الفئة")"></div>
            <ul class="oi-snap-legend" data-snap-legend></ul>
            <div class="oi-snap-trend"><p class="oi-snap-sub" data-snap-trend-title>@L("Suppliers submitting offers, per month", "الموردون المقدمون للعروض شهرياً")</p><div data-chart="snapTrend" role="img" aria-label="@L("Participation trend", "اتجاه المشاركة")"></div></div>
        </article>

        <!-- The Supplier Universe: real authorized suppliers on a slowly orbiting 3D sphere. -->
        <div class="oi-universe" data-universe data-mode="universe">
            <div class="oi-uni-stage" data-uni-stage role="application" tabindex="0" aria-roledescription="@L("3D supplier universe", "عالم الموردين ثلاثي الأبعاد")"
                 aria-label="@L("Supplier universe. Drag to rotate, wheel to zoom, arrow keys move between suppliers, Enter selects, Space pauses, Escape returns.", "عالم الموردين. اسحب للتدوير، العجلة للتكبير، الأسهم للتنقل، Enter للاختيار، المسافة للإيقاف، Esc للعودة.")">
                <canvas data-uni-canvas aria-hidden="true"></canvas>
                <div class="oi-uni-labels" data-uni-labels aria-hidden="true"></div>
                <div class="oi-uni-tip" data-uni-tip role="tooltip" hidden></div>
            </div>

            <div class="oi-uni-panel" role="group" aria-label="@L("Universe controls", "أدوات العالم")">
                <h3>@L("Supplier Universe", "عالم الموردين")</h3>
                <p class="oi-uni-desc" data-uni-desc></p>
                <p class="oi-field-label" id="oi-uni-mode-label">@L("Arrangement", "الترتيب")</p>
                <div class="oi-modes" role="radiogroup" aria-labelledby="oi-uni-mode-label" data-uni-modes>
                    <button type="button" role="radio" aria-checked="true" data-uni-mode="universe"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><ellipse cx="12" cy="12" rx="3.6" ry="8.5" /><path d="M3.5 12h17" /></svg>@L("Universe", "العالم")</button>
                    <button type="button" role="radio" aria-checked="false" data-uni-mode="category"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="8" r="3.5" /><circle cx="17" cy="8" r="3.5" /><circle cx="12" cy="17" r="3.5" /></svg>@L("Category", "الفئة")</button>
                    <button type="button" role="radio" aria-checked="false" data-uni-mode="competition"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z" /></svg>@L("Competition", "المنافسة")</button>
                    <button type="button" role="radio" aria-checked="false" data-uni-mode="tender"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7zM14 3v4h4" /></svg>@L("Tender", "العطاء")</button>
                </div>
                <label class="oi-field" data-uni-tender-field hidden><span>@L("Tender", "العطاء")</span><select data-uni-tender aria-label="@L("Tender context", "سياق العطاء")"></select></label>
                <label class="oi-field"><span>@L("Find a supplier", "ابحث عن مورد")</span><input type="search" list="oi-uni-list" data-uni-search placeholder="@L("Name or category", "الاسم أو الفئة")" autocomplete="off" /><datalist id="oi-uni-list" data-uni-list></datalist></label>
                <label class="oi-switch"><input type="checkbox" data-uni-opt="labels" checked /><span>@L("Show labels", "إظهار الأسماء")</span></label>
                <label class="oi-switch"><input type="checkbox" data-uni-opt="links" checked /><span>@L("Show relationships", "إظهار العلاقات")</span></label>
                <div class="oi-uni-legend" data-uni-legend></div>
            </div>

            <div class="oi-uni-tools" role="toolbar" aria-label="@L("View controls", "أدوات العرض")">
                <button type="button" data-uni-tool="motion" aria-pressed="false" title="@L("Pause motion (Space)", "إيقاف الحركة (مسافة)")" aria-label="@L("Pause motion", "إيقاف الحركة")"><svg viewBox="0 0 24 24" aria-hidden="true" data-icon-pause><path d="M8 5v14M16 5v14" /></svg><svg viewBox="0 0 24 24" aria-hidden="true" data-icon-play hidden><path d="M7 4l13 8-13 8z" /></svg></button>
                <button type="button" data-uni-tool="reset" title="@L("Reset view", "إعادة ضبط العرض")" aria-label="@L("Reset view", "إعادة ضبط العرض")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v5h5" /></svg></button>
                <span class="oi-tools-sep" aria-hidden="true"></span>
                <button type="button" data-uni-tool="3d" aria-pressed="true" class="oi-tool-text">3D</button>
                <button type="button" data-uni-tool="2d" aria-pressed="false" class="oi-tool-text" title="@L("2D network with path and replay", "شبكة ثنائية الأبعاد مع المسار والإعادة")">2D</button>
                <button type="button" data-uni-tool="table" aria-pressed="false" title="@L("Supplier table", "جدول الموردين")" aria-label="@L("Supplier table", "جدول الموردين")"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M9 10v9" /></svg></button>
                <button type="button" data-uni-tool="fullscreen" title="@L("Full screen", "ملء الشاشة")" aria-label="@L("Full screen", "ملء الشاشة")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
            </div>

            <aside class="oi-inspector" data-uni-inspector aria-labelledby="oi-insp-title" hidden>
                <header>
                    <span class="oi-insp-icon" aria-hidden="true" data-insp-icon><svg viewBox="0 0 24 24"><path d="M4 21V5l8-3 8 3v16M4 21h16M9 9h1M14 9h1M9 13h1M14 13h1M10 21v-4h4v4" /></svg></span>
                    <div><h3 id="oi-insp-title" data-insp-title tabindex="-1"></h3><p data-insp-sub></p></div>
                    <span class="oi-pill" data-insp-status></span>
                    <button type="button" class="rd-icon-btn" data-insp-close aria-label="@L("Close supplier details", "إغلاق تفاصيل المورد")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                </header>
                <div class="oi-insp-tabs" role="tablist" aria-label="@L("Supplier details", "تفاصيل المورد")" data-insp-tabs>
                    <button type="button" role="tab" aria-selected="true" data-insp-tab="overview">@L("Overview", "نظرة عامة")</button>
                    <button type="button" role="tab" aria-selected="false" data-insp-tab="participation">@L("Participation", "المشاركة")</button>
                    <button type="button" role="tab" aria-selected="false" data-insp-tab="pricing">@L("Pricing", "الأسعار")</button>
                    <button type="button" role="tab" aria-selected="false" data-insp-tab="relationships">@L("Relationships", "العلاقات")</button>
                </div>
                <div class="oi-insp-body" data-insp-body role="tabpanel"></div>
                <footer class="oi-insp-foot" data-insp-foot></footer>
            </aside>

            <div class="oi-uni-table" data-uni-table hidden></div>
            <div class="oi-uni-empty" data-uni-empty hidden></div>
            <p class="oi-uni-caption" data-uni-caption aria-live="polite"></p>

            <!-- 2D fallback: the full network engine (path, replay, PNG). -->
            <div class="oi-net2d" data-net2d hidden>
                <div class="oi-net2d-head"><div><h3 data-net-title>@L("The supplier market", "سوق الموردين")</h3><p data-net-caption></p></div><p class="rd-net-counts" data-net-counts aria-live="polite"></p></div>
                <div class="rd-net-shell" data-net-stage>
                    <div class="rd-net-head" role="toolbar" aria-label="@L("Network controls", "أدوات الشبكة")">
                        <div class="rd-seg rd-seg-views" role="radiogroup" aria-label="@L("Network view", "عرض الشبكة")" data-net-views>
                            <button type="button" role="radio" aria-checked="true" data-net-view="category">@L("Category", "الفئة")</button>
                            <button type="button" role="radio" aria-checked="false" data-net-view="competition">@L("Competition", "المنافسة")</button>
                            <button type="button" role="radio" aria-checked="false" data-net-view="tender">@L("Tender", "المناقصة")</button>
                        </div>
                        <label class="rd-search">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg>
                            <input type="search" list="rd-net-suggest" placeholder="@L("Find a supplier or category", "ابحث عن مورد أو فئة")" data-net-search aria-label="@L("Find a supplier or category in the network", "ابحث عن مورد أو فئة في الشبكة")" autocomplete="off" />
                            <datalist id="rd-net-suggest" data-net-suggest></datalist>
                        </label>
                        <span class="rd-toolbar-spacer"></span>
                        <div class="rd-tools">
                            <button type="button" class="rd-tool" data-net-tool="filters" aria-expanded="false" aria-controls="rd-net-filters"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg><span>@L("Filters", "مرشحات")</span><b class="rd-tool-badge" data-net-filter-badge hidden></b></button>
                            <button type="button" class="rd-tool" data-net-tool="path"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="18" r="2.5" /><circle cx="19" cy="6" r="2.5" /><path d="M7 16.5C10 14 9 9 12 9s3 0 5-1.5" /></svg><span>@L("Path", "المسار")</span></button>
                            <button type="button" class="rd-tool" data-net-tool="replay" aria-expanded="false" aria-controls="rd-replay"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5M12 8v4l3 2" /></svg><span>@L("Replay", "إعادة")</span></button>
                            <button type="button" class="rd-tool" data-net-tool="table" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M9 10v9" /></svg><span>@L("Table", "جدول")</span></button>
                            <button type="button" class="rd-tool rd-tool-icon" data-net-tool="png" aria-label="@L("Export network as PNG", "تصدير الشبكة كصورة")" title="PNG"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg></button>
                            <button type="button" class="rd-tool rd-tool-icon" data-net-tool="fullscreen" aria-label="@L("Full screen", "ملء الشاشة")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
                        </div>
                    </div>
                    <div class="rd-net-filters" id="rd-net-filters" data-net-filter-panel hidden>
                        <fieldset class="rd-filter-wide"><legend>@L("Links shown", "الروابط المعروضة")</legend><div class="rd-chips" data-net-rel role="group"></div></fieldset>
                        <fieldset class="rd-filter-wide"><legend>@L("Categories", "الفئات")</legend><div class="rd-check-grid" data-net-cats></div></fieldset>
                        <fieldset><legend>@L("Suppliers", "الموردون")</legend>
                            <label><input type="checkbox" data-net-opt="inactive" checked /> @L("Include not-approved suppliers", "تضمين غير المعتمدين")</label>
                            <label><input type="checkbox" data-net-opt="isolated" checked /> @L("Include suppliers with no link", "تضمين الموردين بلا روابط")</label>
                        </fieldset>
                        <fieldset><legend>@L("Competition", "المنافسة")</legend>
                            <label>@L("Link after", "اربط بعد") <select data-net-opt="competition-min"><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option></select> @L("shared bidding cycles", "دورات عطاء مشتركة")</label>
                        </fieldset>
                        <button type="button" class="rd-link" data-net-tool="clear-filters">@L("Reset filters", "إعادة ضبط المرشحات")</button>
                    </div>
                    <div class="rd-net-body">
                        <div class="rd-net-canvas" data-net-canvas>
                            <div class="rd-cy" data-cy role="application" tabindex="0" aria-roledescription="@L("network", "شبكة")" aria-label="@L("Supplier network. Drag to pan, wheel to zoom, Space pauses motion, Escape steps back.", "شبكة الموردين.")"></div>
                            <nav class="rd-crumbs" data-net-crumbs aria-label="@L("Network focus", "تركيز الشبكة")" hidden></nav>
                            <div class="rd-selection" data-net-selection aria-live="polite"></div>
                            <div class="rd-net-replaying" data-net-replaying hidden></div>
                            <div class="rd-empty" data-net-empty hidden></div>
                        </div>
                        <aside class="rd-inspector" data-inspector aria-labelledby="rd-inspector-title" hidden>
                            <header>
                                <div><p class="rd-kicker" data-inspector-kicker></p><h3 id="rd-inspector-title" data-inspector-title tabindex="-1"></h3></div>
                                <button type="button" class="rd-icon-btn" data-inspector-close aria-label="@L("Close inspector", "إغلاق المفتش")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                            </header>
                            <div class="rd-inspector-body" data-inspector-body></div>
                        </aside>
                    </div>
                    <div class="rd-net-foot">
                        <div class="rd-groups" data-net-groups role="group" aria-label="@L("Groups in this view", "المجموعات في هذا العرض")"></div>
                        <div class="rd-legend" data-net-legend aria-label="@L("Legend", "دليل الرموز")"></div>
                        <div class="rd-zoom" role="group" aria-label="@L("Motion and zoom", "الحركة والتكبير")">
                            <button type="button" class="rd-motion" data-net-tool="motion" aria-pressed="false"><i aria-hidden="true"></i><span data-motion-label>Live</span></button>
                            <button type="button" data-net-tool="zoom-out" aria-label="@L("Zoom out", "تصغير")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></button>
                            <button type="button" data-net-tool="zoom-in" aria-label="@L("Zoom in", "تكبير")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
                            <button type="button" data-net-tool="fit" aria-label="@L("Fit to view", "ملاءمة العرض")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
                            <button type="button" data-net-tool="reset" aria-label="@L("Reset layout", "إعادة ضبط التخطيط")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v5h5" /></svg></button>
                        </div>
                    </div>
                    <div class="rd-replay" id="rd-replay" data-replay hidden aria-label="@L("Historical replay", "الإعادة التاريخية")">
                        <button type="button" class="rd-icon-btn rd-replay-play" data-timeline="play" aria-label="@L("Play historical replay", "تشغيل الإعادة التاريخية")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" /></svg></button>
                        <button type="button" class="rd-icon-btn" data-timeline="reset" aria-label="@L("Show all history", "إظهار كل التاريخ")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v5h5" /></svg></button>
                        <select data-timeline-speed aria-label="@L("Replay speed", "سرعة الإعادة")"><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option></select>
                        <div class="rd-track"><canvas data-timeline-canvas height="48" aria-hidden="true"></canvas><input type="range" min="0" max="1000" value="1000" data-timeline-range aria-label="@L("Replay date", "تاريخ الإعادة")" /></div>
                        <output data-timeline-date>All history</output>
                    </div>
                </div>
                <div class="rd-net-table" data-net-table hidden></div>
            </div>
        </div>

        <section class="oi-insights" aria-labelledby="oi-insights-title">
            <header class="oi-insights-head">
                <span class="oi-insights-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 18v-4m7 4V6m7 12v-8" /></svg></span>
                <div><h3 id="oi-insights-title">@L("Supplier Performance Analytics", "تحليلات أداء الموردين")</h3><p>@L("AI-powered insights into supplier participation, pricing, and competitive positioning.", "رؤى ذكية حول مشاركة الموردين وأسعارهم وموقعهم التنافسي.")</p></div>
                <span class="oi-insights-badge">✦ &nbsp;@L("AI Procurement Intelligence", "ذكاء المشتريات")</span>
            </header>
            <div class="oi-insight-tabs" role="tablist" aria-label="@L("Supplier insights", "رؤى الموردين")">
                <button type="button" role="tab" id="oi-insight-landscape-tab" aria-controls="oi-insight-landscape" aria-selected="false" tabindex="-1" data-insight-tab="landscape"><span aria-hidden="true">✣</span>@L("Participation vs Response Rate", "المشاركة مقابل معدل الاستجابة")</button>
                <button type="button" role="tab" id="oi-insight-positions-tab" aria-controls="oi-insight-positions" aria-selected="true" data-insight-tab="positions"><span aria-hidden="true">⌁</span>@L("Price Position Over Time", "موقع السعر عبر الزمن")</button>
            </div>
            <div class="oi-insight-context" aria-live="polite">
                <span><b>@L("Suppliers", "الموردون")</b><span data-insight-suppliers>@L("All in scope", "جميع الموردين في النطاق")</span></span>
                <span><b>@L("Category", "الفئة")</b><span data-insight-category>@L("All categories", "جميع الفئات")</span></span>
                <span><b>@L("Date range", "الفترة")</b><span data-insight-period>@L("All history", "كل الفترات")</span></span>
                <span><b>@L("Compare", "المقارنة")</b><span data-insight-compare>@L("vs. bidding cycle median", "مقابل وسيط دورة العطاء")</span></span>
            </div>
            <p class="rd-focus-bar" data-market-focus aria-live="polite"></p>
            <div class="oi-insight-panels">
                <article class="rd-card" id="oi-insight-landscape" role="tabpanel" aria-labelledby="oi-insight-landscape-tab" data-insight-panel="landscape" hidden>
                    <header><div><h3 data-landscape-title>@L("Participation and success", "المشاركة والنجاح")</h3><p data-landscape-note></p></div><button type="button" class="rd-link" data-table="landscape">@L("Table", "جدول")</button></header>
                    <div class="rd-chart" data-chart="landscape" role="img" aria-label="@L("Supplier landscape chart", "مخطط خريطة الموردين")"></div>
                </article>
                <article class="rd-card" id="oi-insight-positions" role="tabpanel" aria-labelledby="oi-insight-positions-tab" data-insight-panel="positions">
                    <header><div><h3>@L("Price position over time", "موقع السعر عبر الزمن")</h3><p>@L("Each offer vs. its bidding cycle median, same currency · below 0 = cheaper", "كل عرض مقابل وسيط دورة عطائه · أقل من 0 = أرخص")</p></div><button type="button" class="rd-link" data-table="positions">@L("Table", "جدول")</button></header>
                    <div class="rd-chart" data-chart="positions" role="img" aria-label="@L("Relative price position chart", "مخطط موقع السعر النسبي")"></div>
                </article>
            </div>
            <div class="oi-insight-takeaways" data-insight-takeaways aria-live="polite"></div>
        </section>
        <section class="oi-comparison" data-offer-comparison aria-labelledby="oi-comparison-title">
            <header class="oi-comparison-head">
                <span class="oi-insights-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 18h16M4 6v12M8 9h7M8 14h11" /></svg></span>
                <div><h3 id="oi-comparison-title">@L("Supplier Offer Comparison", "مقارنة عروض الموردين")</h3><p>@L("Compare two suppliers' financial offers and submission activity within a selected tender.", "قارن العروض المالية ونشاط تقديم العروض لموردين ضمن عطاء محدد.")</p></div>
            </header>
            <div class="oi-comparison-controls">
                <label>@L("First supplier", "المورد الأول")<select data-comparison-supplier="a" disabled></select></label>
                <label>@L("Second supplier", "المورد الثاني")<select data-comparison-supplier="b" disabled></select></label>
                <label>@L("Tender", "العطاء")<select data-comparison-tender disabled></select></label>
            </div>
            <p class="oi-comparison-status" data-comparison-status role="status">@L("Loading authorized suppliers…", "جارٍ تحميل الموردين المصرح بهم…")</p>
            <div data-comparison-result hidden></div>
        </section>
        <details class="rd-card oi-fold oi-whatif">
            <summary><span><b>@L("What-if: market dependency", "ماذا لو: الاعتماد على السوق")</b><small>@L("Replay recorded history without chosen suppliers. Hypothetical, never a forecast.", "إعادة التاريخ دون موردين مختارين. افتراضي وليس توقعاً.")</small></span></summary>
            <div class="rd-scenario-pick" data-scenario-pick></div>
            <button type="button" class="rd-btn rd-btn-primary" data-action="simulate">@L("Run scenario", "تشغيل السيناريو")</button>
            <div class="rd-scenario-result" data-scenario-result></div>
        </details>
    </section>

    <!-- ===== 3. Tenders ===== -->
    <section class="oi-panel" id="oi-tenders" role="tabpanel" aria-labelledby="oi-tab-tenders" data-tab-panel="tenders" hidden>
        <header class="oi-head">
            <div class="oi-head-title"><span class="oi-head-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5" /></svg></span>
                <div><h2>@L("Tender Intelligence", "ذكاء العطاءات")</h2><p class="oi-lead">@L("Pick any tender in your scope: lifecycle, offers, outcome and report.", "اختر أي عطاء في نطاقك: دورة الحياة والعروض والنتيجة والتقرير.")</p></div></div>
            <div class="oi-filters"><label class="oi-select oi-select-wide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z" /></svg><select data-tender-pick aria-label="@L("Choose a tender", "اختر عطاءً")"></select></label></div>
        </header>
        <div class="oi-tender-layout">
            <aside class="oi-tender-list" aria-label="@L("Tenders in scope", "العطاءات في النطاق")">
                <div class="oi-tender-list-head"><h3>@L("All tenders", "كل العطاءات")</h3><span data-tender-count></span></div>
                <ul data-tender-list></ul>
            </aside>
            <div class="oi-tender-main" data-tender-main>
                <div class="oi-tender-hero" data-tender-hero></div>
                <div class="oi-kpis" data-tender-kpis></div>
                <article class="rd-card">
                    <header><div><h3>@L("Tender Lifecycle", "دورة حياة العطاء")</h3><p>@L("Recorded timestamps only · missing milestones say so", "طوابع زمنية مسجلة فقط · المراحل غير المسجلة موضحة")</p></div></header>
                    <ol class="oi-timeline" data-tender-timeline></ol>
                </article>
                <div class="oi-tender-actions">
                    <button type="button" class="rd-btn" data-export="tender-lifecycle"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>@L("Export lifecycle (Excel)", "تصدير دورة الحياة (إكسل)")</button>
                    <button type="button" class="rd-btn" data-export="tender-pdf"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>@L("PDF report", "تقرير PDF")</button>
                </div>
            </div>
        </div>
        <section class="oi-offers" data-tender-offers-section aria-labelledby="oi-offers-title">
            <header class="oi-offers-head">
                <span class="oi-insights-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 18v-4m7 4V6m7 12v-8" /></svg></span>
                <div><h3 id="oi-offers-title">@L("Financial Offers by Bidding Cycle", "العروض المالية حسب دورة العطاء")</h3><p>@L("Compare submitted financial offers within a closed bidding cycle.", "قارن العروض المالية المقدمة ضمن دورة عطاء مغلقة.")</p></div>
                <div class="oi-offers-actions"><button type="button" class="rd-btn" data-offer-table-toggle>@L("Table", "الجدول")</button><button type="button" class="rd-btn" data-export="tender-offers">@L("Excel", "إكسل")</button></div>
            </header>
            <div class="oi-offers-strip" data-tender-offer-summary></div>
            <div class="oi-offers-picks"><label>@L("Closed bidding cycle", "دورة العطاء المغلقة") <select data-offer-round aria-label="@L("Choose a closed bidding cycle", "اختر دورة عطاء مغلقة")"></select></label><label data-offer-group-wrap hidden>@L("Comparable offers", "العروض القابلة للمقارنة") <select data-offer-group aria-label="@L("Choose comparable group", "اختر مجموعة قابلة للمقارنة")"></select></label></div>
            <p class="oi-offers-note" data-tender-offers-note></p>
            <div class="rd-chart" data-chart="tenderOffers" role="img" aria-label="@L("Offers in the selected closed bidding cycle", "العروض في دورة العطاء المغلقة المختارة")"></div>
            <p class="oi-offers-insight" data-tender-offer-insight></p>
            <div class="oi-offers-extremes" data-tender-offer-extremes></div>
            <div class="oi-offer-detail" data-tender-offer-detail hidden></div>
            <details class="oi-offers-table" data-tender-offers-table><summary>@L("View offer table", "عرض جدول العروض")</summary><div data-offer-table-content></div></details>
        </section>
        <section class="oi-market-strip" aria-labelledby="oi-comp-title">
            <article class="rd-card rd-card-feature">
                <header><div><h3 id="oi-comp-title">@L("Supplier Participation by Bidding Cycle", "مشاركة الموردين حسب دورة العطاء")</h3><p>@L("Submitted offers inside the invited field · dashed line = minimum offers · select a bidding cycle to open its tender", "العروض ضمن المدعوين · الخط المتقطع = الحد الأدنى · اختر دورة لفتح عطائها")</p></div><button type="button" class="rd-link" data-table="competition">@L("Table", "جدول")</button></header>
                <div class="rd-chart rd-chart-lg" data-chart="competition" role="img" aria-label="@L("Supplier participation by bidding cycle chart", "مخطط مشاركة الموردين حسب دورة العطاء")"></div>
            </article>
            <div class="oi-two">
                <article class="rd-card">
                    <header><div><h3>@L("By department", "حسب الجهة")</h3><p>@L("Average offers per bidding cycle", "متوسط العروض لكل دورة عطاء")</p></div></header>
                    <div class="rd-chart rd-chart-sm" data-chart="groups" role="img" aria-label="@L("Average offers by department", "متوسط العروض حسب الجهة")"></div>
                    <div class="rd-pairs" data-pairs></div>
                </article>
                <article class="rd-card">
                    <header><div><h3>@L("Official awards", "الترسيات الرسمية")</h3><p data-award-note></p></div><button type="button" class="rd-link" data-table="awards">@L("Table", "جدول")</button></header>
                    <div class="rd-chart" data-chart="awards" role="img" aria-label="@L("Award distribution chart", "مخطط توزيع الترسيات")"></div>
                </article>
            </div>
        </section>
    </section>

    <!-- ===== 4. AI Studio (Google Gemini) ===== -->
    <section class="oi-panel oi-studio" id="oi-studio" role="tabpanel" aria-labelledby="oi-tab-studio" data-tab-panel="studio" hidden>
        <header class="oi-head">
            <div class="oi-head-title"><span class="oi-head-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z" /></svg></span>
                <div><h2>@L("AI Studio", "استوديو الذكاء")</h2><p class="oi-lead">@L("Powered by Google Gemini · answers use only the selected supplier's authorized facts", "مدعوم بـ Google Gemini · تعتمد الإجابات على بيانات المورد المصرح بها فقط")</p></div></div>
        </header>

        <div class="ais" data-studio
             data-url-summary="@U("SupplierSummary")" data-url-ask="@U("AskSupplier")" data-url-voice="@U("StartVoice")">
            <div class="ais-bar">
                <label class="oi-select oi-select-wide ais-supplier">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5l8-3 8 3v16M4 21h16M9 9h1M14 9h1M9 13h1M14 13h1M10 21v-4h4v4" /></svg>
                    <select data-studio-supplier aria-label="@L("Choose a supplier", "اختر مورداً")"><option value="">@L("Choose a supplier…", "اختر مورداً…")</option></select>
                </label>
                <div class="ais-modes" role="tablist" aria-label="@L("AI Studio mode", "وضع الاستوديو")">
                    <button type="button" role="tab" aria-selected="true" data-studio-mode="summary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7zM10 12h5M10 16h5" /></svg>@L("Summary", "ملخص")</button>
                    <button type="button" role="tab" aria-selected="false" data-studio-mode="chat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v12H9l-5 4z" /></svg>@L("Text Chat", "محادثة نصية")</button>
                    <button type="button" role="tab" aria-selected="false" data-studio-mode="voice"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>@L("Live Voice", "مكالمة صوتية")</button>
                </div>
            </div>

            <p class="ais-error" data-studio-error role="alert" hidden></p>

            <!-- A. Supplier summary -->
            <div class="ais-panel" data-studio-panel="summary">
                <button type="button" class="rd-btn rd-btn-primary" data-studio-summary-button>@L("Generate Summary", "إنشاء الملخص")</button>
                <div class="ais-answer" data-studio-summary aria-live="polite">
                    <p class="ais-hint">@L("Choose a supplier, then generate a short AI summary of its procurement activity.", "اختر مورداً ثم أنشئ ملخصاً قصيراً لنشاطه في المشتريات.")</p>
                </div>
            </div>

            <!-- B. Text chat -->
            <div class="ais-panel" data-studio-panel="chat" hidden>
                <ol class="ais-chat" data-studio-chat aria-live="polite">
                    <li class="ais-msg is-ai">@L("Ask anything about the selected supplier, in Arabic or English.", "اسأل أي شيء عن المورد المختار بالعربية أو الإنجليزية.")</li>
                </ol>
                <form class="ais-ask" data-studio-ask-form>
                    <input type="text" maxlength="1000" dir="auto" data-studio-question placeholder="@L("e.g. How often does this supplier respond to invitations?", "مثال: كم مرة يستجيب هذا المورد للدعوات؟")" aria-label="@L("Your question", "سؤالك")" />
                    <button type="submit" class="rd-btn rd-btn-primary">@L("Send", "إرسال")</button>
                </form>
            </div>

            <!-- C. Live voice call -->
            <div class="ais-panel ais-voice" data-studio-panel="voice" data-voice-panel data-state="idle" hidden>
                <!-- Voice orb: the panel's data-state (idle | connecting | listening | thinking | speaking) picks the CSS animation;
                     --level (0..1, live audio energy) is set by intelligence-audio.js. -->
                <div class="ais-orb" data-voice-orb aria-hidden="true">
                    <span class="ais-orb-halo"></span>
                    <span class="ais-orb-ring"></span><span class="ais-orb-ring"></span><span class="ais-orb-ring"></span>
                    <span class="ais-orb-wave"></span>
                    <span class="ais-orb-core">
                        <svg class="ais-orb-mic" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
                        <span class="ais-orb-bars"><i></i><i></i><i></i><i></i><i></i></span>
                    </span>
                </div>
                <p class="ais-voice-status" role="status"><i aria-hidden="true"></i><span data-voice-status>@L("Ready", "جاهز")</span></p>
                <div class="ais-voice-actions">
                    <button type="button" class="rd-btn rd-btn-primary" data-voice-start>@L("Start Call", "بدء المكالمة")</button>
                    <button type="button" class="rd-btn ais-end" data-voice-end hidden>@L("End Call", "إنهاء المكالمة")</button>
                </div>
                <p class="ais-hint">@L("Speak naturally in Arabic or English. You can interrupt Gemini while it is speaking.", "تحدث بشكل طبيعي بالعربية أو الإنجليزية. يمكنك مقاطعة Gemini أثناء حديثه.")</p>
            </div>
        </div>
    </section>

    <div class="rd-toast" data-toast role="status" aria-live="polite" hidden></div>
</div>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/orange-radar-network.js" asp-append-version="true"></script>
    <script src="~/js/orange-radar.js" asp-append-version="true"></script>
    <script type="module" src="~/js/orange-intelligence-universe.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-ai.js" asp-append-version="true"></script>
    <script type="module" src="~/js/intelligence-audio.js" asp-append-version="true"></script>
}
