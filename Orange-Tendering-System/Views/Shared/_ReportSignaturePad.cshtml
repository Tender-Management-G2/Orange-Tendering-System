<div data-report-signature style="margin:16px 0">
    <label>Draw your signature</label>
    <canvas width="640" height="200" aria-label="Draw your signature" style="display:block;width:100%;max-width:640px;height:160px;border:1px solid #bbb;border-radius:8px;background:white;touch-action:none"></canvas>
    <input type="hidden" name="signatureImage" />
    <button type="button" data-signature-clear>Clear signature</button>
    <p data-signature-error role="alert" hidden>Draw your signature before submitting.</p>
</div>
