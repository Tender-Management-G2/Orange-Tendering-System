@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Error (unhandled exception)

DEVELOPER OWNER: ALL TEAM
MODULE: Shared / Integration
TRELLO TASK: Final Bug Fixing & Demo Preparation
TRELLO URL: Not provided — add from the Trello board

PURPOSE:
Generic error page shown in Production when an exception is
not handled (UseExceptionHandler("/Home/Error")).

BUSINESS ACCESS:
Everyone.

FUTURE IMPLEMENTATION:
- Keep it generic: never show stack traces or record data.

STATUS:
EXISTING TEMPLATE PAGE, restyled with the supplied layout.
===========================================================
*@
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<section class="section auth-section">
    <div class="glass auth-card">
        <span class="eyebrow">SOMETHING WENT WRONG</span>
        <h1>We could not complete this request.</h1>
        <p>Please try again later. No successful operation is confirmed.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p><small>Request ID: <code>@Model.RequestId</code></small></p>
        }
        <a class="primary" asp-area="" asp-controller="Home" asp-action="Index">Back to homepage →</a>
    </div>
</section>
