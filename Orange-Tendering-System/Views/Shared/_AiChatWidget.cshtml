@*
  Orange AI: the floating assistant for all signed-in roles (one widget per page; officer-dashboard.js opens the same panel).
  Backend: AiChatController -> AiChatService -> AssistantDataTools (server-authorized SQL Server data), report generators
  (Excel/PDF/Word/PowerPoint) and the shared OllamaChatClient for guidance and uploaded-document analysis.
  History is stored in SQL Server per user. Separate from AI Bid Analysis and from the Clarification threads.
*@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AiAntiforgery
@inject Microsoft.Extensions.Configuration.IConfiguration VoiceConfig
@{
    var help = Orange_Tendering_System.Services.OrangeHelpKnowledge.Overview(User, Orange_Tendering_System.ViewModels.WorkspaceNavigation.ForArea(ViewContext.RouteData.Values["area"]?.ToString())?.Role);
    var pageContext = "/" + string.Join("/", new[] { ViewContext.RouteData.Values["area"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString() }.Where(x => !string.IsNullOrEmpty(x)));
    var arabic = Orange_Tendering_System.ViewModels.UiLanguage.IsArabic(Context);
    var dir = arabic ? "rtl" : "ltr";
    string T(string en, string ar) => arabic ? ar : en;
}
<div class="ai-chat" data-ai-chat dir="@dir" lang="@(arabic ? "ar" : "en")" data-arabic="@(arabic ? "true" : "false")" data-user="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" data-admin="@(User.IsInRole(Orange_Tendering_System.Models.SystemRoles.Admin) ? "true" : "false")"
     data-csrf="@AiAntiforgery.GetAndStoreTokens(Context).RequestToken" data-page="@pageContext"
     data-send-url="@Url.Action("Send", "AiChat", new { area = "" })" data-history-url="@Url.Action("Conversations", "AiChat", new { area = "" })"
     data-messages-url="@Url.Action("Messages", "AiChat", new { area = "" })" data-delete-url="@Url.Action("Delete", "AiChat", new { area = "" })"
     data-tts="@(VoiceConfig["AssistantVoice:TextToSpeech"] ?? "browser")" data-speech-status-url="/ExecutiveAgent/SpeechStatus" data-transcribe-url="/ExecutiveAgent/Transcribe"
     data-welcome-url="@Url.Action("Welcome", "AiChat", new { area = "" })" data-upload-url="@Url.Action("Upload", "AiChat", new { area = "" })"
     data-knowledge-url="@Url.Action("Knowledge", "AiChat", new { area = "" })" data-knowledge-preview-url="@Url.Action("KnowledgePreview", "AiChat", new { area = "" })"
     data-knowledge-save-url="@Url.Action("KnowledgeSave", "AiChat", new { area = "" })" data-knowledge-search-url="@Url.Action("KnowledgeSearch", "AiChat", new { area = "" })"
     data-knowledge-review-url="@Url.Action("KnowledgeReview", "AiChat", new { area = "" })" data-knowledge-delete-url="@Url.Action("KnowledgeDelete", "AiChat", new { area = "" })"
     data-knowledge-reindex-url="@Url.Action("KnowledgeReindex", "AiChat", new { area = "" })">
    <button type="button" class="ai-fab" aria-haspopup="dialog" aria-expanded="false" aria-label="@T("Open Orange AI assistant", "فتح مساعد Orange AI")" title="Orange AI">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.4L12 15l-1.9-4.6L5.5 9l4.6-1.4zM18 14l.9 2.1L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-.9zM6 15l.7 1.6L8.3 17l-1.6.7L6 19.3l-.7-1.6L3.7 17l1.6-.7z" /></svg>
        <span class="ai-fab-dot" hidden></span>
    </button>
    <aside class="ai-greeting" role="status" aria-live="polite" hidden>
        <button type="button" class="ai-greeting-x" data-ai-greeting-dismiss aria-label="@T("Dismiss welcome", "إغلاق الترحيب")">×</button>
        <div class="ai-greeting-body"></div>
        <div class="ai-greeting-actions">
            <button type="button" class="ai-btn ai-btn--primary" data-ai-greeting-open>@T("Open assistant", "افتح المساعد")</button>
            <button type="button" class="ai-btn" data-ai-greeting-dismiss>@T("Maybe later", "لاحقًا")</button>
        </div>
    </aside>
    <section class="ai-panel" role="dialog" aria-modal="false" aria-labelledby="ai-panel-title" hidden>
        <header class="ai-head">
            <div class="ai-brand">
                <span class="ai-avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.4L12 15l-1.9-4.6L5.5 9l4.6-1.4z" /></svg></span>
                <div><strong id="ai-panel-title">Orange AI</strong><small>Orange System Guide · @string.Join(" / ", help.Roles)</small></div>
            </div>
            <div class="ai-head-actions">
                <button type="button" class="ai-icon ai-voice-lang" data-ai-voice-lang aria-label="@T("Speech language", "لغة الكلام")" title="@T("Speech language: Arabic / English", "لغة الكلام: عربي / إنجليزي")">@(arabic ? "ع" : "EN")</button>
                <button type="button" class="ai-icon" data-ai-voice-mode aria-pressed="false" aria-label="@T("Continuous voice conversation", "محادثة صوتية متواصلة")" title="@T("Voice conversation: listen again after each spoken reply", "محادثة صوتية: الاستماع مجددًا بعد كل رد منطوق")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10v4M7 7v10M11 4v16M15 8v8M19 11v2" /></svg></button>
                <button type="button" class="ai-icon" data-ai-stop-voice hidden aria-label="@T("Stop speaking", "إيقاف الكلام")" title="@T("Stop speaking", "إيقاف الكلام")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10H7z" /></svg></button>
                <button type="button" class="ai-icon" data-ai-history aria-label="@T("Conversation history", "سجل المحادثات")" title="@T("History", "السجل")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5M12 7v5l3 2" /></svg></button>
                <button type="button" class="ai-icon ai-knowledge-toggle" data-ai-knowledge aria-expanded="false" aria-controls="ai-knowledge-panel" aria-label="@T("Knowledge base", "قاعدة المعرفة")" title="@T("Knowledge", "المعرفة")">📚</button>
                <button type="button" class="ai-icon" data-ai-new aria-label="@T("New chat", "محادثة جديدة")" title="@T("New chat", "محادثة جديدة")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
                <button type="button" class="ai-icon ai-hide-mobile" data-ai-expand aria-pressed="false" aria-label="@T("Expand workspace", "توسيع مساحة العمل")" title="@T("Expand", "توسيع")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
                <button type="button" class="ai-icon" data-ai-close aria-label="@T("Minimize assistant", "تصغير المساعد")" title="@T("Minimize", "تصغير")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></button>
            </div>
        </header>
        <details class="ai-reference"><summary>@T("Verified role guide", "دليل دورك المعتمد")</summary><p dir="rtl">@help.Guide</p></details>
        <section class="ai-knowledge" id="ai-knowledge-panel" data-ai-knowledge-panel hidden aria-label="@T("Knowledge management", "إدارة المعرفة")">
            <header><strong>@T("Knowledge base", "قاعدة المعرفة")</strong><button type="button" class="ai-icon" data-ai-knowledge-close aria-label="@T("Close knowledge", "إغلاق المعرفة")">×</button></header>
            <p>@T("Personal references are private to you. Shared references stay hidden from answers until an Admin approves them.", "مراجعك الشخصية خاصة بك. لا تستخدم المراجع المشتركة في الإجابات إلا بعد اعتمادها من مدير النظام.")</p>
            <label class="ai-knowledge-label" for="ai-knowledge-file">@T("Upload a reference to review", "ارفع مرجعًا لمراجعته")</label>
            <input id="ai-knowledge-file" class="ai-knowledge-file" type="file" accept=".pdf,.xlsx,.docx,.csv,.txt" />
            <label class="ai-knowledge-label" for="ai-knowledge-title">@T("Title", "العنوان")</label>
            <input id="ai-knowledge-title" class="ai-knowledge-title" maxlength="200" placeholder="@T("Reference title", "عنوان المرجع")" />
            <label class="ai-knowledge-label" for="ai-knowledge-scope">@T("Save as", "نطاق الحفظ")</label>
            <select id="ai-knowledge-scope" class="ai-knowledge-scope"><option value="Personal">@T("Personal — private to me", "شخصية — خاصة بي")</option><option value="Shared">@T("Shared — submit for Admin approval", "مشتركة — تُرسل لاعتماد المدير")</option></select>
            <button type="button" class="ai-btn ai-btn--primary" data-ai-knowledge-preview>@T("Preview file", "معاينة الملف")</button>
            <div class="ai-knowledge-preview" data-ai-knowledge-preview-result hidden></div>
            <div class="ai-knowledge-search"><label class="ai-knowledge-label" for="ai-knowledge-query">@T("Search saved knowledge", "ابحث في المعرفة المحفوظة")</label><input id="ai-knowledge-query" maxlength="500" /><button type="button" class="ai-btn" data-ai-knowledge-search>@T("Search", "بحث")</button></div>
            <div class="ai-knowledge-results" data-ai-knowledge-results aria-live="polite"></div>
            <div class="ai-knowledge-items" data-ai-knowledge-items></div>
            <div class="ai-knowledge-pending" data-ai-knowledge-pending hidden><strong>@T("Shared items awaiting review", "مراجع مشتركة بانتظار المراجعة")</strong><div></div></div>
            <p class="ai-knowledge-status" data-ai-knowledge-status role="status" aria-live="polite"></p>
        </section>
        <div class="ai-history" hidden><ul></ul><p class="ai-history-empty" hidden>@T("No saved conversations yet.", "لا توجد محادثات محفوظة بعد.")</p></div>
        <div class="ai-messages" aria-live="polite">
            <div class="ai-welcome">
                <div class="ai-welcome-text"><strong>@T("How can I help with your sourcing work?", "كيف أساعدك في عمل التوريد والمناقصات؟")</strong>
                    <span>@T("Ask in Arabic or English. I answer from the records your role may see, generate Excel, PDF, Word and PowerPoint reports, and analyze documents you upload.", "اسأل بالعربية أو الإنجليزية. أجيب من السجلات المصرّح لدورك بعرضها، وأُنشئ تقارير Excel وPDF وWord وPowerPoint، وأحلل المستندات التي ترفعها.")</span></div>
                <div class="ai-actions" role="group" aria-label="@T("Quick actions", "إجراءات سريعة")"></div>
                <div class="ai-suggest">@foreach (var question in help.Questions) { <button type="button">@question</button> }</div>
                <nav class="ai-help-links" aria-label="@T("Your workspace help links", "روابط مساحة عملك")">@foreach (var link in help.Links.Take(5)) { <a href="@Url.Content("~" + link.Url)">@link.Label</a> }</nav>
            </div>
        </div>
        <p class="ai-voice-status" role="status" aria-live="polite" hidden></p>
        <div class="ai-dropzone" hidden>@T("Drop a PDF, Excel, Word, CSV or TXT file", "أفلت ملف PDF أو Excel أو Word أو CSV أو TXT")</div>
        <form class="ai-form" autocomplete="off">
            <input type="file" class="ai-file" accept=".pdf,.xlsx,.docx,.csv,.txt" hidden />
            <button type="button" class="ai-attach" data-ai-attach aria-label="@T("Upload a document (PDF, Excel, Word, CSV, TXT; max 10 MB)", "رفع مستند (PDF أو Excel أو Word أو CSV أو TXT؛ حتى 10 ميغابايت)")" title="@T("Upload document", "رفع مستند")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l9-9a3.7 3.7 0 0 1 5.2 5.2l-9 9a1.8 1.8 0 0 1-2.6-2.6l8.3-8.3" /></svg></button>
            <button type="button" class="ai-attach ai-mic" data-ai-mic aria-pressed="false" aria-label="@T("Speak to Orange AI", "تحدّث إلى Orange AI")" title="@T("Speak (Arabic or English)", "تحدّث (عربي أو إنجليزي)")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3" /></svg></button>
            <textarea rows="1" maxlength="2000" placeholder="@T("Ask Orange AI…", "اسأل Orange AI…")" aria-label="@T("Message to the AI assistant", "رسالة إلى المساعد")"></textarea>
            <button type="submit" class="ai-send" aria-label="@T("Send message", "إرسال")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
        </form>
        <p class="ai-foot">@T("Answers use only data you are authorized to view. AI explanations may be imperfect — verify before acting.", "تستخدم الإجابات البيانات المصرّح لك بها فقط. قد تكون شروحات الذكاء الاصطناعي غير دقيقة — تحقّق قبل اتخاذ أي إجراء.")</p>
    </section>
</div>
<partial name="_ExecutiveAgent" />
