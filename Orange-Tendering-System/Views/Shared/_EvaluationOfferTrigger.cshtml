@model Orange_Tendering_System.Models.Entities.Bid
@{
    var name = Model.TenderInvitation.Supplier.CompanyName;
    var label = UiLanguage.IsArabic(Context) ? $"عرض تفاصيل عرض {name}" : $"View offer details for {name}";
}
<span class="evaluation-supplier-name">
    <strong>@name</strong>
    <button type="button" class="evaluation-offer-trigger" data-evaluation-offer-open
            aria-haspopup="dialog" aria-controls="evaluation-offer-@Model.Id" aria-label="@label" title="@label">!</button>
</span>
