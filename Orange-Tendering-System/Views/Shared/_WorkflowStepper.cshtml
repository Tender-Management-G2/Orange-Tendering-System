@model Orange_Tendering_System.ViewModels.WorkflowDetails
@using Orange_Tendering_System.Models.Entities
@{
    // The four phases of the weighted tender cycle, derived only from the stored tender / evaluation state.
    var status = Model.Tender.Status;
    var state = Model.Session?.State;
    var phase = status switch
    {
        TenderStatus.Draft or TenderStatus.Bidding => 1,
        TenderStatus.Evaluation => state == SessionState.ReportDraft ? 3 : 2,
        TenderStatus.OfficerReview => 3,
        _ => 4
    };
    var lowestPrice = Model.Tender.PurchaseRequest?.EvaluationMethod == TenderEvaluationMethod.LowestPrice;
    var done = status is TenderStatus.Awarded or TenderStatus.Rejected or TenderStatus.Cancelled;
    var ar = Orange_Tendering_System.ViewModels.UiLanguage.IsArabic(Context);
    string L(string en, string arabic) => ar ? arabic : en;
    var steps = new[]
    {
        ("1", L("Setup", "الإعداد"), lowestPrice ? L("Requirements, bidding and compliance", "المتطلبات وتقديم العروض والامتثال") : L("Weights, bidding and meeting", "الأوزان وتقديم العروض والاجتماع")),
        ("2", L("Committee evaluation", "تقييم اللجنة"), L("Signed committee evaluations", "تقييمات اللجنة الموقّعة")),
        ("3", lowestPrice ? L("Price comparison", "مقارنة الأسعار") : L("Weighted results", "النتائج المرجّحة"), L("Ranking and report", "الترتيب والتقرير")),
        ("4", L("Approval & award", "الاعتماد والترسية"), L("Manager, Top Committee, award", "المدير والإدارة العليا والترسية"))
    };
}
<ol class="wf-steps" aria-label="@L("Tender cycle progress", "تقدم دورة المناقصة")">
    @for (var i = 0; i < steps.Length; i++)
    {
        var n = i + 1;
        if (lowestPrice && n == 2) continue;
        var cls = done || n < phase ? "is-done" : n == phase ? "is-current" : "";
        <li class="wf-step @cls" data-phase="@n" tabindex="0" role="button" @(n == phase && !done ? "aria-current=step" : null)><b>@(done || n < phase ? "\u2713" : (lowestPrice && n > 2 ? (n - 1).ToString() : steps[i].Item1))</b><strong>@steps[i].Item2</strong><small>@steps[i].Item3</small></li>
    }
</ol>
