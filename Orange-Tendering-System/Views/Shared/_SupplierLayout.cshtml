@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
FILE: Supplier portal layout (premium horizontal navbar + footer)

PURPOSE:
Shell for the Supplier area: logo, horizontal navigation and account menu, followed by a search and notification row.
Menu items are supplier-only and come from
ViewModels/WorkspaceNavigation.cs ("Supplier"). The Notifications item is the bell itself.

SECURITY:
The layout never shows other suppliers' data. Each supplier page must still filter every query by the signed-in user's
SupplierId on the server (UI hiding is not authorization).
===========================================================
*@
@{
    Layout = null;
    var workspace = WorkspaceNavigation.ForArea("Supplier")!;
    var activeSection = ViewData["WorkspaceSection"] as string;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Supplier workspace";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <meta name="color-scheme" content="dark light" />
    <title>@pageTitle | Orange Sourcing</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/workspace-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orange-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-ui.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ws-shell ws-supplier ws-topnav" data-workspace-role="Supplier">
    <a class="ws-skip" href="#workspace-main">Skip to main content</a>
    <header class="ws-topnav-bar">
        <a class="ws-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Orange Sourcing public homepage"><span class="ws-logo" aria-hidden="true">orange<sup>®</sup></span></a>
        <button class="ws-icon-button ws-topnav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="supplier-nav"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg></button>
        <nav id="supplier-nav" class="ws-topnav-links" aria-label="Supplier navigation">
            @foreach (var item in workspace.Items.Where(i => i.Label != "Notifications"))
            {
                var active = item.Label == activeSection || (item.Controller == "Profile" && activeSection == "Documents");
                <a class="ws-topnav-item @(active ? "is-active" : null)" aria-current="@(active ? "page" : null)" asp-area="Supplier" asp-controller="@item.Controller" asp-action="@item.Action"><svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(WorkspaceNavigation.Icon(item.Icon))</svg><span>@item.Label</span></a>
            }
        </nav>
        <div class="ws-supplier-account"><partial name="_WorkspaceAccountMenu" /></div>
        <div class="ws-supplier-utilities" aria-label="Search and notifications">
        <div class="ws-supplier-search-tools">
        <div class="ws-search ws-supplier-search" data-global-search data-search-url="/Search/Query"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="m15 15 6 6" /></svg><input type="search" placeholder="Search invitations and offers..." aria-label="Search my invitations and offers" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="ws-search-results" /><div id="ws-search-results" class="ws-search-results" role="listbox" hidden></div></div>
            <partial name="_VoiceSearchButton" />
        </div>
        <div class="ws-topbar-actions">
            <partial name="_NotificationBell" />
            <a class="ws-icon-button" asp-area="" asp-controller="Home" asp-action="HowItWorks" aria-label="View procurement workflow and help" title="Workflow &amp; help"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M9 8a3 3 0 0 1 6 1c0 2-3 2-3 4M12 17h.01" /></svg></a>
        </div>
        </div>
    </header>
    <main id="workspace-main" class="ws-supplier-main" tabindex="-1">
        <div class="pg-page">
            @RenderBody()
        </div>
    </main>
    <footer class="ws-supplier-footer">
        <a class="ws-footer-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="ws-logo" aria-hidden="true">orange</span><span>Sourcing &amp; Tender Management System</span></a>
        <nav aria-label="Supplier footer navigation"><a asp-area="" asp-controller="Home" asp-action="About">About</a><span aria-disabled="true" title="Terms of use have not been supplied">Terms of Use</span><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a><a asp-area="" asp-controller="Home" asp-action="Contact">Contact Us</a></nav>
        <small>© @DateTime.UtcNow.Year Sourcing &amp; Tender Management System.</small>
    </footer>
    <partial name="_AiChatWidget" />
    <span id="workspace-theme-status" class="ws-sr-only" role="status" aria-live="polite"></span>
    <script src="~/js/workspace-shell.js" asp-append-version="true"></script>
    <script src="~/js/vendor/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/notification-bell.js" asp-append-version="true"></script>
    <partial name="_JQueryScripts" />
    <script src="~/js/orange-ui.js" asp-append-version="true"></script>
    <script src="~/js/ai-chat.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
