@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
FILE: Supplier portal layout (same sidebar + top bar shell as every workspace role)

PURPOSE:
Shell for the Supplier area. Menu items are supplier-only and come from ViewModels/WorkspaceNavigation.cs ("Supplier");
the Notifications item is the bell itself. Visual design: the shared workspace shell (officer-theme.css, body.so-shell).

SECURITY:
The layout never shows other suppliers' data. Each supplier page must still filter every query by the signed-in user's
SupplierId on the server (UI hiding is not authorization).
===========================================================
*@
@{
    Layout = null;
    var workspace = WorkspaceNavigation.ForArea("Supplier")!;
    var activeSection = ViewData["WorkspaceSection"] as string;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Supplier workspace";
}
<!doctype html>
<html lang="@UiText.Lang(Context)" dir="@UiText.Dir(Context)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <meta name="color-scheme" content="dark light" />
    <title>@pageTitle | Orange Sourcing</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/workspace-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orange-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer-topbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/theme-surfaces.css" asp-append-version="true" />
</head>
<body class="ws-shell ws-internal ws-supplier so-shell @ViewData["BodyClass"]" data-bilingual="true" data-workspace-role="Supplier">
    <a class="ws-skip" href="#workspace-main">@UiText.T(Context, "Skip to main content")</a>
    <aside class="ws-sidebar" id="workspace-navigation" aria-label="@UiText.T(Context, "Supplier Portal")">
        <div class="ws-sidebar-brand">
            <a class="ws-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Orange Sourcing public homepage"><span class="ws-logo" aria-hidden="true">orange<sup>®</sup></span><span>@if (UiText.IsArabic(Context)) { <text>نظام إدارة<br />التوريد والعطاءات</text> } else { <text>Sourcing &amp; Tender<br />Management System</text> }</span></a>
            <button class="ws-icon-button ws-nav-close" type="button" aria-label="Close navigation">×</button>
        </div>
        <nav class="ws-primary-nav" aria-label="Supplier navigation">
            @foreach (var item in workspace.Items.Where(i => i.Label != "Notifications"))
            {
                var active = item.Label == activeSection || (item.Controller == "Profile" && activeSection == "Documents");
                <a class="ws-nav-item @(active ? "is-active" : null)" aria-current="@(active ? "page" : null)" asp-area="Supplier" asp-controller="@item.Controller" asp-action="@item.Action"><svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(WorkspaceNavigation.Icon(item.Icon))</svg><span>@UiText.T(Context, item.Label)</span></a>
            }
        </nav>
        <div class="ws-sidebar-bottom"><span class="ws-role-label">@UiText.T(Context, "Supplier")</span><a asp-area="" asp-controller="Home" asp-action="Contact">Contact support <span aria-hidden="true">↗</span></a></div>
        <div class="ws-sidebar-architecture" aria-hidden="true"></div>
    </aside>
    <button class="ws-backdrop" type="button" aria-label="Close navigation" hidden></button>
    <div class="ws-stage">
        <header class="ws-topbar">
            <button class="ws-icon-button ws-nav-open" type="button" aria-label="Open navigation" aria-controls="workspace-navigation" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg></button>
            <div class="ws-search" data-global-search data-search-url="@Url.Action("Query", "Search", new { area = "" })"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="m15 15 6 6" /></svg><input type="search" placeholder="Search invitations and offers..." aria-label="Search my invitations and offers" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="ws-search-results" /><div id="ws-search-results" class="ws-search-results" role="listbox" hidden></div></div>
            <div class="ws-topbar-actions">
                <partial name="_LanguageSelector" />
                <span data-search-feedback class="ws-sr-only" role="status" aria-live="polite"></span>
                <partial name="_VoiceSearchButton" />
                <partial name="_NotificationBell" />
                <partial name="_ThemeSwitch" />
                <partial name="_WorkspaceAccountMenu" />
            </div>
        </header>
        <main id="workspace-main" class="ws-main" tabindex="-1">
            <div class="pg-page">
                @RenderBody()
            </div>
        </main>
        <footer class="ws-internal-footer ws-supplier-links">
            <span>© @DateTime.UtcNow.Year Sourcing &amp; Tender Management System</span>
            <nav aria-label="Supplier footer navigation"><a asp-area="" asp-controller="Home" asp-action="About">About</a><span aria-disabled="true" title="Terms of use have not been supplied">Terms of Use</span><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a><a asp-area="" asp-controller="Home" asp-action="Contact">Contact Us</a></nav>
        </footer>
    </div>
    <partial name="_AiChatWidget" />
    <span id="workspace-theme-status" class="ws-sr-only" role="status" aria-live="polite"></span>
    <script src="~/js/workspace-shell.js" asp-append-version="true"></script>
    <script src="~/js/vendor/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/notification-bell.js" asp-append-version="true"></script>
    <partial name="_JQueryScripts" />
    <script src="~/js/global-search.js" asp-append-version="true"></script>
    <script src="~/js/orange-ui.js" asp-append-version="true"></script>
    <script src="~/js/ai-chat.js" asp-append-version="true"></script>
    <partial name="_OrangeMotion" />
    <script src="~/js/ui-language.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
