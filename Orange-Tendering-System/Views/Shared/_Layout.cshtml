@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
FILE: Public layout (public website + Identity account pages)

OWNER: Tariq — Shared Layout
MODULE: Public Site & Shared Layout
TRELLO TASK: Shared Layout & Responsive Design
TRELLO URL: https://trello.com/c/CiGKUw2k

PURPOSE:
Shell for the public pages (Home, About, Team, How It Works,
Contact) and for every ASP.NET Core Identity page (login,
register, password reset, account management).
Converted from the supplied layout ZIP (Views/Shared/_Layout).

NOTES:
- Workspace pages use _WorkspaceLayout or _SupplierLayout.
- Identity pages set ViewData["IdentityPage"] (Areas/Identity/
  Pages/_ViewStart.cshtml) to load identity.css, which styles
  the default Identity UI markup without loading Bootstrap.

STATUS:
INTEGRATED. No business logic.
===========================================================
*@
@{
    var isIdentityPage = ViewData["IdentityPage"] is true;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <meta name="description" content="Orange Sourcing & Tender Management System" />
    <title>@(ViewData["Title"] ?? "Orange Sourcing & Tender Management System")</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mvc.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
    @if (isIdentityPage)
    {
        <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <partial name="_Icons" />
    <partial name="_Header" />
    <div id="main-content" class="@(isIdentityPage ? "identity-page" : null)">
        @RenderBody()
    </div>
    <partial name="_Footer" />
    <dialog aria-labelledby="dialog-title"><button class="close" aria-label="Close dialog">×</button><div class="dialog-content"></div></dialog>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/experience.js" asp-append-version="true"></script>
    <script src="~/js/public-pages.js" asp-append-version="true"></script>
</body>
</html>
