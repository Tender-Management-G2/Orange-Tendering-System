@* OWNER: Tariq — Public Site (contact form; posts to ContactController, which honestly answers 501 Not Implemented) *@
<form id="contact-form" asp-controller="Contact" asp-action="Submit" method="post">
  <div class="contact-field-row">
    <div><label for="contact-name">Full Name *</label><input id="contact-name" name="name" autocomplete="name" required maxlength="100" aria-describedby="name-error" /><span id="name-error" class="field-error"></span></div>
    <div><label for="contact-email">Email *</label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-error" /><span id="email-error" class="field-error"></span></div>
  </div>
  <label for="contact-topic">Inquiry Topic *</label><select id="contact-topic" name="topic" required aria-describedby="topic-error"><option value="">Choose an inquiry topic</option><option>General inquiry</option><option>Supplier onboarding</option><option>Platform support</option></select><span id="topic-error" class="field-error"></span>
  <label for="contact-message">Message *</label><textarea id="contact-message" name="message" required minlength="10" maxlength="3000" rows="5" aria-describedby="message-hint message-error"></textarea><span id="message-hint" class="public-caption">10–3,000 characters. Please do not include passwords or sensitive account details.</span><span id="message-error" class="field-error"></span>
  <button type="submit" class="editorial-submit">Submit inquiry <span aria-hidden="true">↗</span></button><p id="form-status" class="contact-submit-status" role="status" aria-live="polite" aria-atomic="true">Your inquiry is saved only after server confirmation.</p>
</form>
