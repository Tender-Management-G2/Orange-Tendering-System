
@*
  OWNER: Tariq — Shared Layout
  Sidebar menu of the internal workspace layout.

  Items come from ViewModels/WorkspaceNavigation.cs:
  the current area's menu, or (on shared pages)
  the menu of the user's first workspace role.

  The active item is the one whose label equals
  ViewData["WorkspaceSection"].

  ADMIN CUSTOMIZATION:
  Hide Roles, Settings, Clarifications, and My Tasks
  from the Admin sidebar only.
  Other roles and navigation remain unchanged.
*@

@inject Orange_Tendering_System.Services.TenderWorkflowService Workflow

@{
    // Policy-aware navigation:
    // Weighted-evaluation links are shown only to authorized roles.

    var canWorkflow =
        User.IsInRole(SystemRoles.SourcingOfficer) ||
        User.IsInRole(SystemRoles.EvaluationCommittee) ||
        User.IsInRole(SystemRoles.SourcingManager) ||
        User.IsInRole(SystemRoles.TopCommittee);

    var canApproveWeights = false;

    try
    {
        canApproveWeights =
            canWorkflow &&
            await Workflow.WeightApprover(
                await Workflow.Actor(User));
    }
    catch
    {
        canApproveWeights = false;
    }

    var workspace = WorkspaceNavigation.Current(
        ViewContext.RouteData.Values["area"]?.ToString(),
        User);

    var activeSection =
        ViewData["WorkspaceSection"] as string;


    // ============================================
    // ADMIN SIDEBAR CUSTOMIZATION ONLY
    // ============================================

   
var isAdminWorkspace =
    string.Equals(
        ViewContext.RouteData.Values["area"]?.ToString(),
        "Admin",
        StringComparison.OrdinalIgnoreCase);

    var hiddenAdminItems = new[]
    {
        "Roles",
        "Settings",
        "Clarifications",
        "My Tasks"
    };
}


<nav class="ws-primary-nav"
     aria-label="@(workspace?.Label ?? "Workspace") navigation">

    @* ==========================================
       WEIGHTED EVALUATION
       Keep existing team behavior
       ========================================== *@

    @if (canWorkflow)
    {
        <a class="ws-nav-item @(activeSection == "Weighted Evaluation" ? "is-active" : null)"
           aria-current="@(activeSection == "Weighted Evaluation" ? "page" : null)"
           asp-area=""
           asp-controller="Workflow"
           asp-action="Index">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                @Html.Raw(WorkspaceNavigation.Icon("tender"))
            </svg>

            <span>Weighted Evaluation</span>
        </a>
    }

    @if (canApproveWeights)
    {
        <a class="ws-nav-item"
           asp-area="EvaluationCommittee"
           asp-controller="WeightApprovals"
           asp-action="Index">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                @Html.Raw(WorkspaceNavigation.Icon("check"))
            </svg>

            <span>Weight Approvals</span>
        </a>
    }


    @* ==========================================
       WORKSPACE NAVIGATION
       ========================================== *@

    @if (workspace is not null)
    {
        foreach (var item in workspace.Items)
        {
            // Hide four menu items in Admin only
            if (isAdminWorkspace &&
                (hiddenAdminItems.Contains(item.Label) ||
                 item.Controller == "Roles" ||
                 item.Controller == "Settings"))
            {
                continue;
            }

            var active = item.Label == activeSection;

            <a class="ws-nav-item @(active ? "is-active" : null)"
               aria-current="@(active ? "page" : null)"
               asp-area="@(item.Area ?? workspace.Area)"
               asp-controller="@item.Controller"
               asp-action="@item.Action">

                <svg viewBox="0 0 24 24" aria-hidden="true">
                    @Html.Raw(WorkspaceNavigation.Icon(item.Icon))
                </svg>

                <span>@item.Label</span>
            </a>
        }
    }
    else
    {
        var active = activeSection == "My Workspace";

        <a class="ws-nav-item @(active ? "is-active" : null)"
           aria-current="@(active ? "page" : null)"
           asp-area=""
           asp-controller="Workspace"
           asp-action="Index">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                @Html.Raw(WorkspaceNavigation.Icon("home"))
            </svg>

            <span>My Workspace</span>
        </a>
    }


    @* ==========================================
       SHARED NAVIGATION
       Keep all existing links for other roles
       ========================================== *@

    @for (var i = 0; i < WorkspaceNavigation.SharedItems.Count; i++)
    {
        var item = WorkspaceNavigation.SharedItems[i];

        // Hide four menu items in Admin only
        if (isAdminWorkspace &&
            (hiddenAdminItems.Contains(item.Label) ||
             item.Controller == "Roles" ||
             item.Controller == "Settings"))
        {
            continue;
        }

        // Keep existing duplicate-link prevention
        if (workspace is not null &&
            workspace.Items.Any(x =>
                x.Controller == item.Controller &&
                string.IsNullOrEmpty(x.Area) &&
                x.Label == item.Label))
        {
            continue;
        }

        var active = item.Label == activeSection;

        <a class="ws-nav-item @(item.Label == "Notifications" ? "ws-nav-support" : null) @(active ? "is-active" : null)"
           aria-current="@(active ? "page" : null)"
           asp-area=""
           asp-controller="@item.Controller"
           asp-action="@item.Action">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                @Html.Raw(WorkspaceNavigation.Icon(item.Icon))
            </svg>

            <span>@item.Label</span>
        </a>
    }

</nav>
