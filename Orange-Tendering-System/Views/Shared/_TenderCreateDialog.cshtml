@model Orange_Tendering_System.ViewModels.RequirementsInput
@inject Orange_Tendering_System.Services.TenderWorkflowService Workflow
@inject Orange_Tendering_System.Data.ApplicationDbContext Records
@using Microsoft.EntityFrameworkCore
@using Orange_Tendering_System.Models.Entities
@using Orange_Tendering_System.Services
@using Orange_Tendering_System.ViewModels
@{
    var ar = UiLanguage.IsArabic(Context);
    string L(string en, string arabic) => ar ? arabic : en;
    string Icon(string name) => name switch {
        "building" => "M4 22V3h12v19M16 10h4v12M2 22h20M8 7h1m3 0h1M8 11h1m3 0h1M8 15h1m3 0h1",
        "coins" => "M2 7a6.5 3 0 1 0 13 0 6.5 3 0 1 0-13 0zm0 0v10c0 4 13 4 13 0V7M2 12c0 4 13 4 13 0m3-8c2 .4 4 1.5 4 3v9c0 1.6-2 2.6-4 3m0-5c2-.4 4-1.4 4-3",
        "code" => "m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18",
        "paperclip" => "m8 13 7-7a3 3 0 0 1 4 4l-9 9a5 5 0 0 1-7-7l9-9m-2 12 7-7",
        "users" or "user-check" => "M15 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M8.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm9 2 2 2 3-4",
        "lock" => "M6 11h12v10H6zm2 0V7a4 4 0 0 1 8 0v4m-4 4v2",
        _ => "M5 2h9l5 5v15H5zm9 0v6h5M8 12h8m-8 4h8"
    };
    var rows = await Records.PurchaseRequests.AsNoTracking()
        .Where(r => r.Status == PurchaseRequestStatus.Accepted && r.Items.Any() && !r.Tenders.Any())
        .OrderByDescending(r => r.Id)
        .Select(r => new { r.Id, r.Title, r.Justification, r.DepartmentId, department = r.Department.Name,
            r.Priority, r.Status, r.NeededBy, r.EvaluationMethod,
            items = r.Items.OrderBy(i => i.Id).Select(i => new { name = i.Name, quantity = i.Quantity, unit = i.Unit, specifications = i.Specifications }).ToList() })
        .ToListAsync();
    var requests = rows.Select(r => new {
        id = r.Id, number = $"PR-{r.Id:0000}", title = r.Title, description = r.Justification,
        departmentId = r.DepartmentId, r.department, status = L(r.Status.ToString(), "مقبول"),
        priority = L(r.Priority.ToString(), r.Priority switch { RequestPriority.Low => "منخفضة", RequestPriority.High => "عالية", RequestPriority.Urgent => "عاجلة", _ => "عادية" }),
        needed = r.NeededBy?.ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo(ar ? "ar-JO" : "en")),
        lowestPrice = r.EvaluationMethod == TenderEvaluationMethod.LowestPrice,
        method = r.EvaluationMethod == TenderEvaluationMethod.LowestPrice ? L("Lowest compliant price", "أقل سعر مطابق") : L("Committee weighting", "أوزان لجنة التقييم"),
        r.items, total = r.items.Select(i => i.unit).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? (decimal?)r.items.Sum(i => i.quantity) : null
    });
    var defaults = await Workflow.StandingEvaluationDefaults();
    var departments = await Records.Departments.AsNoTracking().ToDictionaryAsync(d => d.Id, d => d.Name);
    var steps = new[] { L("Request", "طلب الشراء"), L("Requirements", "المتطلبات"), L("Committee", "اللجنة"), L("Review", "المراجعة") };
    (string Field, string Title, string Key, string Icon)[] seats = [
        (Field: "SourcingManagerId", Title: L("Sourcing Manager", "مدير التوريد"), Key: "evaluation-manager", Icon: "user-check"),
        (Field: "DepartmentRepresentativeId", Title: L("Department Representative", "ممثل القسم الطالب"), Key: "evaluation-department", Icon: "building"),
        (Field: "FinancialRepresentativeId", Title: L("Financial Representative", "الممثل المالي"), Key: "evaluation-financial", Icon: "coins"),
        (Field: "TechnicalRepresentativeId", Title: L("Technical Representative", "الممثل الفني"), Key: "evaluation-technical-1", Icon: "code")
    ];
    var payload = System.Text.Json.JsonSerializer.Serialize(new {
        requests, offerCurrencies = CurrencyRules.Offer,
        strings = new {
            assigned = L("Assigned", "تم التعيين"), missing = L("Pending", "قيد الانتظار"),
            complete = L("Complete", "مكتمل"),
            count = L("{0} of {1} completed", "اكتمل {0} من {1}"),
            step = L("Step {0} of {1}", "الخطوة {0} من {1}"),
            invalid = L("Enter a valid value for this field.", "أدخل قيمة صحيحة لهذا الحقل."),
            chooseRequest = L("Select an eligible purchase request.", "اختر طلب شراء مؤهلًا."),
            enterAmount = L("Enter a positive value with up to two decimal places.", "أدخل قيمة موجبة بمنزلتين عشريتين على الأكثر."),
            chooseCurrency = L("Select a supported currency.", "اختر عملة مدعومة."),
            chooseDocuments = L("Select at least one required supplier document.", "اختر وثيقة واحدة على الأقل من وثائق المورد المطلوبة."),
            chooseEmployee = L("Select an eligible employee for this role.", "اختر موظفًا مؤهلًا لهذا الدور."),
            missingSource = L("Choose a purchase request with a title and description.", "اختر طلب شراء يتضمن عنوانًا ووصفًا."),
            failed = L("The tender could not be created. Check the form and try again.", "تعذّر إنشاء المناقصة. راجع النموذج وحاول مرة أخرى."),
            network = L("The server could not be reached. Try again.", "تعذّر الاتصال بالخادم. حاول مرة أخرى."),
            discard = L("Discard changes to this tender?", "هل تريد تجاهل تغييرات المناقصة؟"),
            removeDocument = L("Remove {0}", "إزالة {0}"),
            from = L("From {0}", "من {0}")
        }
    });
}
<link rel="stylesheet" href="~/css/tender-wizard.css" asp-append-version="true" />
<dialog id="tc-dialog" class="tw-dialog" aria-labelledby="tc-title" dir="@(ar ? "rtl" : "ltr")" lang="@(ar ? "ar" : "en")">
<form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Create" method="post" id="tc-form"
      data-list-url="@Url.Action("Index", "Workflow", new { area = "SourcingOfficer" })" novalidate data-fv-skip data-tender-form>
    <header class="tw-header">
        <span class="tw-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm0 0v6h6m-8 3v7m-3.5-3.5h7"/></svg></span>
        <div><h2 id="tc-title">@L("Create Tender", "إنشاء مناقصة")</h2><p id="tw-subtitle" hidden></p></div>
        <button type="button" class="tw-close" data-tc-close aria-label="@L("Close", "إغلاق")">×</button>
    </header>
    <nav class="tw-steps" aria-label="@L("Tender creation steps", "خطوات إنشاء المناقصة")">
        @for (var i = 0; i < steps.Length; i++)
        {
            <button type="button" data-tw-step="@i"><span class="tw-step-number">@(i + 1)</span><span>@steps[i]</span></button>
        }
    </nav>
    <div class="tw-body">
        <div class="tw-error" id="tw-error" role="alert" tabindex="-1" hidden></div>
        <section data-tw-panel aria-labelledby="tw-request-heading">
            <h3 id="tw-request-heading" tabindex="-1">@L("Select Purchase Request", "اختيار طلب الشراء")</h3>
            <label class="tw-field"><span>@L("Accepted purchase request", "طلب شراء مقبول")</span>
                <select id="tc-pr" name="PurchaseRequestId" required>
                    <option value="">@L("Select an accepted request", "اختر طلبًا مقبولًا")</option>
                    @foreach (var r in requests) { <option value="@r.id">@r.number · @r.title</option> }
                </select>
            </label>
            @if (rows.Count == 0) { <p>@L("No eligible purchase requests are available.", "لا توجد طلبات شراء مؤهلة.")</p> }
            <div id="tw-request-details" hidden>
                <article class="tw-card tw-request-card">
                    <header><div><strong data-pr="number"></strong><p data-pr="title"></p></div>
                        <div class="tw-badges"><span class="tw-chip tw-positive" data-pr="status"></span><span class="tw-chip" data-pr="department"></span><span class="tw-chip tw-warm" data-pr="priority"></span></div></header>
                    <dl class="tw-facts">
                        <div data-tw-optional><dt>@L("Required by", "تاريخ التسليم المطلوب")</dt><dd data-pr="needed"></dd></div>
                        <div><dt>@L("Items", "البنود")</dt><dd data-pr="itemCount"></dd></div>
                        <div data-tw-optional><dt>@L("Total quantity", "الكمية الإجمالية")</dt><dd data-pr="total"></dd></div>
                        <div><dt>@L("Evaluation method", "طريقة التقييم")</dt><dd data-pr="method"></dd></div>
                    </dl>
                </article>
                <article class="tw-card">
                    <h4>@L("Requested items", "البنود المطلوبة")</h4>
                    <table class="tw-items"><thead><tr><th scope="col">@L("Item", "البند")</th><th scope="col">@L("Quantity", "الكمية")</th><th scope="col">@L("Original specifications", "المواصفات الأصلية")</th></tr></thead><tbody id="tw-request-items"></tbody></table>
                </article>
            </div>
        </section>
        <section data-tw-panel aria-labelledby="tw-requirements-heading" hidden>
            <h3 id="tw-requirements-heading" class="tw-heading" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon("file-text")" /></svg>@L("Tender Requirements", "متطلبات المناقصة")</h3>
            <article class="tw-card">
                <header><h4 class="tw-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon("file-text")" /></svg>@L("General Information", "المعلومات العامة")</h4><span class="tw-chip tw-source" id="tw-source"></span></header>
                <div class="tw-two">
                    <label class="tw-field"><span>@L("Tender Title", "عنوان المناقصة")</span><textarea id="Title" rows="2" readonly></textarea></label>
                    <label class="tw-field"><span>@L("Description", "الوصف")</span><textarea id="Description" rows="2" readonly></textarea></label>
                </div>
            </article>
            <article class="tw-card">
                <h4 class="tw-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon("coins")" /></svg>@L("Financial Information", "المعلومات المالية")</h4>
                <div class="tw-two">
                    <label class="tw-field"><span>@L("Estimated Procurement Value", "القيمة التقديرية للمشتريات")</span><input id="EstimatedValue" name="EstimatedValue" type="number" min="0.01" max="9999999999999999.99" step="0.01" required /></label>
                    <label class="tw-field"><span>@L("Currency", "العملة")</span><select asp-for="Currency" required><option value="">@L("Select currency", "اختر العملة")</option>@foreach (var c in CurrencyRules.Tender) { <option value="@c">@c</option> }</select></label>
                </div>
            </article>
            <article class="tw-card">
                <h4 id="tw-documents-label" class="tw-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon("paperclip")" /></svg>@L("Required Supplier Documents", "وثائق المورد المطلوبة")</h4>
                <div class="tw-doc-picker" id="tw-documents" role="group" aria-labelledby="tw-documents-label">
                    <div class="tw-chips" id="tw-selected-documents"></div>
                    <details><summary>@L("Select documents", "اختر الوثائق")</summary>
                        <div class="tw-doc-options">
                        @foreach (var kind in OfferDocumentTypes.All)
                        {
                            var name = OfferDocumentTypes.Label(kind.Key, ar);
                            <label><input type="checkbox" name="RequiredDocuments" value="@kind.Key" data-label="@name" /> @name</label>
                        }
                        </div>
                    </details>
                </div>
            </article>
            @if (Workflow.CriticalTenderEnabled)
            {
                <label class="tw-critical"><input asp-for="IsCritical" /> <span>@L("Critical procurement — requires Top Committee review before award.", "مشتريات حرجة — تتطلب مراجعة اللجنة العليا قبل الإرساء.")</span></label>
            }
        </section>
        <section data-tw-panel aria-labelledby="tw-committee-heading" hidden>
            <h3 id="tw-committee-heading" class="tw-heading" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon("users")" /></svg>@L("Evaluation Committee", "لجنة التقييم")</h3>
            @foreach (var seat in seats)
            {
                var pool = await Workflow.TenderSeatCandidates(TenderWorkflowService.TenderSeatRoles[Array.IndexOf(seats, seat)]);
                <article class="tw-card tw-seat" data-seat="@seat.Field" data-label="@seat.Title">
                    <span class="tw-role-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="@Icon(seat.Icon)" /></svg></span>
                    <div><small>@(seat.Field == "SourcingManagerId" ? L("Required reviewer", "المراجع المطلوب") : L("Committee role", "دور اللجنة"))</small><strong>@seat.Title</strong></div>
                    <label class="tw-field"><span>@L("Employee", "الموظف")</span>
                        <select id="@seat.Field" name="@seat.Field" required>
                            <option value="">@L("Select an employee", "اختر موظفًا")</option>
                            @foreach (var person in pool)
                            {
                                <option value="@person.Id" data-dept="@person.DepartmentId" data-dept-name="@(person.DepartmentId is int dep ? departments.GetValueOrDefault(dep) : null)"
                                        selected="@(defaults.GetValueOrDefault(seat.Key) == person.Id)">@(string.IsNullOrWhiteSpace(person.FullName) ? person.Email : person.FullName)</option>
                            }
                        </select>
                    </label>
                    <div><small>@L("Department", "القسم")</small><span data-seat-department></span></div>
                    <span class="tw-chip" data-seat-status></span>
                </article>
            }
        </section>
        <section data-tw-panel aria-labelledby="tw-review-heading" hidden>
            <h3 id="tw-review-heading" class="tw-heading" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon("file-text")" /></svg>@L("Review & Create", "المراجعة والإنشاء")</h3>
            <div id="tw-review">
                @foreach (var card in new[] {
                    (Key: "request", Step: 0, Icon: "file-text", Title: L("Purchase Request", "طلب الشراء")),
                    (Key: "general", Step: 0, Icon: "lock", Title: L("General Information", "المعلومات العامة")),
                    (Key: "financial", Step: 1, Icon: "coins", Title: L("Financial Information", "المعلومات المالية")),
                    (Key: "documents", Step: 1, Icon: "paperclip", Title: L("Required Supplier Documents", "وثائق المورد المطلوبة")),
                    (Key: "committee", Step: 2, Icon: "users", Title: L("Evaluation Committee", "لجنة التقييم"))
                })
                {
                    <article class="tw-card tw-review-card">
                        <span class="tw-role-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="@Icon(card.Icon)" /></svg></span>
                        <div><h4>@card.Title</h4><div data-review="@card.Key"></div></div>
                        <button type="button" class="tw-secondary" data-tw-edit="@card.Step" aria-label="@L("Edit", "تعديل") @card.Title">@L("Edit", "تعديل")</button>
                    </article>
                }
            </div>
        </section>
        <aside class="tw-readiness" id="tw-readiness" hidden>
            <h3 class="tw-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg><span id="tw-readiness-title" data-review-title="@L("Tender Readiness", "جاهزية المناقصة")">@L("Readiness", "الجاهزية")</span></h3>
            <progress id="tw-progress" value="0" max="1" aria-labelledby="tw-readiness-title"></progress>
            <p id="tw-count" aria-live="polite"></p>
            <ul id="tw-checklist"></ul>
        </aside>
    </div>
    <footer class="tw-footer">
        <span id="tw-step-count"></span>
        <div>
            <button type="button" class="tw-secondary" data-tc-close>@L("Cancel", "إلغاء")</button>
            <button type="button" class="tw-secondary" id="tw-back" hidden>@L("Back", "رجوع")</button>
            <button type="button" class="tw-primary" id="tw-next">@L("Continue", "متابعة") <span class="tw-arrow" aria-hidden="true">→</span></button>
            <button type="submit" class="tw-primary" id="tc-submit" hidden disabled>@L("Create Tender", "إنشاء المناقصة") <span aria-hidden="true">✓</span></button>
        </div>
    </footer>
</form>
<script type="application/json" id="tw-data">@Html.Raw(payload)</script>
</dialog>
<script src="~/js/tender-wizard.js" asp-append-version="true" defer></script>
