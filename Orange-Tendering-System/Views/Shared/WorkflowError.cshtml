@model string
@{ ViewData["Title"] = "Operation blocked"; }
<section class="ws-panel pg-panel" role="alert">
    <h1>Operation blocked</h1>
    <p>@Model</p>
    <p>No successful submission or decision was recorded by this request.</p>
    <a asp-area="@ViewContext.RouteData.Values["area"]" asp-controller="@ViewContext.RouteData.Values["controller"]" asp-action="Index">Return to assigned tenders and check the current state</a>
</section>
