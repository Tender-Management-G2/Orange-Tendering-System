@model Orange_Tendering_System.ViewModels.WorkflowDetails
@using Orange_Tendering_System.Models.Entities
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Orange_Tendering_System.Services
@inject Orange_Tendering_System.Data.ApplicationDbContext Records
@inject Orange_Tendering_System.Services.TenderWorkflowService Flow
@inject Microsoft.AspNetCore.Identity.UserManager<Orange_Tendering_System.Models.Entities.ApplicationUser> People
@{
    // The tender workflow popup. Everything shown is read from the stored workflow; every action posts to the same endpoints as before
    // (the server re-checks every rule). The page tells the user what to do NOW and keeps the rest short and readable.
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var id = Model.Tender.Id;
    var w = Model.Weights;
    var s = Model.Session;
    var status = Model.Tender.Status;
    var round = Model.Tender.Rounds.OrderByDescending(x => x.RoundNumber).FirstOrDefault();
    var lowestPrice = Model.Tender.PurchaseRequest?.EvaluationMethod == TenderEvaluationMethod.LowestPrice;
    var mySeat = Model.Tender.CommitteeMembers.FirstOrDefault(x => x.UserId == Model.UserId && x.CommitteeType == CommitteeType.Evaluation);
    var submitted = s != null && mySeat != null && s.Submissions.Any(x => x.CommitteeMemberId == mySeat.Id);
    var revisionLog = w?.State == WeightState.Proposals
        ? await Records.AuditLogs.AsNoTracking().Where(x => x.EntityName == "Tender" && x.EntityId == id.ToString() && x.Action == "WeightRevisionRequestedEvidence")
            .OrderByDescending(x => x.Id).Select(x => x.NewValues).FirstOrDefaultAsync() : null;
    var revision = revisionLog == null ? null : JsonSerializer.Deserialize<Orange_Tendering_System.ViewModels.WeightRevisionNotice>(revisionLog);
    string Words(string v) => System.Text.RegularExpressions.Regex.Replace(v, "(?<=[a-z])(?=[A-Z])", " ");

    // Names instead of numeric ids.
    var supplierNames = await Records.Suppliers.AsNoTracking().ToDictionaryAsync(x => x.Id, x => x.CompanyName);
    var userIds = Model.Tender.CommitteeMembers.Select(x => x.UserId).Concat(w?.Proposals.Select(x => x.MemberUserId) ?? []).Concat(Model.Votes.Select(v => Model.Tender.CommitteeMembers.FirstOrDefault(m => m.Id == v.CommitteeMemberId)?.UserId ?? "")).Distinct().ToList();
    var userNames = await Records.Users.AsNoTracking().Where(x => userIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => string.IsNullOrWhiteSpace(x.FullName) ? (x.Email ?? "") : x.FullName);
    string Who(string? uid) => uid != null && userNames.TryGetValue(uid, out var n) ? n : "Member";
    string SupplierName(int sid) => supplierNames.TryGetValue(sid, out var n) ? n : "Supplier #" + sid;
    string BidSupplier(int bidId) { var b = Model.Bids.FirstOrDefault(x => x.Id == bidId); return b == null ? "Offer #" + bidId : SupplierName(b.TenderInvitation.SupplierId); }
    decimal Price(Bid b) => TenderWorkflowService.TotalOfferPrice(b);
    string Role(CommitteeResponsibility? r) => r switch { CommitteeResponsibility.SourcingManager => "Sourcing Manager", CommitteeResponsibility.DepartmentRepresentative => "Department", CommitteeResponsibility.FinancialRepresentative => "Financial", CommitteeResponsibility.TechnicalRepresentative => "Technical 1", CommitteeResponsibility.TechnicalRepresentative2 => "Technical 2", CommitteeResponsibility.ChiefExecutiveOfficer => "CEO", _ => "Member" };

    var evalMembers = Model.Tender.CommitteeMembers.Where(x => x.CommitteeType == CommitteeType.Evaluation).OrderBy(x => x.Responsibility).ToList();
    var ar = Orange_Tendering_System.ViewModels.UiLanguage.IsArabic(Context);
    string L(string en, string arabic) => ar ? arabic : en;
    string WeightRole(CommitteeResponsibility? role) => role switch
    {
        CommitteeResponsibility.SourcingManager => L("Sourcing Manager", "مدير التوريد"),
        CommitteeResponsibility.DepartmentRepresentative => L("Requesting Department Representative", "ممثل القسم الطالب"),
        CommitteeResponsibility.FinancialRepresentative => L("Financial Representative", "الممثل المالي"),
        CommitteeResponsibility.TechnicalRepresentative => L("Technical Representative", "الممثل الفني"),
        CommitteeResponsibility.TechnicalRepresentative2 => L("Second Technical Representative", "الممثل الفني الثاني"),
        _ => L(Role(role), "عضو اللجنة")
    };
    var weightSetup = !Model.IsSupplier && !lowestPrice && status == TenderStatus.Draft && (w != null || Model.IsOfficer);
    var canVoteWeights = Model.IsEvaluator && w?.State == WeightState.Proposals && w.Proposals.All(p => p.MemberUserId != Model.UserId);
    var votedMembers = evalMembers.Count(m => w?.Proposals.Any(p => p.MemberUserId == m.UserId) == true);
    var weightHeading = w == null ? L("Send to Committee", "إرسال إلى اللجنة")
        : canVoteWeights ? L("Set Evaluation Weights", "تحديد أوزان التقييم")
        : w.State == WeightState.Proposals ? L("Voting Progress", "تقدّم التصويت")
        : L("Evaluation Weights (Average)", "متوسط أوزان التقييم");
    var matrixBids = (s?.EligibleBids.Select(x => x.BidId) ?? Model.Scores.Select(x => x.BidId)).Distinct().ToList();
    decimal? Cell(int memberId, int bidId, CriterionType t) => Model.Scores.FirstOrDefault(x => x.CommitteeMemberId == memberId && x.BidId == bidId && x.EvaluationCriterion.Type == t)?.Score;
    decimal? Weighted(int memberId, int bidId)
    {
        var f = Cell(memberId, bidId, CriterionType.Financial); var t = Cell(memberId, bidId, CriterionType.Technical);
        return f != null && t != null && w?.ApprovedFinancial != null && w.ApprovedTechnical != null ? WeightedCalculation.Member(f.Value, t.Value, w.ApprovedFinancial.Value, w.ApprovedTechnical.Value) : null;
    }

    // The AI findings come back as JSON; show them as readable labelled rows (raw text if they are not JSON).
    string Flatten(JsonElement e) => e.ValueKind switch
    {
        JsonValueKind.String => e.GetString() ?? "",
        JsonValueKind.Array => string.Join(Environment.NewLine, e.EnumerateArray().Select(x => "- " + Flatten(x))),
        JsonValueKind.Object => string.Join("; ", e.EnumerateObject().Select(p => Words(p.Name) + ": " + Flatten(p.Value))),
        _ => e.ToString()
    };
    List<(string Label, string Value)> FindingRows(string? json)
    {
        var rows = new List<(string, string)>();
        try { using var doc = JsonDocument.Parse(json ?? ""); if (doc.RootElement.ValueKind == JsonValueKind.Object) foreach (var p in doc.RootElement.EnumerateObject()) rows.Add((Words(p.Name), Flatten(p.Value))); }
        catch { rows.Clear(); }
        return rows;
    }

    // Requirements are frozen as JSON; show them as labelled rows.
    var requirementRows = new List<(string Label, string Value)>();
    try
    {
        using var reqDoc = JsonDocument.Parse(Model.Tender.Requirements ?? "");
        var labels = new Dictionary<string, string> { ["TechnicalRequirements"] = "Technical", ["CommercialConditions"] = "Commercial", ["DeliveryExpectations"] = "Delivery", ["MandatoryCompliance"] = "Compliance" };
        foreach (var prop in reqDoc.RootElement.EnumerateObject()) requirementRows.Add((labels.TryGetValue(prop.Name, out var l) ? l : prop.Name, prop.Value.ToString()));
    }
    catch { requirementRows.Clear(); }

    var submittedBidsByInvitation = Model.Bids.Where(b => b.Status == BidStatus.Submitted)
        .OrderByDescending(b => b.Id).ToLookup(b => b.TenderInvitationId);
    var supplierBidRows = (round?.Invitations ?? [])
        .Select(invitation => new { Invitation = invitation, Bid = submittedBidsByInvitation[invitation.Id].FirstOrDefault() })
        .OrderByDescending(row => row.Bid != null)
        .ThenBy(row => SupplierName(row.Invitation.SupplierId))
        .ToList();
    var allAnswered = round != null && round.Invitations.Count > 0 && round.Invitations.All(i => i.Status == InvitationStatus.Declined || submittedBidsByInvitation.Contains(i.Id));
    var waitingInvitations = round?.Invitations.Where(i => i.Status != InvitationStatus.Declined
        && !submittedBidsByInvitation.Contains(i.Id)).ToList() ?? [];
    var submittedSupplierCount = Model.Bids.Where(b => b.Status == BidStatus.Submitted)
        .Select(b => b.TenderInvitation.SupplierId).Distinct().Count();
    var canCloseBidding = round?.Status == TenderRoundStatus.Open && (submittedSupplierCount >= 3 || round.Deadline <= Model.UtcNow || allAnswered);

    // The signed report: shown, downloaded, signed, decided on and forwarded inside the popup (the same server actions as the old review page).
    Orange_Tendering_System.ViewModels.ReportReviewModel? rv = null;
    if (!Model.IsSupplier && s?.ReportId is int reportId) { try { rv = await Flow.ReviewReport(reportId, User); } catch { rv = null; } }

    // The decision relay of the current report only: a reissued round starts a fresh decision cycle.
    var notice = s?.ReportId is int noticeReportId ? await Records.Set<FinalDecisionNotice>().AsNoTracking().FirstOrDefaultAsync(x => x.TenderId == id && x.TenderReportId == noticeReportId) : null;
    var rejected = notice != null && notice.Outcome != FinalDecisionOutcome.Award;
    var reasonText = notice?.Outcome == FinalDecisionOutcome.Retender ? "Re-Tender: " + notice.DecisionReason : "Company no longer needs this tender: " + notice?.DecisionReason;
    var retenderBlocked = notice?.Outcome == FinalDecisionOutcome.Retender && round != null && round.RoundNumber >= Model.MaxRounds;
    var outcomeText = notice?.Outcome == FinalDecisionOutcome.Cancel ? "the tender is cancelled" : retenderBlocked ? "re-tendering is blocked: this is the last permitted round" : $"the Officer prepares round {(round?.RoundNumber ?? 0) + 1} of {Model.MaxRounds} under the same tender";
    var topMembers = Model.Tender.CommitteeMembers.Where(x => x.CommitteeType == CommitteeType.Top).OrderBy(x => x.Id).ToList();
    var topUserIds = topMembers.Select(x => x.UserId).Where(x => !userNames.ContainsKey(x)).ToList();
    if (topUserIds.Count > 0) { foreach (var kv in await Records.Users.AsNoTracking().Where(x => topUserIds.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => string.IsNullOrWhiteSpace(x.FullName) ? (x.Email ?? "") : x.FullName)) { userNames[kv.Key] = kv.Value; } }
    var topVotes = Model.Votes.Where(v => v.CommitteeRound.CommitteeType == CommitteeType.Top).ToList();

    // What should the user do now?
    (string Title, string Text, string Tone) Next()
    {
        // Final decision relay after the Top Committee approval: Manager acknowledges, Officer awards, then notifies the suppliers.
        if (rejected && !Model.IsSupplier)
        {
            if (notice!.Status == FinalDecisionStatus.AwaitingManager)
                return Model.IsManager ? (notice.Outcome == FinalDecisionOutcome.Retender ? "Forward the Re-Tender request" : "Forward the Top Committee rejection", $"A Top Committee member stopped the approval ({reasonText}). The Top approval is stopped; {outcomeText}. Acknowledge and forward it to the Sourcing Officer (step 5 below).", "action")
                    : Model.IsTop ? ("Top approval stopped", $"A member stopped the approval ({reasonText}). No further votes are accepted. The rejection is with the Sourcing Manager.", "muted")
                    : ("Top Committee stopped the approval", $"{reasonText}. Waiting for the Sourcing Manager to forward it.", "wait");
            if (notice.Status == FinalDecisionStatus.ForwardedToOfficer)
                return retenderBlocked ? ("Re-tendering is blocked", $"The Top Committee requested a Re-Tender ({reasonText}), but round {round!.RoundNumber} is the last permitted round ({Model.MaxRounds}). A round {Model.MaxRounds + 1} can never be created.", "wait")
                    : Model.IsOfficer ? (notice.Outcome == FinalDecisionOutcome.Cancel ? ("Notify the suppliers and cancel the tender", $"{reasonText}. One step notifies every participating supplier and the requesting department, and cancels the tender (step 5 below).", "action")
                        : ("Prepare the new bidding round", $"{reasonText}. Edit the tender details and deadline, review the invitation list (at least 3 suppliers) and publish round {(round?.RoundNumber ?? 0) + 1} (step 5 below).", "action"))
                    : ("Waiting for the Officer", $"The rejection was forwarded to the Sourcing Officer; {outcomeText}.", "wait");
            return ("Tender cancelled", $"The Top Committee rejected the tender ({reasonText}). Suppliers and the requesting department were notified.", "muted");
        }
        if (notice != null && !Model.IsSupplier)
        {
            if (notice.Status == FinalDecisionStatus.AwaitingManager)
                return Model.IsManager ? ("Acknowledge the Top Committee decision", $"The Top Committee approved with {notice.TopApprovals} of {notice.TopVotes} votes. Acknowledge it and forward it to the Sourcing Officer (scroll to step 5 below).", "action")
                    : ("Waiting for the Manager", "The Sourcing Manager acknowledges the Top Committee decision and forwards it to the Officer.", "wait");
            if (notice.Status == FinalDecisionStatus.ForwardedToOfficer && status != TenderStatus.Awarded)
                return Model.IsOfficer ? ("Record the official award", "The Manager forwarded the Top Committee decision. Record the award; the system checks every approval first (step 5 below).", "action")
                    : ("Waiting for the Officer", "The Sourcing Officer records the official award.", "wait");
            if (status == TenderStatus.Awarded && notice.Status != FinalDecisionStatus.SuppliersNotified)
                return Model.IsOfficer ? ("Notify the suppliers", "The award is recorded. Announce the result to the winner and the unsuccessful suppliers (step 5 below).", "action")
                    : ("Tender awarded", "The award is recorded. The Officer is notifying the suppliers.", "good");
        }
        if (status == TenderStatus.Awarded) return ("Tender awarded", "The official award is recorded and the tender is closed.", "good");
        if (status is TenderStatus.Rejected or TenderStatus.Cancelled) return ("Tender closed", "This tender is closed. Its history stays available below.", "muted");
        if (Model.IsOfficer && status == TenderStatus.Bidding && w == null)
            return ("Tender setup needs review", "This existing tender has no configured weight round. Its history has been preserved. Complete a reviewed setup correction before inviting suppliers; the Tender page is now the only creation path.", "wait");
        if (Model.IsSupplier && status == TenderStatus.Bidding)
        {
            if (round?.Status != TenderRoundStatus.Open || !round.Deadline.HasValue || round.Deadline <= Model.UtcNow)
                return ("Bidding is closed", "Offers cannot be prepared or submitted after bidding closes. Your existing offers remain available below.", "wait");
            if (w?.State != WeightState.Approved)
                return ("Waiting for approved evaluation weights", "The Officer must complete the committee weight proposals and Sourcing Manager approval before offers can be prepared. Please check again later.", "wait");
            if (round.OpensAt > Model.UtcNow)
                return ("Bidding opens soon", "The opening time has not been reached yet. Check the tender dates below before preparing your offer.", "wait");
        }
        if (w == null && status == TenderStatus.Draft) return Model.IsOfficer ? ("Send the tender to the committee", "The four committee members each propose the Financial / Technical split. The average becomes the evaluation weights.", "action") : ("Waiting for the Officer", "The Sourcing Officer has not sent the tender to the committee yet.", "wait");
        if (w != null && w.State == WeightState.Proposals)
        {
            var mine = Model.IsEvaluator && w.Proposals.All(x => x.MemberUserId != Model.UserId);
            return mine ? (revision?.CommitteeMemberIds.Contains(mySeat?.Id ?? 0) == true
                    ? ("Revise your weights", "Review the Officer's note, adjust your proposal and send it back.", "action")
                    : ("Propose the weights", "Choose the Financial / Technical split. Together they must total 100%.", "action"))
                : ($"Waiting for weight proposals ({votedMembers} of {evalMembers.Count})", "The proposals are averaged after voting closes.", "wait");
        }
        if (w != null && w.State == WeightState.AwaitingApproval)
            return Model.CanApproveWeights ? ("Approve the weights", $"Average of the four proposals: Financial {w.FinancialAverage:0.##}% / Technical {w.TechnicalAverage:0.##}%. Approving locks them.", "action") : ("Waiting for weight approval", "The Sourcing Officer approves the average of the four proposals.", "wait");
        if (status == TenderStatus.Draft) return Model.IsOfficer ? ("Open bidding and invite suppliers", "The weights are locked. Set the bidding deadline, then select suppliers to invite.", "action") : ("Bidding opens soon", "The weights are approved. The Officer will invite suppliers.", "wait");
        if (status == TenderStatus.Bidding)
        {
            if (round?.Status == TenderRoundStatus.Open)
                return Model.IsOfficer ? (submittedSupplierCount >= 3 ? ("Ready to close bidding", $"Offers from {submittedSupplierCount} distinct suppliers were received. You may close bidding now without waiting for the remaining invitations.", "action")
                        : allAnswered ? ("All suppliers have answered", "Every invited supplier submitted an offer or declined. You may close bidding and review the received offers.", "action")
                        : round.Invitations.Count == 0 ? ("Invite suppliers", "Choose the suppliers who may bid, or invite all approved suppliers with one click.", "action")
                        : round.Deadline <= Model.UtcNow ? ("Close bidding", $"The deadline passed. {Model.Bids.Count(x => x.Status == BidStatus.Submitted)} offer(s) were submitted.", "action")
                        : ($"Waiting for offers: {submittedSupplierCount} received", "You can close bidding once three distinct suppliers submit, once all invited suppliers submit or decline, or after the deadline.", "wait"))
                    : Model.IsSupplier ? ("Submit your offer", "Accept the invitation, then prepare and submit your offer before the deadline.", "action")
                    : ("Bidding is open", "Suppliers are sending their offers.", "wait");
            return Model.IsOfficer && lowestPrice ? ("Check offer compliance", "Confirm the screening to send the lowest compliant price to the Manager.", "action") : Model.IsOfficer ? ("Prepare the evaluation", "The system already checked the offers. Continue, run the AI analysis, then schedule the committee evaluation.", "action") : ("Bidding is closed", "The Officer is checking the offers and preparing the evaluation.", "wait");
        }
        if (status == TenderStatus.Evaluation && s != null)
        {
            if (s.State == SessionState.ReportDraft)
                return Model.IsEvaluator ? ("Review and sign the report", "The system generated the report from the four evaluations. Open it, check the ranking and recommendations, and sign it. When all four members sign, it goes to the Sourcing Officer.", "action")
                    : Model.IsOfficer ? ("The committee is signing the report", "The report was generated automatically. You receive the completed, signed report when all four members have signed it.", "wait")
                    : ("Report ready", "The committee is reviewing and signing the report.", "wait");
            if (Model.IsEvaluator && !submitted && (s.State == SessionState.Scheduled || TenderWorkflowService.EvaluationOpen(s, Model.UtcNow)))
                return TenderWorkflowService.EvaluationOpen(s, Model.UtcNow) ? ("Evaluate the offers", "Open the evaluation workspace: compare the offers, score each one (whole numbers from 0 to 99) and sign. You submit once.", "action") : ("Prepare for the meeting", "The evaluation workspace already shows the offers, criteria, documents and AI analysis. Scoring opens at the meeting start.", "wait");
            if (s.State == SessionState.Scheduled && Model.UtcNow < s.StartsAt) return ("Waiting for the meeting to start", "Scoring opens by itself at the start time shown below. Then the four members score the offers.", "wait");
            return ($"Committee evaluation: {s.Submissions.Count} of 4 submitted", submitted ? "Your evaluation is recorded and cannot be edited." : "Scoring is in progress.", "wait");
        }
        if (status == TenderStatus.OfficerReview) return Model.IsOfficer ? ("Forward the signed report to the Sourcing Manager", "The committee approved and signed the report (4 of 4). Preview or download it, then forward it to the Sourcing Manager.", "action") : ("Report is with the Officer", "The completed, signed report is being forwarded to the Sourcing Manager.", "wait");
        if (status == TenderStatus.ManagerReview) return Model.IsManager ? ("Prepare the executive summary", "Review the signed report, write the executive summary and submit it to the Top Committee. You can also return or reject the report with a reason.", "action") : ("Waiting for the Manager", "The Sourcing Manager is preparing the executive summary for the Top Committee.", "wait");
        if (status == TenderStatus.TopCommitteeReview) return Model.IsTop ? ("Decide on the recommendation", "Read the executive summary and the signed report, then Approve, Reject or Re-Tender. Four approvals award the tender automatically.", "action") : (Model.IsOfficer || Model.IsManager ? ("With the Top Committee", "The Top Committee decides from here. Four approvals award the tender automatically; nothing more is needed from you.", "wait") : ("Waiting for the Top Committee", "The Top Committee is voting.", "wait"));
        return status == TenderStatus.Evaluation ? ("Committee evaluation", "The committee members are scoring the offers.", "wait") : ("In progress", "Follow the steps below.", "wait");
    }
    var next = Next();
    var tone = next.Tone;

    // Suppliers that can still be invited in the current round.
    var invitedIds = round?.Invitations.Select(x => x.SupplierId).ToHashSet() ?? [];
    var approvedSuppliers = Model.IsOfficer && round?.Status == TenderRoundStatus.Open
        ? await Records.Suppliers.AsNoTracking().Where(x => x.Status == SupplierStatus.Approved
            && Records.Users.Any(u => u.SupplierId == x.Id && u.IsActive && u.EmailConfirmed))
            .OrderBy(x => x.CompanyName).Select(x => new
            {
                x.Id, x.CompanyName, x.Category,
                // Verified facts only (no invented performance scores).
                Verified = Records.Documents.Count(d => d.SupplierId == x.Id && d.VerificationStatus == DocumentVerificationStatus.Verified && (d.ExpiresAt == null || d.ExpiresAt > Model.UtcNow)),
                Expired = Records.Documents.Count(d => d.SupplierId == x.Id && d.ExpiresAt != null && d.ExpiresAt <= Model.UtcNow),
                Pending = Records.Documents.Count(d => d.SupplierId == x.Id && d.VerificationStatus == DocumentVerificationStatus.Pending),
                Offers = Records.Bids.Count(b => b.Status == BidStatus.Submitted && b.TenderInvitation.SupplierId == x.Id),
                Awards = Records.Tenders.Count(t => t.AwardedBidId != null && t.AwardedBid!.TenderInvitation.SupplierId == x.Id)
            }).ToListAsync()
        : null;
    var inviteable = approvedSuppliers?.Where(x => !invitedIds.Contains(x.Id)).ToList();
    var tenderCategoryIds = Model.Tender.Items.Where(x => x.CategoryId != null).Select(x => x.CategoryId!.Value).Distinct().ToList();
    var tenderCategories = tenderCategoryIds.Count == 0 ? new List<string>() : await Records.ProcurementCategories.AsNoTracking().Where(c => tenderCategoryIds.Contains(c.Id)).Select(c => c.Name).ToListAsync();
    var topUsers = Model.IsOfficer && s != null && Model.FinalPolicyConfigured && !Model.Tender.CommitteeMembers.Any(x => x.CommitteeType == CommitteeType.Top)
        ? (await People.GetUsersInRoleAsync(Orange_Tendering_System.Models.SystemRoles.TopCommittee)).Where(u => u.IsActive).OrderBy(u => u.FullName).ToList() : null;
    var closedRound = round?.Status == TenderRoundStatus.Closed && s == null;
    var proceeded = round != null && Model.RoundDecisions.Any(x => x.TenderRoundId == round.Id && x.Kind == RoundDecisionKind.Proceed);
    var requests = Model.RoundDecisions.Where(x => x.TenderRoundId == round?.Id && x.Kind == RoundDecisionKind.ProceedException).ToList();
    var pendingRequest = requests.FirstOrDefault(x => x.Status == RoundDecisionStatus.Pending);
    var approvedException = requests.FirstOrDefault(x => x.Status == RoundDecisionStatus.Approved);
    var enoughOffers = Model.DistinctOffers >= Model.MinimumOffers;
    var reviewedAi = Model.Analyses.Where(x => x.ReviewedAt != null).OrderByDescending(x => x.Id).ToList();
    var finW = w == null ? (decimal?)null : (w.State == WeightState.Approved ? w.ApprovedFinancial : w.FinancialAverage);
    var tecW = w == null ? (decimal?)null : (w.State == WeightState.Approved ? w.ApprovedTechnical : w.TechnicalAverage);
    string StageState(int n) => n switch
    {
        1 => "done",
        2 => w?.State == WeightState.Approved || status != TenderStatus.Draft ? "done" : "now",
        3 => status == TenderStatus.Bidding ? "now" : status == TenderStatus.Draft ? "todo" : "done",
        4 => status == TenderStatus.Evaluation ? "now" : status is TenderStatus.Draft or TenderStatus.Bidding ? "todo" : "done",
        _ => status == TenderStatus.Awarded ? "done" : status is TenderStatus.OfficerReview or TenderStatus.ManagerReview or TenderStatus.TopCommitteeReview ? "now" : "todo"
    };
    string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
    var stepIndex = status switch { TenderStatus.Draft or TenderStatus.Bidding => 1, TenderStatus.Evaluation => s?.State == SessionState.ReportDraft ? 3 : 2, TenderStatus.OfficerReview => 3, _ => 4 };
    var reviewStage = rv != null && (Model.IsOfficer || Model.IsManager || Model.IsTop)
        && status is TenderStatus.OfficerReview or TenderStatus.ManagerReview or TenderStatus.TopCommitteeReview or TenderStatus.Awarded;
    var evaluationStage = !Model.IsSupplier && (reviewStage || status == TenderStatus.Evaluation || (Model.IsOfficer && closedRound && !lowestPrice));
    var ranked = reviewStage ? Model.Ranking.OrderBy(row => row.Rank).ToList() : [];
    var recommended = rv?.Report.RecommendedBidId is int recommendation ? ranked.FirstOrDefault(row => row.BidId == recommendation) : null;
    var award = reviewStage && status == TenderStatus.Awarded;
    var awardNotice = award && notice != null ? await Records.InternalAwardReports.AsNoTracking()
        .Where(report => report.FinalDecisionNoticeId == notice.Id)
        .Select(report => new { report.OfficerNotificationId, report.ManagerNotificationId }).SingleOrDefaultAsync() : null;
    var winnerNotified = award && notice != null && await Records.SupplierResultDeliveries.AsNoTracking()
        .AnyAsync(delivery => delivery.FinalDecisionNoticeId == notice.Id && delivery.Outcome == "Won" && delivery.InAppStatus == "Delivered");
    var reviewTitle = award ? L("Tender Awarded", "تمت ترسية المناقصة")
        : status == TenderStatus.ManagerReview ? L("Manager Review", "مراجعة مدير التوريد")
        : status == TenderStatus.TopCommitteeReview ? L("Top Management Review", "مراجعة الإدارة العليا")
        : L("Committee Evaluation", "تقييم اللجنة");
    string Mean(int bidId, CriterionType criterion) => Model.Scores
        .Where(score => score.BidId == bidId && score.EvaluationCriterion.Type == criterion)
        .Select(score => (decimal?)score.Score).Average()?.ToString("0.0") ?? "—";
}
@{
    // ---------- Wizard (Officer: eight stages; Manager and Top Management: their own decision stage). Real data only; locked stages open as their requirements are met. ----------
    var wzManager = Model.IsManager && status is TenderStatus.ManagerReview or TenderStatus.TopCommitteeReview or TenderStatus.Awarded && !Model.IsOfficer;
    var wzTop = Model.IsTop && status is TenderStatus.TopCommitteeReview or TenderStatus.Awarded && !Model.IsOfficer;
    var wz = Model.IsOfficer || wzManager || wzTop;
    var wzItem = Model.Tender.Items.OrderBy(x => x.Id).FirstOrDefault();
    var wzPr = Model.Tender.PurchaseRequestId;
    var wzImage = wz ? await Records.Documents.AsNoTracking().Where(d => d.PurchaseRequestId == wzPr && d.DocumentType == "DepartmentSupportingDocument" && d.ContentType.StartsWith("image/")).Select(d => (int?)d.Id).FirstOrDefaultAsync() : null;
    var wzDept = await Records.PurchaseRequests.AsNoTracking().Where(r => r.Id == wzPr).Select(r => r.Department.Name).FirstOrDefaultAsync() ?? "";
    var wzApproved = w?.State == WeightState.Approved || lowestPrice;
    var wzPublished = status != TenderStatus.Draft;
    var wzClosed = closedRound || s != null || status is TenderStatus.Evaluation or TenderStatus.OfficerReview or TenderStatus.ManagerReview or TenderStatus.TopCommitteeReview or TenderStatus.Awarded;
    var wzResults = Model.Ranking.Count > 0 && (s != null && (s.State is SessionState.ReportDraft or SessionState.Finalized or SessionState.ManagerApproved or SessionState.Awarded) || status is TenderStatus.OfficerReview or TenderStatus.ManagerReview or TenderStatus.TopCommitteeReview or TenderStatus.Awarded);
    var wzSent = status is TenderStatus.ManagerReview or TenderStatus.TopCommitteeReview or TenderStatus.Awarded;
    var wzDone = new[] { false, true, true, wzApproved, wzPublished, wzClosed && (s != null || status != TenderStatus.Bidding), wzResults, wzResults && status is not TenderStatus.Evaluation, wzSent };
    var wzOpen = new[] { false, true, true, true, wzApproved, wzPublished, wzClosed, wzResults, wzResults };
    var wzCurrent = 8; for (var n = 3; n <= 8; n++) if (!wzDone[n]) { wzCurrent = n; break; }
    if (!wzOpen[wzCurrent]) wzCurrent = Enumerable.Range(1, 8).Where(n => wzOpen[n]).Max();
    var wzTitles = new[] { "", L("Requirements", "المتطلبات"), L("Committee", "اللجنة"), L("Tender Settings", "إعدادات المناقصة"), L("Publish", "النشر"), L("Bids", "العروض"), L("Evaluation", "التقييم"), L("Results", "النتائج"), L("Send to Manager", "إرسال للمدير") };
    var wzClosing = round?.Deadline;
    var wzSpecs = (wzItem?.Specifications ?? "").Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).Select(l => l.Trim()).Where(l => l.Length > 0).ToList();
    var wzTop1 = Model.Ranking.OrderBy(x => x.Rank).FirstOrDefault();
    var wzWinner = rv?.Report.RecommendedBidId is int wzBid ? Model.Ranking.FirstOrDefault(x => x.BidId == wzBid) : wzTop1;
    var wzSignatures = rv?.Signatures.Count(x => x.Stage == ReportSigningStage.Evaluation && x.InvalidatedAt == null) ?? 0;
    var wzFw = finW; var wzTw = tecW;
    var wzReasons = new[] { "", "", "", "", L("Approve the evaluation weights first.", "اعتمد أوزان التقييم أولاً."), L("Publish the tender first.", "انشر المناقصة أولاً."), L("Close bidding and send the offers to the committee first.", "أغلق العروض وأرسلها إلى اللجنة أولاً."), L("Wait until the committee finishes the evaluation.", "انتظر حتى تنهي اللجنة التقييم."), L("Wait until the committee signs the report.", "انتظر حتى توقّع اللجنة على التقرير.") };
    string WzTime(DateTime? t) => t == null ? "—" : t.Value.ToJordan("d MMM yyyy, HH:mm");
}
@if (wz)
{
<div class="wf wf-pop wz" data-tender="@id" data-wz data-wz-current="@wzCurrent" data-wz-total="@(wzManager || wzTop ? 1 : 8)" dir="@(ar ? "rtl" : null)">
    <header class="wz-head">
        <div class="wz-head-main"><span class="wz-kicker">T-@id.ToString("0000") &middot; @wzDept &middot; PR #@wzPr</span><h2 id="wf-dialog-title">@Model.Tender.Title</h2>
            <div class="wz-chips"><span class="wz-chip wz-chip-status">@Words(status.ToString())</span>@if (wzManager) { <span class="wz-chip wz-chip-role">@L("Manager", "المدير")</span> } @if (wzTop) { <span class="wz-chip wz-chip-role">@L("Top Management", "الإدارة العليا")</span> }</div></div>
        @if (!Model.IsSupplier) { @await Component.InvokeAsync("TenderPassport", new { details = Model, trailUrl = Url.Action("Passport", ViewContext.RouteData.Values["controller"]?.ToString(), new { area, id }) }) }
        @if (!(wzManager || wzTop))
        {
        <ol class="wz-steps" aria-label="@L("Tender stages", "مراحل المناقصة")">
            @for (var n = 1; n <= 8; n++)
            {
                <li><button type="button" class="wz-step@(wzDone[n] ? " is-done" : "")@(n == wzCurrent ? " is-current" : "")" data-wz-go="@n" disabled="@(!wzOpen[n])" data-wz-reason="@(wzOpen[n] ? null : wzReasons[n])" aria-current="@(n == wzCurrent ? "step" : null)" title="@(wzOpen[n] ? null : L("Complete the earlier stages to unlock this one", "أكمل المراحل السابقة لفتح هذه المرحلة"))"><b>@(wzDone[n] && n != wzCurrent ? "✓" : n.ToString())</b><span>@wzTitles[n]</span>@if (!wzOpen[n]) { <i aria-hidden="true">&#128274;</i> }</button></li>
            }
        </ol>
        }
    </header>
    @if (TempData["WorkflowMessage"] is string wzMessage) { <div class="wf-flash" role="status"><b aria-hidden="true">&#10003;</b>@wzMessage</div> }
    <div class="wf-error" role="alert" hidden></div>

    @if (wzManager || wzTop)
    {
        <div class="wz-body wz-single">
            <section class="wz-panel is-current">
                <div class="wz-art-side" aria-hidden="true"><span>@(status == TenderStatus.Awarded ? "\U0001F3C6" : wzTop ? "\U0001F3C5" : "✍")</span></div>
                <div class="wz-main">
                    <h3>@(status == TenderStatus.Awarded ? L("Tender Awarded!", "تمت ترسية المناقصة!") : wzTop ? L("Final Approval & Award", "الاعتماد النهائي والترسية") : L("Review & Sign Recommendation", "مراجعة وتوقيع التوصية"))</h3>
                    <p class="wz-lead">@(status == TenderStatus.Awarded ? L($"T-{id:0000} has been awarded to {(wzWinner != null ? BidSupplier(wzWinner.BidId) : "the winning supplier")}.", $"تمت ترسية المناقصة T-{id:0000} على {(wzWinner != null ? BidSupplier(wzWinner.BidId) : "المورد الفائز")}.") : wzTop ? L("Review the recommendation, approve the award, and finalize the tender.", "راجع التوصية واعتمد الترسية وأنهِ المناقصة.") : L("Review the committee result and sign to forward it to Top Management.", "راجع نتيجة اللجنة ووقّع لإرسالها إلى الإدارة العليا."))</p>
                    <dl class="wz-rows">
                        <div><dt>@L("Recommended Supplier", "المورد الموصى به")</dt><dd class="wz-strong">@(wzWinner != null ? BidSupplier(wzWinner.BidId) : "—")</dd></div>
                        <div><dt>@L("Total Score", "الدرجة الإجمالية")</dt><dd><span class="wz-score">@(wzWinner != null ? wzWinner.Score.ToString("0.0") : "—")</span></dd></div>
                        <div><dt>@L("Committee Result", "نتيجة اللجنة")</dt><dd>@Model.Ranking.Count @L("suppliers evaluated", "موردين تم تقييمهم") · @wzSignatures/4 @L("signatures", "توقيعات")</dd></div>
                        @if (status == TenderStatus.Awarded) { <div><dt>@L("Award Date", "تاريخ الترسية")</dt><dd>@WzTime(Model.Tender.AwardedAt)</dd></div><div><dt>@L("Award Reference", "مرجع الترسية")</dt><dd>AWD-@id.ToString("0000")</dd></div> }
                        @if (rv != null) { <div><dt>@L("Evaluation Report", "تقرير التقييم")</dt><dd><a class="wz-ghost wz-link" data-no-modal href="@Url.Action("Pdf", "Reports", new { area, id = rv.Report.Id })" target="_blank" rel="noopener">&#128065; @L("View Report", "عرض التقرير")</a></dd></div> }
                    </dl>
                    <div class="wz-actions">
                        @if (wzManager && status == TenderStatus.ManagerReview) { <a class="wz-primary wz-link" data-no-modal asp-area="SourcingManager" asp-controller="Workflow" asp-action="ExecutiveSummary" asp-route-id="@id">@L("Review & Sign", "مراجعة وتوقيع") <span aria-hidden="true">&rarr;</span></a> }
                        @if (wzManager && status != TenderStatus.ManagerReview) { <span class="wz-note">@L("Signed and forwarded to Top Management.", "تم التوقيع والإرسال إلى الإدارة العليا.")</span> }
                        @if (wzTop && status == TenderStatus.TopCommitteeReview && rv != null) { <a class="wz-primary wz-link" data-no-modal asp-area="TopCommittee" asp-controller="SignedReports" asp-action="Review" asp-route-id="@rv.Report.Id">@L("Open the decision", "فتح القرار") <span aria-hidden="true">&rarr;</span></a> }
                    </div>
                </div>
            </section>
        </div>
    }
    else
    {
    <div class="wz-body">
        @* 1 — Requirements *@
        <section class="wz-panel" data-wz-panel="1">
            <div class="wz-art-side">@if (wzImage != null) { <img src="@Url.Action("ItemImage", "PurchaseRequests", new { area = "SourcingOfficer", id = wzImage })" alt="@wzItem?.Name" loading="lazy" /> } else { <span aria-hidden="true">&#128230;</span> }</div>
            <div class="wz-main"><h3>@L("Request Details", "تفاصيل الطلب")</h3><p class="wz-lead">@L("Review the requested item and specifications.", "راجع المادة المطلوبة ومواصفاتها.")</p>
                <div class="wz-item"><strong>@(wzItem?.Name ?? "—")</strong><small>@(wzItem?.Category?.Name)</small><span class="wz-qty">@L("Quantity", "الكمية") <b>@(wzItem?.Quantity.ToString("0.###") ?? "—") @wzItem?.Unit</b></span></div>
                <h4>@L("Specifications", "المواصفات")</h4>
                <div class="wz-specs">@foreach (var line in wzSpecs.Take(8)) { var cut = line.IndexOf(':'); <span><small>@(cut > 0 ? line[..cut] : "")</small><b>@(cut > 0 ? line[(cut + 1)..].Trim() : line)</b></span> }@if (wzSpecs.Count == 0) { <span><b>—</b></span> }</div>
            </div></section>
        @* 2 — Committee *@
        <section class="wz-panel" data-wz-panel="2">
            <div class="wz-art-side" aria-hidden="true"><span>&#128101;</span></div>
            <div class="wz-main"><h3>@L("Evaluation Committee", "لجنة التقييم")</h3><p class="wz-lead">@(w != null && !lowestPrice ? L("The committee members and their weight proposals.", "أعضاء اللجنة ومقترحات الأوزان الخاصة بهم.") : L("The committee members assigned to evaluate the suppliers.", "أعضاء اللجنة المعيّنون لتقييم الموردين."))</p>
                @if (w != null && !lowestPrice)
                {
                    <div class="wz-voting" aria-label="@L("Voting Progress", "تقدّم التصويت")">
                        <div class="wz-voting-bar"><progress value="@votedMembers" max="@evalMembers.Count" aria-label="@L("Submitted proposals", "المقترحات المقدّمة")"></progress><span class="wz-tag is-warm">@(ar ? $"صوّت {votedMembers} من {evalMembers.Count}" : $"{votedMembers} of {evalMembers.Count} voted")</span><button type="button" class="wz-ghost wz-small" data-refresh-weight-progress>@L("Refresh", "تحديث")</button></div>
                        <ul class="wz-people wz-compact">@foreach (var m in evalMembers) { var voted = w.Proposals.Any(p => p.MemberUserId == m.UserId); <li><span class="wz-avatar">@Initial(Who(m.UserId))</span><div><strong>@Who(m.UserId)</strong><small>@WeightRole(m.Responsibility)</small></div><span class="wz-tag @(voted ? "is-good" : "")">@(voted ? L("✓ Voted", "✓ صوّت") : L("Pending", "بانتظار التصويت"))</span></li> }</ul>
                    </div>
                }
                else { <ul class="wz-people">@foreach (var m in evalMembers) { <li><span class="wz-avatar">@Initial(Who(m.UserId))</span><div><strong>@Who(m.UserId)</strong><small>@WeightRole(m.Responsibility)</small></div><i aria-hidden="true">&#10003;</i></li> }</ul> }</div></section>
        @* 3 — Tender settings: weights and closing date *@
        <section class="wz-panel" data-wz-panel="3">
            <div class="wz-art-side"><div class="wz-ring" style="--a:@((wzFw ?? 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"><b>@(wzFw != null ? "100%" : "—")</b><small>@L("Total Weight", "إجمالي الوزن")</small></div></div>
            <div class="wz-main"><h3>@L("Evaluation Weights & Closing Date", "أوزان التقييم وموعد الإغلاق")</h3>
                @if (lowestPrice) { <p class="wz-lead">@L("This tender is evaluated 100% on the lowest compliant price: no committee weights are needed.", "تُقيَّم هذه المناقصة بنسبة ١٠٠٪ على أقل سعر مطابق: لا حاجة لأوزان اللجنة.")</p> }
                else
                {
                    <p class="wz-lead">@(w == null ? L("Send the tender to the committee: each member proposes the split and the average becomes the official weights.", "أرسل المناقصة إلى اللجنة: يقترح كل عضو التوزيع ويصبح المتوسط هو الوزن الرسمي.") : w.State == WeightState.Proposals ? L($"Waiting for weight proposals ({votedMembers} of {evalMembers.Count}).", $"بانتظار مقترحات الأوزان ({votedMembers} من {evalMembers.Count}).") : w.State == WeightState.AwaitingApproval ? L("All proposals are in. Review the average and approve it.", "اكتملت المقترحات. راجع المتوسط واعتمده.") : L("The weights are approved and locked.", "تم اعتماد الأوزان وقفلها."))</p>
                    @if (w != null && w.State == WeightState.Proposals)
                    {
                        <div class="wz-voting" aria-label="@L("Voting Progress", "تقدّم التصويت")">
                            <div class="wz-voting-bar"><progress value="@votedMembers" max="@evalMembers.Count" aria-label="@L("Submitted proposals", "المقترحات المقدّمة")"></progress><span class="wz-tag is-warm">@(ar ? $"صوّت {votedMembers} من {evalMembers.Count}" : $"{votedMembers} of {evalMembers.Count} voted")</span><button type="button" class="wz-ghost wz-small" data-refresh-weight-progress>@L("Refresh", "تحديث")</button></div>
                            <ul class="wz-people wz-compact">@foreach (var member in evalMembers) { var voted = w.Proposals.Any(p => p.MemberUserId == member.UserId); <li><span class="wz-avatar">@Initial(Who(member.UserId))</span><div><strong>@Who(member.UserId)</strong><small>@WeightRole(member.Responsibility)</small></div><span class="wz-tag @(voted ? "is-good" : "")">@(voted ? L("✓ Voted", "✓ صوّت") : L("Pending", "بانتظار التصويت"))</span></li> }</ul>
                        </div>
                    }
                    else
                    {
                                        <dl class="wz-rows wz-weights">
                            <div><dt>@L("Technical Evaluation", "التقييم الفني")</dt><dd><span class="wz-pct">@(wzTw?.ToString("0.##") ?? "—")%</span></dd></div>
                            <div><dt>@L("Financial Evaluation", "التقييم المالي")</dt><dd><span class="wz-pct">@(wzFw?.ToString("0.##") ?? "—")%</span></dd></div>
                        </dl>
                    }
                }
                <h4>@L("Tender Closing Date & Time", "تاريخ ووقت إغلاق المناقصة")</h4>
                @if (status == TenderStatus.Draft)
                {
                    <div class="wz-deadline"><select class="wz-select" data-wz-preset aria-label="@L("Days from now", "عدد الأيام من الآن")"><option value="">@L("Choose number of days…", "اختر عدد الأيام…")</option><option value="1">@L("In 1 day", "خلال يوم")</option><option value="2">@L("In 2 days", "خلال يومين")</option><option value="3">@L("In 3 days", "خلال ٣ أيام")</option><option value="5">@L("In 5 days", "خلال ٥ أيام")</option><option value="7">@L("In 1 week", "خلال أسبوع")</option><option value="14">@L("In 2 weeks", "خلال أسبوعين")</option><option value="21">@L("In 3 weeks", "خلال ٣ أسابيع")</option><option value="30">@L("In 1 month", "خلال شهر")</option></select>
                        <input type="datetime-local" class="wz-select" data-wz-deadline aria-label="@L("Bidding deadline", "الموعد النهائي")" @(Model.Tender.PurchaseRequest?.NeededBy is DateTime wzNeeded && wzNeeded.Date > Model.UtcNow.AddHours(3).Date ? Html.Raw("max=\"" + wzNeeded.ToString("yyyy-MM-dd") + "T23:59\"") : null) /></div>
                    @if (Model.Tender.PurchaseRequest?.NeededBy is DateTime wzNeededBy) { <p class="wz-muted">@(wzNeededBy.Date > Model.UtcNow.AddHours(3).Date ? L("The department needs the items by", "تحتاج الجهة الطالبة المواد بحلول") + " " + wzNeededBy.ToString("d MMM yyyy") + ". " + L("The closing date cannot be later.", "ولا يمكن أن يكون موعد الإغلاق بعد ذلك.") : L("The department's needed-by date", "تاريخ حاجة الجهة الطالبة") + " (" + wzNeededBy.ToString("d MMM yyyy") + ") " + L("is today or has passed, so you can choose any closing date.", "هو اليوم أو انتهى، فيمكنك اختيار أي موعد إغلاق."))</p> }
                }
                else { <p class="wz-strong">@WzTime(wzClosing)</p> }
                @if (!lowestPrice)
                {
                    @if (!wzApproved && status == TenderStatus.Draft && !(Model.CanApproveWeights && w?.State == WeightState.AwaitingApproval)) { <p class="wz-callout" role="status"><b aria-hidden="true">&#9203;</b> @(w == null ? L("Next step: send the tender to the committee so each member proposes the weights.", "الخطوة التالية: أرسل المناقصة إلى اللجنة ليقترح كل عضو الأوزان.") : w.State == WeightState.Proposals ? L($"Next step: the committee proposes the weights ({votedMembers} of {evalMembers.Count} so far). \"Continue\" opens when the weights are approved.", $"الخطوة التالية: تقترح اللجنة الأوزان ({votedMembers} من {evalMembers.Count} حتى الآن). يُفتح \"متابعة\" عند اعتماد الأوزان.") : L("Next step: approve the average of the proposals to unlock \"Continue\".", "الخطوة التالية: اعتمد متوسط المقترحات لفتح \"متابعة\".")) </p> }
                    <div class="wz-actions wz-inline wz-approve">
                        @if (w == null && status == TenderStatus.Draft) { <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="RequestWeights" asp-route-id="@id" method="post" class="wp-form"><button class="wz-primary">@L("Send to Committee", "إرسال إلى اللجنة") <span aria-hidden="true">&rarr;</span></button></form> }
                        @if (Model.CanApproveWeights && w != null && w.State == WeightState.AwaitingApproval) { <partial name="_ApproveTechnicalWeights" model='(w!, Model.Tender.Items.AsEnumerable())' />
                <details class="wp-opt"><summary>@L("Return selected proposals for revision", "إعادة مقترحات محددة للمراجعة")</summary>
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="ReturnWeights" asp-route-id="@id" method="post" class="wp-form">
                        @foreach (var member in evalMembers) { <label class="wp-check"><input type="checkbox" name="memberIds" value="@member.Id" /><span>@Who(member.UserId) · @WeightRole(member.Responsibility)</span></label> }
                        <label>@L("Reason and what to revise", "السبب والمطلوب مراجعته")<textarea name="note" minlength="10" maxlength="2000" rows="3" required></textarea></label>
                        <button class="wp-ghost">@L("Return selected proposals", "إعادة المقترحات المحددة")</button>
                    </form>
                </details> }
                    </div>
                }
            </div></section>
        @* 4 — Publish *@
        <section class="wz-panel" data-wz-panel="4">
            <div class="wz-art-side" aria-hidden="true"><span>&#128227;</span></div>
            <div class="wz-main" data-wz-publish-main><h3>@L("Publish Tender", "نشر المناقصة")</h3><div data-wz-summary><p class="wz-lead">@L("Send the tender to registered suppliers.", "أرسل المناقصة إلى الموردين المسجّلين.")</p>
                <dl class="wz-rows">
                    <div><dt>@L("Tender", "المناقصة")</dt><dd>T-@id.ToString("0000")</dd></div>
                    <div><dt>@L("Item", "المادة")</dt><dd>@(wzItem?.Name) × @(wzItem?.Quantity.ToString("0.###"))</dd></div>
                    <div><dt>@L("Closing Date", "تاريخ الإغلاق")</dt><dd data-wz-deadline-echo>@(status == TenderStatus.Draft ? "—" : WzTime(wzClosing))</dd></div>
                    <div><dt>@L("Evaluation Weights", "أوزان التقييم")</dt><dd>@(lowestPrice ? L("100% financial", "١٠٠٪ مالي") : $"{L("Technical", "فني")} {wzTw?.ToString("0.##")}% · {L("Financial", "مالي")} {wzFw?.ToString("0.##")}%")</dd></div>
                    <div><dt>@L("Invited Suppliers", "الموردون المدعوون")</dt><dd>@(round?.Invitations.Count ?? 0)</dd></div>
                </dl>
                <div class="wz-actions">
                    @if (status == TenderStatus.Draft && wzApproved) { <form id="wz-open-form" asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="OpenBidding" asp-route-id="@id" method="post" class="wp-form"><input type="hidden" name="deadline" data-wz-deadline-utc /><button class="wz-primary" data-wz-publish>&#128227; @L("Publish to Suppliers", "نشر للموردين")</button><small data-wz-publish-hint>@L("Choose the closing date in the Tender Settings stage first.", "اختر تاريخ الإغلاق في مرحلة إعدادات المناقصة أولاً.")</small><small class="wz-bad" data-wz-deadline-error hidden>@L("The closing time must be at least one hour from now.", "يجب أن يكون وقت الإغلاق بعد ساعة على الأقل من الآن.")</small></form> }
                    @if (status == TenderStatus.Bidding && round?.Status == TenderRoundStatus.Open && inviteable is { Count: > 0 })
                    {
                        <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="InviteAll" asp-route-id="@id" method="post" class="wp-form">@foreach (var sp in inviteable) { <input type="hidden" name="supplierIds" value="@sp.Id" /> }<button class="wz-primary" data-confirm="@L("Send tender invitations to all eligible suppliers?", "هل تريد إرسال دعوات المناقصة لجميع الموردين المؤهلين؟")">@L($"Invite {inviteable.Count} eligible supplier(s)", $"دعوة {inviteable.Count} من الموردين المؤهلين")</button></form>
                        <button type="button" class="wz-ghost" data-wz-picker-open>@L("Choose suppliers manually", "اختيار الموردين يدوياً")</button>
                    }
                </div></div>
                <div class="wz-picker" data-wz-picker hidden><p><button type="button" class="wz-ghost wz-small" data-wz-picker-close>&larr; @L("Back to the summary", "العودة إلى الملخص")</button></p>
        @if (Model.IsOfficer && status == TenderStatus.Bidding && round?.Status == TenderRoundStatus.Open && w?.State == WeightState.Approved)
        {
            <div class="wp-actions">
                @if (approvedSuppliers is { Count: > 0 })
                {
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="InviteAll" asp-route-id="@id" method="post" class="wp-form wp-picker" data-picker>
                        <div class="wp-cols">
                            <label>Search suppliers<input type="search" data-supplier-search placeholder="Company name" /></label>
                            <label>Category<select data-supplier-category><option value="">All categories (@approvedSuppliers.Count)</option>@foreach (var category in SupplierCategories.All) { <option value="@category">@category (@approvedSuppliers.Count(x => x.Category == category))@(tenderCategories.Contains(category) ? " · in this tender" : "")</option> }</select></label>
                            <label>Documents<select data-supplier-docs><option value="">Any</option><option value="verified">Verified, not expired</option><option value="clean">No expired or pending documents</option></select></label>
                            <label>History<select data-supplier-history><option value="">Any</option><option value="offers">Has submitted offers before</option><option value="awards">Has won a tender before</option><option value="new">No earlier offers</option></select></label>
                        </div>
                        <p class="wp-hint">Only approved suppliers with an active, verified account are listed.@(tenderCategories.Count > 0 ? " Tender item categories: " + string.Join(", ", tenderCategories) + "." : "") <button type="button" class="wp-ghost" data-supplier-reset>Clear filters</button></p>
                        @if (inviteable is { Count: 0 }) { <p class="wp-empty">All eligible suppliers have already been invited to this round.</p> }
                        <div class="wp-pick-head"><label class="wp-check"><input type="checkbox" data-select-all @(inviteable is { Count: > 0 } ? null : "disabled") /> Select all</label><span class="wp-pick-count" data-count>0 selected</span></div>
                        <ul class="wp-pick" data-fv-group-required data-fv-label="suppliers" data-fv-msg="Please select at least one supplier to invite." data-fv-msg-ar="يرجى اختيار مورد واحد على الأقل لدعوته.">@foreach (var sp in approvedSuppliers) { var done = invitedIds.Contains(sp.Id); <li class="@(done ? "is-invited" : null)" data-supplier-name="@sp.CompanyName.ToLowerInvariant()" data-supplier-category="@sp.Category" data-verified="@sp.Verified" data-issues="@(sp.Expired + sp.Pending)" data-offers="@sp.Offers" data-awards="@sp.Awards"><label class="wp-check"><input type="checkbox" name="supplierIds" value="@sp.Id" @(done ? "checked disabled" : null) /><span>@sp.CompanyName <small>@sp.Category · @sp.Verified verified doc(s)@(sp.Expired > 0 ? $" · {sp.Expired} expired" : "")@(sp.Pending > 0 ? $" · {sp.Pending} pending review" : "") · @sp.Offers earlier offer(s) · @sp.Awards award(s)</small></span>@if (done) { <em>Invited</em> }</label></li> }</ul>
                        <p class="wp-empty" role="status" data-supplier-empty hidden>No eligible suppliers match these filters. Clear the filters to see all eligible suppliers.</p>
                        <button class="wp-primary" data-pick-btn disabled data-confirm="Send tender invitations to the selected suppliers? Each one is notified and can accept or decline.">Invite selected</button>
                        <small>Each invited supplier gets a notification, accepts, and sends an offer from their own portal.</small>
                    </form>
                }
                else
                {
                    <p class="wp-empty">No eligible suppliers are available. Suppliers can be selected once their company is approved and they have an active account with a verified email address.</p>
                }
                <details class="wp-opt"><summary>Invite a company that is not registered</summary>
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="InviteExternal" asp-route-id="@id" method="post" class="wp-form"><div class="wp-cols"><label>Company<input name="companyName" maxlength="200" required data-fv-label="Company name" /></label><label>Email<input name="email" type="email" maxlength="256" required /></label><label>Phone (optional)<input name="phone" type="tel" maxlength="40" /></label></div><button>Send invitation</button><small>They receive a registration invitation first; an offer still needs an approved registration.</small></form></details>
            </div>
        }

                </div></section>
        @* 5 — Bids *@
        <section class="wz-panel" data-wz-panel="5">
            <div class="wz-art-side" aria-hidden="true"><span>&#128203;</span></div>
            <div class="wz-main">@if (wzClosed && s == null)
                {
                <h3>@L("Send Offers to the Committee", "إرسال العروض إلى اللجنة")</h3>
        @if (Model.IsOfficer && closedRound && lowestPrice)
        {
            <partial name="_FinancialOfferReview" model="Model" />
        }
        else if (Model.IsOfficer && closedRound)
        {
            var cur = !proceeded ? 1 : reviewedAi.Count == 0 ? 2 : 3;
            <div class="wp-wizard" data-wizard data-current="@cur">
                <ol class="wp-wsteps" aria-label="Preparation steps">
                    <li class="@(cur > 1 ? "is-done" : "is-now")"><button type="button" data-goto="1"><b>@(cur > 1 ? "✓" : "1")</b><span>Continue</span></button></li>
                    <li class="@(cur > 2 ? "is-done" : cur == 2 ? "is-now" : "")"><button type="button" data-goto="2" @(cur < 2 ? "disabled" : null)><b>@(cur > 2 ? "✓" : "2")</b><span>AI analysis</span></button></li>
                    <li class="@(cur == 3 ? "is-now" : "")"><button type="button" data-goto="3" @(cur < 3 ? "disabled" : null)><b>3</b><span>Schedule</span></button></li>
                </ol>
                <section class="wp-wpanel" data-step="1" @(cur == 1 ? null : "hidden")>
                    <h4>Continue with this round</h4>
                                        <small>@Model.DistinctOffers supplier(s) sent offers. The normal minimum is @Model.MinimumOffers.</small>
                    @if (proceeded) { <p class="wp-hint">Recorded: you are continuing with this round.</p> }
                    else if (enoughOffers || approvedException != null) { <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Proceed" asp-route-id="@id" method="post" class="wp-form"><button class="wp-primary">Next <span aria-hidden="true">&rarr;</span></button></form> }
                    else if (pendingRequest != null) { <p class="wp-hint">Waiting for the Sourcing Manager to approve continuing with fewer suppliers.</p> }
                    else if (Model.DistinctOffers >= 1) { <details class="wp-opt" open><summary>Fewer offers than the minimum</summary><form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="RequestProceed" asp-route-id="@id" method="post" class="wp-form"><label>Why continue with @Model.DistinctOffers supplier(s)?<select class="wp-quick" aria-label="Quick text"><option value="">Quick pick&hellip;</option><option>The market has only a few qualified suppliers.</option><option>The offers received meet all requirements.</option><option>Re-tendering would delay a critical purchase.</option></select><textarea name="justification" maxlength="2000" required rows="2" data-fv-label="Justification"></textarea></label><button>Ask the Manager to approve</button></form></details> }
                    else { <p class="wp-hint">No offers were received, so re-tender is the only option.</p> }
                    @if (round!.RoundNumber < Model.MaxRounds)
                    {
                        <details class="wp-opt"><summary>Or re-tender (new round)</summary><form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Retender" asp-route-id="@id" method="post" class="wp-form"><label>Reason<select class="wp-quick" aria-label="Quick text"><option value="">Quick pick&hellip;</option><option>Not enough compliant offers were received.</option><option>The offers do not meet the requirements.</option><option>The requirements were updated.</option><option>The prices are far above the estimate.</option></select><textarea name="reason" maxlength="2000" required rows="2" data-fv-label="Re-tender reason" data-fv-label-ar="سبب إعادة الطرح"></textarea></label><label class="wp-check"><input type="checkbox" required /> These offers will not be evaluated.</label><button class="wp-ghost">Create round @(round.RoundNumber + 1)</button></form></details>
                    }
                    else { <p class="wp-hint">This was the last permitted round.</p> }
                </section>
                <section class="wp-wpanel" data-step="2" @(cur == 2 ? null : "hidden")>
                    <h4>AI analysis</h4>
                                        <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Analyze" asp-route-id="@id" method="post" class="wp-form wp-inline"><button class="wp-ghost">Run the AI analysis</button><small>Advisory only. It never changes scores or decisions.</small></form>
                    @foreach (var ai in Model.Analyses)
                    {
                        <details class="wp-opt" @(ai.ReviewedAt == null ? "open" : null)><summary>Analysis #@ai.Id &middot; @ai.Status @(ai.ReviewedAt != null ? "· reviewed" : "")</summary>@{ var fr = FindingRows(ai.Findings); }@if (fr.Count > 0) { <dl class="wp-ai">@foreach (var row in fr) { <div><dt>@row.Label</dt><dd>@row.Value</dd></div> }</dl> } else { <div class="wp-text">@ai.Findings</div> }
                            @if (ai.Status == "Completed" && ai.ReviewedAt == null) { <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="ReviewAi" asp-route-id="@id" method="post" class="wp-form"><input name="analysisId" type="hidden" value="@ai.Id" /><button class="wp-primary">I reviewed it, next &rarr;</button></form> }</details>
                    }
                </section>
                <section class="wp-wpanel" data-step="3" @(cur == 3 ? null : "hidden")>
                    <h4>@L("Evaluation Meeting", "اجتماع التقييم")</h4>
                                        @if (reviewedAi.Count == 0) { <p class="wp-hint">Run and review the AI analysis first.</p> }
                    else
                    {
                        <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Setup" asp-route-id="@id" method="post" class="wp-form">
                            <div class="wp-cols"><label class="wp-schedule-ai">@L("Reviewed AI supplier comparison", "مقارنة الموردين المراجعة")<select name="AiAnalysisId" required>@foreach (var ai in reviewedAi) { <option value="@ai.Id">@L("Analysis", "التحليل") #@ai.Id</option> }</select></label></div><div class="wp-cols"><label>@L("Starts", "البدء")<input name="StartsAt" type="datetime-local" data-utc="local" required data-fv-future data-fv-label="Start time" data-fv-label-ar="وقت البدء" /></label><label>@L("Ends", "الانتهاء")<input name="EndsAt" type="datetime-local" data-utc="local" required data-fv-after="StartsAt" data-fv-label="End time" data-fv-label-ar="وقت الانتهاء" /></label></div>
                            <label class="wp-check"><input name="CreateJitsiMeeting" type="checkbox" value="true" checked /> @L("Create the video meeting automatically", "إنشاء اجتماع الفيديو تلقائيًا")</label>
                            <details class="wp-opt"><summary>@L("Use an existing Zoom link", "استخدام رابط Zoom موجود")</summary><label>@L("Zoom link", "رابط Zoom")<input name="MeetingUrl" type="url" placeholder="https://zoom.us/j/..." data-fv-optional /></label></details>
                            <button class="wp-primary">@L("Schedule and Invite Committee", "جدولة الاجتماع ودعوة اللجنة")</button></form>
                    }
                </section>
                <div class="wp-wnav"><button type="button" class="wp-ghost" data-wback>&larr; Back</button><span class="wp-wnote" data-wnote></span><button type="button" class="wp-primary" data-wnext>Next <span aria-hidden="true">&rarr;</span></button></div>
            </div>
        }

                }
                else
                {
                <h3 id="wz-supplier-bids-title">@L("Track Supplier Bids", "متابعة عروض الموردين")</h3>
                <div class="wz-table wz-supplier-bids" role="region" aria-labelledby="wz-supplier-bids-title" tabindex="0"><table><thead><tr><th>#</th><th>@L("Supplier", "المورد")</th><th>@L("Offer Amount", "قيمة العرض")</th><th>@L("Submission Time", "وقت التقديم")</th><th>@L("Status", "الحالة")</th></tr></thead><tbody>
                @{ var rowNo = 0; }
                @foreach (var row in supplierBidRows)
                {
                    rowNo++;
                    var bid = row.Bid;
                    var declined = row.Invitation.Status == InvitationStatus.Declined;
                    <tr>
                        <td>@rowNo</td>
                        <td>@SupplierName(row.Invitation.SupplierId)</td>
                        <td>@(bid != null ? Price(bid).ToString("N0") + " " + bid.CurrencyCode : "—")</td>
                        <td>@WzTime(bid?.SubmittedAt)</td>
                        <td><span class="wz-tag @(bid != null ? "is-good" : declined ? "is-bad" : "")">@(bid != null ? L("Submitted", "تم التقديم") : declined ? L("Declined", "اعتذر") : L("Pending", "قيد الانتظار"))</span></td>
                    </tr>
                }
                @if (supplierBidRows.Count == 0) { <tr><td colspan="5" class="wz-empty">@L("No suppliers have been invited yet.", "لم تتم دعوة أي مورد بعد.")</td></tr> }
                </tbody></table></div>
                <p class="wz-muted">@submittedSupplierCount @L("offer(s) received", "عرض/عروض مستلمة") · @L("closing", "الإغلاق") @WzTime(wzClosing)</p>
                <div class="wz-actions">
                    @if (round?.Status == TenderRoundStatus.Open && status == TenderStatus.Bidding)
                    {
                        <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="CloseBidding" asp-route-id="@id" method="post" class="wp-form" data-close-bidding><button class="wz-primary" disabled="@(!canCloseBidding)">@L("Close bidding & continue", "إغلاق العروض والمتابعة") <span aria-hidden="true">&rarr;</span></button>@if (!canCloseBidding) { <small>@L("Available when 3 suppliers submit, everyone answers, or the deadline passes.", "متاح عند تقديم 3 موردين أو رد الجميع أو انتهاء الموعد.")</small> }</form>
                    }
                </div>
                }
            </div></section>
        @* 6 — Committee evaluation *@
        <section class="wz-panel" data-wz-panel="6">
            <div class="wz-art-side" aria-hidden="true"><span>&#128101;</span></div>
            <div class="wz-main"><h3>@L("Committee Evaluation", "تقييم اللجنة")</h3><p class="wz-lead">@L("The committee evaluates the suppliers based on the weights.", "تقيّم اللجنة الموردين بحسب الأوزان.")</p>
                @if (s != null)
                {
                    <dl class="wz-rows"><div><dt>@L("Meeting & scoring", "الاجتماع والتقييم")</dt><dd>@WzTime(s.StartsAt) → @WzTime(s.EndsAt)</dd></div><div><dt>@L("Submitted", "تم التقديم")</dt><dd>@s.Submissions.Count / @evalMembers.Count</dd></div></dl>
                    @if (Model.IsOfficer && status == TenderStatus.Evaluation && s.ReportId == null && s.State is (SessionState.Scheduled or SessionState.Incomplete) && s.Submissions.Count == 0)
                    {
                        <details class="wp-opt"><summary>@L("Change the meeting time", "تغيير موعد الاجتماع")</summary>
                            <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="RescheduleEvaluation" asp-route-id="@id" method="post" class="wp-form">
                                <div class="wp-cols">
                                    <label>@L("New start", "وقت البدء الجديد")<input name="startsAt" type="datetime-local" value="@s.StartsAt.ToJordan("yyyy-MM-ddTHH:mm")" required data-utc data-fv-label="Start time" data-fv-label-ar="وقت البدء" /></label>
                                    <label>@L("New end", "وقت الانتهاء الجديد")<input name="endsAt" type="datetime-local" value="@s.EndsAt.ToJordan("yyyy-MM-ddTHH:mm")" required data-utc data-fv-after="startsAt" data-fv-label="End time" data-fv-label-ar="وقت الانتهاء" /></label>
                                </div>
                                <label>@L("Reason", "السبب")<textarea name="reason" maxlength="500" required rows="2" data-fv-label="Reason" data-fv-label-ar="السبب"></textarea></label>
                                <small>@L("Enter times in Jordan time. You can change the meeting time until the first final evaluation is submitted. The meeting link stays the same.", "أدخل الأوقات بتوقيت الأردن. يمكنك تغيير موعد الاجتماع حتى تقديم أول تقييم نهائي. يظل رابط الاجتماع كما هو.")</small>
                                <button class="wz-primary">@L("Save the new time and notify the committee", "حفظ الموعد الجديد وإبلاغ اللجنة")</button>
                            </form>
                        </details>
                    }
                    <ul class="wz-people wz-compact">@foreach (var m in evalMembers) { var done = s.Submissions.Any(x => x.CommitteeMemberId == m.Id); <li><span class="wz-avatar">@Initial(Who(m.UserId))</span><div><strong>@Who(m.UserId)</strong><small>@WeightRole(m.Responsibility)</small></div><span class="wz-tag @(done ? "is-good" : "")">@(done ? L("Submitted", "تم") : L("Pending", "قيد الانتظار"))</span></li> }</ul>
                    @if (s.State == SessionState.Scheduled && s.Submissions.Count == 4) { <div class="wz-actions"><form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="EndEvaluation" asp-route-id="@id" method="post" class="wp-form"><input type="hidden" name="reason" value="All four committee evaluations were submitted." /><label class="wp-check"><input name="confirmed" type="checkbox" value="true" required /> @L("I confirm that all four evaluations are final.", "أؤكد أن التقييمات الأربعة نهائية.")</label><button class="wz-primary">@L("Generate the report now", "إنشاء التقرير الآن")</button></form></div> }
                    @if (s.MeetingUrl != null && s.State == SessionState.Scheduled) { <p class="wz-muted"><a class="wz-link" data-no-modal href="/Meetings/Join/@id">&#127909; @L("Join the meeting", "الانضمام إلى الاجتماع")</a></p> }
                }
                else { <p class="wz-empty">@L("The evaluation starts after the offers are sent to the committee.", "يبدأ التقييم بعد إرسال العروض إلى اللجنة.")</p> }
            </div></section>
        @* 7 — Results *@
        <section class="wz-panel" data-wz-panel="7">
            <div class="wz-art-side" aria-hidden="true"><span>&#128202;</span></div>
            <div class="wz-main"><h3>@L("Weighted Results", "النتائج المرجّحة")</h3><p class="wz-lead">@L("Final evaluation results from the committee.", "النتائج النهائية لتقييم اللجنة.")</p>
                <div class="wz-table"><table><thead><tr><th>@L("Rank", "الترتيب")</th><th>@L("Supplier", "المورد")</th><th>@L("Total Score", "الدرجة الإجمالية")</th></tr></thead><tbody>
                @foreach (var row in Model.Ranking.OrderBy(x => x.Rank).Take(6)) { <tr class="@(row.Rank == 1 ? "is-top" : null)"><td><span class="wz-rank">@row.Rank</span></td><td>@BidSupplier(row.BidId)</td><td><span class="wz-score@(row.Rank == 1 ? " is-win" : "")">@row.Score.ToString("0.0")</span></td></tr> }
                @if (Model.Ranking.Count == 0) { <tr><td colspan="3" class="wz-empty">@L("Results appear when the evaluation ends.", "تظهر النتائج عند انتهاء التقييم.")</td></tr> }
                </tbody></table></div>
            </div></section>
        @* 8 — Send to Manager *@
        <section class="wz-panel" data-wz-panel="8">
            <div class="wz-art-side" aria-hidden="true"><span>@(wzSent ? "✅" : "\U0001F4E4")</span></div>
            <div class="wz-main">
                @if (wzSent)
                {
                    @if (rejected)
                    {
                        <h3>@L("Returned by Top Management", "أُعيدت من الإدارة العليا")</h3><p class="wz-lead">@reasonText</p>
                        <div class="wz-actions"><a class="wz-primary wz-link" data-no-modal asp-area="SourcingOfficer" asp-controller="FinalDecisions" asp-action="Index">@L("Open Final Decisions", "فتح القرارات النهائية") <span aria-hidden="true">&rarr;</span></a></div>
                    }
                    else {
                    <h3>@L("Result Sent to Manager!", "تم إرسال النتيجة إلى المدير!")</h3><p class="wz-lead">@L("The evaluation result and recommendation have been sent to the Manager for review and signature.", "تم إرسال نتيجة التقييم والتوصية إلى المدير للمراجعة والتوقيع.")</p>
                    <p><span class="wz-chip wz-chip-status">@(status == TenderStatus.ManagerReview ? L("Awaiting Manager Review", "بانتظار مراجعة المدير") : status == TenderStatus.TopCommitteeReview ? L("Awaiting Top Management Decision", "بانتظار قرار الإدارة العليا") : L("Awarded", "تمت الترسية"))</span></p>
                    }
                }
                else
                {
                    <h3>@L("Send Recommendation to Manager", "إرسال التوصية إلى المدير")</h3><p class="wz-lead">@L("Submit the committee result and recommend the winning supplier.", "قدّم نتيجة اللجنة ورشّح المورد الفائز.")</p>
                    <dl class="wz-rows"><div><dt>@L("Recommended Supplier", "المورد الموصى به")</dt><dd class="wz-strong">@(wzWinner != null ? BidSupplier(wzWinner.BidId) : "—")</dd></div><div><dt>@L("Total Score", "الدرجة الإجمالية")</dt><dd><span class="wz-score is-win">@(wzWinner != null ? wzWinner.Score.ToString("0.0") : "—")</span></dd></div><div><dt>@L("Committee signatures", "تواقيع اللجنة")</dt><dd>@wzSignatures / 4</dd></div></dl>
                    <div class="wz-actions">
                        @if (rv != null) { <a class="wz-ghost wz-link" data-no-modal href="@Url.Action("Pdf", "Reports", new { area, id = rv.Report.Id })" target="_blank" rel="noopener">&#128065; @L("View Report", "عرض التقرير")</a> }
                        @if (rv != null && rv.CanForward) { <form asp-area="SourcingOfficer" asp-controller="Reports" asp-action="Forward" asp-route-id="@rv.Report.Id" method="post" class="wp-form"><button class="wz-primary" data-confirm="@L("Send the signed report to the Sourcing Manager?", "هل تريد إرسال التقرير الموقّع إلى مدير التوريد؟")">@L("Send to Manager", "إرسال إلى المدير") <span aria-hidden="true">&rarr;</span></button></form> }
                        else { <small class="wz-note">@(status == TenderStatus.Evaluation ? L("Available when all four members have signed the report.", "متاح عند توقيع الأعضاء الأربعة على التقرير.") : "")</small> }
                    </div>
                }
            </div></section>
    </div>
    <footer class="wz-foot">
        <button type="button" class="wz-ghost" data-wz-back>&larr; @L("Back", "رجوع")</button>
        <div class="wz-dots" aria-hidden="true">@for (var n = 1; n <= 8; n++) { <i class="@(n <= wzCurrent ? "is-on" : null)"></i> }</div>
        <span class="wz-lockhint" data-wz-lockhint role="status"></span>
        <span class="wz-stepno" data-wz-stepno>@L("Step", "الخطوة") @wzCurrent @L("of", "من") 8</span>
        <button type="button" class="wz-primary" data-wz-next>@L("Continue", "متابعة") <span aria-hidden="true">&rarr;</span></button>
    </footer>
    }
</div>
}

@if (!wz)
{
<div data-wz-classic-box>
<div class="wf wf-pop@(weightSetup ? " wf-weight-setup" : "")@(evaluationStage ? " wf-evaluation-stage" : "")" dir="@((weightSetup || evaluationStage) ? (ar ? "rtl" : "ltr") : null)" data-tender="@id">
    <header class="wf-pop-head@(Model.IsSupplier ? "" : " has-passport")">
        <div class="wf-pop-title"><span class="wf-eyebrow">T-@id.ToString("0000")</span><h2 id="wf-dialog-title">@Model.Tender.Title</h2>
            <div class="wf-chips"><span class="wf-chip wf-chip-status">@Words(status.ToString())</span>@if (w?.State == WeightState.Approved) { <span class="wf-chip wf-chip-good">Weights @w.ApprovedFinancial!.Value.ToString("0.##")% financial / @w.ApprovedTechnical!.Value.ToString("0.##")% technical</span> }</div></div>
        @* Tender Passport: the audit trail as a tracked package (internal users only; Views/Shared/Components/TenderPassport). *@
        @if (!Model.IsSupplier) { @await Component.InvokeAsync("TenderPassport", new { details = Model, trailUrl = Url.Action("Passport", ViewContext.RouteData.Values["controller"]?.ToString(), new { area, id }) }) }
        <partial name="_WorkflowStepper" model="Model" />
    </header>
    @if (TempData["WorkflowMessage"] is string message) { <div class="wf-flash" role="status"><b aria-hidden="true">&#10003;</b>@message</div> }
    <div class="wf-error" role="alert" hidden></div>
    <div class="wp-layout"><div class="wp-main" data-view="@(stepIndex == 4 ? "approval" : "journey")">
    <section class="wp-now wp-now-@tone" aria-live="polite">
        @if (reviewStage)
        {
            <div class="ew-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8v6a4 4 0 0 1-8 0zm0 1H4v3a4 4 0 0 0 4 4m8-7h4v3a4 4 0 0 1-4 4m-4 2v6m-5 2h10"/></svg><h3>@reviewTitle</h3></div>
            @if (award)
            {
                <div class="wf-award-card" data-award-result>
                    <strong>@BidSupplier(Model.Tender.AwardedBidId ?? 0)</strong>
                    @if (Model.Tender.AwardedAt is DateTime awardedAt) { <span>@awardedAt.ToJordan("d MMM yyyy HH:mm")</span> }
                    @if (notice?.TopApprovals > 0) { <span>@notice.TopApprovals @L("signed approvals", "موافقات موقّعة")</span> }
                    @if (notice?.TopApprovals > 0)
                    {
                        <ol class="wf-award-milestones" aria-label="@L("Completed award stages", "مراحل الترسية المكتملة")">
                            <li>@(lowestPrice ? L("Financial Review", "المراجعة المالية") : L("Committee Evaluation", "تقييم اللجنة"))</li>
                            <li>@L("Manager Review", "مراجعة المدير")</li>
                            <li>@L("Top Management Approval", "اعتماد الإدارة العليا")</li>
                            <li>@L("Awarded", "تمت الترسية")</li>
                        </ol>
                    }
                </div>
                @if (awardNotice != null || winnerNotified)
                {
                    <section class="wf-evidence-card"><h4>@L("Award Notifications", "إشعارات الترسية")</h4>
                        <ul class="wf-deliveries">
                            @if (winnerNotified) { <li><strong>@BidSupplier(Model.Tender.AwardedBidId ?? 0)</strong><span>@L("✓ Delivered in app", "✓ تم التسليم داخل النظام")</span></li> }
                            @if (awardNotice?.OfficerNotificationId > 0) { <li><strong>@L("Sourcing Officer", "مسؤول التوريد")</strong><span>@L("✓ Delivered in app", "✓ تم التسليم داخل النظام")</span></li> }
                            @if (awardNotice?.ManagerNotificationId > 0) { <li><strong>@L("Sourcing Manager", "مدير التوريد")</strong><span>@L("✓ Delivered in app", "✓ تم التسليم داخل النظام")</span></li> }
                        </ul>
                        <a class="wp-ghost wp-link" data-no-modal asp-area="" asp-controller="Notifications" asp-action="Index">@L("View Notifications", "عرض الإشعارات")</a>
                    </section>
                }
            }
            else
            {
                @if (!lowestPrice && s?.WeightRound is { } lockedWeights)
                {
                    <dl class="wf-locked-weights">
                        <div><dt>@L("Technical weight", "الوزن الفني")</dt><dd>@lockedWeights.ApprovedTechnical?.ToString("0.##")%</dd></div>
                        <div><dt>@L("Financial weight", "الوزن المالي")</dt><dd>@lockedWeights.ApprovedFinancial?.ToString("0.##")%</dd></div>
                    </dl>
                }
                @if (ranked.Count > 0)
                {
                    <div class="wp-table wf-result-table" data-evaluation-ranking>
                        <table><thead><tr><th scope="col">#</th><th scope="col">@L("Supplier", "المورد")</th>
                            @if (!lowestPrice) { <th scope="col">@L("Technical", "الفني")</th><th scope="col">@L("Financial", "المالي")</th> }
                            <th scope="col">@(lowestPrice ? L("Offer total", "إجمالي العرض") : L("Weighted score", "الدرجة المرجّحة"))</th>
                        </tr></thead><tbody>
                            @foreach (var row in ranked)
                            {
                                <tr class="@(row.BidId == recommended?.BidId ? "wf-recommended-row" : null)">
                                    <td>@row.Rank</td><th scope="row">@BidSupplier(row.BidId) @if (row.Tied) { <small>@L("Tie", "تعادل")</small> }</th>
                                    @if (!lowestPrice) { <td>@Mean(row.BidId, CriterionType.Technical)</td><td>@Mean(row.BidId, CriterionType.Financial)</td> }
                                    <td><b>@(lowestPrice ? CurrencyRules.Format(row.Score, Model.Tender.Currency) : row.Score.ToString("0.0"))</b></td>
                                </tr>
                            }
                        </tbody></table>
                    </div>
                }
                @if (recommended != null)
                {
                    var winnerOffer = Model.Bids.FirstOrDefault(bid => bid.Id == recommended.BidId);
                    <div class="wf-award-card" data-calculated-recommendation>
                        <strong>@L("Recommended winner", "الفائز الموصى به") · @BidSupplier(recommended.BidId)</strong>
                        @if (!lowestPrice) { <span>@L("Highest weighted score", "أعلى درجة مرجّحة") <b>@recommended.Score.ToString("0.0")</b></span> }
                        @if (winnerOffer != null) { <span>@L("Offer total", "إجمالي العرض") <b>@CurrencyRules.Format(Price(winnerOffer), winnerOffer.CurrencyCode)</b></span> }
                    </div>
                }
                else if (rv!.Report.RecommendedBidId == null)
                {
                    <p class="wp-hint wp-warn">@L("There is no unique recommended offer.", "لا يوجد عرض موصى به بشكل منفرد.")</p>
                }
                @if ((status == TenderStatus.TopCommitteeReview || status == TenderStatus.ManagerReview)
                    && reviewedAi.FirstOrDefault(analysis => analysis.Id == s?.AiAnalysisId) is { } comparison)
                {
                    <details class="wp-opt wf-evidence-card"><summary>@L("AI Supplier Comparison · Advisory", "مقارنة الموردين بالذكاء الاصطناعي · استرشادي")</summary>
                        @{ var findings = FindingRows(comparison.Findings); }
                        @if (findings.Count > 0)
                        {
                            <dl class="wp-rows">@foreach (var finding in findings) { <div><dt>@finding.Label</dt><dd style="white-space:pre-line">@finding.Value</dd></div> }</dl>
                        }
                        else { <p class="wp-text">@comparison.Findings</p> }
                        <p><a data-no-modal asp-action="AiAnalysisPdf" asp-route-id="@id">@L("View comparison evidence (PDF)", "عرض أدلة المقارنة (PDF)")</a></p>
                    </details>
                }
            }
        }
        else if (weightSetup)
        {
            <div class="ew-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="6" r="3"/><path d="M6 21v-3a6 6 0 0 1 12 0v3zM4 8a2 2 0 0 0 0 4m16-4a2 2 0 0 1 0 4M2 19v-2a4 4 0 0 1 2-3m18 5v-2a4 4 0 0 0-2-3"/></svg><h3>@weightHeading</h3></div>
            @if (w == null || (w.State == WeightState.Proposals && !canVoteWeights))
            {
                <div class="ew-overview">
                    @if (w == null)
                    {
                        <div class="ew-summary"><span class="ew-badge" dir="ltr">T-@id.ToString("0000")</span><h4>@Model.Tender.Title</h4>
                            <dl><div><dt>@L("Items", "البنود")</dt><dd>@Model.Tender.Items.Count</dd></div>
                                @if (Model.Tender.Items.Count > 0 && Model.Tender.Items.Select(item => item.Unit).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1)
                                { <div><dt>@L("Quantity", "الكمية")</dt><dd>@Model.Tender.Items.Sum(item => item.Quantity).ToString("0.###") @Model.Tender.Items.First().Unit</dd></div> }
                                @if (Model.Tender.PurchaseRequest?.NeededBy is DateTime needed)
                                { <div><dt>@L("Required by", "التسليم المطلوب")</dt><dd>@needed.ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo(ar ? "ar-JO" : "en"))</dd></div> }
                            </dl>
                        </div>
                    }
                    <div class="ew-roster">
                        @if (w != null)
                        {
                            <div class="ew-progress" aria-label="@L("Voting Progress", "تقدّم التصويت")">
                                @if (evalMembers.Count > 0) { <progress value="@votedMembers" max="@evalMembers.Count" aria-label="@L("Submitted proposals", "المقترحات المقدّمة")"></progress> }
                                <span class="ew-badge">@(ar ? $"صوّت {votedMembers} من {evalMembers.Count}" : $"{votedMembers} of {evalMembers.Count} voted")</span>
                                <button class="wp-ghost" type="button" data-refresh-weight-progress>@L("Refresh", "تحديث")</button>
                            </div>
                        }
                        else { <h4>@L("Assigned Committee", "اللجنة المعيّنة")</h4> }
                        <ul class="ew-members">
                            @foreach (var member in evalMembers)
                            {
                                var voted = w?.Proposals.Any(p => p.MemberUserId == member.UserId) == true;
                                <li><span class="ew-avatar" aria-hidden="true">@Initial(Who(member.UserId))</span>
                                    <span class="ew-member"><strong>@Who(member.UserId)</strong><span>@WeightRole(member.Responsibility)</span></span>
                                    @if (w != null) { <span class="ew-badge @(voted ? "ew-success" : "ew-pending")">@(voted ? L("✓ Voted", "✓ صوّت") : L("Pending", "بانتظار التصويت"))</span> }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else if (finW is decimal financialWeight && tecW is decimal technicalWeight)
            {
                <dl class="ew-results">
                    <div><dt>@L("Technical Evaluation", "التقييم الفني")</dt><dd dir="ltr">@technicalWeight.ToString("0.######")%</dd></div>
                    <div><dt>@L("Financial Evaluation", "التقييم المالي")</dt><dd dir="ltr">@financialWeight.ToString("0.######")%</dd></div>
                </dl>
                <p class="ew-result-status @(w.State == WeightState.Approved ? "ew-success" : "ew-pending")">
                    @(w.State == WeightState.Approved ? L("✓ Evaluation weights are approved and locked.", "✓ تم اعتماد أوزان التقييم وتثبيتها.")
                        : L("Awaiting weight approval.", "بانتظار اعتماد الأوزان."))
                </p>
            }
        }
        else
        {
        <div class="wp-now-top">
            <span class="wp-now-icon" aria-hidden="true">@(tone == "action" ? "!" : tone == "good" ? "✓" : tone == "wait" ? "⏳" : "•")</span>
            <div><small>@(tone == "action" ? "YOUR TURN" : tone == "good" ? "DONE" : "WAITING")</small><h3>@next.Title</h3><p>@next.Text</p></div>
        </div>
        }

        @* ============ ACTIONS: only what this person can do right now ============ *@
        @if (Model.IsOfficer && status == TenderStatus.Bidding && round?.Status == TenderRoundStatus.Open)
        {
            <div class="wp-actions">
                <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="CloseBidding" asp-route-id="@id" method="post" class="wp-form" data-close-bidding>
                    <h4>Close offer submissions</h4>
                    <p>@round.Invitations.Count invited · @round.Invitations.Count(i => i.Status == InvitationStatus.Accepted) accepted invitations · @submittedSupplierCount submitted offers · @Model.Bids.Count(b => b.Status == BidStatus.Draft) drafts · @round.Invitations.Count(i => i.Status == InvitationStatus.Declined) declined</p>
                    <button class="wp-primary" disabled="@(!canCloseBidding)">Close bidding &amp; continue <span aria-hidden="true">&rarr;</span></button>
                    @if (canCloseBidding)
                    {
                        <small>@(submittedSupplierCount >= 3 ? "At least three distinct suppliers submitted offers. You may close bidding now without waiting for other invitations." : round.Deadline <= Model.UtcNow ? "The deadline has passed. You can close bidding and continue to compliance review." : "Every invited supplier has submitted an offer or declined. You can close bidding now.")</small>
                    }
                    else
                    {
                        <p class="wp-hint" role="status">@submittedSupplierCount of 3 distinct supplier offers received. Waiting for @waitingInvitations.Count invited supplier(s) to submit an offer or decline. Drafts and accepted invitations do not count as submitted offers.</p>
                        <small>@(round.Deadline.HasValue ? $"You may also close bidding after the deadline: {round.Deadline.Value.ToLocalTime():d MMM yyyy HH:mm}." : "No deadline is configured. Every invited supplier must submit an offer or decline before bidding can close.")</small>
                    }
                    <h5>All invited suppliers</h5>
                    <ul>
                        @foreach (var row in supplierBidRows)
                        {
                            var invitation = row.Invitation;
                            var progress = row.Bid != null ? "Submitted offer"
                                : invitation.Status == InvitationStatus.Declined ? "Declined invitation"
                                : Model.Bids.Any(b => b.TenderInvitationId == invitation.Id && b.Status == BidStatus.Draft) ? "Draft offer"
                                : invitation.Status == InvitationStatus.Accepted ? "Accepted invitation — no offer yet"
                                : "Invitation pending";
                            <li>@SupplierName(invitation.SupplierId) — @progress</li>
                        }
                    </ul>
                </form>
            </div>
        }
        @if (Model.IsOfficer && status == TenderStatus.Draft && w == null)
        {
            <div class="wp-actions">
                <details class="wp-opt"><summary>@L("Attach a supporting document (optional)", "إرفاق مستند داعم (اختياري)")</summary>
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Upload" asp-route-id="@id" method="post" enctype="multipart/form-data" class="wp-form wp-inline"><input type="file" name="file" aria-label="@L("Supporting document", "مستند داعم")" accept=".pdf,.docx,.txt,.csv,.png,.jpg,.jpeg" required /><button>@L("Upload", "رفع")</button></form></details>
                <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="RequestWeights" asp-route-id="@id" method="post" class="wp-form ew-action"><small>@L("Sending freezes the current requirements and documents.", "الإرسال يثبّت المتطلبات والمستندات الحالية.")</small><button class="wp-primary">@L("Send to Committee", "إرسال إلى اللجنة")</button></form>
            </div>
        }
        @if (canVoteWeights)
        {
            var priorFinancial = revision?.CommitteeMemberIds.Contains(mySeat?.Id ?? 0) == true && revision.PriorFinancial.TryGetValue(mySeat!.Id, out var prior) ? decimal.Round(prior, 0, MidpointRounding.AwayFromZero) : 50m;
            <div class="wp-actions">
                <form asp-area="EvaluationCommittee" asp-controller="Workflow" asp-action="Propose" asp-route-id="@id" method="post" class="wp-form ew-sliders" data-weight-sliders>
                    @if (revision?.CommitteeMemberIds.Contains(mySeat?.Id ?? 0) == true) { <p class="wp-hint wp-warn"><strong>@L("Officer’s revision note", "ملاحظة مسؤول التوريد")</strong> · @revision.Note</p> }
                    @foreach (var slider in new[] { (Key: "technical", Label: L("Technical Evaluation", "التقييم الفني"), Value: 100m - priorFinancial), (Key: "financial", Label: L("Financial Evaluation", "التقييم المالي"), Value: priorFinancial) })
                    {
                        var value = slider.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
                        <label class="ew-slider"><span>@slider.Label</span><input id="ew-@slider.Key" name="@slider.Key" type="range" min="0" max="100" step="1" value="@value" style="--ew-fill:@(value)%" aria-valuetext="@(value)%" /><output for="ew-@slider.Key" dir="ltr">@(value)%</output></label>
                    }
                    <div class="ew-action"><small>@L("Total 100%", "المجموع ١٠٠٪")</small><button type="button" class="wp-ghost" data-cancel-weight-vote>@L("Cancel", "إلغاء")</button><button class="wp-primary">@(revision?.CommitteeMemberIds.Contains(mySeat?.Id ?? 0) == true ? L("Submit Revised Vote", "إرسال التصويت المعدّل") : L("Submit Vote", "إرسال التصويت"))</button></div>
                </form>
            </div>
        }
        @if (Model.CanApproveWeights && w != null && w.State == WeightState.AwaitingApproval)
        {
            <div class="wp-actions"><partial name="_ApproveTechnicalWeights" model='(w!, Model.Tender.Items.AsEnumerable())' />
                <details class="wp-opt"><summary>@L("Return selected proposals for revision", "إعادة مقترحات محددة للمراجعة")</summary>
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="ReturnWeights" asp-route-id="@id" method="post" class="wp-form">
                        @foreach (var member in evalMembers) { <label class="wp-check"><input type="checkbox" name="memberIds" value="@member.Id" /><span>@Who(member.UserId) · @WeightRole(member.Responsibility)</span></label> }
                        <label>@L("Reason and what to revise", "السبب والمطلوب مراجعته")<textarea name="note" minlength="10" maxlength="2000" rows="3" required></textarea></label>
                        <button class="wp-ghost">@L("Return selected proposals", "إعادة المقترحات المحددة")</button>
                    </form>
                </details>
            </div>
        }
        @if (Model.IsOfficer && status == TenderStatus.Draft && w?.State == WeightState.Approved)
        {
            <div class="wp-actions"><form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="OpenBidding" asp-route-id="@id" method="post" class="wp-form wp-inline"><label>@L("Quick pick", "اختيار سريع")<select class="wp-preset" data-preset="deadline"><option value="">@L("Choose…", "اختر…")</option><option value="3">@L("In 3 days", "خلال ٣ أيام")</option><option value="7">@L("In 1 week", "خلال أسبوع")</option><option value="14">@L("In 2 weeks", "خلال أسبوعين")</option><option value="30">@L("In 1 month", "خلال شهر")</option></select></label><label>@L("Bidding deadline", "الموعد النهائي لتقديم العروض")<input type="datetime-local" data-utc name="deadline" required data-fv-future data-fv-label="Bidding deadline" data-fv-label-ar="الموعد النهائي لتقديم العروض" /></label><button class="wp-primary">@L("Open bidding", "فتح باب تقديم العروض")</button></form></div>
        }
        @if (Model.IsOfficer && status == TenderStatus.Bidding && round?.Status == TenderRoundStatus.Open && w?.State == WeightState.Approved)
        {
            <div class="wp-actions">
                @if (approvedSuppliers is { Count: > 0 })
                {
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="InviteAll" asp-route-id="@id" method="post" class="wp-form wp-picker" data-picker>
                        <div class="wp-cols">
                            <label>Search suppliers<input type="search" data-supplier-search placeholder="Company name" /></label>
                            <label>Category<select data-supplier-category><option value="">All categories (@approvedSuppliers.Count)</option>@foreach (var category in SupplierCategories.All) { <option value="@category">@category (@approvedSuppliers.Count(x => x.Category == category))@(tenderCategories.Contains(category) ? " · in this tender" : "")</option> }</select></label>
                            <label>Documents<select data-supplier-docs><option value="">Any</option><option value="verified">Verified, not expired</option><option value="clean">No expired or pending documents</option></select></label>
                            <label>History<select data-supplier-history><option value="">Any</option><option value="offers">Has submitted offers before</option><option value="awards">Has won a tender before</option><option value="new">No earlier offers</option></select></label>
                        </div>
                        <p class="wp-hint">Only approved suppliers with an active, verified account are listed.@(tenderCategories.Count > 0 ? " Tender item categories: " + string.Join(", ", tenderCategories) + "." : "") <button type="button" class="wp-ghost" data-supplier-reset>Clear filters</button></p>
                        @if (inviteable is { Count: 0 }) { <p class="wp-empty">All eligible suppliers have already been invited to this round.</p> }
                        <div class="wp-pick-head"><label class="wp-check"><input type="checkbox" data-select-all @(inviteable is { Count: > 0 } ? null : "disabled") /> Select all</label><span class="wp-pick-count" data-count>0 selected</span></div>
                        <ul class="wp-pick" data-fv-group-required data-fv-label="suppliers" data-fv-msg="Please select at least one supplier to invite." data-fv-msg-ar="يرجى اختيار مورد واحد على الأقل لدعوته.">@foreach (var sp in approvedSuppliers) { var done = invitedIds.Contains(sp.Id); <li class="@(done ? "is-invited" : null)" data-supplier-name="@sp.CompanyName.ToLowerInvariant()" data-supplier-category="@sp.Category" data-verified="@sp.Verified" data-issues="@(sp.Expired + sp.Pending)" data-offers="@sp.Offers" data-awards="@sp.Awards"><label class="wp-check"><input type="checkbox" name="supplierIds" value="@sp.Id" @(done ? "checked disabled" : null) /><span>@sp.CompanyName <small>@sp.Category · @sp.Verified verified doc(s)@(sp.Expired > 0 ? $" · {sp.Expired} expired" : "")@(sp.Pending > 0 ? $" · {sp.Pending} pending review" : "") · @sp.Offers earlier offer(s) · @sp.Awards award(s)</small></span>@if (done) { <em>Invited</em> }</label></li> }</ul>
                        <p class="wp-empty" role="status" data-supplier-empty hidden>No eligible suppliers match these filters. Clear the filters to see all eligible suppliers.</p>
                        <button class="wp-primary" data-pick-btn disabled data-confirm="Send tender invitations to the selected suppliers? Each one is notified and can accept or decline.">Invite selected</button>
                        <small>Each invited supplier gets a notification, accepts, and sends an offer from their own portal.</small>
                    </form>
                }
                else
                {
                    <p class="wp-empty">No eligible suppliers are available. Suppliers can be selected once their company is approved and they have an active account with a verified email address.</p>
                }
                <details class="wp-opt"><summary>Invite a company that is not registered</summary>
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="InviteExternal" asp-route-id="@id" method="post" class="wp-form"><div class="wp-cols"><label>Company<input name="companyName" maxlength="200" required data-fv-label="Company name" /></label><label>Email<input name="email" type="email" maxlength="256" required /></label><label>Phone (optional)<input name="phone" type="tel" maxlength="40" /></label></div><button>Send invitation</button><small>They receive a registration invitation first; an offer still needs an approved registration.</small></form></details>
            </div>
        }
        @if (Model.IsSupplier)
        {
            var mine = Model.Tender.Rounds.SelectMany(x => x.Invitations).Where(x => x.TenderRoundId == round?.Id).ToList();
            <div class="wp-actions">
                @foreach (var invitation in mine)
                {
                    if (invitation.Status == InvitationStatus.Pending && round?.Status == TenderRoundStatus.Open && round.Deadline > Model.UtcNow)
                    {
                        <form asp-area="Supplier" asp-controller="Workflow" asp-action="Respond" asp-route-id="@id" method="post" class="wp-form wp-inline"><input type="hidden" name="invitationId" value="@invitation.Id" /><button name="accept" value="true" class="wp-primary">Accept the invitation</button><button name="accept" value="false" class="wp-ghost">Decline</button></form>
                    }
                    else if (invitation.Status == InvitationStatus.Accepted && Model.Bids.All(x => x.TenderInvitationId != invitation.Id) && status == TenderStatus.Bidding
                        && w?.State == WeightState.Approved && round?.Status == TenderRoundStatus.Open && round.Deadline > Model.UtcNow
                        && (!round.OpensAt.HasValue || round.OpensAt <= Model.UtcNow))
                    {
                        <a class="wp-primary wp-link" data-no-modal asp-area="Supplier" asp-controller="Offers" asp-action="Create" asp-route-id="@invitation.Id">Prepare my offer <span aria-hidden="true">&rarr;</span></a>
                    }
                }
                @foreach (var bid in Model.Bids) { <a class="wp-ghost wp-link" data-no-modal asp-area="Supplier" asp-controller="Offers" asp-action="Details" asp-route-id="@bid.Id">My offer: @Words(bid.Status.ToString()) &middot; open</a> }
            </div>
        }
        @if (Model.IsOfficer && closedRound && lowestPrice)
        {
            <partial name="_FinancialOfferReview" model="Model" />
        }
        else if (Model.IsOfficer && closedRound)
        {
            var cur = !proceeded ? 1 : reviewedAi.Count == 0 ? 2 : 3;
            <div class="wp-wizard" data-wizard data-current="@cur">
                <ol class="wp-wsteps" aria-label="Preparation steps">
                    <li class="@(cur > 1 ? "is-done" : "is-now")"><button type="button" data-goto="1"><b>@(cur > 1 ? "✓" : "1")</b><span>Continue</span></button></li>
                    <li class="@(cur > 2 ? "is-done" : cur == 2 ? "is-now" : "")"><button type="button" data-goto="2" @(cur < 2 ? "disabled" : null)><b>@(cur > 2 ? "✓" : "2")</b><span>AI analysis</span></button></li>
                    <li class="@(cur == 3 ? "is-now" : "")"><button type="button" data-goto="3" @(cur < 3 ? "disabled" : null)><b>3</b><span>Schedule</span></button></li>
                </ol>
                <section class="wp-wpanel" data-step="1" @(cur == 1 ? null : "hidden")>
                    <h4>Continue with this round</h4>
                                        <small>@Model.DistinctOffers supplier(s) sent offers. The normal minimum is @Model.MinimumOffers.</small>
                    @if (proceeded) { <p class="wp-hint">Recorded: you are continuing with this round.</p> }
                    else if (enoughOffers || approvedException != null) { <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Proceed" asp-route-id="@id" method="post" class="wp-form"><button class="wp-primary">Next <span aria-hidden="true">&rarr;</span></button></form> }
                    else if (pendingRequest != null) { <p class="wp-hint">Waiting for the Sourcing Manager to approve continuing with fewer suppliers.</p> }
                    else if (Model.DistinctOffers >= 1) { <details class="wp-opt" open><summary>Fewer offers than the minimum</summary><form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="RequestProceed" asp-route-id="@id" method="post" class="wp-form"><label>Why continue with @Model.DistinctOffers supplier(s)?<select class="wp-quick" aria-label="Quick text"><option value="">Quick pick&hellip;</option><option>The market has only a few qualified suppliers.</option><option>The offers received meet all requirements.</option><option>Re-tendering would delay a critical purchase.</option></select><textarea name="justification" maxlength="2000" required rows="2" data-fv-label="Justification"></textarea></label><button>Ask the Manager to approve</button></form></details> }
                    else { <p class="wp-hint">No offers were received, so re-tender is the only option.</p> }
                    @if (round!.RoundNumber < Model.MaxRounds)
                    {
                        <details class="wp-opt"><summary>Or re-tender (new round)</summary><form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Retender" asp-route-id="@id" method="post" class="wp-form"><label>Reason<select class="wp-quick" aria-label="Quick text"><option value="">Quick pick&hellip;</option><option>Not enough compliant offers were received.</option><option>The offers do not meet the requirements.</option><option>The requirements were updated.</option><option>The prices are far above the estimate.</option></select><textarea name="reason" maxlength="2000" required rows="2" data-fv-label="Re-tender reason" data-fv-label-ar="سبب إعادة الطرح"></textarea></label><label class="wp-check"><input type="checkbox" required /> These offers will not be evaluated.</label><button class="wp-ghost">Create round @(round.RoundNumber + 1)</button></form></details>
                    }
                    else { <p class="wp-hint">This was the last permitted round.</p> }
                </section>
                <section class="wp-wpanel" data-step="2" @(cur == 2 ? null : "hidden")>
                    <h4>AI analysis</h4>
                                        <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Analyze" asp-route-id="@id" method="post" class="wp-form wp-inline"><button class="wp-ghost">Run the AI analysis</button><small>Advisory only. It never changes scores or decisions.</small></form>
                    @foreach (var ai in Model.Analyses)
                    {
                        <details class="wp-opt" @(ai.ReviewedAt == null ? "open" : null)><summary>Analysis #@ai.Id &middot; @ai.Status @(ai.ReviewedAt != null ? "· reviewed" : "")</summary>@{ var fr = FindingRows(ai.Findings); }@if (fr.Count > 0) { <dl class="wp-ai">@foreach (var row in fr) { <div><dt>@row.Label</dt><dd>@row.Value</dd></div> }</dl> } else { <div class="wp-text">@ai.Findings</div> }
                            @if (ai.Status == "Completed" && ai.ReviewedAt == null) { <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="ReviewAi" asp-route-id="@id" method="post" class="wp-form"><input name="analysisId" type="hidden" value="@ai.Id" /><button class="wp-primary">I reviewed it, next &rarr;</button></form> }</details>
                    }
                </section>
                <section class="wp-wpanel" data-step="3" @(cur == 3 ? null : "hidden")>
                    <h4>@L("Evaluation Meeting", "اجتماع التقييم")</h4>
                                        @if (reviewedAi.Count == 0) { <p class="wp-hint">Run and review the AI analysis first.</p> }
                    else
                    {
                        <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Setup" asp-route-id="@id" method="post" class="wp-form">
                            <div class="wp-cols"><label class="wp-schedule-ai">@L("Reviewed AI supplier comparison", "مقارنة الموردين المراجعة")<select name="AiAnalysisId" required>@foreach (var ai in reviewedAi) { <option value="@ai.Id">@L("Analysis", "التحليل") #@ai.Id</option> }</select></label></div><div class="wp-cols"><label>@L("Starts", "البدء")<input name="StartsAt" type="datetime-local" data-utc="local" required data-fv-future data-fv-label="Start time" data-fv-label-ar="وقت البدء" /></label><label>@L("Ends", "الانتهاء")<input name="EndsAt" type="datetime-local" data-utc="local" required data-fv-after="StartsAt" data-fv-label="End time" data-fv-label-ar="وقت الانتهاء" /></label></div>
                            <label class="wp-check"><input name="CreateJitsiMeeting" type="checkbox" value="true" checked /> @L("Create the video meeting automatically", "إنشاء اجتماع الفيديو تلقائيًا")</label>
                            <details class="wp-opt"><summary>@L("Use an existing Zoom link", "استخدام رابط Zoom موجود")</summary><label>@L("Zoom link", "رابط Zoom")<input name="MeetingUrl" type="url" placeholder="https://zoom.us/j/..." data-fv-optional /></label></details>
                            <button class="wp-primary">@L("Schedule and Invite Committee", "جدولة الاجتماع ودعوة اللجنة")</button></form>
                    }
                </section>
                <div class="wp-wnav"><button type="button" class="wp-ghost" data-wback>&larr; Back</button><span class="wp-wnote" data-wnote></span><button type="button" class="wp-primary" data-wnext>Next <span aria-hidden="true">&rarr;</span></button></div>
            </div>
        }
        @if (Model.IsManager && !lowestPrice && pendingRequest != null && closedRound)
        {
            <div class="wp-actions"><form asp-area="SourcingManager" asp-controller="Workflow" asp-action="DecideProceed" asp-route-id="@id" method="post" class="wp-form"><input type="hidden" name="decisionId" value="@pendingRequest.Id" /><p class="wp-text">@pendingRequest.Justification</p><label>Your comment<select class="wp-quick" aria-label="Quick text"><option value="">Quick pick&hellip;</option><option>Approved: the offers received are sufficient.</option><option>Approved: the purchase is time critical.</option><option>Rejected: please re-tender.</option></select><textarea name="comment" maxlength="2000" required rows="2" data-fv-label="Decision comment" data-fv-label-ar="تعليق القرار"></textarea></label><button name="approve" value="true" class="wp-primary">Approve</button><button name="approve" value="false" class="wp-ghost">Reject</button></form></div>
        }
        @if (Model.IsEvaluator && !submitted && s != null && TenderWorkflowService.EvaluationOpen(s, Model.UtcNow))
        {
            var scoreIndex = 0;
            <div class="wp-actions">
                <form asp-area="EvaluationCommittee" asp-controller="Workflow" asp-action="SubmitEvaluation" asp-route-id="@id" method="post" class="wp-form wp-scores" data-evaluator-scores
                      data-financial-weight="@s.WeightRound.ApprovedFinancial?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      data-technical-weight="@s.WeightRound.ApprovedTechnical?.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @foreach (var eligible in s.EligibleBids)
                    {
                        var bid = Model.Bids.FirstOrDefault(b => b.Id == eligible.BidId);
                        <fieldset data-score-row data-bid="@eligible.BidId">
                            <legend>@if (bid != null) { <partial name="_EvaluationOfferTrigger" model="bid" /> } else { @BidSupplier(eligible.BidId) }</legend>
                            <input type="hidden" name="scores[@scoreIndex].BidId" value="@eligible.BidId" />
                            <div class="evaluation-score-line">
                                <label for="financial-score-@scoreIndex">@L("Financial score", "الدرجة المالية") <small>/ 100</small></label>
                                <input id="financial-score-@scoreIndex" name="scores[@scoreIndex].Financial" data-score="financial" type="text" inputmode="numeric" maxlength="2" pattern="[0-9]{1,2}" data-score-digits required data-fv-label="Financial score" data-fv-label-ar="الدرجة المالية" />
                            </div>
                            <partial name="_TechnicalScoreInputs" model='(s!.WeightRound.ReadTechnicalCriteria(), scoreIndex, "technical")' />
                            <label>@L("Score justification (optional)", "مبرر الدرجات (اختياري)")<select class="wp-quick" aria-label="@L("Quick text", "نص سريع")"><option value="">@L("Use a suggested justification", "استخدم مبررًا مقترحًا")</option><option>Meets all specifications at a competitive price.</option><option>Strong technical offer, price above average.</option><option>Good price but some specifications are weak.</option><option>Does not meet the key requirements.</option></select><textarea name="scores[@scoreIndex].Justification" maxlength="2000" rows="2" data-fv-label="Score justification" data-fv-label-ar="مبرر الدرجات"></textarea></label>
                            <span class="wf-weighted-preview">@L("Weighted score preview", "معاينة الدرجة المرجّحة") <output data-weighted-preview>—</output></span>
                        </fieldset>
                        scoreIndex++;
                    }
                    <h5 class="wp-sub">@L("Required signature", "التوقيع المطلوب")</h5>
                    <div class="wp-pad" data-pad><canvas width="640" height="200" aria-label="@L("Draw your signature", "ارسم توقيعك")"></canvas><div class="wp-pad-bar"><span>@L("Sign here", "وقّع هنا")</span><button type="button" class="wp-ghost" data-pad-clear>@L("Clear", "مسح")</button></div></div>
                    <button class="wp-primary">@L("Sign and submit my final evaluation", "توقيع تقييمي النهائي وإرساله")</button>
                </form>
                <a class="wp-ghost wp-link" data-no-modal asp-area="EvaluationCommittee" asp-controller="Workflow" asp-action="Meeting" asp-route-id="@id">Open the detailed evaluation workspace</a>
            </div>
        }
        else if (Model.IsEvaluator && s != null && (s.State is SessionState.Scheduled or SessionState.Incomplete or SessionState.ReportDraft))
        {
            <div class="wp-actions">
                <a class="wp-primary wp-link" data-no-modal asp-area="EvaluationCommittee" asp-controller="Workflow" asp-action="Meeting" asp-route-id="@id">Open the evaluation workspace <span aria-hidden="true">&rarr;</span></a>
                <small>@(submitted ? "Your evaluation is submitted. The workspace shows the results, the report and the signatures." : "Review the offers, criteria, documents and AI analysis. Scoring opens at the meeting start.")</small>
            </div>
        }
        @if (Model.IsOfficer && s != null && s.State == SessionState.Scheduled)
        {
            var allIn = s.Submissions.Count == 4;
            <div class="wp-actions">
                <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="EndEvaluation" asp-route-id="@id" method="post" class="wp-form"><input type="hidden" name="reason" value="All four committee evaluations were submitted." />
                    <label class="wp-check"><input name="confirmed" type="checkbox" value="true" required @(allIn ? null : "disabled") /> I confirm that all four evaluations are final.</label>
                    <button class="wp-ghost" @(allIn ? null : "disabled")>Generate the report now</button>
                    <small>@(allIn ? "Normally the report is generated automatically when the fourth member submits." : $"The report is generated automatically when all four members have submitted ({s.Submissions.Count} of 4 so far).")</small>
                </form>
                @if (s.EligibleBids.Count < Model.MinimumOffers && round != null && round.RoundNumber < Model.MaxRounds)
                {
                    <details class="wp-opt"><summary>Only @s.EligibleBids.Count compliant offer(s), fewer than the @Model.MinimumOffers required: re-do with new offers</summary>
                        <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Retender" asp-route-id="@id" method="post" class="wp-form"><label>Reason<select class="wp-quick" aria-label="Quick text"><option value="">Quick pick&hellip;</option><option>Not enough compliant offers were received.</option><option>The offers do not meet the requirements.</option></select><textarea name="reason" maxlength="2000" required rows="2" data-fv-label="Re-tender reason" data-fv-label-ar="سبب إعادة الطرح"></textarea></label><label class="wp-check"><input type="checkbox" required /> The scheduled evaluation is cancelled and a new bidding round opens (round @(round.RoundNumber + 1) of @Model.MaxRounds).</label><button class="wp-ghost">Re-tender: new round</button></form></details>
                }
            </div>
        }
        @if (rv != null)
        {
            var mySigned = rv.Signatures.Any(x => x.UserId == rv.UserId && x.Stage == (rv.CanVoteTop ? ReportSigningStage.Top : ReportSigningStage.Evaluation));
            var pdfUrl = Url.Action("Pdf", area == "TopCommittee" ? "SignedReports" : "Reports", new { area, id = rv.Report.Id });
            // Signing needs a recorded view of this exact PDF version (ReportDocumentService.Sign). If this person has not opened it yet,
            // the popup opens the preview itself and keeps the signing buttons locked until the PDF has loaded.
            var mustSign = (rv.CanSignCommittee && !mySigned) || rv.CanReviewManager || (rv.CanVoteTop && !mySigned);
            var reportIdText = rv.Report.Id.ToString();
            var viewedReport = !mustSign || string.IsNullOrEmpty(rv.Report.PdfSha256) || await Records.AuditLogs.AsNoTracking().AnyAsync(x => x.EntityName == "TenderReport" && x.EntityId == reportIdText
                && x.UserId == rv.UserId && x.Action == "ProtectedReportViewed" && x.NewValues != null && x.NewValues.Contains(rv.Report.PdfSha256));
            <div class="wp-actions wp-report" data-needs-view="@(viewedReport ? null : "1")">
                @if (!viewedReport) { <p class="wp-hint" data-view-note>Read the report below first. Signing unlocks as soon as the PDF has opened.</p> }
                <div class="wp-reportbar"><button type="button" class="wp-ghost" data-preview="@pdfUrl">@L("View Committee Report", "عرض تقرير اللجنة")</button><a class="wp-ghost wp-link" data-no-modal download href="@Url.Action("Pdf", area == "TopCommittee" ? "SignedReports" : "Reports", new { area, id = rv.Report.Id, download = true })">@L("Download PDF", "تنزيل PDF")</a></div>
                <div class="wp-preview" hidden></div>
                @if (s?.State == SessionState.ReportDraft)
                {
                    var signedNow = rv.Signatures.Where(x => x.Stage == ReportSigningStage.Evaluation).ToList();
                    <div class="wp-sigtable">
                        <div class="wp-sigtable-head"><strong>Who signed</strong><span class="wp-sum">@signedNow.Count of 4 signed</span></div>
                        <div class="wp-table"><table><thead><tr><th>Member</th><th>Role</th><th>Status</th><th>When</th></tr></thead><tbody>
                        @foreach (var m in evalMembers) { var sg = signedNow.FirstOrDefault(x => x.UserId == m.UserId); <tr class="@(sg != null ? "is-best" : null)"><td><strong>@Who(m.UserId)</strong></td><td>@Role(m.Responsibility)</td><td><span class="wp-tag @(sg != null ? "wp-tag-good" : "")">@(sg != null ? "Signed" : "Waiting")</span></td><td>@(sg != null ? sg.SignedAt.ToJordan("d MMM HH:mm") : "—")</td></tr> }
                        </tbody></table></div>
                    </div>
                }
                @if (rv.CanSignCommittee && !mySigned)
                {
                    <form asp-area="EvaluationCommittee" asp-controller="Reports" asp-action="Sign" asp-route-id="@rv.Report.Id" method="post" class="wp-form wp-sign"><input type="hidden" name="documentHash" value="@rv.Report.PdfSha256" />
                        <label>Your observations (optional)<textarea name="comment" maxlength="2000" rows="2"></textarea></label>
                        <div class="wp-pad" data-pad><canvas width="640" height="200" aria-label="Signature pad: draw your signature"></canvas><div class="wp-pad-bar"><span>&#9998; Sign here with your mouse or finger</span><button type="button" class="wp-ghost" data-pad-clear>Clear</button></div></div>
                        <label class="wp-check"><input type="checkbox" name="confirmed" value="true" required /> I reviewed this report and sign my section.</label>
                        <button class="wp-primary">Sign the report</button></form>
                }
                @if (rv.CanSignCommittee && mySigned) { <p class="wp-hint">You signed this report. Waiting for the other members.</p> }
                @if (rv.CanReviewManager)
                {
                    if (Model.FinalPolicyConfigured && topMembers.Count == 0 && !await Flow.TopRosterReady())
                    {
                        <p class="wp-hint wp-warn" role="alert">The Top Committee is not set up yet, so approving will be refused. Ask the Admin to save the four Chiefs (CEO, CFO, CTO, COO) in Admin &rarr; Committees &rarr; Top Committee, then approve. Rejecting still works.</p>
                    }
                    <a class="wp-primary wp-link" data-no-modal asp-area="SourcingManager" asp-controller="Workflow" asp-action="ExecutiveSummary" asp-route-id="@id">@L("Review and Send to Top Management", "مراجعة وإرسال إلى الإدارة العليا")</a>
                    <details class="wp-opt"><summary>Reject the report</summary>
                    <form asp-area="SourcingManager" asp-controller="Reports" asp-action="Decision" asp-route-id="@rv.Report.Id" method="post" class="wp-form"><input type="hidden" name="documentHash" value="@rv.Report.PdfSha256" /><input type="hidden" name="decision" value="Reject" />
                        <label>Reason for rejecting (required)<textarea name="comment" maxlength="2000" minlength="10" rows="2" required data-fv-label="Reason"></textarea></label>
                        <label class="wp-check"><input type="checkbox" name="confirmed" value="true" required /> I reviewed the report and reject it. The tender stops here.</label>
                        <button class="wp-ghost" data-confirm="Reject this evaluation report? The tender is stopped and the Officer is notified.">Reject the report</button></form></details>
                }
                @if (Model.IsTop || Model.IsManager || Model.IsOfficer)
                {
                    var summary = await Flow.SubmittedSummary(id);
                    if (summary != null)
                    {
                        <details class="wp-opt" @(rv.CanVoteTop && !mySigned ? "open" : null)><summary>Sourcing Manager's executive summary</summary>
                            <dl class="wp-rows">
                                <div><dt>Business need</dt><dd style="white-space:pre-line">@summary.BusinessNeed</dd></div>
                                <div><dt>Key findings</dt><dd style="white-space:pre-line">@summary.KeyFindings</dd></div>
                                <div><dt>Reasons for the recommendation</dt><dd style="white-space:pre-line">@summary.RecommendationReasons</dd></div>
                                @if (!string.IsNullOrWhiteSpace(summary.Risks)) { <div><dt>Risks and observations</dt><dd style="white-space:pre-line">@summary.Risks</dd></div> }
                                <div><dt>Manager's assessment</dt><dd style="white-space:pre-line">@summary.ManagerAssessment</dd></div>
                            </dl></details>
                    }
                }
                @if (rv.CanVoteTop && !mySigned)
                {
                    <form asp-area="TopCommittee" asp-controller="SignedReports" asp-action="Vote" asp-route-id="@rv.Report.Id" method="post" class="wp-form wp-sign wf-award-decision"><input type="hidden" name="documentHash" value="@rv.Report.PdfSha256" />
                        <fieldset class="wp-decide"><legend>@L("Award Decision", "قرار الترسية")</legend>
                            <label class="wp-check"><input type="radio" name="decision" value="Approve" required /> <span><b>@L("Accept & Award", "قبول وترسية")</b></span></label>
                            <label class="wp-check"><input type="radio" name="decision" value="Reject" /> <span><b>@L("Reject", "رفض")</b><small>@L("Tender no longer needed.", "لم تعد المناقصة مطلوبة.")</small></span></label>
                            <label class="wp-check"><input type="radio" name="decision" value="Retender" @(round != null && round.RoundNumber >= Model.MaxRounds ? "disabled" : null) /> <span><b>@L("Re-tender", "إعادة الطرح")</b><small>@(round != null && round.RoundNumber >= Model.MaxRounds ? L("Final permitted round", "آخر جولة مسموحة") : L("No acceptable offer.", "لا يوجد عرض مقبول."))</small></span></label>
                        </fieldset>
                        <label data-reason-box hidden>@L("Decision reason (required)", "سبب القرار (مطلوب)")<textarea name="comment" maxlength="2000" minlength="10" rows="2" data-reason-input disabled></textarea></label>
                        <div class="wp-pad" data-pad><canvas width="640" height="200" aria-label="@L("Draw your signature", "ارسم توقيعك")"></canvas><div class="wp-pad-bar"><span>@L("Signature required", "التوقيع مطلوب")</span><button type="button" class="wp-ghost" data-pad-clear>@L("Clear", "مسح")</button></div></div>
                        <label class="wp-check"><input type="checkbox" name="confirmed" value="true" required /> @L("I reviewed the report and sign this decision.", "راجعت التقرير وأوقّع على هذا القرار.")</label>
                        <button class="wp-primary">@L("Confirm Decision", "تأكيد القرار")</button></form>
                }
                @if (Model.IsTop) { <p class="wp-hint"><a data-no-modal asp-area="TopCommittee" asp-controller="Rejections" asp-action="Details" asp-route-id="@rv.Report.Id">Top Committee decision and rejection reason agreement</a></p> }
                @if (rv.CanReturn && (rv.CanReviewManager || rv.CanVoteTop))
                {
                    <details class="wp-opt"><summary>Return the report for revision</summary>
                        <form asp-area="@area" asp-controller="@(area == "TopCommittee" ? "SignedReports" : "Reports")" asp-action="Return" asp-route-id="@rv.Report.Id" method="post" class="wp-form"><input name="RequestId" type="hidden" value="@Guid.NewGuid()" /><input name="DocumentHash" type="hidden" value="@rv.Report.PdfSha256" />
                            <div class="wp-cols"><label>Send it back to<select name="Target" required><option value="SourcingOfficer">Assigned Sourcing Officer</option><option value="ReportAuthor">Original report author</option></select></label><label>What needs correcting<select name="Correction" required><option value="NarrativeOnly">Narrative clarification only</option><option value="Weights">Approved evaluation weights - policy blocked</option><option value="SupplierBid">Deadline-locked supplier bid - policy blocked</option><option value="FinalScores">Finalized committee scores - policy blocked</option></select></label></div>
                            <label>Feedback<textarea name="Feedback" maxlength="4000" required rows="2" data-fv-label="Feedback"></textarea></label>
                            <label>Required corrective action<textarea name="RequiredAction" maxlength="4000" required rows="2" data-fv-label="Corrective action" data-fv-label-ar="الإجراء التصحيحي"></textarea></label>
                            <button class="wp-ghost">Return for revision</button><small>Only a narrative correction can proceed; weights, bids and final scores stay locked.</small></form></details>
                }
                @if (rv.CanReviewManager || rv.CanVoteTop)
                {
                    <p class="wp-hint"><a data-no-modal asp-area="@area" asp-controller="@(area == "TopCommittee" ? "SignedReports" : "Reports")" asp-action="Review" asp-route-id="@rv.Report.Id">Open the full report page (signatures, receipts and version history)</a></p>
                }
                @if (rv.CanForward)
                {
                    <form asp-area="SourcingOfficer" asp-controller="Reports" asp-action="Forward" asp-route-id="@rv.Report.Id" method="post" class="wp-form wf-review-action"><button class="wp-primary" data-confirm="@L("Send the signed report to the Sourcing Manager?", "هل تريد إرسال التقرير الموقّع إلى مدير التوريد؟")">@L("Send to Manager", "إرسال إلى المدير")</button></form>
                }
            </div>
        }
        @if (false && Model.IsOfficer && s != null && s.State == SessionState.ManagerApproved && Model.FinalPolicyConfigured)
        {
            <div class="wp-actions"><form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Award" asp-route-id="@id" method="post" class="wp-form"><button class="wp-primary">Record the official award</button><small>The server checks every required approval first.</small></form></div>
        }
        @if (Model.IsTop && !Model.FinalPolicyConfigured && s != null) { <p class="wp-hint wp-warn">The final approval policy is not configured yet, so award is blocked.</p> }
    </section>

    @* ============ JOURNEY: the whole tender on one timeline ============ *@
    <div class="wp-timeline">
        @if (stepIndex >= 2 && !Model.IsSupplier) { @Html.Raw("<details class=\"wp-prev\"><summary>Earlier stages: " + (lowestPrice ? "tender and offers" : stepIndex >= 3 ? "tender, weights, offers and committee evaluation" : "tender, weights and offers") + "</summary><div class=\"wp-prev-body\">") }
        <article class="wp-stage wp-done" data-ph="1">
            <span class="wp-dot">&#10003;</span>
            <div class="wp-stage-body">
                <header><h4>Tender</h4><span class="wp-sum">@Model.Tender.Items.Count item(s) &middot; @Model.Tender.EstimatedValue.ToString("N0") @Model.Tender.Currency</span></header>
                <p class="wp-lead">@Model.Tender.Description</p>
                @if (requirementRows.Count > 0) { <dl class="wp-rows">@foreach (var row in requirementRows) { <div><dt>@row.Label</dt><dd>@row.Value</dd></div> }</dl> }
                @if (Model.Tender.Items.Count > 0) { <ul class="wp-items">@foreach (var item in Model.Tender.Items) { <li><b>@item.Name</b><span>@item.Quantity.ToString("0.##") @item.Unit</span>@if (!string.IsNullOrWhiteSpace(item.Specifications)) { <em>@item.Specifications</em> }</li> }</ul> }
            </div>
        </article>

        @if (!Model.IsSupplier)
        {
            @if (!lowestPrice)
            {
            <article class="wp-stage st-@StageState(2)" data-ph="1">
                <span class="wp-dot">@(StageState(2) == "done" ? "\u2713" : "2")</span>
                <div class="wp-stage-body">
                    <header><h4>@L("Weights", "الأوزان")</h4><span class="wp-sum">@(w == null ? L("Not requested yet", "لم تُطلب بعد") : w.State == WeightState.Approved ? $"{finW:0.##}% / {tecW:0.##}% · {L("Locked", "مثبّتة")}" : L($"{votedMembers} of {evalMembers.Count} proposals", $"{votedMembers} من {evalMembers.Count} مقترحات"))</span></header>
                    @if (w == null) { <p class="wp-empty">When the Officer sends the tender, each committee member proposes the Financial / Technical split.</p> }
                    else
                    {
                        @if (!weightSetup)
                        {
                        <div class="wp-split-view">
                            @if (finW != null && tecW != null) { <div class="wp-donut" style="--p:@finW.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%" role="img" aria-label="Financial @finW.Value.ToString("0.##") percent, technical @tecW.Value.ToString("0.##") percent"><b>@finW.Value.ToString("0.#")%</b><small>financial</small></div><div class="wp-legend"><span><i class="wp-k1"></i><b>@finW.Value.ToString("0.##")%</b> Financial</span><span><i class="wp-k2"></i><b>@tecW.Value.ToString("0.##")%</b> Technical</span><small>@(w.State == WeightState.Approved ? "Approved and locked" : "Average of the proposals, waiting for approval")</small></div> }
                            else { <div class="wp-legend"><small>@L("The average appears after all members submit.", "يظهر المتوسط بعد تقديم جميع الأعضاء لمقترحاتهم.")</small></div> }
                        </div>
                        }
                        @if (w.ReadTechnicalCriteria() is { Count: > 0 } criteria)
                        {
                            <h5>Technical criteria</h5>
                            <dl class="wp-rows">@foreach (var criterion in criteria) { <div><dt>@criterion.Name</dt><dd>@criterion.Weight.ToString("0.##")% of technical</dd></div> }</dl>
                        }
                        @if (evalMembers.Count > 0)
                        {
                            <div class="wp-table"><table class="wp-sortable"><thead><tr><th>Member</th><th>Role</th><th data-num>Financial</th><th data-num>Technical</th></tr></thead><tbody>
                            @foreach (var m in evalMembers) { var p = w.Proposals.FirstOrDefault(x => x.MemberUserId == m.UserId); <tr class="@(p == null ? "is-empty" : null)"><td><strong>@Who(m.UserId)</strong></td><td>@Role(m.Responsibility)</td><td data-v="@(p?.Financial.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? "")">@(p == null ? "Waiting" : p.Financial.ToString("0.##") + "%")</td><td data-v="@(p?.Technical.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? "")">@(p == null ? "" : p.Technical.ToString("0.##") + "%")</td></tr> }
                            </tbody></table></div>
                        }
                    }
                </div>
            </article>

            }
            <article class="wp-stage st-@StageState(3)" data-ph="1">
                <span class="wp-dot">@(StageState(3) == "done" ? "\u2713" : "3")</span>
                <div class="wp-stage-body">
                    <header><h4>Offers</h4><span class="wp-sum">@(Model.Bids.Count == 0 ? (status == TenderStatus.Bidding ? "Waiting for offers" : "Bidding not open yet") : $"{Model.Bids.Count} offer(s)")</span></header>
                    @if (round != null && round.Invitations.Count > 0)
                    {
                        <h5 class="wp-sub">Invited suppliers <small>(round @round.RoundNumber)</small></h5>
                        <div class="wp-table"><table class="wp-sortable"><thead><tr><th>Supplier</th><th>Invitation</th><th>Offer</th></tr></thead><tbody>
                        @foreach (var inv in round.Invitations.OrderBy(x => SupplierName(x.SupplierId)))
                        {
                            var offer = Model.Bids.FirstOrDefault(b => b.TenderInvitationId == inv.Id);
                            <tr><td><strong>@SupplierName(inv.SupplierId)</strong></td><td><span class="wp-tag @(inv.Status == InvitationStatus.Accepted ? "wp-tag-good" : "")">@Words(inv.Status.ToString())</span></td><td>@(offer == null ? "No offer yet" : Words(offer.Status.ToString()))</td></tr>
                        }
                        </tbody></table></div>
                    }
                    @if (Model.Bids.Count == 0) { <p class="wp-empty">Supplier offers appear here, with price, delivery and the compliance check.</p> }
                    else
                    {
                        var lowest = Model.Bids.Min(b => Price(b));
                        <div class="wp-table"><table class="wp-sortable"><thead><tr><th>Supplier</th><th data-num>Total price</th><th data-num>Delivery</th><th>Compliance</th></tr></thead><tbody>
                        @foreach (var bid in Model.Bids) { <tr class="@(Price(bid) == lowest && Model.Bids.Count > 1 ? "is-best" : null)"><td><strong>@SupplierName(bid.TenderInvitation.SupplierId)</strong></td><td data-v="@Price(bid).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)">@Price(bid).ToString("N2") @bid.CurrencyCode@(Price(bid) == lowest && Model.Bids.Count > 1 ? " \u2605" : "")</td><td data-v="@bid.DeliveryDays">@bid.DeliveryDays days</td><td><span class="wp-tag @(bid.ComplianceStatus == ComplianceStatus.Compliant ? "wp-tag-good" : "")">@Words(bid.ComplianceStatus.ToString())</span></td></tr> }
                        </tbody></table></div>
                    }
                </div>
            </article>
            @if (stepIndex == 2) { @Html.Raw("</div></details>") }

            @if (!lowestPrice)
            {
            <article class="wp-stage st-@StageState(4)" data-ph="2">
                <span class="wp-dot">@(StageState(4) == "done" ? "\u2713" : "4")</span>
                <div class="wp-stage-body">
                    <header><h4>Committee evaluation</h4><span class="wp-sum">@(s == null ? "Not scheduled yet" : $"{s.Submissions.Count} of 4 submitted")</span></header>
                    @if (s == null) { <p class="wp-empty">The Officer schedules a meeting. Scoring opens at its start and remains available after its end. Each member scores every supplier once, independently.</p> }
                    else
                    {
                            var startIso = DateTime.SpecifyKind(s.StartsAt, DateTimeKind.Utc).ToString("O");
                            var endIso = DateTime.SpecifyKind(s.EndsAt, DateTimeKind.Utc).ToString("O");
                            var roomState = Model.UtcNow < s.StartsAt ? "before" : (Model.UtcNow < s.EndsAt && s.State == SessionState.Scheduled ? "open" : "closed");
                            var doneCount = s.Invitations.Count(x => x.SubmittedAt != null);
                        <div class="wp-clock wp-clock-@roomState" data-countdown data-start="@startIso" data-end="@endIso" data-state="@roomState" data-final="@(s.State != SessionState.Scheduled && !TenderWorkflowService.EvaluationOpen(s, Model.UtcNow) ? "1" : null)">
                            <div class="wp-clock-main"><small data-clock-label>@(roomState == "before" ? "Meeting and scoring start in" : roomState == "open" ? "Meeting ends in" : TenderWorkflowService.EvaluationOpen(s, Model.UtcNow) ? "Meeting ended; evaluation remains open" : "Scoring is closed")</small><strong data-clock>--:--:--</strong></div>
                            <div class="wp-clock-times"><span>Starts <time data-local="@startIso">@s.StartsAt.ToJordan("yyyy-MM-dd HH:mm")</time></span><span>Ends <time data-local="@endIso">@s.EndsAt.ToJordan("yyyy-MM-dd HH:mm")</time></span></div>
                            @if (!string.IsNullOrWhiteSpace(s.MeetingUrl) && s.State == SessionState.Scheduled) { <a class="wp-primary wp-link wp-join@(roomState == "before" ? " is-locked" : null)" data-no-modal data-join="/Meetings/Join/@id" @(roomState == "before" ? Html.Raw("aria-disabled=\"true\" tabindex=\"-1\"") : Html.Raw("href=\"/Meetings/Join/" + id + "\""))><span data-join-label>@Html.Raw(roomState == "before" ? "&#128274; Opens when the meeting starts" : "&#127909; Join the meeting")</span></a> }
                        </div>
                        var meetingAi = Model.Analyses.FirstOrDefault(x => x.Id == s.AiAnalysisId);
                        @if (meetingAi != null)
                        {
                            <div class="wp-aifile">
                                <h5 class="wp-sub">AI analysis for this meeting <small>advisory only &middot; reviewed by the Sourcing Officer</small></h5>
                                <div class="wp-reportbar"><a class="wp-primary wp-link" data-no-modal download href="@Url.Action("AiAnalysisPdf", "Workflow", new { area, id })">&#11015; Download the AI analysis (PDF)</a></div>
                                <details class="wp-opt"><summary>Read the analysis here</summary>@{ var mfr = FindingRows(meetingAi.Findings); }@if (mfr.Count > 0) { <dl class="wp-ai">@foreach (var row in mfr) { <div><dt>@row.Label</dt><dd>@row.Value</dd></div> }</dl> } else { <div class="wp-text">@meetingAi.Findings</div> }</details>
                            </div>
                        }
                        <h5 class="wp-sub">Committee <small>@doneCount of 4 submitted</small></h5>
                        <div class="wp-table"><table class="wp-sortable"><thead><tr><th>Member</th><th>Role</th><th>Status</th><th>Submitted</th></tr></thead><tbody>
                        @foreach (var m in evalMembers)
                        {
                            var part = s.Invitations.FirstOrDefault(x => x.CommitteeMemberId == m.Id);
                            var did = part?.SubmittedAt != null;
                            <tr class="@(did ? "is-best" : null)"><td><strong>@Who(m.UserId)</strong></td><td>@Role(m.Responsibility)</td><td><span class="wp-tag @(did ? "wp-tag-good" : "")">@(did ? (part!.SignatureImage != null ? "Submitted · signed" : "Submitted") : roomState == "open" ? "Scoring now" : roomState == "before" ? "Invited" : "No submission")</span></td><td>@(did ? part!.SubmittedAt!.Value.ToJordan("HH:mm") : "\u2014")</td></tr>
                        }
                        </tbody></table></div>
                        <h5 class="wp-sub">Compliant offers</h5>
                        var eligibleBids = s.EligibleBids.Select(e => Model.Bids.FirstOrDefault(b => b.Id == e.BidId)).OfType<Bid>().ToList();
                        <div class="wp-table"><table class="wp-sortable"><thead><tr><th>Supplier</th><th data-num>Total price</th><th data-num>Delivery</th></tr></thead><tbody>
                        @foreach (var bid in eligibleBids)
                        {
                            <tr>
                                <td>@if (Model.IsEvaluator) { <partial name="_EvaluationOfferTrigger" model="bid" /> } else { <strong>@SupplierName(bid.TenderInvitation.SupplierId)</strong> }</td>
                                <td data-v="@Price(bid).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)">@Price(bid).ToString("N2") @bid.CurrencyCode</td>
                                <td data-v="@bid.DeliveryDays">@bid.DeliveryDays days</td>
                            </tr>
                        }
                        </tbody></table></div>
                        @if (Model.IsEvaluator)
                        {
                            @foreach (var bid in eligibleBids)
                            {
                                <partial name="_EvaluationOfferSummary" model="(bid, Model.Documents.Where(d => d.BidId == bid.Id))" />
                            }
                        }
                        @if (s.State == SessionState.Incomplete) { <p class="wp-hint wp-warn">The evaluation is incomplete. A missing score is never counted as zero.</p> }
                                            }
                </div>
            </article>

            }
            var resultsState = stepIndex == 3 ? "now" : stepIndex > 3 ? "done" : "todo";
            @if (stepIndex >= 3) { @Html.Raw("</div></details>") }
            <article class="wp-stage st-@resultsState" data-ph="3">
                <span class="wp-dot">@(resultsState == "done" ? "\u2713" : "3")</span>
                <div class="wp-stage-body">
                    <header><h4>@(lowestPrice ? "Lowest compliant price" : "Weighted results")</h4><span class="wp-sum">@(Model.Ranking.Count > 0 ?  $"Recommended: {BidSupplier(Model.Ranking.OrderBy(x => x.Rank).First().BidId)}" : "Calculated when the evaluation ends")</span></header>
                    @if (Model.Ranking.Count == 0) { <p class="wp-empty">When the evaluation ends, the system calculates each member's weighted score and the final ranking, and generates the report automatically.</p> }
                    else
                    {
                        @if (!lowestPrice) { <p class="wp-formula">Member score = financial &times; @(finW?.ToString("0.##"))% + technical &times; @(tecW?.ToString("0.##"))%. Final score = the average of the four members.</p> }
                        <ol class="wp-rank wp-podium">@foreach (var r in Model.Ranking.OrderBy(x => x.Rank)) { <li class="@(r.Rank == 1 ? "is-first" : "")"><b>@r.Rank</b><span>@BidSupplier(r.BidId)@if (r.Rank == 1) { <em class="wp-crown">&#9733; Recommended winner</em> }</span><strong>@(lowestPrice ? $"{r.Score:0.####} {Model.Tender.Currency}" : r.Score.ToString("0.00"))</strong>@if (r.Tied) { <em>tie</em> }</li> }</ol>
                        @if (Model.Ranking.Count(x => x.Rank == 1) > 1) { <p class="wp-hint wp-warn">Two suppliers have the exact highest score. A documented tie rule is needed before award.</p> }
                    }
                    @if (Model.Scores.Count > 0 && matrixBids.Count > 0)
                        {
                            @if (s?.State == SessionState.Scheduled) { <p class="wp-hint">Each member's scores stay private until the evaluation ends, so nobody is influenced by anyone else. Your own scores are always visible to you.</p> }
                            <div class="wp-table wp-matrix"><table class="wp-sortable"><thead><tr><th>Member</th><th>Role</th>@foreach (var bidId in matrixBids) { <th data-num>@BidSupplier(bidId)</th> }</tr></thead><tbody>
                            @foreach (var m in evalMembers)
                            {
                                <tr><td><strong>@Who(m.UserId)</strong></td><td>@Role(m.Responsibility)</td>
                                @foreach (var bidId in matrixBids) { var f = Cell(m.Id, bidId, CriterionType.Financial); var t = Cell(m.Id, bidId, CriterionType.Technical); var ws = Weighted(m.Id, bidId);
                                    <td data-v="@(ws?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? "")">@if (f == null) { <span class="wp-dim">@(s?.Invitations.Any(x => x.CommitteeMemberId == m.Id && x.SubmittedAt != null) == true ? "✓ Submitted, hidden until the evaluation ends" : "Waiting")</span> } else { <b>@(ws?.ToString("0.00") ?? "\u2014")</b><small>@f.Value.ToString("0.##") / @t?.ToString("0.##")</small> }</td> }
                                </tr>
                            }
                            @if (Model.Ranking.Count > 0)
                            {
                                <tr class="wp-final"><td colspan="2"><strong>Final score</strong> <small>average of the four</small></td>@foreach (var bidId in matrixBids) { var rk = Model.Ranking.FirstOrDefault(r => r.BidId == bidId); <td data-v="@(rk?.Score.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? "")"><b>@(rk?.Score.ToString("0.00") ?? "—")</b>@if (rk?.Rank == 1) { <small>&#9733; rank 1</small> } else if (rk != null) { <small>rank @rk.Rank</small> }</td> }</tr>
                            }
                            </tbody></table></div>
                            <details class="wp-opt"><summary>Read the members' notes</summary><div class="wp-notes">
                                @foreach (var m in evalMembers) { var notes = Model.Scores.Where(x => x.CommitteeMemberId == m.Id && !string.IsNullOrWhiteSpace(x.Comment)).GroupBy(x => x.BidId).ToList(); if (notes.Count == 0) { continue; }
                                    <div><strong>@Who(m.UserId)</strong> <small>@Role(m.Responsibility)</small>@foreach (var g in notes) { <p><b>@BidSupplier(g.Key):</b> @g.First().Comment</p> }</div> }
                            </div></details>
                        }
                    @if (s?.Report != null) { <p class="wp-auto"><b>&#9889;</b> The system generated the evaluation report automatically (version @s.Report.VersionNumber, @Words(s.Report.Status.ToString())). After four signed submissions, the Officer receives the report and forwards it to the Manager.</p> }
                </div>
            </article>

        }
    </div>
    @if (!Model.IsSupplier)
    {
        var evalSigned = rv?.Signatures.Where(x => x.Stage == ReportSigningStage.Evaluation).ToList() ?? new List<ReportSignature>();
        var mgrSig = rv?.Signatures.FirstOrDefault(x => x.Stage == ReportSigningStage.Manager);
        var sentToManager = status is TenderStatus.ManagerReview or TenderStatus.TopCommitteeReview or TenderStatus.Awarded || s?.State is SessionState.ManagerApproved or SessionState.Awarded;
        var managerDone = mgrSig != null || s?.State is SessionState.ManagerApproved or SessionState.Awarded;
        var topDone = notice != null || status == TenderStatus.Awarded;
        var outcomeDone = rejected ? notice!.Status == FinalDecisionStatus.SuppliersNotified : status == TenderStatus.Awarded && notice?.Status == FinalDecisionStatus.SuppliersNotified;
        var awarded = status == TenderStatus.Awarded;
        var steps5 = new[] { lowestPrice || evalSigned.Count >= 4, sentToManager, managerDone, topDone, outcomeDone };
        var curStep = Array.FindIndex(steps5, x => !x); if (curStep < 0) { curStep = 5; }
        string AS(int i) => steps5[i] ? "done" : i == curStep ? "now" : "todo";
        <div class="wp-approval">
            <div class="wp-ap-intro"><h3>Approval &amp; award</h3><p>@(Model.IsTop || Model.IsManager || Model.IsOfficer ? "From the signed report to the official award. Every step is recorded with who did it and when." : "From the signed report to the Manager's decision. Every step is recorded with who did it and when.")</p></div>

            @if (!lowestPrice)
            {
            <article class="wp-ap wp-ap-@AS(0)"><span class="wp-dot">@(steps5[0] ? "\u2713" : "1")</span><div class="wp-ap-body">
                <header><h4>Committee signatures</h4><span class="wp-sum">@evalSigned.Count of 4 signed</span></header>
                <div class="wp-table"><table><thead><tr><th>Member</th><th>Role</th><th>Status</th><th>When</th></tr></thead><tbody>
                @foreach (var m in evalMembers) { var sg = evalSigned.FirstOrDefault(x => x.UserId == m.UserId); <tr class="@(sg != null ? "is-best" : null)"><td><strong>@Who(m.UserId)</strong></td><td>@Role(m.Responsibility)</td><td><span class="wp-tag @(sg != null ? "wp-tag-good" : "")">@(sg != null ? "Signed" : "Waiting")</span></td><td>@(sg != null ? sg.SignedAt.ToJordan("d MMM HH:mm") : "\u2014")</td></tr> }
                </tbody></table></div>
            </div></article>

            }
            <article class="wp-ap wp-ap-@AS(1)"><span class="wp-dot">@(steps5[1] ? "\u2713" : "2")</span><div class="wp-ap-body">
                <header><h4>@(lowestPrice ? "Financial recommendation" : "Send the report to the Sourcing Manager")</h4><span class="wp-sum">@(sentToManager ? "Sent" : lowestPrice ? "Waiting for screening" : evalSigned.Count >= 4 ? "Ready to send" : "Waiting for signatures")</span></header>
                @if (rv != null)
                {
                    <div class="wp-report">
                        <div class="wp-reportbar"><a class="wp-primary wp-link" data-no-modal download href="@Url.Action("Pdf", area == "TopCommittee" ? "SignedReports" : "Reports", new { area, id = rv.Report.Id, download = true })">&#11015; Download the report (PDF)</a><button type="button" class="wp-ghost" data-preview="@Url.Action("Pdf", area == "TopCommittee" ? "SignedReports" : "Reports", new { area, id = rv.Report.Id })">Preview it here</button></div>
                        <div class="wp-preview" hidden></div>
                    </div>
                }
                <p class="wp-empty">@(lowestPrice ? (sentToManager ? "The system sent the lowest compliant price to the Manager." : "Confirm screening to send the financial recommendation.") : sentToManager ? "The Officer sent the fully signed report to the Manager." : evalSigned.Count >= 4 ? "All four members signed. Send the report to the Sourcing Manager for review." : $"{evalSigned.Count} of 4 members signed. The report can be sent as soon as all four have signed.")</p>
                @if (!reviewStage && !lowestPrice && !sentToManager && rv != null && Model.IsOfficer)
                {
                    <form asp-area="SourcingOfficer" asp-controller="Reports" asp-action="Forward" asp-route-id="@rv.Report.Id" method="post" class="wp-form"><button class="wp-primary" @(rv.CanForward ? null : "disabled")>Send to the Sourcing Manager <span aria-hidden="true">&rarr;</span></button>@if (!rv.CanForward) { <small>Enabled when all four committee members have signed (@evalSigned.Count of 4).</small> }</form>
                }
            </div></article>

            <article class="wp-ap wp-ap-@AS(2)"><span class="wp-dot">@(steps5[2] ? "\u2713" : "3")</span><div class="wp-ap-body">
                <header><h4>Executive summary to the Top Committee</h4><span class="wp-sum">@(managerDone ? "Submitted" : "Waiting")</span></header>
                <p class="wp-empty">@(mgrSig != null ? $"Submitted and signed by {mgrSig.SignerName} on {mgrSig.SignedAt.ToJordan("d MMM HH:mm")}." : managerDone ? "The Manager submitted the report to the Top Committee." : "The assigned Sourcing Manager reviews the signed report and submits a concise executive summary to the Top Committee (or returns / rejects it with a reason).")</p>
            </div></article>

            @* Top vote and final decision: the Top Committee follows it, the Manager acknowledges, the Officer awards and notifies. *@
            @if (Model.IsTop || Model.IsManager || Model.IsOfficer)
            {
            <article class="wp-ap wp-ap-@AS(3)"><span class="wp-dot">@(steps5[3] ? "\u2713" : "4")</span><div class="wp-ap-body">
                <header><h4>Top Committee vote</h4><span class="wp-sum">@(rejected ? "Stopped by a rejection" : topMembers.Count == 0 ? "Waiting for members" : $"{topVotes.Count} of {topMembers.Count} voted")</span></header>
                @if (topMembers.Count == 0) { <p class="wp-empty">When the Sourcing Manager submits the executive summary, the Top Committee decides. Four approvals out of four award the tender automatically.</p> }
                else
                {
                    <div class="wp-table"><table><thead><tr><th>Member</th><th>Vote</th><th>When</th></tr></thead><tbody>
                    @foreach (var tm in topMembers) { var v = topVotes.FirstOrDefault(x => x.CommitteeMemberId == tm.Id); <tr><td><strong>@Who(tm.UserId)</strong></td><td><span class="wp-tag @(v?.Decision == VoteDecision.Approve ? "wp-tag-good" : "")">@(v == null ? "Waiting" : Words(v.Decision.ToString()))</span></td><td>@(v != null ? v.VotedAt.ToJordan("d MMM HH:mm") : "\u2014")</td></tr> }
                    </tbody></table></div>
                    <p class="wp-formula">Approvals: <b>@topVotes.Count(x => x.Decision == VoteDecision.Approve)</b> of @topMembers.Count. Four approvals award the tender automatically; a single Reject or Re-Tender stops it.</p>
                    @if (rejected) { <p class="wp-hint wp-warn">@(notice!.Outcome == FinalDecisionOutcome.Retender ? "Re-Tender requested" : "Rejected") by @Who(notice.RejectedByUserId ?? "") on @notice.RejectedAt?.ToJordan("d MMM HH:mm"): <b>@reasonText</b>. All earlier votes and signatures are kept.</p> }
                }
                @if (topMembers.Count == 0 && s != null && s.State == SessionState.ManagerApproved) { <p class="wp-hint wp-warn">The Top Committee is seated automatically from four active Top Committee accounts. Ask an Admin to add them; the vote opens by itself.</p> }
            </div></article>

            @if (rejected)
            {
            <article class="wp-ap wp-ap-@AS(4)"><span class="wp-dot">@(steps5[4] ? "\u2713" : "5")</span><div class="wp-ap-body">
                <header><h4>Rejection outcome: @(notice!.Outcome == FinalDecisionOutcome.Cancel ? "cancel the tender" : "reissue the tender")</h4><span class="wp-sum">@(notice.Status == FinalDecisionStatus.AwaitingManager ? "Awaiting the Manager" : notice.Status == FinalDecisionStatus.ForwardedToOfficer ? (retenderBlocked ? "Blocked: round limit" : "With the Officer") : "Done")</span></header>
                <ol class="wp-chain">
                    <li class="is-done"><b></b><span><strong>@(notice.Outcome == FinalDecisionOutcome.Retender ? "Top Committee requested a Re-Tender" : "Top Committee rejected the tender")</strong><small>@reasonText &middot; @notice.TopApprovals approval(s) before the rejection were stopped.</small></span></li>
                    <li class="@(notice.Status != FinalDecisionStatus.AwaitingManager ? "is-done" : null)"><b></b><span><strong>@(notice.Status == FinalDecisionStatus.AwaitingManager ? "Awaiting the (legacy) Manager acknowledgement" : "Sent to the Sourcing Officer")</strong><small>@(notice.ManagerAcknowledgedAt != null ? $"Acknowledged by the Manager on {notice.ManagerAcknowledgedAt:d MMM HH:mm}." : notice.Status == FinalDecisionStatus.AwaitingManager ? "This decision was recorded before the redesign and still needs the Manager's acknowledgement." : "The Sourcing Manager was informed; no acknowledgement is required.")</small></span></li>
                    <li class="@(notice.Status == FinalDecisionStatus.SuppliersNotified ? "is-done" : null)"><b></b><span><strong>@(notice.Outcome == FinalDecisionOutcome.Cancel ? "Officer notifies suppliers and the department; tender cancelled" : "Officer edits the tender, invites at least 3 suppliers and opens the new round")</strong><small>@(notice.SuppliersNotifiedAt != null ? $"Done on {notice.SuppliersNotifiedAt:d MMM HH:mm}." : retenderBlocked ? $"Blocked: round {round!.RoundNumber} is the last permitted round ({Model.MaxRounds})." : notice.Outcome == FinalDecisionOutcome.Cancel ? "No further bidding, evaluation or award." : "Same tender, fresh offers from at least 3 suppliers, then a new evaluation and approval cycle.")</small></span></li>
                </ol>
                @if (Model.IsManager && notice.Status == FinalDecisionStatus.AwaitingManager)
                {
                    <form asp-area="SourcingManager" asp-controller="FinalDecisions" asp-action="Acknowledge" asp-route-id="@id" method="post" class="wp-form"><label>Comment (optional)<textarea name="comment" maxlength="1000" rows="2"></textarea></label><button class="wp-primary">@(notice.Outcome == FinalDecisionOutcome.Retender ? "Forward the Re-Tender request to the Officer" : "Forward the rejection to the Officer")</button></form>
                }
                @if (Model.IsOfficer && notice.Status == FinalDecisionStatus.ForwardedToOfficer && !retenderBlocked && notice.Outcome == FinalDecisionOutcome.Retender)
                {
                    <a class="wp-primary wp-link" data-no-modal asp-area="SourcingOfficer" asp-controller="FinalDecisions" asp-action="Retender" asp-route-id="@id">Prepare round @((round?.RoundNumber ?? 0) + 1): details, deadline and invitations <span aria-hidden="true">&rarr;</span></a>
                }
                else if (Model.IsOfficer && notice.Status == FinalDecisionStatus.ForwardedToOfficer && !retenderBlocked)
                {
                    <form asp-area="SourcingOfficer" asp-controller="FinalDecisions" asp-action="Notify" asp-route-id="@id" method="post" class="wp-form"><button class="wp-primary">@(notice.Outcome == FinalDecisionOutcome.Cancel ? "Notify the suppliers and cancel the tender" : $"Notify the suppliers and open round {(round?.RoundNumber ?? 0) + 1}")</button><small>Runs once. Earlier votes, signatures and offers stay on record.</small></form>
                }
                @if (retenderBlocked && (Model.IsOfficer || Model.IsManager)) { <p class="wp-hint wp-warn">Re-tendering is blocked: round @round!.RoundNumber is the last permitted round (@Model.MaxRounds). No further round can be created.</p> }
            </div></article>
            }
            else
            {
            <article class="wp-ap wp-ap-@AS(4)"><span class="wp-dot">@(steps5[4] ? "\u2713" : "5")</span><div class="wp-ap-body">
                <header><h4>Final decision &amp; award</h4><span class="wp-sum">@(awarded ? "Awarded" : notice == null ? "Not started" : notice.Status == FinalDecisionStatus.AwaitingManager ? "Awaiting the Manager (legacy)" : "With the Officer (legacy)")</span></header>
                <ol class="wp-chain">
                    <li class="@(notice != null ? "is-done" : null)"><b></b><span><strong>Unanimous Top Committee approval</strong><small>@(notice != null ? $"{notice.TopApprovals} of {notice.TopVotes} approvals on the same report version." : "Four distinct approvals of the same signed report version.")</small></span></li>
                    <li class="@(awarded ? "is-done" : null)"><b></b><span><strong>Award recorded automatically</strong><small>@(awarded ? $"Awarded to {(Model.Tender.AwardedBidId != null ? BidSupplier(Model.Tender.AwardedBidId.Value) : "the winner")} on {Model.Tender.AwardedAt?.ToJordan("d MMM HH:mm")}." : "The system re-checks eligibility, signatures and the ranking, then awards and closes the tender in the same step.")</small></span></li>
                    <li class="@(notice?.Status == FinalDecisionStatus.SuppliersNotified ? "is-done" : null)"><b></b><span><strong>Everyone is notified</strong><small>@(notice?.SuppliersNotifiedAt != null ? $"Sent on {notice.SuppliersNotifiedAt?.ToJordan("d MMM HH:mm")}: the winner, the unsuccessful suppliers (own result only), the department and all committees." : "The winner, the unsuccessful suppliers (own result only), the department and all committees.")</small></span></li>
                </ol>
                @if (Model.IsManager && notice is { Status: FinalDecisionStatus.AwaitingManager })
                {
                    <form asp-area="SourcingManager" asp-controller="FinalDecisions" asp-action="Acknowledge" asp-route-id="@id" method="post" class="wp-form"><label>Comment (optional)<textarea name="comment" maxlength="1000" rows="2"></textarea></label><button class="wp-primary">Acknowledge and forward to the Officer</button></form>
                }
                @if (Model.IsOfficer && awarded && notice != null && notice.Status != FinalDecisionStatus.SuppliersNotified)
                {
                    <form asp-area="SourcingOfficer" asp-controller="FinalDecisions" asp-action="Notify" asp-route-id="@id" method="post" class="wp-form"><button class="wp-primary">Notify the suppliers</button><small>This sends each supplier its result once.</small></form>
                }
                @if (Model.IsOfficer && s != null && s.State == SessionState.ManagerApproved && Model.FinalPolicyConfigured && !awarded && notice is { Status: FinalDecisionStatus.ForwardedToOfficer })
                {
                    <form asp-area="SourcingOfficer" asp-controller="Workflow" asp-action="Award" asp-route-id="@id" method="post" class="wp-form"><button class="wp-primary">Record the official award</button></form>
                }
            </div></article>
            }
            }
        </div>
    }
    </div>

    <aside class="wp-side" aria-label="At a glance">
        <div class="wp-side-card">
            <h4>At a glance</h4>
            <dl class="wp-facts">
                <div><dt>Estimated value</dt><dd>@Model.Tender.EstimatedValue.ToString("N0") @Model.Tender.Currency</dd></div>
                <div><dt>Items</dt><dd>@Model.Tender.Items.Count</dd></div>
                @if (round != null) { <div><dt>Round</dt><dd>@round.RoundNumber of @Model.MaxRounds</dd></div> }
                @if (round?.Deadline != null) { <div><dt>Bidding deadline</dt><dd><time data-local="@DateTime.SpecifyKind(round.Deadline.Value, DateTimeKind.Utc).ToString("O")">@round.Deadline.Value.ToJordan("yyyy-MM-dd HH:mm")</time></dd></div> }
                <div><dt>Purchase request</dt><dd>#@Model.Tender.PurchaseRequestId</dd></div>
            </dl>
        </div>
        @if (!Model.IsSupplier && !weightSetup && evalMembers.Count > 0)
        {
            <div class="wp-side-card">
                <h4>Committee</h4>
                <ul class="wp-team">@foreach (var m in evalMembers)
                {
                    var did = (w != null && w.State == WeightState.Proposals && w.Proposals.Any(x => x.MemberUserId == m.UserId)) || (s != null && s.Submissions.Any(x => x.CommitteeMemberId == m.Id));
                    <li class="@(did ? "is-done" : null)"><i>@Initial(Who(m.UserId))</i><span><strong>@Who(m.UserId)</strong><small>@Role(m.Responsibility)</small></span><b aria-hidden="true">@(did ? "\u2713" : "")</b></li>
                }</ul>
            </div>
        }
        @if (Model.Documents.Count > 0)
        {
            <div class="wp-side-card">
                <h4>Documents</h4>
                <p class="wp-docs wp-docs-col">@foreach (var d in Model.Documents) { <a data-no-modal href="@Url.Action("Download", ViewContext.RouteData.Values["controller"]?.ToString(), new { area, id = d.Id })">&#128206; @d.FileName</a> }</p>
            </div>
        }
    </aside>
    </div>

    @if (!Model.IsSupplier && (Model.History.Count > 0))
    {
        <details class="wp-history"><summary>History (@Model.History.Count)</summary>
            <ul>@foreach (var entry in Model.History) { <li><time>@entry.CreatedAt.ToJordan("d MMM yyyy HH:mm")</time><span>@Words(entry.Action)</span></li> }</ul></details>
    }
</div>
</div>
}
