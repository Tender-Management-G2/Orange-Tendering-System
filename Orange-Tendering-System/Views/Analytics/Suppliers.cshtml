@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Supplier Reports

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Reports, Analytics & Exports
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
Supplier report: registration/approval/suspension, document
verification and upcoming expirations, participation,
fact-based performance indicators, awards.

BUSINESS ACCESS:
Admin, Sourcing Officer, Sourcing Manager, Top Committee
(exact audience per report to be confirmed; results must be
role- and ownership-filtered)

ROUTE: /Analytics/Suppliers

FUTURE IMPLEMENTATION:
- Performance indicators only from stored facts
  (participation, compliance, awards); do not invent a
  quality score.

DEPENDENCIES:
Suppliers, Documents, TenderInvitations, Bids, Tenders.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Required report category (spec §16); no Trello card covers
reports/exports — team assignment required. No PDF/Excel
generation yet.
===========================================================
*@
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Supplier Reports";
    ViewData["WorkspaceSection"] = "Analytics & Exports";
    ViewData["Description"] = "Registration and approval status, legal document verification and expiry, participation, performance facts and awards.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search supplier" aria-label="Search supplier" />
    <select aria-label="Status"><option>Status: All</option><option>Status: Pending</option><option>Status: Approved</option><option>Status: Rejected</option><option>Status: Suspended</option></select>
    <select aria-label="Documents"><option>Documents: All</option><option>Documents: Expiring in 30 days</option><option>Documents: Expired</option><option>Documents: Unverified</option></select>
    <span class="pg-hint">Search and filters update the records shown on this page.</span>
</section>

<section class="pg-toolbar" aria-label="Export supplier reports">
    <button type="button" class="pg-btn" disabled title="PDF export is not implemented yet">Download PDF</button>
    <button type="button" class="pg-btn" disabled title="Excel export is not implemented yet">Download Excel</button>
    <span class="pg-hint">Export of supplier reports is not implemented yet. Exports must contain only data this user may see.</span>
</section>

<section class="pg-cards" aria-label="Summary">
    <article class="pg-card"><span>Pending registrations</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Approved suppliers</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Suspended</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Documents expiring soon</span><strong>—</strong><small>Not connected</small></article>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-legal-document-verification-and-expiry">
    <div class="pg-panel-head"><h2 id="tbl-legal-document-verification-and-expiry">Legal document verification and expiry</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Supplier</th><th scope="col">Document</th><th scope="col">Verification</th><th scope="col">Expires</th></tr></thead>
            <tbody><tr><td colspan="4"><partial name="_EmptyState" model='"No document data."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-participation-and-performance-facts-only">
    <div class="pg-panel-head"><h2 id="tbl-participation-and-performance-facts-only">Participation and performance (facts only)</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Supplier</th><th scope="col">Invitations</th><th scope="col">Accepted</th><th scope="col">Offers submitted</th><th scope="col">Non-compliant offers</th><th scope="col">Awards</th></tr></thead>
            <tbody><tr><td colspan="6"><partial name="_EmptyState" model='"No participation data."' /></td></tr></tbody>
        </table>
    </div>
</section>
