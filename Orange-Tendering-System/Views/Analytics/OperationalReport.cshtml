@model Orange_Tendering_System.Services.ReportModel
@using Orange_Tendering_System.Models.Entities
@using System.Globalization
@{
    var tender = Model.Key == "tenders";
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = tender ? "Tender Reports" : "Evaluation Reports";
    ViewData["WorkspaceSection"] = "Reports & Analytics";
    ViewData["Description"] = Model.Description;
    ViewData["BodyClass"] = "operational-reports-page";
    var statusTable = Model.Tables.FirstOrDefault(x => x.Title == "Status breakdown") ?? Model.Tables.FirstOrDefault(x => x.Title == "Compliance summary");
    var chart = tender ? Model.Charts.FirstOrDefault(x => x.Title == "Tenders by status") : Model.Charts.FirstOrDefault(x => x.Title == "Bid submission status");
    var trend = tender ? Model.Charts.FirstOrDefault(x => x.Title == "Tender activity over time") : Model.Charts.FirstOrDefault(x => x.Title == "Evaluation activity over time");
    var total = chart?.Points.Sum(x => x.Value) ?? 0; var max = trend?.Points.Count > 0 ? trend.Points.Max(x => x.Value) : 0;
    string ColorFor(string label) => label.ToLowerInvariant() switch { var x when x.Contains("open") || x.Contains("submitted") => "#1e88e5", var x when x.Contains("review") => "#ffb127", var x when x.Contains("accepted") || x.Contains("approved") || x.Contains("awarded") => "#17b26a", var x when x.Contains("rejected") => "#e54444", var x when x.Contains("returned") => "#8d36e8", var x when x.Contains("closed") => "#ff7900", _ => "#a8afb9" }; var current = 0m; var slices = new List<string>();
    if (chart != null && total > 0) { for (var i = 0; i < chart.Points.Count; i++) { var end = current + chart.Points[i].Value * 100 / total; slices.Add($"{ColorFor(chart.Points[i].Label)} {current.ToString("0.##", CultureInfo.InvariantCulture)}% {end.ToString("0.##", CultureInfo.InvariantCulture)}%"); current = end; } }
}
<partial name="_PageHeader" />
<section class="ws-panel pg-panel op-filters"><div class="pg-panel-head"><div><h2>Filters</h2><span class="pg-hint">Filter @(tender ? "tender" : "evaluation") reports by date range, department, supplier, tender, or status.</span></div><partial name="_ReportExportLinks" model='@(new Orange_Tendering_System.ViewModels.ReportExportLinksViewModel(tender ? "tenders" : "evaluations", Model.Filters))' /></div><form method="get" asp-action="@(tender ? "Tenders" : "Evaluations")" class="op-filter-grid"><label>From<input type="date" name="From" value="@Model.Filters.From?.ToString("yyyy-MM-dd")" /></label><label>To<input type="date" name="To" value="@Model.Filters.To?.ToString("yyyy-MM-dd")" /></label><label>Department<select name="DepartmentId"><option value="">All departments</option>@foreach (var x in Model.Departments) { <option value="@x.Id" selected="@(Model.Filters.DepartmentId == x.Id)">@x.Label</option> }</select></label><label>Tender<select name="TenderId"><option value="">All tenders</option>@foreach (var x in Model.Tenders) { <option value="@x.Id" selected="@(Model.Filters.TenderId == x.Id)">@x.Label</option> }</select></label>@if (tender) { <label>Tender status<select name="TenderStatus"><option value="">All statuses</option>@foreach (var x in Html.GetEnumSelectList<TenderStatus>()) { <option value="@x.Value" selected="@(x.Value == ((int?)Model.Filters.TenderStatus)?.ToString())">@x.Text</option> }</select></label> } else { <label>Supplier<select name="SupplierId"><option value="">All suppliers</option>@foreach (var x in Model.Suppliers) { <option value="@x.Id" selected="@(Model.Filters.SupplierId == x.Id)">@x.Label</option> }</select></label> }<div><button class="pg-btn pg-btn-primary">Apply Filters</button><a class="pg-btn" asp-action="@(tender ? "Tenders" : "Evaluations")">Reset</a></div></form></section>
<section class="ws-panel pg-panel"><div class="pg-panel-head"><h2>@(tender ? "Tender Reports" : "Evaluation Reports")</h2></div><div class="op-kpis">@foreach (var item in Model.Kpis.Take(6)) { <div><span>◌</span><small>@item.Label</small><strong>@item.Value</strong></div> }</div></section>
<section class="op-charts"><article class="ws-panel pg-panel"><div class="pg-panel-head"><h2>@(tender ? "Tender Status Distribution" : "Evaluation Status Distribution")</h2></div>@if (total == 0) { <partial name="_EmptyState" model='"No data matches the selected filters."' /> } else { <div class="op-donut" style="background:conic-gradient(@string.Join(",", slices))"><span><strong>@total.ToString("0")</strong><small>@(tender ? "Tenders" : "Offers")</small></span></div><div class="pg-table-wrap"><table class="pg-table op-mini"><thead><tr><th>Status</th><th>Count</th></tr></thead><tbody>@foreach (var p in chart!.Points) { <tr><td>@p.Label</td><td>@p.Value.ToString("0")</td></tr> }</tbody></table></div> }</article><article class="ws-panel pg-panel"><div class="pg-panel-head"><h2>@(tender ? "Tender Activity Over Time" : "Evaluation Activity")</h2></div><div class="op-bars">@if (trend != null) { @foreach (var p in trend.Points) { var h = max == 0 ? 0 : p.Value * 100 / max; <div><strong>@p.Value.ToString("0")</strong><i style="height:@h.ToString("0.##", CultureInfo.InvariantCulture)%"></i><span>@p.Label</span></div> } }</div></article></section>
@foreach (var table in Model.Tables.Where(x => x.Title is "All tenders" or "Evaluation delay (tenders still in evaluation or review)" or "Unified evaluation reports" or "Offer comparison by tender" or "Excluded offers" or "Technical and financial evaluation summary")) { <section class="ws-panel pg-panel"><div class="pg-panel-head"><h2>@table.Title</h2></div><div class="pg-table-wrap"><table class="pg-table"><thead><tr>@foreach (var c in table.Columns) { <th>@c</th> }</tr></thead><tbody>@foreach (var row in table.Rows) { <tr>@foreach (var cell in row) { <td>@cell</td> }</tr> }@if (table.Rows.Count == 0) { <tr><td colspan="@table.Columns.Length"><partial name="_EmptyState" model='"No records found."' /></td></tr> }</tbody></table></div></section>}
