@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Bids & Evaluation Reports

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Reports, Analytics & Exports
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
Bids and evaluation report: comparisons, technical/financial
summaries, received vs eligible vs excluded, recommendation
and score breakdown.

BUSINESS ACCESS:
Admin, Sourcing Officer, Sourcing Manager, Top Committee
(exact audience per report to be confirmed; results must be
role- and ownership-filtered)

ROUTE: /Analytics/Evaluations

FUTURE IMPLEMENTATION:
- Ranking only from the approved report’s
  RankingSnapshotJson; never recalculate a historic result.

DEPENDENCIES:
Bids, BidItems, EvaluationScores, EvaluationCriteria,
TenderReports.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Required report category (spec §16); no Trello card covers
reports/exports — team assignment required. No PDF/Excel
generation yet.
===========================================================
*@
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Bids & Evaluation Reports";
    ViewData["WorkspaceSection"] = "Analytics & Exports";
    ViewData["Description"] = "Side-by-side offers, technical and financial summaries, received vs eligible vs excluded offers and score breakdowns.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search tender" aria-label="Search tender" />
    <select aria-label="Tender"><option>Tender: Select a tender</option></select>
    <span class="pg-hint">Search and filters update the records shown on this page.</span>
</section>

<section class="pg-toolbar" aria-label="Export bid and evaluation reports">
    <button type="button" class="pg-btn" disabled title="PDF export is not implemented yet">Download PDF</button>
    <button type="button" class="pg-btn" disabled title="Excel export is not implemented yet">Download Excel</button>
    <span class="pg-hint">Export of bid and evaluation reports is not implemented yet. Exports must contain only data this user may see.</span>
</section>

<section class="pg-cards" aria-label="Summary">
    <article class="pg-card"><span>Received offers</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Eligible (compliant)</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Excluded (non-compliant)</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Pending clarification</span><strong>—</strong><small>Not connected</small></article>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-side-by-side-offers">
    <div class="pg-panel-head"><h2 id="tbl-side-by-side-offers">Side-by-side offers</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Supplier</th><th scope="col">Calculated total</th><th scope="col">Delivery</th><th scope="col">Validity</th><th scope="col">Compliance</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"Select a tender."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-score-breakdown">
    <div class="pg-panel-head"><h2 id="tbl-score-breakdown">Score breakdown</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Supplier</th><th scope="col">Technical</th><th scope="col">Financial</th><th scope="col">Final</th><th scope="col">Rank</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"No approved evaluation for this tender."' /></td></tr></tbody>
        </table>
    </div>
</section>
