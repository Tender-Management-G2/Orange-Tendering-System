@model AdminAccountOverviewViewModel
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Maintenance & System Overview";
    ViewData["WorkspaceSection"] = "Analytics & Exports";
    ViewData["Description"] = "Maintenance planning, technical coordination and routine administration.";
}
<partial name="_PageHeader" />
<aside class="pg-note" role="note">
    <strong>Maintenance preview · Read only</strong>
    <p>The maintenance date and duration below are demo information. Technical checks are a reference checklist, not live monitoring or confirmed maintenance records.</p>
</aside>
<section class="pg-cards" aria-label="Maintenance overview">
    <article class="pg-card" data-search-item><span>Next maintenance · Demo</span><h2>@Model.NextMaintenanceUtc.ToString("dd MMM yyyy")</h2><p>@Model.NextMaintenanceUtc.ToString("HH:mm") UTC · Illustrative schedule</p></article>
    <article class="pg-card" data-search-item><span>Estimated window · Demo</span><h2>2 hours</h2><p>Confirm timing and service impact with the technical team.</p></article>
    <article class="pg-card" data-search-item><span>Technical coordination</span><h2>Technical team</h2><p>Coordinate the approved schedule, planned work and completion report.</p></article>
</section>
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><div><h2>Maintenance plan</h2><p>Sample plan for review with the technical team</p></div></div>
    <dl class="pg-dl">
        <div data-search-item><dt>Planned work</dt><dd>Security updates, database backup verification and platform health checks</dd></div>
        <div data-search-item><dt>Expected impact · Demo</dt><dd>Brief service interruptions within the agreed maintenance window</dd></div>
        <div data-search-item><dt>Before maintenance</dt><dd>Confirm the technical contact, approved timing, backup and rollback plan.</dd></div>
        <div data-search-item><dt>After maintenance</dt><dd>Review the completion report and confirm that sign-in and core pages work.</dd></div>
    </dl>
</section>
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><div><h2>Routine admin review</h2><p>Reference checklist for maintaining the platform</p></div></div>
    <div class="pg-table-wrap"><table class="pg-table" data-no-enhance>
        <thead><tr><th>Area</th><th>Review item</th><th>Coordinate with</th></tr></thead>
        <tbody>
            <tr data-search-item><td>User access</td><td>Review active/inactive accounts and the roles assigned to staff.</td><td>Admin</td></tr>
            <tr data-search-item><td>Department records</td><td>Review unassigned employees and inactive departments.</td><td>Admin</td></tr>
            <tr data-search-item><td>Audit trail</td><td>Review recorded administrative changes and investigate unexpected activity.</td><td>Admin / Technical team</td></tr>
            <tr data-search-item><td>Backups</td><td>Confirm the latest backup and restoration check with the technical team.</td><td>Technical team</td></tr>
            <tr data-search-item><td>Security updates</td><td>Agree on updates and verify the system after deployment.</td><td>Technical team</td></tr>
        </tbody>
    </table></div>
</section>
