@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Approvals & Governance Reports

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Reports, Analytics & Exports
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
Governance report: recommendations, 4/4 votes per round,
Manager decisions, report version history, awarded bids,
links to the audit trail.

BUSINESS ACCESS:
Admin, Sourcing Officer, Sourcing Manager, Top Committee
(exact audience per report to be confirmed; results must be
role- and ownership-filtered)

ROUTE: /Analytics/Governance

FUTURE IMPLEMENTATION:
- Awards from Tender.AwardedBidId/AwardedAt; recommendations
  from TenderReport.RecommendedBidId — show both, never
  merge them.

DEPENDENCIES:
CommitteeRounds, CommitteeVotes, TenderReports, Tenders,
AuditLogs.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Required report category (spec §16); no Trello card covers
reports/exports — team assignment required. No PDF/Excel
generation yet.
===========================================================
*@
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Approvals & Governance Reports";
    ViewData["WorkspaceSection"] = "Analytics & Exports";
    ViewData["Description"] = "Committee recommendations, individual votes, Manager decisions, report versions and final awards.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search tender" aria-label="Search tender" />
    <select aria-label="Committee"><option>Committee: All</option><option>Committee: Evaluation</option><option>Committee: Top</option></select>
    <select aria-label="Outcome"><option>Outcome: All</option><option>Outcome: Approved</option><option>Outcome: Rejected</option></select>
    <span class="pg-hint">Search and filters update the records shown on this page.</span>
</section>

<section class="pg-toolbar" aria-label="Export governance reports">
    <button type="button" class="pg-btn" disabled title="PDF export is not implemented yet">Download PDF</button>
    <button type="button" class="pg-btn" disabled title="Excel export is not implemented yet">Download Excel</button>
    <span class="pg-hint">Export of governance reports is not implemented yet. Exports must contain only data this user may see.</span>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-committee-rounds-and-votes">
    <div class="pg-panel-head"><h2 id="tbl-committee-rounds-and-votes">Committee rounds and votes</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender</th><th scope="col">Committee</th><th scope="col">Round</th><th scope="col">Approvals</th><th scope="col">Rejections</th><th scope="col">Outcome</th></tr></thead>
            <tbody><tr><td colspan="6"><partial name="_EmptyState" model='"No committee rounds yet."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-manager-decisions">
    <div class="pg-panel-head"><h2 id="tbl-manager-decisions">Manager decisions</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender</th><th scope="col">Report version</th><th scope="col">Decision</th><th scope="col">Comment</th><th scope="col">Date</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"No manager decisions yet."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-awards">
    <div class="pg-panel-head"><h2 id="tbl-awards">Awards</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Tender</th><th scope="col">Recommended offer</th><th scope="col">Awarded offer</th><th scope="col">Awarded at</th></tr></thead>
            <tbody><tr><td colspan="4"><partial name="_EmptyState" model='"No awards yet."' /></td></tr></tbody>
        </table>
    </div>
</section>

<nav class="pg-links" aria-label="Related pages">
    <ul>
        <li><a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Audit logs (Admin)</a></li>
    </ul>
</nav>
