@model Orange_Tendering_System.Services.ReportModel
@using Orange_Tendering_System.Models.Entities
@using System.Globalization
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Reports Management";
    ViewData["WorkspaceSection"] = "Reports & Analytics";
    ViewData["Description"] = "Search and filter every stored report version and its workflow status.";
    ViewData["BodyClass"] = "reports-management-page";
    var status = Model.Charts.First(x => x.Title == "Reports by status");
    var types = Model.Charts.First(x => x.Title == "Report types distribution");
    var table = Model.Tables.First(x => x.Title == "Stored report versions");
    string ColorFor(string label) => label.ToLowerInvariant() switch { var x when x.Contains("draft") => "#a8afb9", var x when x.Contains("submitted") || x.Contains("open") => "#1e88e5", var x when x.Contains("review") => "#ffb127", var x when x.Contains("accepted") || x.Contains("approved") || x.Contains("awarded") => "#17b26a", var x when x.Contains("rejected") => "#e54444", var x when x.Contains("returned") => "#8d36e8", var x when x.Contains("closed") => "#ff7900", _ => "#737373" };
    string Pie(List<Orange_Tendering_System.Services.ReportChartPoint> points)
    {
        var total = points.Sum(x => x.Value); if (total == 0) return "#e8e8e8 0 100%";
        var current = 0m; var slices = new List<string>();
        for (var i = 0; i < points.Count; i++) { var end = current + points[i].Value * 100 / total; slices.Add($"{ColorFor(points[i].Label)} {current.ToString("0.##", CultureInfo.InvariantCulture)}% {end.ToString("0.##", CultureInfo.InvariantCulture)}%"); current = end; }
        return string.Join(",", slices);
    }
    var route = new Dictionary<string, string?> { ["From"] = Model.Filters.From?.ToString("yyyy-MM-dd"), ["To"] = Model.Filters.To?.ToString("yyyy-MM-dd"), ["DepartmentId"] = Model.Filters.DepartmentId?.ToString(), ["SupplierId"] = Model.Filters.SupplierId?.ToString(), ["TenderId"] = Model.Filters.TenderId?.ToString(), ["ReportType"] = Model.Filters.ReportType?.ToString(), ["ReportStatus"] = Model.Filters.ReportStatus?.ToString(), ["ReportVersion"] = Model.Filters.ReportVersion?.ToString(), ["CreatedByUserId"] = Model.Filters.CreatedByUserId, ["Search"] = Model.Filters.Search, ["Sort"] = Model.Filters.Sort };
}
<partial name="_PageHeader" />

<section class="ws-panel pg-panel"><div class="pg-panel-head"><h2>Reports Management</h2></div><partial name="_ReportKpiCards" model="@(Model.Kpis)" /></section>

<section class="ws-panel pg-panel rm-filters">
    <div class="pg-panel-head"><div><h2>Filters</h2><span class="pg-hint">Filter management reports by date range, department, supplier, tender, report type, status, version, or creator.</span></div><partial name="_ReportExportLinks" model="@(new Orange_Tendering_System.ViewModels.ReportExportLinksViewModel("reports-management", Model.Filters))" /></div>
    <form method="get" asp-action="ReportsManagement" class="rm-filter-grid">
        <label>From<input type="date" name="From" value="@Model.Filters.From?.ToString("yyyy-MM-dd")" /></label>
        <label>To<input type="date" name="To" value="@Model.Filters.To?.ToString("yyyy-MM-dd")" /></label>
        <label>Department<select name="DepartmentId"><option value="">All departments</option>@foreach (var x in Model.Departments) { <option value="@x.Id" selected="@(Model.Filters.DepartmentId == x.Id)">@x.Label</option> }</select></label>
        <label>Supplier<select name="SupplierId"><option value="">All suppliers</option>@foreach (var x in Model.Suppliers) { <option value="@x.Id" selected="@(Model.Filters.SupplierId == x.Id)">@x.Label</option> }</select></label>
        <label>Tender<select name="TenderId"><option value="">All tenders</option>@foreach (var x in Model.Tenders) { <option value="@x.Id" selected="@(Model.Filters.TenderId == x.Id)">@x.Label</option> }</select></label>
        <label>Report type<select name="ReportType"><option value="">All types</option>@foreach (var x in Html.GetEnumSelectList<ReportType>()) { <option value="@x.Value" selected="@(x.Value == ((int?)Model.Filters.ReportType)?.ToString())">@x.Text</option> }</select></label>
        <label>Report status<select name="ReportStatus"><option value="">All statuses</option>@foreach (var x in Html.GetEnumSelectList<ReportStatus>()) { <option value="@x.Value" selected="@(x.Value == ((int?)Model.Filters.ReportStatus)?.ToString())">@x.Text</option> }</select></label>
        <label>Report version<input type="number" min="1" name="ReportVersion" value="@Model.Filters.ReportVersion" placeholder="All versions" /></label>
        <label>Created by<select name="CreatedByUserId"><option value="">All users</option>@foreach (var x in Model.ReportCreators) { <option value="@x.Id" selected="@(Model.Filters.CreatedByUserId == x.Id)">@x.Label</option> }</select></label>
        <label>Search<input name="Search" value="@Model.Filters.Search" placeholder="Tender title or report content" /></label>
        <div class="rm-filter-actions"><button class="pg-btn pg-btn-primary" type="submit">Apply Filters</button><a class="pg-btn" asp-action="ReportsManagement">Reset</a></div>
    </form>
</section>

<section class="rm-charts">
    <article class="ws-panel pg-panel"><div class="pg-panel-head"><h2>Reports by Status</h2></div><div class="rm-pie" style="background:conic-gradient(@Pie(status.Points))"><span><strong>@status.Points.Sum(x => x.Value).ToString("0")</strong><small>Reports</small></span></div><ul class="rm-legend">@foreach (var p in status.Points) { <li>@p.Label <strong>@p.Value.ToString("0")</strong></li> }</ul></article>
    <article class="ws-panel pg-panel"><div class="pg-panel-head"><h2>Report Types Distribution</h2></div><div class="rm-pie" style="background:conic-gradient(@Pie(types.Points))"><span><strong>@types.Points.Sum(x => x.Value).ToString("0")</strong><small>Reports</small></span></div><ul class="rm-legend">@foreach (var p in types.Points) { <li>@p.Label <strong>@p.Value.ToString("0")</strong></li> }</ul></article>
</section>

<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><div><h2>Stored Report Versions</h2><span class="pg-hint">@table.TotalRows filtered records · sorted and paginated from live system data.</span></div></div>
    <form method="get" asp-action="ReportsManagement" class="rm-table-controls">
        <input type="hidden" name="From" value="@Model.Filters.From?.ToString("yyyy-MM-dd")" /><input type="hidden" name="To" value="@Model.Filters.To?.ToString("yyyy-MM-dd")" /><input type="hidden" name="DepartmentId" value="@Model.Filters.DepartmentId" /><input type="hidden" name="SupplierId" value="@Model.Filters.SupplierId" /><input type="hidden" name="TenderId" value="@Model.Filters.TenderId" /><input type="hidden" name="ReportType" value="@Model.Filters.ReportType" /><input type="hidden" name="ReportVersion" value="@Model.Filters.ReportVersion" /><input type="hidden" name="CreatedByUserId" value="@Model.Filters.CreatedByUserId" />
        <select name="ReportStatus"><option value="">All statuses</option>@foreach (var x in Html.GetEnumSelectList<ReportStatus>()) { <option value="@x.Value" selected="@(x.Value == ((int?)Model.Filters.ReportStatus)?.ToString())">@x.Text</option> }</select><select name="Sort"><option value="" selected="@(string.IsNullOrEmpty(Model.Filters.Sort))">Newest first</option><option value="created_asc" selected="@(Model.Filters.Sort == "created_asc")">Oldest first</option><option value="status" selected="@(Model.Filters.Sort == "status")">Status</option><option value="version" selected="@(Model.Filters.Sort == "version")">Version</option></select><button class="pg-btn" type="submit">Apply</button>
    </form>
    <div class="pg-table-wrap"><table class="pg-table" data-no-enhance><thead><tr>@foreach (var c in table.Columns) { <th>@c</th> }</tr></thead><tbody>@foreach (var row in table.Rows) { <tr>@for (var i = 0; i < row.Length; i++) { <td>@if (i == 0) { <a asp-action="ReportDetails" asp-route-id="@row[i]">@row[i]</a> } else { @row[i] }</td> }</tr> }@if (table.Rows.Count == 0) { <tr><td colspan="@table.Columns.Length"><partial name="_EmptyState" model='"No report versions match the selected filters."' /></td></tr> }</tbody></table></div>
    @if (table.TotalRows > table.PageSize) { var pages = (int)Math.Ceiling(table.TotalRows / (decimal)table.PageSize); <nav class="rm-pager" aria-label="Report pages">@for (var pageNumber = 1; pageNumber <= pages; pageNumber++) { <a class="@(pageNumber == table.Page ? "is-current" : "")" asp-action="ReportsManagement" asp-route-From="@Model.Filters.From" asp-route-To="@Model.Filters.To" asp-route-DepartmentId="@Model.Filters.DepartmentId" asp-route-SupplierId="@Model.Filters.SupplierId" asp-route-TenderId="@Model.Filters.TenderId" asp-route-ReportType="@Model.Filters.ReportType" asp-route-ReportStatus="@Model.Filters.ReportStatus" asp-route-ReportVersion="@Model.Filters.ReportVersion" asp-route-CreatedByUserId="@Model.Filters.CreatedByUserId" asp-route-Search="@Model.Filters.Search" asp-route-Sort="@Model.Filters.Sort" asp-route-ReportPage="@pageNumber">@pageNumber</a> }</nav> }
</section>
