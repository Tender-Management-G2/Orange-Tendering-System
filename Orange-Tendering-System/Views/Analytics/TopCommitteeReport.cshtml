@model Orange_Tendering_System.Services.ReportModel
@using System.Globalization
@{ Layout = WorkspaceNavigation.LayoutFor(User); ViewData["Title"] = "Top Committee Reports"; ViewData["WorkspaceSection"] = "Reports & Analytics"; ViewData["Description"] = "System-wide supplier participation, awards, outcomes and committee voting statistics."; ViewData["BodyClass"] = "top-committee-reports-page";
var tenders = Model.Tables.First(x => x.Title == "Tenders by status"); var transactions = Model.Tables.First(x => x.Title == "Transactions with each supplier"); var award = Model.Charts.FirstOrDefault(x => x.Title == "Tender award trend"); var total = tenders.Rows.Sum(x => decimal.TryParse(x[1], out var v) ? v : 0); var max = award?.Points.Count > 0 ? award.Points.Max(x => x.Value) : 0; string ColorFor(string label) => label.ToLowerInvariant() switch { var x when x.Contains("open") => "#1e88e5", var x when x.Contains("closed") => "#ff7900", var x when x.Contains("awarded") => "#17b26a", _ => "#a8afb9" };var cursor=0m;var slices=new List<string>();for(var i=0;i<tenders.Rows.Count&&total>0;i++){var count=decimal.Parse(tenders.Rows[i][1]);var end=cursor+count*100/total;slices.Add($"{ColorFor(tenders.Rows[i][0])} {cursor.ToString("0.##",CultureInfo.InvariantCulture)}% {end.ToString("0.##",CultureInfo.InvariantCulture)}%");cursor=end;}}
<partial name="_PageHeader" />
<section class="ws-panel pg-panel tc-filters"><div class="pg-panel-head"><div><h2>Filters</h2><span class="pg-hint">Filter top committee reports by date range, supplier, or tender.</span></div><partial name="_ReportExportLinks" model='@(new Orange_Tendering_System.ViewModels.ReportExportLinksViewModel("management", Model.Filters))' /></div><form method="get" asp-action="Management" class="tc-filter-grid"><label>From<input type="date" name="From" value="@Model.Filters.From?.ToString("yyyy-MM-dd")" /></label><label>To<input type="date" name="To" value="@Model.Filters.To?.ToString("yyyy-MM-dd")" /></label><label>Supplier<select name="SupplierId"><option value="">All suppliers</option>@foreach(var x in Model.Suppliers){<option value="@x.Id" selected="@(Model.Filters.SupplierId==x.Id)">@x.Label</option>}</select></label><label>Tender<select name="TenderId"><option value="">All tenders</option>@foreach(var x in Model.Tenders){<option value="@x.Id" selected="@(Model.Filters.TenderId==x.Id)">@x.Label</option>}</select></label><div><button class="pg-btn pg-btn-primary">Apply Filters</button><a class="pg-btn" asp-action="Management">Reset</a></div></form></section>
<section class="ws-panel pg-panel"><div class="pg-panel-head"><h2>Top Committee Reports</h2></div><div class="tc-kpis">@foreach(var x in Model.Kpis.Take(6)){<div><span>◌</span><small>@x.Label</small><strong>@x.Value</strong></div>}</div></section>
<section class="tc-charts"><article class="ws-panel pg-panel"><div class="pg-panel-head"><h2>Tender Status Distribution</h2></div>@if(total==0){<partial name="_EmptyState" model='"No tender data."'/>}else{<div class="tc-donut" style="background:conic-gradient(@string.Join(",",slices))"><span><strong>@total.ToString("0")</strong><small>Tenders</small></span></div><div class="pg-table-wrap"><table class="pg-table tc-mini"><thead><tr><th>Status</th><th>Tenders</th></tr></thead><tbody>@foreach(var row in tenders.Rows){<tr><td>@row[0]</td><td>@row[1]</td></tr>}</tbody></table></div>}</article><article class="ws-panel pg-panel"><div class="pg-panel-head"><h2>Tender Award Trend</h2></div><div class="tc-bars">@if(award!=null){@foreach(var p in award.Points){var h=max==0?0:p.Value*100/max;<div><strong>@p.Value.ToString("0")</strong><i style="height:@h.ToString("0.##",CultureInfo.InvariantCulture)%"></i><span>@p.Label</span></div>}}</div></article></section>
@foreach(var table in Model.Tables.Where(x=>x.Title is "Transactions with each supplier" or "Technical & financial evaluation summary" or "Top Committee voting summary")){<section class="ws-panel pg-panel"><div class="pg-panel-head"><h2>@table.Title</h2></div><div class="pg-table-wrap"><table class="pg-table"><thead><tr>@foreach(var c in table.Columns){<th>@c</th>}</tr></thead><tbody>@foreach(var row in table.Rows){<tr>@foreach(var cell in row){<td>@cell</td>}</tr>}@if(table.Rows.Count==0){<tr><td colspan="@table.Columns.Length"><partial name="_EmptyState" model='"No records found."'/></td></tr>}</tbody></table></div></section>}
