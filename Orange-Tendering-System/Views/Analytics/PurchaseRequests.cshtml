@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Purchase Request Reports

DEVELOPER OWNER: UNASSIGNED — Team assignment required
MODULE: Reports, Analytics & Exports
TRELLO TASK: None — no dedicated Trello card
TRELLO URL: —

PURPOSE:
Purchase request report: counts, statuses, department/time
breakdown, average Officer review time, request/item
history.

BUSINESS ACCESS:
Admin, Sourcing Officer, Sourcing Manager, Top Committee
(exact audience per report to be confirmed; results must be
role- and ownership-filtered)

ROUTE: /Analytics/PurchaseRequests

FUTURE IMPLEMENTATION:
- Counts from PurchaseRequests; review time =
  PurchaseRequestReviews.ReviewedAt − SubmittedAt.

DEPENDENCIES:
PurchaseRequests, PurchaseRequestReviews,
PurchaseRequestItems, Departments.

STATUS:
UI SCAFFOLD ONLY — BUSINESS LOGIC NOT IMPLEMENTED.

IMPORTANT:
Required report category (spec §16); no Trello card covers
reports/exports — team assignment required. No PDF/Excel
generation yet.
===========================================================
*@
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Purchase Request Reports";
    ViewData["WorkspaceSection"] = "Analytics & Exports";
    ViewData["Description"] = "Request counts and status by department and period, review times, returns and request history.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<section class="pg-toolbar" aria-label="Search and filters">
    <input type="search" placeholder="Search request" aria-label="Search request" disabled />
    <select aria-label="Department" disabled><option>Department: All</option></select>
    <select aria-label="Status" disabled><option>Status: All</option><option>Status: Draft</option><option>Status: Submitted</option><option>Status: Returned</option><option>Status: Rejected</option><option>Status: Accepted</option></select>
    <select aria-label="Period" disabled><option>Period: This month</option><option>Period: This quarter</option><option>Period: This year</option><option>Period: Custom</option></select>
    <span class="pg-hint">Search and filters are not implemented yet.</span>
</section>

<section class="pg-toolbar" aria-label="Export purchase request reports">
    <button type="button" class="pg-btn" disabled title="PDF export is not implemented yet">Download PDF</button>
    <button type="button" class="pg-btn" disabled title="Excel export is not implemented yet">Download Excel</button>
    <span class="pg-hint">Export of purchase request reports is not implemented yet. Exports must contain only data this user may see.</span>
</section>

<section class="pg-cards" aria-label="Summary">
    <article class="pg-card"><span>Requests</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Submitted</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Returned</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Accepted</span><strong>—</strong><small>Not connected</small></article>
    <article class="pg-card"><span>Average review time</span><strong>—</strong><small>Not connected</small></article>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-by-department">
    <div class="pg-panel-head"><h2 id="tbl-by-department">By department</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Department</th><th scope="col">Drafts</th><th scope="col">Submitted</th><th scope="col">Returned</th><th scope="col">Rejected</th><th scope="col">Accepted</th></tr></thead>
            <tbody><tr><td colspan="6"><partial name="_EmptyState" model='"No request data."' /></td></tr></tbody>
        </table>
    </div>
</section>

<section class="ws-panel pg-panel" aria-labelledby="tbl-request-history">
    <div class="pg-panel-head"><h2 id="tbl-request-history">Request history</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Request</th><th scope="col">Submission #</th><th scope="col">Submitted</th><th scope="col">Decision</th><th scope="col">Reviewed</th></tr></thead>
            <tbody><tr><td colspan="5"><partial name="_EmptyState" model='"No request data."' /></td></tr></tbody>
        </table>
    </div>
</section>
