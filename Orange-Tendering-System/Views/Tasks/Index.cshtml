@* My Tasks: real, role-scoped work items from InternalDashboardService. Table search/sort/pagination come from the shared table kit. *@
@model IReadOnlyList<DashboardTask>
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "My Tasks";
    ViewData["WorkspaceSection"] = "My Tasks";
    ViewData["Description"] = "Work waiting for you across the workflow.";
}
<partial name="_PageHeader" />
<section class="ws-panel pg-panel" aria-labelledby="tbl-my-tasks">
    <div class="pg-panel-head"><h2 id="tbl-my-tasks">My tasks</h2></div>
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead><tr><th scope="col">Task</th><th scope="col">Related record</th><th scope="col">Status</th><th scope="col" data-nosort>Action</th></tr></thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr><td>@t.Title</td><td>@t.Context</td><td><span class="pg-status">@t.Status</span></td><td>@if (t.Link != null) { <a class="pg-btn" href="@t.Link">Open</a> }</td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4"><partial name="_EmptyState" model='"No tasks are waiting for you."' /></td></tr> }
            </tbody>
        </table>
    </div>
</section>
