@model Orange_Tendering_System.Models.Entities.Clarification
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Clarification Thread";
    ViewData["WorkspaceSection"] = "Clarifications";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var other = Model.FromUserId == userId ? Model.ToUser?.UserName : Model.FromUser?.UserName;
    var linked = Model.Bid?.TenderInvitation?.TenderRound?.Tender?.Title ?? Model.Tender?.Title ?? Model.PurchaseRequest?.Title ?? "General";
}
<partial name="_PageHeader" />
@if (TempData["ClarificationError"] is string error) { <p class="pg-note" role="alert">@error</p> }
@if (TempData["ClarificationMessage"] is string notice) { <p class="pg-note" role="status">@notice</p> }
<section class="ws-panel pg-panel">
    <div class="pg-panel-head"><div><h2>@Model.Subject</h2><span class="pg-hint">With @other · @linked · <span class="ui-pill ui-pill--@(Model.Status == Orange_Tendering_System.Models.Entities.ClarificationStatus.Closed ? "good" : Model.Status == Orange_Tendering_System.Models.Entities.ClarificationStatus.Open ? "warn" : "info")">@Orange_Tendering_System.Services.ClarificationPolicy.Label(Model.Status)</span></span></div><a asp-action="Index" class="pg-btn">Back to clarifications</a></div>
    <div class="so-chat">
    @foreach (var item in Model.Messages.OrderBy(m => m.SentAt))
    {
        var own = item.SenderUserId == userId;
        <article class="so-message @(own ? "is-own" : "")"><small><strong>@(own ? "You" : item.SenderUser?.UserName)</strong> · @item.SentAt.ToLocalTime().ToString("d MMM yyyy h:mm tt")</small><p style="white-space:pre-wrap">@item.Message</p>
            @if (item.Documents.Count > 0) { <ul>@foreach (var document in item.Documents) { <li>@document.FileName</li> }</ul> }
        </article>
    }
    @if (Model.Messages.Count == 0) { <p>No messages yet.</p> }
    </div>
</section>
@if (Model.Status != Orange_Tendering_System.Models.Entities.ClarificationStatus.Closed)
{
    <section class="ws-panel pg-panel"><h2>Reply</h2><form asp-action="Reply" method="post" class="pg-form">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="pg-field"><label for="message">Message</label><textarea id="message" name="message" rows="4" maxlength="10000" required></textarea></div>
        <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Send reply</button></div>
    </form>
    <form asp-action="Resolve" asp-route-id="@Model.Id" method="post" class="pg-form"><div class="pg-actions"><button type="submit" class="pg-btn">Mark as resolved</button></div></form></section>
}
