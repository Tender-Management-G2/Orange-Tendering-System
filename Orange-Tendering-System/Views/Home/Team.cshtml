@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Team Page — scroll-controlled courtyard experience

DEVELOPER OWNER: Tariq
MODULE: Public Site
TRELLO TASK: Team Page
TRELLO URL: https://trello.com/c/P1gL4sPq

PURPOSE:
A pinned, scroll-synchronised Three.js scene in the Orange HQ
courtyard (wwwroot/js/team-scene.js) that ends on the team
cards. Members come from wwwroot/data/team.json.

BUSINESS ACCESS:
Anonymous

ROUTE: /team

SEQUENCE:
One segment per member in team.json order: walk in, sit on the
bench, the orange falls, profile card, then take a place in the
line beside the bench. Finale: the whole team side by side.

FUTURE IMPLEMENTATION:
- Replace the placeholder entries in team.json with the verified
  team members (names, roles, photos, links); set placeholder =
  false for verified profiles.

DEPENDENCIES:
wwwroot/data/team.json, TeamMemberViewModel, Three.js (vendored),
GSAP ScrollTrigger (CDN with local fallback).

STATUS:
STATIC PUBLIC CONTENT, NO BUSINESS LOGIC.
===========================================================
*@
@using Orange_Tendering_System.ViewModels
@model IReadOnlyList<TeamMemberViewModel>
@{ ViewData["Title"] = "Our Team | Orange Sourcing"; }
@section Styles {<link rel="stylesheet" href="~/css/team-scene.css" asp-append-version="true" />}
<main class="public-page team-page tx-page">
  <section class="tx" id="tx" style="--tx-n:@Model.Count" aria-labelledby="tx-title">
    <div class="tx-sticky">
      <canvas class="tx-canvas" aria-hidden="true"></canvas>
      <div class="tx-shade" aria-hidden="true"></div>
      <div class="tx-intro">
        <span class="tx-eyebrow">OUR TEAM</span>
        <h1 id="tx-title">The people behind<br /><em>the system.</em></h1>
        <p>@Model.Count people, one bench and one orange tree. Scroll to meet the team one by one; stop to pause, scroll back to rewind.</p>
        <span class="tx-hint" aria-hidden="true">Scroll <i></i></span>
      </div>
      <ol class="tx-stages" aria-hidden="true">
        @for (var i = 0; i < Model.Count; i++) { <li>@((i + 1).ToString("00"))</li> }
        <li class="tx-stage-all">Team</li>
      </ol>
      <span class="tx-live sr-only" role="status" aria-live="polite"></span>
      <div class="tx-progress" aria-hidden="true"><i></i></div>
      <aside class="tx-member" aria-live="polite" aria-label="Team member profile" inert>
        <div class="tx-member-photo"><img alt="" hidden /><span class="tx-ph" aria-hidden="true"><b></b><small>Portrait pending</small></span></div>
        <div class="tx-member-copy">
          <span class="tx-member-idx"></span>
          <span class="tx-member-status"></span>
          <h3></h3>
          <p class="tx-member-role"></p>
          <p class="tx-member-text"></p>
          <button type="button" class="tx-member-open" aria-haspopup="dialog" aria-controls="tx-dialog">View full profile <span aria-hidden="true">&rarr;</span></button>
        </div>
      </aside>
      <div class="tx-reveal" id="team-reveal" inert>
        <div class="tx-reveal-head">
          <span class="tx-brand" aria-hidden="true"><span>orange</span></span>
          <div>
            <span class="tx-eyebrow">OUR TEAM</span>
            <h2>Great Ideas Start with<br /><em>Great People.</em></h2>
            @if (Model.Any(m => m.Placeholder))
            {
              <p class="tx-note">Profiles marked as awaiting verification are placeholders; the verified team details will replace them.</p>
            }
          </div>
        </div>
        @if (Model.Count > 0)
        {
          <ul class="tx-cards" aria-label="Team members">
            @for (var i = 0; i < Model.Count; i++)
            {
              var m = Model[i];
              var photo = !string.IsNullOrWhiteSpace(m.Image) && Url.IsLocalUrl(m.Image) ? Url.Content(m.Image) : "";
              <li>
                <button type="button" class="tx-card" aria-haspopup="dialog" aria-controls="tx-dialog"
                        data-index="@((i + 1).ToString("00"))" data-name="@m.FullName" data-role="@m.Role" data-contrib="@m.Contributions"
                        data-photo="@photo" data-placeholder="@(m.Placeholder ? "true" : "false")"
                        data-github="@(TeamMemberViewModel.ProfileUrl(m.GitHub) ?? "")" data-linkedin="@(TeamMemberViewModel.ProfileUrl(m.LinkedIn) ?? "")">
                  <span class="tx-card-photo">
                    @if (photo != "") { <img src="@photo" alt="" loading="lazy" width="400" height="500" /> }
                    else { <span class="tx-ph" aria-hidden="true"><b>@((i + 1).ToString("00"))</b><small>Portrait pending</small></span> }
                  </span>
                  <span class="tx-card-body">
                    <span class="tx-card-status">@(m.Placeholder ? "Awaiting verification" : "Project contributor")</span>
                    <strong>@m.FullName</strong>
                    <span class="tx-card-role">@m.Role</span>
                    <span class="tx-card-more">View profile <span aria-hidden="true">&rarr;</span></span>
                  </span>
                </button>
              </li>
            }
          </ul>
        }
      </div>
    </div>
  </section>
  <dialog class="tx-dialog" id="tx-dialog" aria-labelledby="tx-dlg-name">
    <div class="tx-dlg">
      <button type="button" class="tx-dlg-close" data-tx-close aria-label="Close profile">&times;</button>
      <div class="tx-dlg-photo"><img alt="" hidden /><span class="tx-ph" aria-hidden="true"><b></b><small>Portrait pending</small></span></div>
      <div class="tx-dlg-copy">
        <span class="tx-dlg-status tx-eyebrow"></span>
        <h2 class="tx-dlg-name" id="tx-dlg-name"></h2>
        <p class="tx-dlg-role"></p>
        <span class="tx-eyebrow tx-dlg-label">Responsibilities &amp; contributions</span>
        <p class="tx-dlg-text"></p>
        <div class="tx-dlg-links"></div>
      </div>
    </div>
  </dialog>
  <section class="page-shell public-next public-reveal"><span class="public-eyebrow">START A CONVERSATION</span><a asp-action="Contact">A question.<br /><em>A new connection.</em><span aria-hidden="true">↗</span></a></section>
</main>
@section Scripts {
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script>
    /* Same pinned version served locally when the CDN is unreachable. */
    (function () {
      if (window.gsap && window.ScrollTrigger) return;
      function add(src) { document.write('<script src="' + src + '"><\/script>'); }
      add('@Url.Content("~/js/vendor/gsap.min.js")');
      add('@Url.Content("~/js/vendor/ScrollTrigger.min.js")');
    })();
  </script>
  @* Emitted raw: the .NET importmap tag helper would replace this map with its own. *@
  @Html.Raw("<script type=\"importmap\">{ \"imports\": { \"three\": \"" + Url.Content("~/js/vendor/three/build/three.module.min.js") + "\" } }</script>")
  <script type="module" src="~/js/team-scene.js" asp-append-version="true"></script>
}
