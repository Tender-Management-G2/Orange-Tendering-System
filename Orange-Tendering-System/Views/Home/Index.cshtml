@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Home / Landing Page (cinematic, scroll-driven)

CONCEPT: "From Chaos to Control - The Art of Connected Procurement"
ROUTE: /      ACCESS: Anonymous
LAYOUT: _HomeLayout (only this page). Styles: wwwroot/css/home-cinema.css. Script: wwwroot/js/home-cinema.js.

DATA: The only dynamic content is ViewBag.Stats from HomeController.Index, which are aggregate
counts from SQL Server (no names, prices or documents). Everything else is illustrative and labelled so.
Nothing here calls an authenticated endpoint. Official reference: Sourcing.docx.
===========================================================
*@
@inject IWebHostEnvironment HostEnv
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Orange | From Request to Award. One Connected System.";
    var st = ViewBag.Stats as PublicStats;
    var hasData = st is not null && (st.ActiveTenders + st.ApprovedSuppliers + st.CompletedRequests + st.Closed + st.Bidding + st.Evaluation + st.Approvals) > 0;
}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
        <symbol id="i-pr" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></symbol>
        <symbol id="i-tender" viewBox="0 0 24 24"><path d="M4 9l12-5v16L4 15z"/><path d="M4 9v6M19 9.5a3 3 0 010 5"/></symbol>
        <symbol id="i-suppliers" viewBox="0 0 24 24"><path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-6h6v6M8 11h2M14 11h2"/></symbol>
        <symbol id="i-bids" viewBox="0 0 24 24"><path d="M3 12l9-9h8v8l-9 9z"/><circle cx="16" cy="8" r="1.4"/></symbol>
        <symbol id="i-compliance" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 5-5"/></symbol>
        <symbol id="i-ai" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4M10 12h4"/></symbol>
        <symbol id="i-committee" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6M15.5 14.4c3 .2 5.5 1.7 5.5 5.6"/></symbol>
        <symbol id="i-weights" viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></symbol>
        <symbol id="i-report" viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 17v-4M12 17v-7M15 17v-2"/></symbol>
        <symbol id="i-sign" viewBox="0 0 24 24"><path d="M4 20l1-4L16 5l3 3L8 19z"/><path d="M14 7l3 3M4 22h16"/></symbol>
        <symbol id="i-approve" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/></symbol>
        <symbol id="i-award" viewBox="0 0 24 24"><circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5L7 21l5-3 5 3-1.5-7.5"/></symbol>
        <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></symbol>
        <symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
        <symbol id="i-log" viewBox="0 0 24 24"><path d="M5 4h14v16H5z"/><path d="M8 9h8M8 13h8M8 17h5"/></symbol>
        <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 17V11a6 6 0 0112 0v6l2 2H4z"/><path d="M10 21h4"/></symbol>
        <symbol id="i-face" viewBox="0 0 24 24"><path d="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3"/><circle cx="12" cy="12" r="3.5"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V4M4 20h16M8 16v-5M12 16V8M16 16v-3"/></symbol>
    </defs>
</svg>

@* ============ 01-03  ORANGE HQ: procedural 3D reconstruction (wwwroot/js/home-hq3d.js, Three.js).
     Real geometry assembles on scroll under a moving 3D camera; panels are interactive HTML anchored in 3D. ============ *@
@{
    var hqPanels = new (string side, string floor, string icon, string name, string desc)[] {
        ("left", "f1", "i-pr", "Purchase Requests", "Departments submit items, quantities, specifications, priority and target date. Each request is reviewed and approved, returned or rejected."),
        ("right", "f1", "i-tender", "Tender Management", "The Sourcing Officer turns an approved request into a tender with terms, dates and committee-approved weights."),
        ("left", "f2", "i-suppliers", "Supplier Management", "Suppliers register with official documents. An Admin verifies each account before it can take part."),
        ("right", "f2", "i-bids", "Bidding", "Invited suppliers submit prices, technical details and documents before the deadline. Each supplier sees only its own offer."),
        ("left", "f3", "i-compliance", "Compliance", "Mandatory documents and requirements are checked and marked Compliant, Non-Compliant or Pending Clarification."),
        ("right", "f3", "i-ai", "AI Analysis", "Ollama-assisted analysis compares prices, delivery and missing items. It is advisory only: people decide."),
        ("left", "f4", "i-committee", "Technical & Financial Evaluation", "A four-member committee scores every offer; member scores are weighted and averaged into a recommendation."),
        ("right", "f4", "i-report", "Reports", "One unified Orange-branded report with scores, observations and the recommendation, signed by the four members."),
        ("left", "roof", "i-approve", "Approvals", "The Sourcing Manager approves, rejects or returns the report; the Top Committee decides when policy requires."),
        ("right", "roof", "i-award", "Award & Closure", "The decision reaches the Sourcing Officer, who notifies suppliers. The tender closes with a complete audit trail."),
    };
    var pi = 0;
}
<section class="hq" id="home" aria-labelledby="hc-h1">
    <div class="hq-stage hq3" id="hq-stage">
        <canvas class="hq3-canvas" id="hq3-canvas" role="img" aria-label="3D model of the Orange headquarters assembling floor by floor"></canvas>
        <svg class="hq3-lines" id="hq3-lines" aria-hidden="true" focusable="false"></svg>
        <ul class="hq3-panels" id="hq3-panels" aria-label="Procurement capabilities">
            @foreach (var p in hqPanels)
            {
                pi++;
                <li class="hq3-panel hq3-@p.side" data-side="@p.side" data-floor="@p.floor" data-stage="@pi">
                    <button type="button" aria-expanded="false" aria-controls="hq3-d@(pi)">
                        <span class="hq3-ic" aria-hidden="true"><svg><use href="#@p.icon" /></svg></span>
                        <span class="hq3-name">@p.name</span>
                    </button>
                    <p class="hq3-desc" id="hq3-d@(pi)">@p.desc</p>
                </li>
            }
        </ul>
        @* Curved corridor behind the entrance: seven module tiles on the wall; reaching a tile opens its popup.
           A module timeline runs along the bottom, and the overview video wall stands at the end
           (it plays only if wwwroot/media/company-overview.mp4 exists). *@
        @{
            var hqModules = new (string icon, string name, string kicker, string anchor, string text, string[] items)[] {
                ("i-pr", "Sourcing", "Where every purchase starts", "how-it-works",
                    "Departments raise purchase requests; the Sourcing Officer reviews each one and turns approved requests into tenders.",
                    new[] { "Purchase requests with items, quantities and specifications", "Approve, return for changes or reject, with a reason", "Live status for the requesting department", "Clarifications between the department and the Sourcing Officer" }),
                ("i-tender", "Tender Management", "One lifecycle, fully traceable", "platform",
                    "The Sourcing Officer builds the tender, the committee agrees its weights, and bidding opens on a fixed schedule.",
                    new[] { "Tender terms, documents, opening date and deadline", "Weights proposed by the committee and approved before bidding", "Supplier invitations and supplier questions", "Submissions tracked round by round until the deadline" }),
                ("i-suppliers", "Supplier Management", "A verified supplier base", "suppliers",
                    "Suppliers register with their official documents and join tenders through their own portal once an administrator verifies them.",
                    new[] { "Registration with commercial documents", "Administrator verification before activation", "Accept or decline each tender invitation", "Every supplier sees only its own offers and messages" }),
                ("i-committee", "Evaluation & Scoring", "Four independent evaluations", "evaluation",
                    "Offers that pass compliance screening are scored separately by each of the four committee members.",
                    new[] { "Compliance screening of every offer", "Financial and technical score out of 100 per offer", "Each member scores independently", "Scores are recalculated on the server, never taken from the browser" }),
                ("i-ai", "AI Analysis", "Assistance, not a decision", "analysis",
                    "A locally hosted Ollama model reads the offers and their documents and prepares an evidence-based briefing for the reviewers.",
                    new[] { "Financial, technical and delivery comparison", "Missing information, strengths and weaknesses", "Every claim cites its offer, document and uncertainty", "May suggest a compliant supplier, clearly marked advisory", "Never sets weights or scores, and never approves or awards" }),
                ("i-weights", "Weights Calculation", "How the final score is built", "evaluation",
                    "", new string[0]),
                ("i-report", "Reporting", "From ranking to decision", "reports",
                    "One report carries the ranking through signatures and approvals to the final decision.",
                    new[] { "Unified Orange-branded PDF report", "Signed by all four committee members", "Sourcing Manager and, when policy requires, Top Committee decisions", "The Sourcing Officer notifies the suppliers of the outcome" })
            };
        }
        <div class="hq3-corridor-ui" id="hq3-corridor-ui">
            <div class="hq3-tiles" id="hq3-tiles">
                @foreach (var m in hqModules)
                {
                    <button type="button" class="hq3-tile" aria-label="Show @m.name"><span class="hq3-tile-ic" aria-hidden="true"><svg><use href="#@m.icon" /></svg></span><b>@m.name</b><i aria-hidden="true">&rarr;</i></button>
                }
            </div>
            <div class="hq3-video" id="hq3-video">
                <video data-src="@Url.Content("~/media/company-overview.mp4")" data-available="@(System.IO.File.Exists(System.IO.Path.Combine(HostEnv.WebRootPath, "media", "company-overview.mp4")) ? "true" : "false")" controls playsinline preload="none" aria-label="Orange company overview video"></video>
                <div class="hq3-video-title"><span class="hq3-video-logo">orange</span><h3>Orange<br />Company Overview</h3><p>Sourcing &amp; Tender Management System</p></div>
            </div>
            <aside class="hq3-info" id="hq3-info" aria-live="polite" aria-label="Module details">
                <button type="button" class="hq3-info-close" id="hq3-info-close" aria-label="Close module details">&times;</button>
                @for (var mi = 0; mi < hqModules.Length; mi++)
                {
                    var m = hqModules[mi];
                    <div class="hq3-mod@(m.icon == "i-weights" ? " hq3-mod-calc" : "")" hidden>
                        <div class="hq3-mod-head">
                            <span class="hq3-mod-ic" aria-hidden="true"><svg><use href="#@m.icon" /></svg></span>
                            <div><span class="hq3-mod-num">@((mi + 1).ToString("00")) / @hqModules.Length.ToString("00")</span><span class="hq3-mod-kicker">@m.kicker</span></div>
                        </div>
                        <h3>@m.name</h3>
                        @if (m.icon == "i-weights")
                        {
                            <ol class="hq3-calc">
                                <li><b>Agree the weights</b><span>Each of the four committee members proposes a Financial % and a Technical %; each proposal must total exactly 100%.</span></li>
                                <li><b>Average and approve</b><span>The four proposals are averaged, approved by the authorised approver and locked before scoring.</span></li>
                                <li><b>Score each offer</b><span>Every member gives each offer a Financial and a Technical score out of 100.</span></li>
                                <li><b>Combine</b><span class="hq3-formula">Member score = (Financial &times; W<sub>F</sub> + Technical &times; W<sub>T</sub>) &divide; 100</span></li>
                                <li><b>Average and rank</b><span>Final score = average of the four member scores. Offers are ranked from highest to lowest; ties are flagged, never broken silently.</span></li>
                            </ol>
                            <div class="hq3-example" aria-label="Worked example">
                                <span>Example &middot; weights 40% / 60%</span>
                                <p>Financial 80, Technical 90 &rarr; (80 &times; 40 + 90 &times; 60) &divide; 100 = <b>86</b></p>
                            </div>
                        }
                        else
                        {
                            <p>@m.text</p>
                            <ul>@foreach (var it in m.items) { <li>@it</li> }</ul>
                        }
                        <a class="hq-cta" href="#@m.anchor">Explore @m.name <span aria-hidden="true">&rarr;</span></a>
                    </div>
                }
            </aside>
            <nav class="hq3-steps" id="hq3-steps" aria-label="Corridor modules">
                @foreach (var m in hqModules)
                {
                    <button type="button" aria-label="Go to @m.name"><span aria-hidden="true"><svg><use href="#@m.icon" /></svg></span><em>@m.name</em></button>
                }
            </nav>
        </div>
        <div class="hq3-flash" id="hq3-flash" aria-hidden="true"></div>
        <div class="hq-shade" id="hq-shade" aria-hidden="true"></div>

        <div class="hq-copy" id="hq-copy">
            <p class="hq-eyebrow">Sourcing &amp; Tender Management</p>
            <h1 id="hc-h1">From Procurement Complexity to <em>One Unified Platform</em></h1>
            <p class="hq-lead">Orange's intelligent sourcing and tender management platform connects suppliers, evaluations, approvals and procurement workflows in one secure digital experience.</p>
            <div class="hq-actions">
                <a class="hq-cta" href="#how-it-works">Explore the Platform <span aria-hidden="true">&rarr;</span></a>
                <a class="hq-play" href="#platform" data-see-action><span class="hq-play-i" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 7l8 5-8 5z" /></svg></span>See It in Action</a>
            </div>
            <p class="hq-account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Workspace" asp-action="Index">Open My Workspace &rarr;</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login">Login</a><span aria-hidden="true">/</span><a asp-area="Identity" asp-page="/Account/Register">Supplier Registration</a>
                }
            </p>
        </div>

        <div class="hq-stagebar" aria-hidden="true">
            <div class="hq-label" id="hq-label"><b>00</b><span>Scroll to assemble the headquarters</span></div>
            <div class="hq-progress"><i id="hq-progress"></i></div>
        </div>
        <div class="hq3-cap" id="hq3-cap" aria-live="polite"></div>
        <div class="hq-fade" id="hq-fade" aria-hidden="true"></div>
    </div>
</section>

@* ============ 09  WORKSPACES ============ *@
<section class="hc-sec hc-sec-alt" id="platform" aria-labelledby="hc-ws-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Inside the platform</p>
            <h2 id="hc-ws-h">A workspace for <em>each role.</em></h2>
            <p class="hc-lead">Navigation below follows the real workspaces. Contents are blurred placeholders, not live data.</p>
        </div>
        <p class="hc-banner hc-reveal">Demo representation of the interface. Sign in to use the real workspaces.</p>
        <div class="hc-ws hc-reveal" id="hc-ws">
            <div class="hc-ws-tabs" role="tablist" aria-label="Workspace previews">
                <button type="button" role="tab" id="wt-officer" aria-controls="wp-officer" data-ws="officer">Sourcing Officer Workspace</button>
                <button type="button" role="tab" id="wt-supplier" aria-controls="wp-supplier" data-ws="supplier">Supplier Portal</button>
                <button type="button" role="tab" id="wt-committee" aria-controls="wp-committee" data-ws="committee">Evaluation Committee Workspace</button>
                <button type="button" role="tab" id="wt-manager" aria-controls="wp-manager" data-ws="manager">Manager Review</button>
                <button type="button" role="tab" id="wt-top" aria-controls="wp-top" data-ws="top">Top Committee Decisions</button>
            </div>
            @{
                var ws = new (string id, string title, string[] nav, string active, string heading, string[] cards)[] {
                    ("officer","Sourcing Officer",new[]{"Dashboard","Requests","Tenders","Received Bids","Reports","Final Decisions","Clarifications"},"Tenders","Tenders",new[]{"Draft tenders","Bidding","Under evaluation"}),
                    ("supplier","Supplier Portal",new[]{"Dashboard","Invitations","Weighted Tenders","My Offers","Documents","Profile","Clarifications"},"My Offers","My Offers",new[]{"Submitted offers","Documents","Invitations"}),
                    ("committee","Evaluation Committee",new[]{"Dashboard","Assigned Evaluations"},"Assigned Evaluations","Assigned Evaluations",new[]{"Weight proposal","Technical scores","Financial scores"}),
                    ("manager","Sourcing Manager",new[]{"Dashboard","Pending Reports","Final Decisions","Decision History","Analytics & Exports"},"Pending Reports","Pending Reports",new[]{"Approve","Reject","Return with comments"}),
                    ("top","Top Committee",new[]{"Dashboard","Evaluation Summary","Voting","Decision History","Management Statistics","Analytics & Exports"},"Voting","Voting",new[]{"Consolidated report","Manager recommendation","Decision and notes"})
                };
            }
            @foreach (var w in ws)
            {
                <div class="hc-ws-panel" id="wp-@w.id" role="tabpanel" aria-labelledby="wt-@w.id" tabindex="0" hidden>
                    <div class="hc-app">
                        <aside><b class="hc-app-brand">orange</b><small>@w.title</small>
                            @foreach (var item in w.nav) { <span class="@(item == w.active ? "on" : null)">@item</span> }
                        </aside>
                        <section><h4>@w.heading</h4>
                            <div class="hc-app-cards">
                                @foreach (var c in w.cards) { <div><small>@c</small><i></i><i></i></div> }
                            </div>
                            <div class="hc-app-table"><i></i><i></i><i></i><i></i></div>
                        </section>
                    </div>
                </div>
            }
        </div>
    </div>
</section>


@* ============ HOW IT WORKS: NINE STAGES ============ *@
<section class="hc-steps-sec" id="how-it-works" aria-labelledby="hc-steps-h">
    <div class="hc-wrap">
        <p class="hc-eyebrow"><span></span>How it works</p>
        <h2 id="hc-steps-h">Nine stages. One governed path.</h2>
        <ol class="hc-steps" id="hc-steps">
            <li data-stage="1"><span class="hc-step-n">01</span><div><h3>Purchase Request</h3><p>A requesting department states what it needs: items, quantities, specifications, priority and target date. The request is reviewed and approved, returned for changes or rejected.</p><ul class="hc-chips"><li>Purchase Request</li></ul></div></li>
            <li data-stage="2"><span class="hc-step-n">02</span><div><h3>Tender Creation</h3><p>The Sourcing Officer turns an approved request into a tender with terms and dates. The four committee members propose financial and technical weights, and the Officer approves their average before bidding opens.</p><ul class="hc-chips"><li>Tender</li></ul></div></li>
            <li data-stage="3"><span class="hc-step-n">03</span><div><h3>Supplier Invitations &amp; Bidding</h3><p>Selected suppliers are invited and submit prices, technical details and documents before the deadline. Each supplier sees only its own offer.</p><ul class="hc-chips"><li>Suppliers</li><li>Bids</li></ul></div></li>
            <li data-stage="4"><span class="hc-step-n">04</span><div><h3>Compliance &amp; AI Analysis</h3><p>Mandatory documents and requirements are checked and marked Compliant, Non-Compliant or Pending Clarification. Ollama-assisted analysis adds advisory insight; people decide.</p><ul class="hc-chips"><li>Compliance</li><li>AI Analysis</li></ul></div></li>
            <li data-stage="5"><span class="hc-step-n">05</span><div><h3>Technical &amp; Financial Evaluation</h3><p>A four-member Evaluation Committee scores every offer against the technical and financial criteria and records its observations.</p><ul class="hc-chips"><li>Evaluation Committee</li></ul></div></li>
            <li data-stage="6"><span class="hc-step-n">06</span><div><h3>Weighted Scoring &amp; Results</h3><p>Each member's scores are combined with the approved weights, and the final supplier score is the average of the four member scores. Scores are recommendations, not automatic awards.</p><ul class="hc-chips"><li>Financial &amp; Technical Weights</li></ul></div></li>
            <li data-stage="7"><span class="hc-step-n">07</span><div><h3>Reports &amp; Signatures</h3><p>One unified Orange-branded report carries scores, observations and the recommendation. The four committee members sign it.</p><ul class="hc-chips"><li>Unified Report</li><li>Signatures</li></ul></div></li>
            <li data-stage="8"><span class="hc-step-n">08</span><div><h3>Manager &amp; Top Committee Approvals</h3><p>The Sourcing Manager approves, rejects or returns the report with comments. When policy requires it, the Top Committee takes the final collective decision.</p><ul class="hc-chips"><li>Approvals</li></ul></div></li>
            <li data-stage="9"><span class="hc-step-n">09</span><div><h3>Award &amp; Closure</h3><p>The decision is relayed to the Sourcing Officer, who notifies suppliers. The tender closes with a complete audit trail.</p><ul class="hc-chips"><li>Final Award</li></ul></div></li>
        </ol>
        <p class="hc-more"><a class="hc-btn hc-btn-ghost" asp-area="" asp-controller="Home" asp-action="HowItWorks">Read the full workflow <span aria-hidden="true">&rarr;</span></a></p>
    </div>
</section>


@* ============ 03  ROLES NETWORK ============ *@
<section class="hc-sec" id="roles" aria-labelledby="hc-roles-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Seven roles</p>
            <h2 id="hc-roles-h">Everyone has a seat. <em>No one has every key.</em></h2>
            <p class="hc-lead">Select a role to see its responsibilities and the only connections it is authorised to have. Access is role-based and enforced on the server.</p>
        </div>
        <div class="hc-roles hc-reveal" id="hc-roles">
            <div class="hc-role-pick" role="tablist" aria-label="System roles" aria-orientation="vertical">
                <button type="button" role="tab" id="rt-admin" aria-controls="rp-admin" data-role="admin">Admin</button>
                <button type="button" role="tab" id="rt-dept" aria-controls="rp-dept" data-role="dept">Requesting Department</button>
                <button type="button" role="tab" id="rt-officer" aria-controls="rp-officer" data-role="officer">Sourcing Officer</button>
                <button type="button" role="tab" id="rt-supplier" aria-controls="rp-supplier" data-role="supplier">Supplier</button>
                <button type="button" role="tab" id="rt-committee" aria-controls="rp-committee" data-role="committee">Technical &amp; Financial Evaluation Committee</button>
                <button type="button" role="tab" id="rt-manager" aria-controls="rp-manager" data-role="manager">Sourcing Manager</button>
                <button type="button" role="tab" id="rt-top" aria-controls="rp-top" data-role="top">Top Committee</button>
            </div>
            <div class="hc-net" aria-hidden="true">
                <svg viewBox="0 0 800 560" class="hc-net-lines" focusable="false">
                    <g fill="none" stroke-linecap="round">
                        <path class="adm" data-a="admin" data-b="dept" d="M110 80 Q 40 190 100 300"/>
                        <path class="adm" data-a="admin" data-b="officer" d="M110 80 Q 200 150 360 300"/>
                        <path class="adm" data-a="admin" data-b="supplier" d="M110 80 Q 20 330 360 500"/>
                        <path class="adm" data-a="admin" data-b="committee" d="M110 80 Q 420 130 620 400"/>
                        <path class="adm" data-a="admin" data-b="manager" d="M110 80 Q 460 70 700 250"/>
                        <path class="adm" data-a="admin" data-b="top" d="M110 80 Q 340 40 600 90"/>
                        <path class="ch" data-a="dept" data-b="officer" d="M100 300 L360 300"/>
                        <path class="ch" data-a="officer" data-b="supplier" d="M360 300 L360 500"/>
                        <path class="ch" data-a="officer" data-b="committee" d="M360 300 L620 400"/>
                        <path class="ch" data-a="committee" data-b="manager" d="M620 400 L700 250"/>
                        <path class="ch" data-a="manager" data-b="top" d="M700 250 L600 90"/>
                    </g>
                </svg>
                <button type="button" class="hc-node" data-role="admin" style="--nx:13.75%;--ny:14.3%" tabindex="-1"><i>AD</i><span>Admin</span></button>
                <button type="button" class="hc-node" data-role="dept" style="--nx:12.5%;--ny:53.6%" tabindex="-1"><i>RD</i><span>Requesting Department</span></button>
                <button type="button" class="hc-node hc-node-lg" data-role="officer" style="--nx:45%;--ny:53.6%" tabindex="-1"><i>SO</i><span>Sourcing Officer</span></button>
                <button type="button" class="hc-node" data-role="supplier" style="--nx:45%;--ny:89.3%" tabindex="-1"><i>SU</i><span>Supplier</span></button>
                <button type="button" class="hc-node" data-role="committee" style="--nx:77.5%;--ny:71.4%" tabindex="-1"><i>EC</i><span>Evaluation Committee</span></button>
                <button type="button" class="hc-node" data-role="manager" style="--nx:87.5%;--ny:44.6%" tabindex="-1"><i>SM</i><span>Sourcing Manager</span></button>
                <button type="button" class="hc-node" data-role="top" style="--nx:75%;--ny:16.1%" tabindex="-1"><i>TC</i><span>Top Committee</span></button>
                <p class="hc-legend"><i class="l-ch"></i>Authorised channel <i class="l-adm"></i>Administration only</p>
            </div>
            <div class="hc-panels" aria-live="polite">
                <div class="hc-panel" id="rp-admin" role="tabpanel" aria-labelledby="rt-admin" tabindex="0" hidden>
                    <h3>Admin</h3><p class="hc-sum">Configures the system, accounts and master data. Not involved in technical or financial evaluations.</p>
                    <ul><li>Dashboard of users, suppliers, departments, requests and tenders.</li><li>Creates, edits, enables or disables accounts and sets roles.</li><li>Reviews supplier registrations, legal documents, tax numbers and licences, then sets Pending, Approved, Rejected or Suspended with a reason.</li></ul>
                    <p class="hc-conn"><b>Connections:</b> administrative only (accounts, departments, supplier verification). No tender communication channel.</p>
                </div>
                <div class="hc-panel" id="rp-dept" role="tabpanel" aria-labelledby="rt-dept" tabindex="0" hidden>
                    <h3>Requesting Department</h3><p class="hc-sum">The internal teams that need products or services, such as IT or HR.</p>
                    <ul><li>Creates purchase requests with reason, priority, target date, items, quantities and specifications.</li><li>Tracks request history and review notes.</li><li>A Department Representative is one of the four Evaluation Committee members.</li></ul>
                    <p class="hc-conn"><b>Connections:</b> Sourcing Officer (clarification channel).</p>
                </div>
                <div class="hc-panel" id="rp-officer" role="tabpanel" aria-labelledby="rt-officer" tabindex="0" hidden>
                    <h3>Sourcing Officer</h3><p class="hc-sum">Manages the tender lifecycle from approved request to supplier notification.</p>
                    <ul><li>Creates tenders, sets dates and terms, selects and invites suppliers.</li><li>Approves the committee's averaged weights before bidding opens.</li><li>Reviews and compares offers and runs the compliance check.</li><li>Tracks the evaluation, sends the unified report for signing and notifies suppliers of the final decision.</li></ul>
                    <p class="hc-conn"><b>Connections:</b> Requesting Department, Supplier, Evaluation Committee.</p>
                </div>
                <div class="hc-panel" id="rp-supplier" role="tabpanel" aria-labelledby="rt-supplier" tabindex="0" hidden>
                    <h3>Supplier</h3><p class="hc-sum">An external vendor taking part in tenders. Suppliers cannot see competing offers.</p>
                    <ul><li>Registers with company details and official documents; an Admin verifies the account before activation.</li><li>Views invitations and accepts or declines participation.</li><li>Submits pricing, delivery time, technical details and documents, and tracks its own offers.</li></ul>
                    <p class="hc-conn"><b>Connections:</b> Sourcing Officer only (missing documents and offer clarifications).</p>
                </div>
                <div class="hc-panel" id="rp-committee" role="tabpanel" aria-labelledby="rt-committee" tabindex="0" hidden>
                    <h3>Technical &amp; Financial Evaluation Committee</h3><p class="hc-sum">Four members: the Sourcing Manager, a Department Representative, a Financial Representative and a Technical Representative.</p>
                    <ul><li>Each member proposes financial and technical weights; the Officer approves their average.</li><li>Scores every offer technically and financially and documents observations and non-compliance.</li><li>Produces one unified report with the final result and a substantiated recommendation, signed by the four members.</li></ul>
                    <p class="hc-conn"><b>Connections:</b> Sourcing Officer, Sourcing Manager.</p>
                </div>
                <div class="hc-panel" id="rp-manager" role="tabpanel" aria-labelledby="rt-manager" tabindex="0" hidden>
                    <h3>Sourcing Manager</h3><p class="hc-sum">Sits on the Evaluation Committee, and separately reviews the finished report.</p>
                    <ul><li>As a committee member, scores and signs like the other three members.</li><li>In the separate report-approval responsibility, approves, rejects or returns the unified report with comments.</li><li>Forwards the tender to the Top Committee when policy requires.</li></ul>
                    <p class="hc-conn"><b>Connections:</b> Evaluation Committee, Top Committee.</p>
                </div>
                <div class="hc-panel" id="rp-top" role="tabpanel" aria-labelledby="rt-top" tabindex="0" hidden>
                    <h3>Top Committee</h3><p class="hc-sum">A separate four-member body: the final authority for high-value or critical tenders.</p>
                    <ul><li>Reviews requisitions, bids, the consolidated report and the Sourcing Manager's recommendation, including AI analysis where available.</li><li>Selects a supplier or asks for further details, recording notes and justification.</li><li>Keeps access to past tenders and their decisions.</li></ul>
                    <p class="hc-conn"><b>Connections:</b> Sourcing Manager.</p>
                </div>
            </div>
        </div>
    </div>
</section>


@* ============ 04  GOVERNED COMMUNICATION ============ *@
<section class="hc-sec hc-sec-alt" id="clarifications" aria-labelledby="hc-comm-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Governed communication</p>
            <h2 id="hc-comm-h">Five channels. <em>Nothing else.</em></h2>
            <p class="hc-lead">Clarification requests are limited to the people directly involved in the process. Illustrative view only; no real messages are shown.</p>
        </div>
        <div class="hc-comm hc-reveal" id="hc-comm">
            <div class="hc-chain" aria-hidden="true">
                <div class="hc-cn" data-n="dept" style="grid-area:1/1">Requesting<br>Department</div>
                <i class="hc-cl" data-c="1" style="grid-area:1/2"></i>
                <div class="hc-cn" data-n="officer" style="grid-area:1/3">Sourcing<br>Officer</div>
                <i class="hc-cl" data-c="3" style="grid-area:1/4"></i>
                <div class="hc-cn" data-n="committee" style="grid-area:1/5">Evaluation<br>Committee</div>
                <i class="hc-cl" data-c="4" style="grid-area:1/6"></i>
                <div class="hc-cn" data-n="manager" style="grid-area:1/7">Sourcing<br>Manager</div>
                <i class="hc-cl" data-c="5" style="grid-area:1/8"></i>
                <div class="hc-cn" data-n="top" style="grid-area:1/9">Top<br>Committee</div>
                <i class="hc-cl hc-cl-v" data-c="2" style="grid-area:2/3"></i>
                <div class="hc-cn" data-n="supplier" style="grid-area:3/3">Supplier</div>
            </div>
            <div class="hc-chan-list" role="list">
                <button type="button" role="listitem" class="hc-chan" data-c="1" data-a="dept" data-b="officer" data-purpose="Clarify purchase requests: specifications, quantities and required changes."><span>Requesting Department</span><b aria-hidden="true">&harr;</b><span>Sourcing Officer</span></button>
                <button type="button" role="listitem" class="hc-chan" data-c="2" data-a="officer" data-b="supplier" data-purpose="Request missing documents or clarification about a submitted offer, and receive the response."><span>Sourcing Officer</span><b aria-hidden="true">&harr;</b><span>Supplier</span></button>
                <button type="button" role="listitem" class="hc-chan" data-c="3" data-a="officer" data-b="committee" data-purpose="Clarify submitted offers, documents and evaluation results."><span>Sourcing Officer</span><b aria-hidden="true">&harr;</b><span>Evaluation Committee</span></button>
                <button type="button" role="listitem" class="hc-chan" data-c="4" data-a="committee" data-b="manager" data-purpose="Discuss evaluation results, the combined evaluation report and recommendations."><span>Evaluation Committee</span><b aria-hidden="true">&harr;</b><span>Sourcing Manager</span></button>
                <button type="button" role="listitem" class="hc-chan" data-c="5" data-a="manager" data-b="top" data-purpose="Clarify reports, recommendations and final decisions."><span>Sourcing Manager</span><b aria-hidden="true">&harr;</b><span>Top Committee</span></button>
            </div>
            <div class="hc-chan-detail" aria-live="polite">
                <p class="hc-tag">Illustrative</p>
                <h3 id="hc-chan-title">Select a channel</h3>
                <p id="hc-chan-purpose">Hover, focus or select a channel to see what it exists for.</p>
                <div class="hc-states" id="hc-states" role="group" aria-label="Clarification status (illustrative)">
                    <button type="button" data-s="0" aria-pressed="true">Pending</button>
                    <button type="button" data-s="1" aria-pressed="false">Answered</button>
                    <button type="button" data-s="2" aria-pressed="false">Resolved</button>
                </div>
                <p class="hc-note" id="hc-state-note">Pending: a clarification request was sent and is waiting for a response.</p>
            </div>
        </div>
    </div>
</section>


@* ============ SUPPLIER PARTICIPATION ============ *@
<section class="hc-sec" id="suppliers" aria-labelledby="hc-sup-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Supplier participation</p>
            <h2 id="hc-sup-h">A fair seat at every tender. <em>Your offer stays yours.</em></h2>
            <p class="hc-lead">External suppliers take part through their own portal. Competing suppliers never see each other's offers.</p>
        </div>
        <ol class="hc-path">
            <li class="hc-reveal"><span>01</span><h3>Register</h3><p>Submit company details, tax and registration numbers, contact information and official documents.</p></li>
            <li class="hc-reveal"><span>02</span><h3>Admin verification</h3><p>An Admin reviews the application and sets it to Approved, Rejected, Suspended or Pending with a reason.</p></li>
            <li class="hc-reveal"><span>03</span><h3>Invitations</h3><p>Invited suppliers accept or decline participation in a tender.</p></li>
            <li class="hc-reveal"><span>04</span><h3>Submit an offer</h3><p>Enter pricing, delivery time and technical details, and upload documents before the deadline.</p></li>
            <li class="hc-reveal"><span>05</span><h3>Clarifications</h3><p>The Sourcing Officer may request missing documents or clarification; the supplier answers in the same channel.</p></li>
            <li class="hc-reveal"><span>06</span><h3>Decision</h3><p>After approval, the Sourcing Officer notifies suppliers of the outcome. Suppliers can track their own offers.</p></li>
        </ol>
        <p class="hc-actions hc-reveal">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="hc-btn hc-btn-solid" asp-area="Identity" asp-page="/Account/Register">Supplier Registration</a>
            }
        </p>
    </div>
</section>

@* ============ 05  WEIGHTED EVALUATION DEMO ============ *@
<section class="hc-sec hc-sec-alt" id="evaluation" aria-labelledby="hc-eval-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Weighted evaluation</p>
            <h2 id="hc-eval-h">Weights agreed first. <em>Scores computed openly.</em></h2>
            <p class="hc-lead">Four members propose weights, the Sourcing Officer approves their average, then every member scores each supplier. Move the sliders to see the live result.</p>
        </div>
        <p class="hc-banner hc-reveal">Illustrative values only. Nothing here is real data and no supplier is named.</p>
        <noscript><p class="hc-banner">The interactive demo needs JavaScript.</p></noscript>
        <div class="hc-eval hc-reveal" id="hc-eval">
            <div class="hc-eval-col">
                <h3><span>1</span>Committee weight proposals</h3>
                <div id="hc-props" class="hc-props"></div>
                <div class="hc-avg" aria-live="polite">
                    <div><small>Average of proposals</small><strong id="hc-avg-txt">50% / 50%</strong></div>
                    <div><small>Approved by the Sourcing Officer</small><strong id="hc-appr-txt">50% / 50%</strong></div>
                </div>
                <div class="hc-wbar" aria-hidden="true"><i id="hc-wbar-f"></i><i id="hc-wbar-t"></i></div>
                <p class="hc-note"><b class="o">Financial</b> and <b class="g">Technical</b> approved weights always total 100%.</p>
            </div>
            <div class="hc-eval-col">
                <h3><span>2</span>Member scores</h3>
                <div class="hc-sup-tabs" role="tablist" aria-label="Supplier to score (illustrative)" id="hc-sup-tabs"></div>
                <div id="hc-scores" class="hc-scores"></div>
            </div>
            <div class="hc-eval-col">
                <h3><span>3</span>Live result</h3>
                <div id="hc-rank" class="hc-rank" aria-live="polite"></div>
                <div class="hc-formula">
                    <code>MemberScore = (Financial &times; FinancialWeight + Technical &times; TechnicalWeight) / 100</code>
                    <code>FinalSupplierScore = average of the four member scores</code>
                </div>
                <p class="hc-note">Scores are recommendations for the committee and managers. They are not an automatic award.</p>
            </div>
        </div>
    </div>
</section>


@* ============ 06  AI + COMPLIANCE ============ *@
<section class="hc-sec" id="analysis" aria-labelledby="hc-ai-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Compliance &amp; AI</p>
            <h2 id="hc-ai-h">AI Informs. <em>People Decide.</em></h2>
            <p class="hc-lead">Every bid passes a compliance screening and an advisory analysis. Neither one awards anything.</p>
        </div>
        <p class="hc-banner hc-reveal">Illustrative walkthrough. No live data and no live AI call is made from this page.</p>
        <div class="hc-split hc-reveal" id="hc-split">
            <div class="hc-doc" id="hc-doc" aria-hidden="true"><i></i><i></i><i></i><b>BID</b></div>
            <article class="hc-pane">
                <header><span class="hc-ic"><svg aria-hidden="true"><use href="#i-compliance"/></svg></span><div><h3>Compliance screening</h3><small>Mandatory requirements, checked by people</small></div></header>
                <ul class="hc-checks">
                    <li data-st="ok"><span>Mandatory documents</span><em>Compliant</em></li>
                    <li data-st="ok"><span>Technical requirements</span><em>Compliant</em></li>
                    <li data-st="wait"><span>Eligibility evidence</span><em>Pending Clarification</em></li>
                    <li data-st="bad"><span>Offer validity period</span><em>Non-Compliant</em></li>
                </ul>
                <p class="hc-note">Non-compliance must be logged with a clear reason.</p>
            </article>
            <article class="hc-pane hc-pane-ai">
                <header><span class="hc-ic"><svg aria-hidden="true"><use href="#i-ai"/></svg></span><div><h3>Ollama-assisted bid analysis</h3><small>Advisory insights for reviewers</small></div></header>
                <div class="hc-ai-grid">
                    <div><small>Price comparison</small><div class="hc-mini"><i style="--w:92%"></i><i style="--w:74%"></i><i style="--w:61%"></i></div></div>
                    <div><small>Delivery observations</small><p>Delivery times differ between offers and are flagged for reviewers.</p></div>
                    <div><small>Missing requirements</small><p>Lists documents or specifications it could not find.</p></div>
                    <div><small>Advisory insight</small><p>Highlights strengths and weaknesses for the committee to weigh.</p></div>
                </div>
                <p class="hc-note">The output is an assistant tool and never replaces a committee decision.</p>
            </article>
            <p class="hc-ai-msg" id="hc-ai-msg">AI Informs. People Decide.</p>
        </div>
    </div>
</section>


@* ============ 07  REPORTS ============ *@
<section class="hc-sec hc-sec-alt" id="reports" aria-labelledby="hc-rep-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Reports &amp; signatures</p>
            <h2 id="hc-rep-h">One report. <em>Four signatures.</em></h2>
            <p class="hc-lead">Evaluation data assembles into a single Orange-branded PDF. The decision then travels up the chain, and back down in a fixed order.</p>
        </div>
        <div class="hc-rep" id="hc-rep">
            <div class="hc-pdf" aria-label="Illustrative unified report">
                <div class="hc-pdf-top"><b>orange</b><span>Unified Evaluation Report</span></div>
                <div class="hc-pdf-body">
                    <div class="hc-frag" data-f="1"><small>Tender summary</small><i></i><i></i></div>
                    <div class="hc-frag" data-f="2"><small>Approved weights</small><i class="w"></i></div>
                    <div class="hc-frag" data-f="3"><small>Supplier scores</small><span class="hc-bars"><i style="--w:88%"></i><i style="--w:72%"></i><i style="--w:55%"></i></span></div>
                    <div class="hc-frag" data-f="4"><small>Recommendation</small><i></i><i></i></div>
                    <div class="hc-sigs" data-f="5"><span><u></u>Signature 1</span><span><u></u>Signature 2</span><span><u></u>Signature 3</span><span><u></u>Signature 4</span></div>
                </div>
                <p class="hc-pdf-note">Illustrative layout</p>
            </div>
            <ol class="hc-tl" id="hc-tl">
                <li>Evaluation completed</li>
                <li>Scores consolidated</li>
                <li>Report generated</li>
                <li>Four committee signatures</li>
                <li>Sourcing Manager decision</li>
                <li>Top Committee approval <small>when applicable</small></li>
                <li>Final decision relayed to the Sourcing Officer</li>
                <li>Sourcing Officer notifies suppliers</li>
            </ol>
        </div>
        <div class="hc-notify hc-reveal" id="hc-notify">
            <h3>Notification order</h3>
            <ol>
                <li>Top Committee</li><li>Sourcing Manager</li><li>Sourcing Officer</li><li>Suppliers</li>
            </ol>
            <p><b>Approval does not notify suppliers by itself.</b> The Sourcing Officer receives the final decision and then notifies suppliers.</p>
        </div>
    </div>
</section>


<section class="hc-sec" id="governance" aria-labelledby="hc-gov-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Security &amp; governance</p>
            <h2 id="hc-gov-h">Control is built in, <em>not bolted on.</em></h2>
        </div>
        <div class="hc-grid3">
            <article class="hc-reveal"><svg aria-hidden="true"><use href="#i-lock"/></svg><h3>Role-based access</h3><p>Each user only reaches the pages and actions their role allows, enforced on the server.</p></article>
            <article class="hc-reveal"><svg aria-hidden="true"><use href="#i-eye"/></svg><h3>Supplier isolation</h3><p>Suppliers see only their own offers and records, never a competitor's.</p></article>
            <article class="hc-reveal"><svg aria-hidden="true"><use href="#i-log"/></svg><h3>Audit trail</h3><p>Offers, scores, signatures and approvals are logged for later review.</p></article>
            <article class="hc-reveal"><svg aria-hidden="true"><use href="#i-weights"/></svg><h3>Locked weights</h3><p>Evaluation weights are approved before bidding opens, so the rules cannot shift after offers arrive.</p></article>
            <article class="hc-reveal"><svg aria-hidden="true"><use href="#i-face"/></svg><h3>Biometric sign-in</h3><p>Face and fingerprint verification can be linked to a registered account.</p></article>
            <article class="hc-reveal"><svg aria-hidden="true"><use href="#i-ai"/></svg><h3>Human decisions</h3><p>AI analysis is advisory. Awards are decided by committees and managers.</p></article>
        </div>
    </div>
</section>


<section class="hc-sec hc-sec-alt" id="about" aria-labelledby="hc-about-h">
    <div class="hc-wrap hc-two">
        <div class="hc-reveal">
            <p class="hc-eyebrow"><span></span>About Orange Sourcing</p>
            <h2 id="hc-about-h">Paperwork, scattered emails and spreadsheets <em>replaced by one platform.</em></h2>
        </div>
        <div class="hc-reveal">
            <p class="hc-lead">The Sourcing &amp; Tender Management System keeps purchase requests, tenders, supplier offers, documents, evaluations, decisions, notifications and reports in one central place, so every step is traceable and every comparison is fair.</p>
            <p class="hc-actions"><a class="hc-btn hc-btn-ghost" asp-area="" asp-controller="Home" asp-action="About">About the platform</a><a class="hc-btn hc-btn-text" asp-area="" asp-controller="Home" asp-action="Team">Meet the team <span aria-hidden="true">&rarr;</span></a></p>
        </div>
    </div>
</section>


<section class="hc-sec" id="analytics" aria-labelledby="hc-stats-h">
    <div class="hc-wrap">
        <div class="hc-head hc-reveal">
            <p class="hc-eyebrow"><span></span>Live from the system</p>
            <h2 id="hc-stats-h">Public figures, <em>never invented.</em></h2>
            <p class="hc-lead">Aggregate counts read directly from the platform database. No names, prices or documents are exposed.</p>
        </div>
        @if (hasData)
        {
            <dl class="hc-stats hc-reveal">
                <div><dt>Active tenders</dt><dd>@st!.ActiveTenders</dd></div>
                <div><dt>Approved suppliers</dt><dd>@st.ApprovedSuppliers</dd></div>
                <div><dt>Completed purchase requests</dt><dd>@st.CompletedRequests</dd></div>
                <div><dt>Closed tenders</dt><dd>@st.Closed</dd></div>
            </dl>
        }
        else
        {
            <p class="hc-empty hc-reveal">No tenders, suppliers or requests have been recorded yet, so there is nothing to report. Figures appear here automatically as the platform is used.</p>
        }
    </div>
</section>


<section class="hc-cta" id="contact" aria-labelledby="hc-contact-h">
    <div class="hc-wrap">
        <p class="hc-eyebrow hc-eyebrow-c"><span></span>Contact &amp; get started</p>
        <h2 id="hc-contact-h">Ready to join the journey?</h2>
        <p class="hc-lead">Suppliers register and are verified by an Admin before activation. Employees sign in with accounts created by an Admin. For general inquiries, onboarding or support, use the contact page.</p>
        <p class="hc-actions hc-actions-c">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="hc-btn hc-btn-solid" asp-area="" asp-controller="Workspace" asp-action="Index">Open My Workspace</a>
            }
            else
            {
                <a class="hc-btn hc-btn-solid" asp-area="Identity" asp-page="/Account/Register">Supplier Registration</a>
                <a class="hc-btn hc-btn-ghost" asp-area="Identity" asp-page="/Account/Login">Login</a>
            }
            <a class="hc-btn hc-btn-text" asp-area="" asp-controller="Home" asp-action="Contact">Contact us <span aria-hidden="true">&rarr;</span></a>
        </p>
    </div>
</section>
