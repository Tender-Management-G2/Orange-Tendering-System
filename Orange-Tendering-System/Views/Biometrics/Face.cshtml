@model BiometricManageViewModel
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Face Registration & Recognition Login";
    ViewData["WorkspaceSection"] = "My Workspace";
    ViewData["Description"] = "Camera-based authentication is disabled pending a verified server-side identity proof.";
}
@section Styles { <link rel="stylesheet" href="~/css/biometric.css" asp-append-version="true" /> }
<partial name="_PageHeader" />

<div id="bio-root" data-return-url="">
    @Html.AntiForgeryToken()
    <div id="bio-status" class="bio-status bio-status--info" role="status">
        Face enrollment and login are disabled. Browser descriptors, liveness measurements and JavaScript verification decisions are untrusted. Existing encrypted samples are retained for your control but cannot authorize a login.
    </div>

    <section class="ws-panel pg-panel">
        <h2>Face recognition</h2>
        <p>
            @if (Model.FaceTemplateCount == 0)
            {
                <span class="pg-hint">No face registered yet.</span>
            }
            else
            {
                <span>@Model.FaceTemplateCount encrypted face sample(s) stored.</span>
            }
        </p>
        <div class="pg-form">
            <div class="pg-form-grid">
                <div class="pg-field"><label for="bioPassword">Current password</label><input id="bioPassword" type="password" autocomplete="current-password" /><small class="pg-hint">Re-checked before your face is registered.</small></div>
            </div>
            <label class="pg-hint"><input id="faceReplace" type="checkbox" checked /> Replace my existing face samples</label>
            <div class="pg-actions">
                <button id="btnFaceEnroll" data-bio-disabled="true" type="button" disabled class="pg-btn pg-btn-primary">Face enrollment unavailable</button>
                @if (Model.FaceTemplateCount > 0)
                {
                    <button id="btnFaceRemove" type="button" class="pg-btn pg-btn-danger">Remove stored samples</button>
                }
            </div>
        </div>
    </section>

    <div id="facePanel" class="bio-face-panel bio-hidden">
        <video id="faceVideo" playsinline muted autoplay></video>
        <div id="faceHint" class="bio-face-hint"></div>
    </div>
</div>

@section Scripts { <script src="~/js/biometric.js" asp-append-version="true"></script> }
