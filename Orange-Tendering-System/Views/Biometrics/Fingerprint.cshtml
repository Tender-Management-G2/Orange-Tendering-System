@*
===========================================================
ORANGE TENDER MANAGEMENT SYSTEM
PAGE: Fingerprint Registration & Login

DEVELOPER OWNER: Ahmad
MODULE: Authentication & Biometrics
TRELLO TASK: Fingerprint Registration & Login
TRELLO URL: https://trello.com/c/mQphpvOG

PURPOSE:
Signed-in users register or remove the fingerprint-capable
authenticator (Windows Hello, Touch ID, phone through QR code,
security key) used by the Login page "Sign in with fingerprint".

BUSINESS ACCESS:
Any signed-in user (enrolls their own account)

ROUTE: /Biometrics/Fingerprint

HOW IT WORKS:
WebAuthn passkey with user verification required. The device
checks the fingerprint locally; this system stores only the
public key (AspNetUserPasskeys). Registration needs the
current password. Everything is audited without biometric data.

DEPENDENCIES:
AspNetUsers, AspNetUserPasskeys, AuditLogs,
wwwroot/js/biometric.js, BiometricsController.
===========================================================
*@
@model BiometricManageViewModel
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Fingerprint Registration & Login";
    ViewData["WorkspaceSection"] = "My Workspace";
    ViewData["Description"] = "Register a fingerprint-capable authenticator for this account.";
}
@section Styles { <link rel="stylesheet" href="~/css/biometric.css" asp-append-version="true" /> }
<partial name="_PageHeader" />

<div id="bio-root" data-return-url="">
    @Html.AntiForgeryToken()
    <div id="bio-status" class="bio-status bio-status--info" role="status">Your fingerprint never leaves your device; only a public key is stored.</div>

    <section class="ws-panel pg-panel">
        <h2>Registered devices</h2>
        @if (Model.Passkeys.Count == 0)
        {
            <p class="pg-hint">No device registered yet.</p>
        }
        else
        {
            <ul class="bio-list">
                @foreach (var p in Model.Passkeys)
                {
                    <li>
                        <div>
                            <strong>@p.Label</strong>
                            <small>Added @p.AddedAt.ToString("yyyy-MM-dd")</small>
                        </div>
                        <button type="button" class="pg-btn pg-btn-danger" data-remove-passkey="@p.Id">Remove</button>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="ws-panel pg-panel">
        <h2>Register fingerprint</h2>
        <div class="pg-form">
            <div class="pg-form-grid">
                <div class="pg-field"><label for="passkeyLabel">Authenticator name</label><input id="passkeyLabel" type="text" maxlength="150" placeholder="e.g. Office laptop" /></div>
                <div class="pg-field"><label for="bioPassword">Current password</label><input id="bioPassword" type="password" autocomplete="current-password" /><small class="pg-hint">Re-checked before a new authenticator is added.</small></div>
            </div>
            <div class="pg-actions">
                <button id="btnPasskeyRegister" type="button" class="pg-btn pg-btn-primary">Register Fingerprint / Passkey</button>
                <span class="pg-hint">If this computer has no fingerprint reader or Windows Hello, choose "Use a phone or tablet" in the browser window and scan the QR code with your phone.</span>
            </div>
        </div>
    </section>
</div>

@section Scripts { <script src="~/js/biometric.js" asp-append-version="true"></script> }
