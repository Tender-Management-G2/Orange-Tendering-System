*@
@{
    Layout = WorkspaceNavigation.LayoutFor(User);
    ViewData["Title"] = "Fingerprint Registration & Login";
    ViewData["WorkspaceSection"] = "My Workspace";
    ViewData["Description"] = "Register a fingerprint-capable authenticator for this account.";
}
<partial name="_PageHeader" />
<partial name="_ScaffoldNotice" />

<aside class="pg-note"><strong>Not implemented</strong><p>No fingerprint data is captured or stored. A real verification approach (device, provider or WebAuthn with a documented way to prove the fingerprint modality) must be chosen and demonstrated first.</p></aside>

<section class="ws-panel pg-panel">
    <h2>Planned enrollment</h2>
    <ol class="pg-steps">
        <li><div><strong>Choose method</strong><small>Team decision on the biometric provider / device</small></div></li>
        <li><div><strong>Verify identity</strong><small>Password re-check before enrollment</small></div></li>
        <li><div><strong>Register authenticator</strong><small>Store only a credential reference, never raw fingerprint data</small></div></li>
        <li><div><strong>Use at sign-in</strong><small>Login page fingerprint button</small></div></li>
    </ol>
</section>

<section class="ws-panel pg-panel">
    <h2>Register fingerprint</h2>
    <form class="pg-form">
        <fieldset disabled>
            <div class="pg-form-grid">
                <div class="pg-field"><label for="f-authenticator-name-1">Authenticator name</label><input id="f-authenticator-name-1" type="text" /><small class="pg-hint">e.g. Office laptop</small></div>
            </div>
            <div class="pg-actions"><button type="submit" class="pg-btn pg-btn-primary">Register fingerprint</button><span class="pg-hint">Not implemented yet — nothing is saved.</span></div>
        </fieldset>
    </form>
</section>
