@model List<Orange_Tendering_System.Models.Entities.Notification>
@{ Layout=WorkspaceNavigation.LayoutFor(User); ViewData["Title"]="Notifications"; ViewData["WorkspaceSection"]="Notifications"; }
<h1>Your notifications</h1>
<form asp-area="" asp-controller="Notifications" asp-action="MarkRead" method="post"><button>Mark your notifications as read</button></form>
@if(Model.Count==0) { <p>No notifications for your account.</p> }
@foreach(var n in Model) { <section class="ws-panel pg-panel"><h2>@n.Title</h2><p>@n.Message</p><p>@n.CreatedAt.ToString("u") · @(n.IsRead ? "Read" : "Unread")</p>@if(n.Link!=null && Url.IsLocalUrl(n.Link)) { <a href="@n.Link">Open related tender</a> }</section> }
